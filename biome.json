{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.json",
      "**/*.css",
      "**/*.mjs",
      "!apps/desktop/public/models/manifest.json",
      "!apps/desktop/public/models/siglip-tokenizer.json",
      "!packaging/flatpak/*.json"
    ]
  },
  "overrides": [
    {
      "includes": ["apps/website/src/styles/global.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/tokens/tokens.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDuplicateCustomProperties": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/**/__goldens__/**", "packages/**/__snapshots__/**"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    },
    {
      "includes": ["crates/**/tests/fixtures/**"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    },
    {
      "includes": [
        ".architecture-baseline.json",
        ".health-baseline.json",
        ".typecheck-baseline.json",
        ".render-perf-baseline.json",
        ".render-perf-results.json",
        ".replay-browser-baseline.json",
        ".replay-browser-results.json",
        ".rust-coverage-baseline.json"
      ],
      "formatter": { "enabled": false }
    },
    {
      "includes": ["**/*.test.*", "**/__tests__/**", "tests/**", "scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "error",
        "noDescendingSpecificity": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noNonNullAssertedOptionalChain": "warn",
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "warn"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "noUnreachable": "warn",
        "noPrecisionLoss": "warn",
        "noUnsafeOptionalChaining": "warn"
      },
      "a11y": {
        "useAriaPropsSupportedByRole": "warn",
        "useSemanticElements": "warn",
        "useKeyWithClickEvents": "warn",
        "noStaticElementInteractions": "warn",
        "useButtonType": "warn",
        "useFocusableInteractive": "warn",
        "noSvgWithoutTitle": "warn",
        "noLabelWithoutControl": "warn",
        "noRedundantRoles": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "actions": {
      "source": { "organizeImports": "on" }
    }
  }
}
