{
  "name": "@varve/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Varve design-system primitives: tokens, themes, icons, and APG-pattern components.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    },
    "./tokens.css": "./src/tokens/tokens.css",
    "./icons": {
      "types": "./src/icons/index.ts",
      "default": "./src/icons/index.ts"
    },
    "./components/ColorPicker": {
      "types": "./src/components/ColorPicker/index.ts",
      "default": "./src/components/ColorPicker/index.ts"
    },
    "./utils/menuTypeAhead": {
      "types": "./src/utils/menuTypeAhead.ts",
      "default": "./src/utils/menuTypeAhead.ts"
    },
    "./utils/focusMovement": {
      "types": "./src/utils/focusMovement.ts",
      "default": "./src/utils/focusMovement.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run packages/ui",
    "audit:tokens": "tsx scripts/audit-tokens.ts",
    "storybook": "storybook dev -p 6006",
    "tokens:generate": "tsx scripts/generate-token-css.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tabler/icons-react": "^3.46.0",
    "@varve/scene": "workspace:*",
    "@varve/shared": "workspace:*",
    "lucide-react": "^1.31.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/react": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "storybook": "^10.5.7",
    "tsx": "^4.23.11"
  },
  "license": "FSL-1.1-MIT"
}
