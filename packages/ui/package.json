{
  "name": "@strata/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Strata design-system primitives: tokens, themes, icons, and APG-pattern components.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    },
    "./tokens.css": "./src/tokens/tokens.css",
    "./icons": {
      "types": "./src/icons/index.ts",
      "default": "./src/icons/index.ts"
    },
    "./components/ColorPicker": {
      "types": "./src/components/ColorPicker/index.ts",
      "default": "./src/components/ColorPicker/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run packages/ui",
    "audit:tokens": "tsx scripts/audit-tokens.ts",
    "storybook": "storybook dev -p 6006",
    "tokens:generate": "tsx scripts/generate-token-css.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.13",
    "@fontsource-variable/geist": "^5.2.0",
    "@fontsource-variable/ibm-plex-sans": "^5.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@strata/scene": "workspace:*",
    "@strata/shared": "workspace:*",
    "lucide-react": "^0.469.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/preview-api": "^8.6.14",
    "@storybook/react": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "storybook": "^10.4.6",
    "tsx": "^4.19.0"
  },
  "license": "FSL-1.1-MIT"
}
