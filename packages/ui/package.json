{
  "name": "@strata/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Strata design-system primitives: tokens, themes, icons, and APG-pattern components.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    },
    "./tokens.css": "./src/tokens/tokens.css",
    "./icons": {
      "types": "./src/icons/index.ts",
      "default": "./src/icons/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run packages/ui",
    "audit:tokens": "tsx scripts/audit-tokens.ts",
    "tokens:generate": "tsx scripts/generate-token-css.ts"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.2.0",
    "@fontsource-variable/geist": "^5.2.0",
    "lucide-react": "^0.469.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.13"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
