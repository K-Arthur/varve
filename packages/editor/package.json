{
  "name": "@strata/editor",
  "version": "0.0.0",
  "private": true,
  "description": "Strata editor UI: app shell, toolbar, canvas, layers, inspector, status, shortcuts.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./editor.css": "./src/editor.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run packages/editor"
  },
  "dependencies": {
    "@strata/ai": "workspace:*",
    "@strata/compositor": "workspace:*",
    "@strata/codegen": "workspace:*",
    "@strata/collab": "workspace:*",
    "@strata/engine": "workspace:*",
    "@strata/help": "workspace:*",
    "@strata/import": "workspace:*",
    "@strata/platform": "workspace:*",
    "@strata/plugin-sandbox": "workspace:*",
    "@strata/prototype": "workspace:*",
    "@strata/scene": "workspace:*",
    "@strata/shared": "workspace:*",
    "@strata/ui": "workspace:*",
    "@tanstack/react-virtual": "^3.14.4",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/prismjs": "^1.26.6"
  }
}
