{
  "name": "@strata/editor",
  "version": "0.0.0",
  "private": true,
  "description": "Strata editor UI: app shell, toolbar, canvas, layers, inspector, status, shortcuts.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./editor.css": "./src/editor.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run packages/editor"
  },
  "dependencies": {
    "@strata/codegen": "workspace:*",
    "@strata/shared": "workspace:*",
    "@strata/scene": "workspace:*",
    "@strata/engine": "workspace:*",
    "@strata/ui": "workspace:*"
  }
}
