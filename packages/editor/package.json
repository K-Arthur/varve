{
  "name": "@varve/editor",
  "version": "0.0.0",
  "private": true,
  "description": "Varve editor UI: app shell, toolbar, canvas, layers, inspector, status, shortcuts.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./auxiliary": {
      "types": "./src/auxiliary/index.ts",
      "default": "./src/auxiliary/index.ts"
    },
    "./editor.css": "./src/editor.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run packages/editor"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "@varve/ai": "workspace:*",
    "@varve/codegen": "workspace:*",
    "@varve/collab": "workspace:*",
    "@varve/compositor": "workspace:*",
    "@varve/crash": "workspace:*",
    "@varve/engine": "workspace:*",
    "@varve/help": "workspace:*",
    "@varve/history": "workspace:*",
    "@varve/import": "workspace:*",
    "@varve/platform": "workspace:*",
    "@varve/prototype": "workspace:*",
    "@varve/scene": "workspace:*",
    "@varve/shared": "workspace:*",
    "@varve/tokens": "workspace:*",
    "@varve/ui": "workspace:*",
    "fflate": "^0.8.3",
    "prismjs": "^1.30.0",
    "wawoff2": "^2.0.1",
    "@varve/layout": "workspace:*"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.11.1",
    "@types/prismjs": "^1.26.6"
  },
  "license": "FSL-1.1-MIT"
}
