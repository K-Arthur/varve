{
  "name": "@varve/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Dual-backend renderer facade: native (Tauri IPC → Rust) on desktop, WASM on web. Identical API.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./font": {
      "types": "./src/font/index.ts",
      "default": "./src/font/index.ts"
    },
    "./liveEffects": {
      "types": "./src/liveEffects/index.ts",
      "default": "./src/liveEffects/index.ts"
    },
    "./rasterPyramid": {
      "types": "./src/rasterPyramid/index.ts",
      "default": "./src/rasterPyramid/index.ts"
    },
    "./gpuAdapter": {
      "types": "./src/gpuAdapter.ts",
      "default": "./src/gpuAdapter.ts"
    },
    "./semanticSimilarity": {
      "types": "./src/semanticSimilarity/index.ts",
      "default": "./src/semanticSimilarity/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run packages/engine"
  },
  "dependencies": {
    "@varve/platform": "workspace:*",
    "@varve/shared": "workspace:*",
    "bidi-js": "^1.0.3",
    "harfbuzzjs": "^1.6.0",
    "mp4-muxer": "^5.2.2",
    "opentype.js": "^2.0.0",
    "wawoff2": "^2.0.1",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@types/opentype.js": "^1.3.10",
    "@webgpu/types": "^0.1.71",
    "onnxruntime-web": "^1.27.0"
  },
  "license": "FSL-1.1-MIT"
}
