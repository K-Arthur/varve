{
  "name": "@strata/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Dual-backend renderer facade: native (Tauri IPC → Rust) on desktop, WASM on web. Identical API.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run packages/engine"
  },
  "dependencies": {
    "@strata/shared": "workspace:*"
  }
}
