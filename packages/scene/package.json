{
  "name": "@varve/scene",
  "version": "0.0.0",
  "private": true,
  "description": "Document model: scene graph, ComponentDefinition with typed slots, VariableStore with math.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./export": {
      "types": "./src/export/index.ts",
      "default": "./src/export/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run packages/scene"
  },
  "dependencies": {
    "@varve/engine": "workspace:*",
    "@varve/shared": "workspace:*",
    "@varve/tokens": "workspace:*",
    "polygon-clipping": "^0.15.7"
  },
  "license": "FSL-1.1-MIT"
}
