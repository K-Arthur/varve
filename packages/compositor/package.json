{
  "name": "@varve/compositor",
  "version": "0.0.0",
  "private": true,
  "description": "Pluggable render compositor: Canvas2D baseline, WebGPU when available.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run packages/compositor"
  },
  "dependencies": {
    "@varve/engine": "workspace:*",
    "@varve/shared": "workspace:*"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.71",
    "esbuild": "^0.27.7"
  },
  "license": "FSL-1.1-MIT"
}
