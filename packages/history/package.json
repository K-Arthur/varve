{
  "name": "@varve/history",
  "version": "0.0.0",
  "private": true,
  "description": "Persistent revision history: append-only operation log, revision DAG, replay, snapshots, and recovery (ADRs 0017-0046).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run packages/history"
  },
  "dependencies": {
    "@varve/scene": "workspace:*",
    "idb": "^8.0.0"
  },
  "license": "FSL-1.1-MIT"
}
