# --- Build caches / tmp ---
.tmp/
.boot-check.tmp.mjs

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Credential files (never commit) ---
# A .npmrc containing registry auth, a .netrc with host credentials, or a
# Cargo credentials file must never enter the repository.
.netrc
.npmrc
credentials
cargo-credentials

# --- Signing material (NEVER commit) ---
# Private keys, PKCS#12 bundles, certificate export passwords live only in
# secret storage / offline backups. Nothing here may ever be committed.
*.p12
*.pfx
*.p8
*.key
*.pem
*.der
*.cer
*.crt
*.csr
!packages/**/test-fixtures/**
# CI-generated signing config merge (contains no secrets, but is CI-local)
apps/desktop/src-tauri/tauri.signing.windows.json

# --- Secret-scanner local state (never commit reports/baselines) ---
.gitleaks/
.gitleaks-report.*
secret-scan-report.*

# --- Logs ---
*.log
npm-debug.log*

# --- Test artifacts ---
test-results/
playwright-report/
visual-diff-report/

# --- Human-review screenshot captures (regenerated by tests/e2e/workspace/capture.*) ---
/docs/screenshots/detach-flow/
/docs/screenshots/detach-multi/
/docs/screenshots/multi-window/
/docs/screenshots/table-modifiers/

# --- Python bytecode ---
__pycache__/
*.pyc

# --- Generated review artifacts (screenshots, mutation outputs) ---
reports/

# --- Transient GPU-verify Chrome profile (verify-gpu-effects.mjs) ---
.tmp-gpu-verify-profile/

# --- Local AI tool config (personal paths, no secrets) ---
.claude/

# --- Devin AI agent (workflows directory intentionally empty) ---
.devin/

# --- Generated ONNX Runtime Web WASM artifacts ---
apps/desktop/public/ort-wasm/

# --- Fetched native ONNX Runtime shared libraries (scripts/fetch-onnxruntime.mjs) ---
apps/desktop/src-tauri/onnxruntime-libs/

# --- Render-perf raw run output (regenerated every run; .render-perf-baseline.json is the
# committed, deliberately-updated artifact — see scripts/audit-render-perf.mjs) ---
.render-perf-results.json
scripts/diagnostics/
.replay-browser-results.json

# --- One-off perf debugging dumps (removed 2026-08-04; kept out of future commits) ---
scripts/perf/dump*.mjs

# --- Local CI/CD (act) secrets stub — never commit real tokens ---
.act-secrets
.replay-browser-results.json
