node_modules
.pnpm-store
dist
.astro
build
.next
.turbo
*.tsbuildinfo
coverage
.vitest-cache

# --- Tauri ---
apps/desktop/src-tauri/target
apps/desktop/src-tauri/gen
apps/desktop/.tauri

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.swp
.DS_Store
Thumbs.db

# --- Worktrees ---
.worktrees

# --- Agent brainstorm / visual companion ---
.superpowers/

# --- Transient agent memory files (tracked copies in docs/implementation-memory/) ---
.system_memory.md
.alignment_memory.md
.color_system_memory.md
.effects_system_memory.md
.select_scale_memory.md
.impeccable.md
/*_MEMORY.md
/CONTINUATION.md

# --- CI debug reports (generated, one-off) ---
/ci-debug-report*.md
/ci-failure-manifest*.json

# --- Build caches / tmp ---
.tmp/
.tmp-*
.boot-check.tmp.mjs
.flatpak-builder/

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Credential files (never commit) ---
# A .npmrc containing registry auth, a .netrc with host credentials, or a
# Cargo credentials file must never enter the repository.
.netrc
.npmrc
credentials
cargo-credentials

# --- Signing material (NEVER commit) ---
# Private keys, PKCS#12 bundles, certificate export passwords live only in
# secret storage / offline backups. Nothing here may ever be committed.
*.p12
*.pfx
*.p8
*.key
*.pem
*.der
*.cer
*.crt
*.csr
!packages/**/test-fixtures/**
# CI-generated signing config merge (contains no secrets, but is CI-local)
apps/desktop/src-tauri/tauri.signing.windows.json

# --- Secret-scanner local state (never commit reports/baselines) ---
.gitleaks/
.gitleaks-report.*
secret-scan-report.*

# --- Logs ---
*.log
npm-debug.log*

# --- Local-only Playwright validation configs (machine accommodations, declared
# "not part of the committed test matrix"; the committed layer-fidelity config
# is the deliberate exception) ---
/playwright.*.local.config.ts
!/playwright.layer-fidelity.local.config.ts

# --- Test artifacts ---
test-results/
test-results-*/
playwright-report/
# Scratch recordings from scripts/capture — the delivered clips live in docs/
.capture-tmp/
visual-diff-report/

# --- Human-review screenshot captures (regenerated by tests/e2e/workspace/capture.*) ---
/docs/screenshots/detach-flow/
/docs/screenshots/detach-multi/
/docs/screenshots/download/
/docs/screenshots/multi-window/
/docs/screenshots/table-modifiers/

# --- Python bytecode ---
__pycache__/
*.pyc

# --- Generated review artifacts (screenshots, mutation outputs) ---
reports/
artifacts/

# --- Generated CI plan downloads ---
ci-plan-artifact/
candidate-plan/
# Exact workflow outputs; these are evidence artifacts, never source.
/ci-plan.json
/ci-execution/
/ci-needs.json
/ci-certification.json
/candidate-certification.json
/ci-feedback.json

# --- Downloaded test corpus (restore-system fixtures fetched by scripts) ---
tests/fixtures/restore-corpus/

# --- Local AI tool config (personal paths, no secrets) ---
.claude/
.codex/
.agents/
.zcode/
/.zcodeignore

# --- Devin AI agent (workflows directory intentionally empty) ---
.devin/

# --- Generated ONNX Runtime Web WASM artifacts ---
apps/desktop/public/ort-wasm/

# --- Fetched native ONNX Runtime shared libraries (scripts/fetch-onnxruntime.mjs) ---
apps/desktop/src-tauri/onnxruntime-libs/

# --- Render-perf raw run output (regenerated every run; .render-perf-baseline.json is the
# committed, deliberately-updated artifact — see scripts/audit-render-perf.mjs) ---
.render-perf-results.json
# Older native qualification runs wrote machine-local diagnostics at the repo
# root. New runs go under reports/perf/; keep any legacy output out of releases.
/native-webgl2-*.json
scripts/diagnostics/
.replay-browser-results.json

# --- Large source models for quantization (hosted on varve-models-v1 release) ---
models-source/

# --- One-off perf debugging dumps (removed 2026-08-04; kept out of future commits) ---
scripts/perf/dump*.mjs

# --- Local CI/CD (act) secrets stub — never commit real tokens ---
.act-secrets

# --- Non-bundled downloaded ONNX models (fetched on demand; never commit) ---
apps/desktop/public/models/**/*.onnx
# MODNet portrait is a runtime download (26 MB), served from a per-model
# directory so a local download cache cannot be committed accidentally.
apps/desktop/public/models/modnet-portrait/
# Grounding DINO Tiny is a 194 MB runtime download with a tokenizer sidecar.
apps/desktop/public/models/grounding-dino/
# The five checksum-pinned bundled models in manifest.json remain tracked.
# Optional downloads stay ignored; never ship a warm local model cache.
!apps/desktop/public/models/u2netp.onnx
!apps/desktop/public/models/realesr-general-x4v3.onnx
!apps/desktop/public/models/yunet-face-detect.onnx
!apps/desktop/public/models/quantized/u2netp-int8.onnx
!apps/desktop/public/models/quantized/realesr-general-x4v3-int8.onnx

# Browser-demo build output (apps/desktop/dist-try) — the bare `dist` rule
# above does not match it, and a warm local ONNX model cache makes this
# directory ~700 MB. Never commit it.
apps/desktop/dist-try/
