{"id":"varve-demo-layout","formatVersion":"2.21","name":"Editorial Spread","rootChildren":["spread-left","spread-right"],"nodes":{"spread-left":{"id":"spread-left","kind":"frame","name":"Page 12","layerColor":null,"order":"a0","visible":true,"locked":false,"opacity":1,"blendMode":"normal","rotation":0,"transform":[1,0,0,1,0,0],"fill":{"space":"rgb","r":247,"g":245,"b":240,"a":255},"w":620,"h":840,"children":["spread-left-title","spread-left-col-0","spread-left-col-1","spread-left-plate","spread-left-folio"],"clipContent":true,"strokes":[],"effects":[],"index":0},"spread-left-title":{"id":"spread-left-title","kind":"text","name":"Headline","layerColor":null,"order":"a0","visible":true,"locked":false,"opacity":1,"blendMode":"normal","rotation":0,"text":"Reading\nthe record","transform":[1,0,0,1,56,84],"fill":{"space":"rgb","r":16,"g":21,"b":31,"a":255},"fontSize":62,"fontFamily":"IBM Plex Sans Variable","fontWeight":800,"fontStyle":"normal","lineHeight":1,"letterSpacing":-2,"textAlign":"left","strokes":[],"effects":[]},"spread-left-col-0":{"id":"spread-left-col-0","kind":"text","name":"Column 1","layerColor":null,"order":"a1","visible":true,"locked":false,"opacity":1,"blendMode":"normal","rotation":0,"text":"A varve is a pair of sediment\nlayers laid down in a single\nyear: a pale spring layer of\nfine silt, and a darker winter\nlayer of clay.","transform":[1,0,0,1,56,268],"w":232,"fill":{"space":"rgb","r":16,"g":21,"b":31,"a":255},"fontSize":15,"fontFamily":"IBM Plex Sans Variable","fontWeight":400,"fontStyle":"normal","lineHeight":1.62,"letterSpacing":0,"textAlign":"left","strokes":[],"effects":[]},"spread-left-col-1":{"id":"spread-left-col-1","kind":"text","name":"Column 2","layerColor":null,"order":"a2","visible":true,"locked":false,"opacity":1,"blendMode":"normal","rotation":0,"text":"Counted downward they date\na lake bed the way tree rings\ndate a trunk — one line per\nyear, in order, without gaps.","transform":[1,0,0,1,314,268],"w":232,"fill":{"space":"rgb","r":16,"g":21,"b":31,"a":255},"fontSize":15,"fontFamily":"IBM Plex Sans Variable","fontWeight":400,"fontStyle":"normal","lineHeight":1.62,"letterSpacing":0,"textAlign":"left","strokes":[],"effects":[]},"spread-left-plate":{"id":"spread-left-plate","kind":"shape","name":"Plate","layerColor":null,"order":"a3","visible":true,"locked":false,"opacity":1,"blendMode":"normal","rotation":0,"shape":{"kind":"rect","x":0,"y":0,"w":508,"h":190},"transform":[1,0,0,1,56,596],"fill":{"space":"rgb","r":45,"g":165,"b":158,"a":255},"strokes":[],"effects":[]},"spread-left-folio":{"id":"spread-left-folio","kind":"text","name":"Folio","layerColor":null,"order":"a4","visible":true,"locked":false,"opacity":1,"blendMode":"normal","rotation":0,"text":"12","transform":[1,0,0,1,56,800],"fill":{"space":"rgb","r":18,"g":92,"b":92,"a":255},"fontSize":15,"fontFamily":"IBM Plex Sans Variable","fontWeight":600,"fontStyle":"normal","lineHeight":1.2,"letterSpacing":0,"textAlign":"left","strokes":[],"effects":[]},"spread-right":{"id":"spread-right","kind":"frame","name":"Page 13","layerColor":null,"order":"a1","visible":true,"locked":false,"opacity":1,"blendMode":"normal","rotation":0,"transform":[1,0,0,1,660,0],"fill":{"space":"rgb","r":247,"g":245,"b":240,"a":255},"w":620,"h":840,"children":["spread-right-title","spread-right-col-0","spread-right-col-1","spread-right-plate","spread-right-folio"],"clipContent":true,"strokes":[],"effects":[],"index":1},"spread-right-title":{"id":"spread-right-title","kind":"text","name":"Headline","layerColor":null,"order":"a0","visible":true,"locked":false,"opacity":1,"blendMode":"normal","rotation":0,"text":"One year,\none layer","transform":[1,0,0,1,56,84],"fill":{"space":"rgb","r":16,"g":21,"b":31,"a":255},"fontSize":62,"fontFamily":"IBM Plex Sans Variable","fontWeight":800,"fontStyle":"normal","lineHeight":1,"letterSpacing":-2,"textAlign":"left","strokes":[],"effects":[]},"spread-right-col-0":{"id":"spread-right-col-0","kind":"text","name":"Column 1","layerColor":null,"order":"a1","visible":true,"locked":false,"opacity":1,"blendMode":"normal","rotation":0,"text":"Read one layer on its own and\nit says very little. Read the\nsequence and it keeps a record\nno single layer holds.","transform":[1,0,0,1,56,268],"w":232,"fill":{"space":"rgb","r":16,"g":21,"b":31,"a":255},"fontSize":15,"fontFamily":"IBM Plex Sans Variable","fontWeight":400,"fontStyle":"normal","lineHeight":1.62,"letterSpacing":0,"textAlign":"left","strokes":[],"effects":[]},"spread-right-col-1":{"id":"spread-right-col-1","kind":"text","name":"Column 2","layerColor":null,"order":"a2","visible":true,"locked":false,"opacity":1,"blendMode":"normal","rotation":0,"text":"The thinnest bands mark dry\nyears; the thickest follow a\nflood. The record is legible\nbecause the order survived.","transform":[1,0,0,1,314,268],"w":232,"fill":{"space":"rgb","r":16,"g":21,"b":31,"a":255},"fontSize":15,"fontFamily":"IBM Plex Sans Variable","fontWeight":400,"fontStyle":"normal","lineHeight":1.62,"letterSpacing":0,"textAlign":"left","strokes":[],"effects":[]},"spread-right-plate":{"id":"spread-right-plate","kind":"shape","name":"Plate","layerColor":null,"order":"a3","visible":true,"locked":false,"opacity":1,"blendMode":"normal","rotation":0,"shape":{"kind":"rect","x":0,"y":0,"w":508,"h":190},"transform":[1,0,0,1,56,596],"fill":{"space":"rgb","r":226,"g":140,"b":60,"a":255},"strokes":[],"effects":[]},"spread-right-folio":{"id":"spread-right-folio","kind":"text","name":"Folio","layerColor":null,"order":"a4","visible":true,"locked":false,"opacity":1,"blendMode":"normal","rotation":0,"text":"13","transform":[1,0,0,1,56,800],"fill":{"space":"rgb","r":18,"g":92,"b":92,"a":255},"fontSize":15,"fontFamily":"IBM Plex Sans Variable","fontWeight":600,"fontStyle":"normal","lineHeight":1.2,"letterSpacing":0,"textAlign":"left","strokes":[],"effects":[]}},"components":{},"nextId":1,"selectionSets":{"version":1,"sets":[]},"savedAreaSelections":[],"gridSettings":{"documentGrid":{"id":"grid-document-default","type":"document","name":"Document Grid","visible":false,"snapEnabled":true,"color":"var(--color-border-subtle)","opacity":0.4,"scope":"document","spacingX":8,"spacingY":8,"subdivisions":4,"offsetX":0,"offsetY":0},"pixelGrid":{"id":"grid-pixel-default","type":"pixel","name":"Pixel Grid","visible":false,"snapEnabled":false,"color":"var(--color-border-subtle)","opacity":0.5,"scope":"document","showAtHighZoom":true,"zoomThreshold":4}}}
