#!/bin/sh
# commit-msg hook: reject AI tool attribution in commit messages.
# All commits in this repository are authored by the maintainer.
# AI tool output is reviewed and committed as the maintainer's work.
#
# Install: cp .githooks/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
# Or: git config core.hooksPath .githooks

msg=$(cat "$1")

# Block AI Co-authored-by trailers (all known AI tools)
if echo "$msg" | grep -qiE '^Co-authored-by:.*(claude|anthropic|devin|cognition|copilot|codex|chatgpt|openai|gemini|cursor|windsurf|opencode|strata.agent|cascade)'; then
  echo "ERROR: Commit message contains an AI tool Co-authored-by trailer." >&2
  echo "All commits in this repository are authored by the maintainer." >&2
  echo "Remove the AI Co-authored-by line(s) and try again." >&2
  exit 1
fi

# Block AI generation attribution signatures in commit body
if echo "$msg" | grep -qiE '(Generated with \[Devin\]|Generated by Claude|Generated with Claude|Created with Devin|Written with Copilot|Generated by Codex|AI-generated commit|AI-assisted commit)'; then
  echo "ERROR: Commit message contains AI tool generation attribution." >&2
  echo "All commits in this repository are authored by the maintainer." >&2
  echo "Remove the attribution line(s) and try again." >&2
  exit 1
fi

# Block placeholder/template co-author trailers (sign of automated tool output)
if echo "$msg" | grep -qiE '^Co-authored-by:.*<<[A-Z_]+>>'; then
  echo "ERROR: Commit message contains a placeholder co-author trailer." >&2
  echo "Remove the placeholder line(s) and try again." >&2
  exit 1
fi
