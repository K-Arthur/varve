{
  "schemaVersion": 1,
  "id": "dev.varve.example.batch-rename",
  "name": "Number Selected Layers",
  "publisher": "Varve examples (local source)",
  "version": "1.1.0",
  "apiVersion": 1,
  "entry": "module.wasm",
  "description": "Previews sequential names for unlocked selected layers before one undoable apply.",
  "thumbnail": {
    "path": "thumbnail.png",
    "alt": "Three unnamed layers transform into a numbered list"
  },
  "permissions": {
    "required": ["selection.read"],
    "optional": ["document.write"]
  },
  "commands": [{ "id": "rename", "title": "Preview numbered layer names", "kind": "rename" }],
  "inspector": [
    {
      "id": "numbered-layers",
      "title": "Number layers",
      "command": "rename",
      "tab": "properties",
      "modes": ["design", "print", "drawing", "image", "email"]
    }
  ]
}
