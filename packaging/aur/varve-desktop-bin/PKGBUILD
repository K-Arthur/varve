# Maintainer: Varve <hello at varve dot studio>
#
# Binary package: extracts the released AppImage rather than running it in
# place. Extracting gives real .desktop/icon/MIME integration, avoids the FUSE
# dependency entirely, and lets pacman own every installed file so uninstall is
# clean — none of which an AppImage wrapper script provides.
#
# NOTE: `sha256sums` must be updated on every release. Get the value from the
# published SHA256SUMS.txt, which the release pipeline generates:
#   curl -sL https://github.com/K-Arthur/varve/releases/download/v$pkgver/SHA256SUMS.txt

pkgname=varve-desktop-bin
_appname=varve-desktop
pkgver=0.5.0
pkgrel=1
pkgdesc="Local-first design suite for vector, layout, typography, motion and print"
arch=('x86_64' 'aarch64')
url="https://github.com/K-Arthur/varve"
license=('FSL-1.1-MIT')
# Runtime libraries the Tauri binary links against. Deliberately not the full
# AppImage payload: on Arch these are all present as system packages, and using
# them keeps the install small and patched by the distro.
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'glib2'
  'libsoup3'
  'librsvg'
  'openssl'
  'gdk-pixbuf2'
  'cairo'
  'pango'
  'fontconfig'
)
optdepends=(
  'cups: printing support'
  'xdg-desktop-portal: native file dialogs under Wayland'
)
provides=("${_appname}")
conflicts=("${_appname}" "${_appname}-git")
options=('!strip' '!debug')

source=("Varve-${pkgver}-linux-${CARCH}.AppImage::${url}/releases/download/v${pkgver}/Varve-${pkgver}-linux-${CARCH}.AppImage")
sha256sums_x86_64=('fb0c188286fbd92479f88dd0eefc4547d3544b33e7dc5120abd399bfdf2237af')
sha256sums_aarch64=('4684fef861cdf3dd51cfd326f5a9452d29d733af9e9d4c53b18f06fc0ab8c404')
noextract=("Varve-${pkgver}-linux-${CARCH}.AppImage")

# Install a directory tree with world-readable dirs (755), regular files 644,
# and executables / shared objects 755. The v0.5.0 AppImage squashfs ships
# every directory as 0700 (and AppRun.wrapped as 0770); `cp -a` would otherwise
# install root-owned 0700 trees that unprivileged users cannot read.
_install_tree() {
  local src="$1" dest="$2" path rel
  install -dm755 "${dest}"
  while IFS= read -r -d '' path; do
    rel="${path#"${src}"/}"
    if [[ -d "${path}" && ! -L "${path}" ]]; then
      install -dm755 "${dest}/${rel}"
    elif [[ -L "${path}" ]]; then
      install -dm755 "${dest}/$(dirname "${rel}")"
      cp -d "${path}" "${dest}/${rel}"
    elif [[ -f "${path}" ]]; then
      if [[ "${rel}" == *.so || "${rel}" == *.so.* || -x "${path}" ]]; then
        install -Dm755 "${path}" "${dest}/${rel}"
      else
        install -Dm644 "${path}" "${dest}/${rel}"
      fi
    fi
  done < <(find "${src}" -mindepth 1 -print0)
}

prepare() {
  cd "${srcdir}"
  chmod +x "Varve-${pkgver}-linux-${CARCH}.AppImage"
  # --appimage-extract does not need FUSE, so this works in a clean chroot and
  # in CI containers where /dev/fuse is unavailable.
  "./Varve-${pkgver}-linux-${CARCH}.AppImage" --appimage-extract >/dev/null

  # World-readable extract: dirs 755, files 644, anything that already had
  # user-execute (binaries, AppRun.wrapped, most .so files) 755.
  chmod -R u+rwX,go+rX,go-w squashfs-root
}

package() {
  cd "${srcdir}/squashfs-root"

  # Main executable
  install -Dm755 "usr/bin/${_appname}" "${pkgdir}/usr/bin/${_appname}"

  # The AppImage bundles copies of system libraries so it can run anywhere.
  # On Arch those come from `depends` above, so they are intentionally dropped —
  # keeping them would ship stale, unpatched duplicates of distro libraries.

  # Tauri resources (bundled ONNX Runtime) must be kept under /usr/lib/Varve/
  # where Tauri looks for them. This includes ONNX Runtime which is not in any
  # distro repo.
  if [[ -d "usr/lib/Varve" ]]; then
    _install_tree "usr/lib/Varve" "${pkgdir}/usr/lib/Varve"
  fi

  # Install license files (required for non-common licenses)
  install -Dm644 "usr/lib/Varve/_up_/_up_/_up_/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  if [[ -f "usr/lib/Varve/_up_/_up_/_up_/THIRD_PARTY_NOTICES" ]]; then
    install -Dm644 "usr/lib/Varve/_up_/_up_/_up_/THIRD_PARTY_NOTICES" \
      "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_NOTICES"
  fi
  if [[ -d "usr/lib/Varve/_up_/_up_/_up_/THIRD_PARTY_LICENSES" ]]; then
    _install_tree "usr/lib/Varve/_up_/_up_/_up_/THIRD_PARTY_LICENSES" \
      "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_LICENSES"
  fi

  # Desktop entry, normalised to the packaged binary path
  local _desktop
  _desktop="$(find usr/share/applications -name '*.desktop' | head -1)"
  if [[ -n "${_desktop}" ]]; then
    install -Dm644 "${_desktop}" "${pkgdir}/usr/share/applications/dev.varve.desktop.desktop"
    sed -i \
      -e 's|^Exec=.*|Exec=varve-desktop %F|' \
      -e 's|^Icon=.*|Icon=dev.varve.desktop|' \
      "${pkgdir}/usr/share/applications/dev.varve.desktop.desktop"
  fi

  # MetaInfo for GNOME Software, KDE Discover, etc.
  if [[ -f "usr/share/metainfo/dev.varve.desktop.metainfo.xml" ]]; then
    install -Dm644 "usr/share/metainfo/dev.varve.desktop.metainfo.xml" \
      "${pkgdir}/usr/share/metainfo/dev.varve.desktop.metainfo.xml"
  fi

  # Icons — every size the AppImage carries, with modes reset (not `cp -a`).
  if [[ -d usr/share/icons/hicolor ]]; then
    _install_tree usr/share/icons/hicolor "${pkgdir}/usr/share/icons/hicolor"
  fi

  # MIME types for .varve and .strata documents, so double-click opens the app
  if [[ -f "usr/share/mime/packages/dev.varve.desktop.xml" ]]; then
    install -Dm644 "usr/share/mime/packages/dev.varve.desktop.xml" \
      "${pkgdir}/usr/share/mime/packages/dev.varve.desktop.xml"
  fi

  # Documentation
  install -Dm644 /dev/stdin "${pkgdir}/usr/share/doc/${pkgname}/README" <<'DOC'
Varve stores documents as .varve files (legacy .strata files stay openable) and keeps everything on your machine.

This build is not code-signed. Verify your download against the published
SHA256SUMS.txt at https://github.com/K-Arthur/varve/releases

Optional AI models (colorization, font identification, depth, denoise) are
downloaded on demand from within the app and verified by SHA-256. They are not
included in this package.
DOC
}
