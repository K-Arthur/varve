#!/bin/sh
# Varve pre-commit hook.
# Installed by scripts/install-git-hooks.mjs (triggered from package.json prepare).

set -e

if [ -n "$CI" ]; then
  exit 0
fi

echo "=== Varve pre-commit checks ==="

# 1. Format + lint (staged only)
pnpm exec biome check --staged --no-errors-on-unmatched

# 2. Emoji audit
pnpm audit:emoji

# 3. Health check: hub file budgets, complexity comments, over-ceiling guards
node scripts/audit-health.mjs --staged

# 4. Validation-policy audit (cheap): impact config not stale + infra present
node scripts/quality/audit-impact-config.mjs

# 5. Workflow validation (only if workflow files are staged)
STAGED_WORKFLOWS=$(git diff --cached --name-only --diff-filter=ACMR | grep '.github/workflows/' || true)
if [ -n "$STAGED_WORKFLOWS" ]; then
  echo "  → Validating GitHub Actions workflows..."
  node scripts/validate-workflows.mjs --staged
  echo "  → Checking action SHA pinning (static)..."
  node scripts/pin-github-actions.mjs --check
  echo "  → Verifying pinned SHAs resolve upstream..."
  node scripts/pin-github-actions.mjs --verify
fi

# 6. Quick cycle check on changed packages (madge, runs only on JS/TS changes)
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACMR | grep -c '\.\(ts\|tsx\)$' || true)
if [ "$STAGED_TS" -gt 0 ]; then
  echo "  → Checking dependency cycles..."
  # Only check editor and scene (the two packages with recent cycle debt)
  for pkg in editor scene engine; do
    RESULT=$(npx --yes madge --circular --extensions ts,tsx \
      --ts-config tsconfig.base.json "packages/$pkg/src/index.ts" 2>/dev/null | tail -1)
    if echo "$RESULT" | grep -q "Found"; then
      CYCLE_COUNT=$(echo "$RESULT" | grep -o '[0-9]\+' || echo "0")
      if [ "$CYCLE_COUNT" -gt 1 ]; then
        echo "  ❌ packages/$pkg: $CYCLE_COUNT cycles (ceiling: 1)"
        echo "  Run: npx madge --circular ... packages/$pkg/src/index.ts"
        exit 1
      fi
    fi
  done
fi

# 7. Policy test when validation infra itself changed (cheap; guards the system)
STAGED_VALIDATION=$(git diff --cached --name-only --diff-filter=ACMR | grep -E 'scripts/quality/|validation-impact|tests/unit/validationPolicy' || true)
if [ -n "$STAGED_VALIDATION" ]; then
  echo "  → Validation infrastructure changed; running policy test..."
  pnpm exec vitest run tests/unit/validationPolicy.test.ts
fi

echo "=== Pre-commit checks passed ==="
