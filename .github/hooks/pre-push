#!/bin/sh
# Varve pre-push hook.
# Installed by scripts/install-git-hooks.mjs (triggered from package.json prepare).

set -e

# Do not run inside CI.
if [ -n "$CI" ]; then
  exit 0
fi

# Run the full Cascade Review gate before pushing.
echo "Running pre-push gate (just gate)..."
just gate

# Informational pipeline health check. Never blocks the push — it warns when
# remote CI cannot run (GitHub billing block / runner outage / Actions
# incident) so the developer knows a red run is infra, not code.
if node scripts/ci-health.mjs --quiet; then
  :
else
  echo "(ci-health check unavailable — skipping pipeline health warning)"
fi

# GitHub Actions incident warning (e.g. "major_outage" — jobs queue forever
# then die with "not acquired by Runner"). Pushing into an outage produces
# zero signal, so surface it before the push. Still never blocks.
if ! node scripts/ci-health.mjs --status --quiet; then
  node scripts/ci-health.mjs --status || echo "(could not check githubstatus.com — skipping incident warning)"
fi

# Version drift warning: the five version manifests must agree or the next
# release dies at its tag gate. Warn (never block) — a drift fix is one
# `just release-bump` + `cargo check` away.
if ! node scripts/release/version.mjs verify; then
  echo "Version manifests disagree — fix before releasing with:"
  echo "  just release-bump <major|minor|patch>   # or"
  echo "  node scripts/release/version.mjs set <semver>"
fi

echo "Pre-push gate passed."
