{
  "name": "varve",
  "version": "0.1.2",
  "private": true,
  "description": "Varve — local-first design suite for vector, layout, typography, motion, prototyping, and print production.",
  "homepage": "https://varve.studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/K-Arthur/varve.git"
  },
  "bugs": {
    "url": "https://github.com/K-Arthur/varve/issues"
  },
  "license": "FSL-1.1-MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/copy-onnx-wasm.mjs && node scripts/fetch-onnxruntime.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm test:ci:tools && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci:tools": "node scripts/ci-debug.test.mjs && node scripts/ci-health.test.mjs && node scripts/pin-github-actions.test.mjs && node scripts/validate-workflows.test.mjs && node scripts/release/release-pipeline.test.mjs && node scripts/release/collect-artifacts.test.mjs && node scripts/release/signing-policy.test.mjs && node scripts/release/report-installer-size.test.mjs && node scripts/secret-scan.test.mjs && node scripts/security/workflow-policy.test.mjs && node scripts/security/validate-client-env.test.mjs && node scripts/security/import-boundaries.test.mjs && node scripts/security/dependency-hardening.test.mjs && bash scripts/test-ci-shell-scripts.sh",
    "bench:canvas": "vitest run --config vitest.bench.config.ts packages/engine/src/bench/replay.bench.ts",
    "bench:table": "vitest run --config vitest.bench.config.ts packages/engine/src/bench/tableReplay.bench.ts",
    "bench:palette": "vitest run --config vitest.bench.config.ts packages/engine/src/bench/paletteExtraction.bench.test.ts",
    "bench:table-layout": "vitest run --config vitest.bench.config.ts packages/scene/src/__benchmarks__/tableLayout.bench.ts",
    "bench:bgremove:report": "node scripts/bench/background-removal-report.mjs",
    "bench": "vitest bench --run --pool=forks",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "audit:tokens": "pnpm --filter @varve/ui audit:tokens",
    "audit:emoji": "node scripts/audit-emoji.mjs",
    "audit:docs": "node scripts/audit-docs.mjs",
    "audit:contacts": "node scripts/audit-contacts.mjs",
    "audit:secrets": "node scripts/secret-scan.mjs",
    "audit:clientenv": "node scripts/security/validate-client-env.mjs --app website && node scripts/security/validate-client-env.mjs --app desktop",
    "audit:boundaries": "node scripts/security/import-boundaries.mjs",
    "audit:artifacts": "node scripts/secret-scan.mjs --dir apps/website/dist --dir apps/website/dist-pages --dir apps/desktop/dist",
    "audit:product-truth": "node scripts/release/verify-product-truth.mjs",
    "verify:plan": "node scripts/quality/verify.mjs plan",
    "verify:quick": "node scripts/quality/verify.mjs quick",
    "verify:affected": "node scripts/quality/verify.mjs affected",
    "verify:full": "node scripts/quality/verify.mjs full",
    "verify:lease": "node scripts/quality/heavy-lease.mjs",
    "e2e:visual": "playwright test --project=chromium-visual-1x --project=chromium-visual-2x",
    "e2e:all": "playwright test",
    "audit:a11y": "playwright test tests/e2e/a11y tests/e2e/home/a11y.spec.ts tests/e2e/spec/axe.spec.ts tests/e2e/layers/axe.spec.ts tests/e2e/startup/axe.spec.ts tests/e2e/canvas/history-panel-a11y.spec.ts --project=chromium --workers=1",
    "audit:perf": "node scripts/audit-perf.mjs",
    "test:e2e": "playwright test",
    "desktop:build:test": "pnpm --dir apps/desktop tauri build --debug --no-bundle --config src-tauri/tauri.test.conf.json --features wdio",
    "test:desktop:native": "pnpm desktop:preflight && pnpm desktop:build:test && wdio run wdio.conf.ts",
    "test:wdio": "pnpm test:desktop:native",
    "desktop:preflight": "node scripts/desktop/preflight.mjs",
    "ci:debug": "node scripts/ci-debug.mjs",
    "ci:health": "node scripts/ci-health.mjs",
    "ci:local": "bash scripts/ci-local-run.sh",
    "lint:css": "stylelint \"packages/ui/src/**/*.css\"",
    "lint:css:all": "stylelint \"**/*.css\"",
    "build:website": "pnpm --filter @varve/website build",
    "build:website:pages": "pnpm --filter @varve/website build:pages",
    "screenshots:product": "node scripts/screenshots/product.mjs",
    "screenshots:og": "node scripts/screenshots/og-image.mjs",
    "screenshots:website": "pnpm build:website && node scripts/screenshots/validate.mjs",
    "screenshots:update": "pnpm screenshots:product && pnpm screenshots:og && pnpm screenshots:website -- --strict",
    "test:website": "vitest run apps/website/src/test",
    "test:website:e2e": "pnpm build:website && pnpm build:website:pages && playwright test -c playwright.website.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.7",
    "@floating-ui/dom": "^1.8.0",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@wdio/cli": "9.30.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "js-yaml": "^5.2.3",
    "jsdom": "^30.0.1",
    "knip": "^6.32.0",
    "lucide-react": "^1.31.0",
    "onnxruntime-web": "^1.27.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "ts-node": "10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
