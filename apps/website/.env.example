# Website environment configuration (all values are PUBLIC)

# These variables drive the Astro site/base configuration. The website is a
# static site: anything set here is compiled into the published output and is
# therefore public. Do NOT place any private credential in this file or in
# the website build at all.
#
# Public configuration — safe to commit or set in CI:

# Canonical origin of the deployed site (default: https://varve.studio).
SITE_URL=https://varve.studio

# Base path the site is served under. '/' for the custom domain;
# '/varve' for the legacy GitHub Pages project-site mode.
SITE_BASE=/

# Plausible-style analytics domain, empty to disable analytics
# (analytics identifiers are public by design — the site is a static build).
ANALYTICS_DOMAIN=

# ---------------------------------------------------------------------------
# NEVER set any of these here (they have no legitimate role in the website):
#   APPLE_CERTIFICATE, APPLE_API_KEY_P8_BASE64, AZURE_SIGNING_CLIENT_SECRET,
#   TAURI_SIGNING_PRIVATE_KEY, Porkbun API credentials, GitHub PATs.
# The website build receives zero application-signing or DNS credentials.
# ---------------------------------------------------------------------------
