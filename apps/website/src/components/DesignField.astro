---
/**
 * Live Design Field — the homepage's signature interactive artwork.
 *
 * A decorative Canvas2D scene speaking design-tool language: strata bands
 * (the Varve mark's three planes), a wireframe artboard with crop marks,
 * bezier paths with anchors and handle tangents, a selection box, smart
 * guides, swatch chips, a timeline with keyframe dots, and ruler ticks.
 * The pointer gently perturbs nearby elements — springs, guide flashes,
 * swatch lifts — as if the field were a live canvas document.
 *
 * Guarantees:
 *  - decorative: aria-hidden, and the section is the only thing that sees
 *    pointer events (the canvas itself is pointer-events: none);
 *  - deterministic: fixed-seed PRNG; identical static frame under reduced
 *    motion and `?test-motion=static`;
 *  - cheap: one RAF loop, no per-frame allocations, DPR capped at 2,
 *    paused when offscreen or the tab is hidden, passive pointer listeners;
 *  - safe: without JS (or with canvas unavailable) a CSS-composed static
 *    field renders instead, so the hero never depends on the canvas.
 */
---

<div class="design-field" data-design-field>
  <div class="design-field-fallback" aria-hidden="true"></div>
  <canvas class="design-field-canvas" aria-hidden="true"></canvas>
</div>

<script>
  import { mulberry32, prefersMotion, easeOut } from '../lib/motion';

  // Deterministic seed: the same seed renders the same static frame in
  // every browser and every theme.
  const FIELD_SEED = 20260808;

  type ColorSet = {
    ink: string;
    muted: string;
    grid: string;
    teal: string;
    sand: string;
    terra: string;
    snap: string;
  };

  interface Anchor {
    x: number;
    y: number;
    bx: number;
    by: number;
    hx: number;
    hy: number;
    vx: number;
    vy: number;
    phase: number;
  }

  interface Path2DLike {
    color: string;
    anchors: Anchor[];
  }

  interface Guide {
    horizontal: boolean;
    pos: number;
    length: number;
    offset: number;
  }

  interface Swatch {
    x: number;
    y: number;
    size: number;
    color: string;
  }

  interface Keyframe {
    x: number;
    phase: number;
  }

  interface SnapLabel {
    x: number;
    y: number;
    text: string;
    phase: number;
  }

  const root = document.querySelector<HTMLElement>('[data-design-field]');
  const canvas = root?.querySelector<HTMLCanvasElement>('canvas');

  function isSupported(): boolean {
    return typeof canvas !== 'undefined' && !!canvas;
  }

  function createScene(rand: () => number, w: number, h: number, colors: ColorSet) {
    const W = w;
    const H = h;
    const cx = W * 0.62;

    // Two bezier paths, roughly following the logo's strata direction.
    const paths: Path2DLike[] = [
      {
        color: colors.teal,
        anchors: [
          { x: W * 0.1, y: H * 0.34, bx: W * 0.1, by: H * 0.34, hx: 34, hy: -18, vx: 0, vy: 0, phase: rand() * Math.PI * 2 },
          { x: cx, y: H * 0.3, bx: cx, by: H * 0.3, hx: 0, hy: 40, vx: 0, vy: 0, phase: rand() * Math.PI * 2 },
          { x: W * 0.95, y: H * 0.42, bx: W * 0.95, by: H * 0.42, hx: -46, hy: 26, vx: 0, vy: 0, phase: rand() * Math.PI * 2 },
        ],
      },
      {
        color: colors.sand,
        anchors: [
          { x: W * 0.16, y: H * 0.62, bx: W * 0.16, by: H * 0.62, hx: 26, hy: -24, vx: 0, vy: 0, phase: rand() * Math.PI * 2 },
          { x: cx + 40, y: H * 0.56, bx: cx + 40, by: H * 0.56, hx: -30, hy: 34, vx: 0, vy: 0, phase: rand() * Math.PI * 2 },
          { x: W * 0.88, y: H * 0.68, bx: W * 0.88, by: H * 0.68, hx: 0, hy: -30, vx: 0, vy: 0, phase: rand() * Math.PI * 2 },
        ],
      },
    ];

    const strata = [
      { x: -W * 0.1, y: H * 0.12, w: W * 1.2, h: H * 0.16, color: colors.teal, alpha: 0.07, speed: 0.04, phase: 0 },
      { x: -W * 0.1, y: H * 0.3, w: W * 1.2, h: H * 0.2, color: colors.sand, alpha: 0.06, speed: 0.03, phase: 2.1 },
      { x: -W * 0.1, y: H * 0.52, w: W * 1.2, h: H * 0.24, color: colors.terra, alpha: 0.05, speed: 0.05, phase: 4.2 },
    ];

    // Artboard with print crop marks, left of center.
    const board = {
      x: W * 0.16,
      y: H * 0.16,
      w: Math.min(W * 0.34, 420),
      h: Math.min(H * 0.5, 330),
    };

    const selection = {
      x: board.x + board.w * 0.5,
      y: board.y + board.h * 0.42,
      w: Math.min(board.w * 0.36, 150),
      h: Math.min(board.h * 0.3, 96),
      rot: 0,
      rotTarget: 0,
    };

    const guides: Guide[] = [
      { horizontal: false, pos: W * 0.5, length: H * 0.94, offset: 0 },
      { horizontal: true, pos: H * 0.52, length: W * 0.94, offset: 0 },
    ];

    const swatchSize = Math.max(16, Math.min(26, W * 0.018));
    const swatches: Swatch[] = [
      { x: W * 0.82, y: H * 0.22, size: swatchSize, color: colors.teal },
      { x: W * 0.82 + swatchSize * 1.8, y: H * 0.22, size: swatchSize, color: colors.sand },
      { x: W * 0.82 + swatchSize * 3.6, y: H * 0.22, size: swatchSize, color: colors.terra },
      { x: W * 0.82 + swatchSize * 5.4, y: H * 0.22, size: swatchSize, color: colors.ink },
    ];

    const timeline = { x: W * 0.7, y: H * 0.86, w: Math.min(W * 0.26, 300) };
    const keyframes: Keyframe[] = [0.12, 0.31, 0.58, 0.76, 0.9].map((k) => ({
      x: timeline.x + timeline.w * k,
      phase: rand() * Math.PI * 2,
    }));

    const snapLabels: SnapLabel[] = [
      { x: W * 0.38, y: H * 0.58, text: 'snap · 8 px', phase: 0 },
      { x: W * 0.66, y: H * 0.48, text: 'align · center', phase: 2.4 },
      { x: W * 0.52, y: H * 0.75, text: 'x 420 · y 240', phase: 4.6 },
    ];

    return { paths, strata, board, selection, guides, swatches, timeline, keyframes, snapLabels };
  }

  if (root && isSupported()) {
    const ctx = canvas!.getContext('2d');
    let motion = prefersMotion();

    // Theme-aware palette, resolved from the design-field tokens in theme.css.
    function readColors(): ColorSet {
      const cs = getComputedStyle(root!);
      return {
        ink: cs.getPropertyValue('--df-ink').trim() || '#666',
        muted: cs.getPropertyValue('--df-muted').trim() || '#999',
        grid: cs.getPropertyValue('--df-grid').trim() || '#aaa',
        teal: cs.getPropertyValue('--df-teal').trim() || '#39D0C6',
        sand: cs.getPropertyValue('--df-sand').trim() || '#E28C3C',
        terra: cs.getPropertyValue('--df-terra').trim() || '#C54B3A',
        snap: cs.getPropertyValue('--df-snap').trim() || '#444',
      };
    }

    let colors = readColors();
    let scene = createScene(mulberry32(FIELD_SEED), 1, 1, colors);
    let dpr = 1;
    let w = 0;
    let h = 0;
    let raf = 0;
    let running = false;
    let inView = true;
    let tabVisible = true;
    let pointer = { x: 0, y: 0, vx: 0, vy: 0, active: false };
    let lastPointer = { x: 0, y: 0 };
    const po = { x: 0, y: 0 }; // eased pointer

    // Cached origin of the field in viewport space. Pointer events convert
    // clientX/Y with this instead of calling getBoundingClientRect() per
    // move, which would force a layout read on every pointermove.
    const origin = { x: 0, y: 0 };
    let originDirty = true;

    function refreshOrigin(): void {
      const r = root!.getBoundingClientRect();
      origin.x = r.left;
      origin.y = r.top;
      originDirty = false;
    }

    function resize(): void {
      if (!canvas) return;
      const rect = root!.getBoundingClientRect();
      origin.x = rect.left;
      origin.y = rect.top;
      originDirty = false;
      const nextW = Math.max(1, Math.round(rect.width));
      const nextH = Math.max(1, Math.round(rect.height));
      if (nextW === w && nextH === h) return;
      w = nextW;
      h = nextH;
      dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      canvas.style.width = `${w}px`;
      canvas.style.height = `${h}px`;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      scene = createScene(mulberry32(FIELD_SEED), w, h, colors);
      pointer.x = w * 0.62;
      pointer.y = h * 0.4;
      po.x = pointer.x;
      po.y = pointer.y;
    }

    // --- drawing ---------------------------------------------------------

    function tracePath(p: Path2DLike, t: number): void {
      const ctx2 = ctx!;
      const n = p.anchors.length;
      // Anchors: base + idle wobble + spring toward pointer.
      const pts = p.anchors.map((a) => {
        const wob = motion ? Math.sin(t * 0.6 + a.phase) * 1.5 : 0;
        let x = a.bx + wob;
        let y = a.by + wob * 0.6;
        if (pointer.active && motion) {
          const dx = a.bx - po.x;
          const dy = a.by - po.y;
          const d = Math.hypot(dx, dy);
          const r = 150;
          if (d < r && d > 0.01) {
            const push = (1 - d / r) * 8 * easeOut(0.4);
            x += (dx / d) * push;
            y += (dy / d) * push;
          }
        }
        return { ...a, x, y };
      });
      ctx2.strokeStyle = p.color;
      ctx2.globalAlpha = motion ? 0.65 : 0.8;
      ctx2.lineWidth = 1.5;
      ctx2.beginPath();
      ctx2.moveTo(pts[0].x, pts[0].y);
      for (let i = 1; i < n; i++) {
        const prev = pts[i - 1];
        const midX = (prev.x + pts[i].x) / 2;
        const midY = (prev.y + pts[i].y) / 2;
        ctx2.quadraticCurveTo(prev.x + prev.hx * 0.6, prev.y + prev.hy * 0.6, midX, midY);
      }
      const last = pts[n - 1];
      ctx2.lineTo(last.x + last.hx, last.y + last.hy);
      ctx2.stroke();
      // Handle tangents.
      ctx2.globalAlpha = motion ? 0.35 : 0.5;
      ctx2.lineWidth = 1;
      ctx2.setLineDash([3, 4]);
      for (const pt of pts) {
        ctx2.beginPath();
        ctx2.moveTo(pt.x, pt.y);
        ctx2.lineTo(pt.x + pt.hx, pt.y + pt.hy);
        ctx2.stroke();
      }
      ctx2.setLineDash([]);
      // Anchor nodes.
      for (const pt of pts) {
        const near = motion && pointer.active && Math.hypot(pt.x - po.x, pt.y - po.y) < 26;
        ctx2.fillStyle = near ? colors.snap : colors.ink;
        ctx2.globalAlpha = near ? 1 : 0.85;
        ctx2.beginPath();
        ctx2.arc(pt.x, pt.y, near ? 4.5 : 3.2, 0, Math.PI * 2);
        ctx2.fill();
      }
      ctx2.globalAlpha = 1;
    }

    function draw(t: number): void {
      const c = ctx!;
      c.clearRect(0, 0, w, h);

      // Dot grid.
      c.globalAlpha = motion ? 0.4 : 0.5;
      c.fillStyle = colors.grid;
      const step = 56;
      for (let gx = step / 2; gx < w; gx += step) {
        for (let gy = step / 2; gy < h; gy += step) {
          c.fillRect(gx, gy, 1.2, 1.2);
        }
      }

      // Rulers: ticks along top and left edges.
      c.globalAlpha = motion ? 0.5 : 0.7;
      c.strokeStyle = colors.muted;
      c.lineWidth = 1;
      c.fillStyle = colors.muted;
      c.font = '9px var(--font-mono, monospace)';
      for (let rx = 0; rx < w; rx += 24) {
        c.beginPath();
        c.moveTo(rx + 0.5, 10);
        c.lineTo(rx + 0.5, rx % 96 === 0 ? 18 : 14);
        c.stroke();
        if (rx % 96 === 0 && rx > 0) c.fillText(String(rx), rx + 4, 14);
      }
      for (let ry = 0; ry < h; ry += 24) {
        c.beginPath();
        c.moveTo(10, ry + 0.5);
        c.lineTo(ry % 96 === 0 ? 18 : 14, ry + 0.5);
        c.stroke();
        if (ry % 96 === 0 && ry > 0) c.fillText(String(ry), 14, ry - 4);
      }

      // Strata bands — slow drift, nudged by pointer velocity.
      for (const band of scene.strata) {
        const drift = motion ? Math.sin(t * band.speed + band.phase) * 8 + pointer.vx * 2.4 : 0;
        c.globalAlpha = band.alpha;
        c.fillStyle = band.color;
        c.beginPath();
        c.moveTo(band.x + drift, band.y);
        c.lineTo(band.x + band.w + drift, band.y - band.h * 0.25);
        c.lineTo(band.x + band.w + drift, band.y + band.h);
        c.lineTo(band.x + drift, band.y + band.h * 1.15);
        c.closePath();
        c.fill();
      }

      // Artboard + crop marks.
      const b = scene.board;
      c.globalAlpha = motion ? 0.8 : 0.9;
      c.strokeStyle = colors.ink;
      c.lineWidth = 1;
      c.strokeRect(b.x, b.y, b.w, b.h);
      c.setLineDash([4, 4]);
      c.globalAlpha *= 0.5;
      c.strokeRect(b.x + 10, b.y + 10, b.w - 20, b.h - 20);
      c.setLineDash([]);
      // Crop marks.
      c.globalAlpha = 0.85;
      const crop = 12;
      const cx1 = b.x - crop;
      const cy1 = b.y - crop;
      for (const [mx, my, mx2, my2] of [
        [cx1, b.y - 1, b.x, b.y - 1],
        [cx1, b.y + b.h, b.x, b.y + b.h],
        [b.x - 1, cy1, b.x - 1, b.y],
        [b.x + b.w, cy1, b.x + b.w, b.y],
        [b.x - 1, b.y + b.h, b.x - 1, b.y + b.h + crop],
        [b.x + b.w, b.y + b.h, b.x + b.w, b.y + b.h + crop],
        [cx1, b.y + b.h + crop, b.x, b.y + b.h + crop],
        [b.x + b.w, b.y + b.h + crop, b.x + b.w + crop, b.y + b.h + crop],
      ] as const) {
        c.beginPath();
        c.moveTo(mx, my);
        c.lineTo(mx2, my2);
        c.stroke();
      }

      // Smart guides — flash when the pointer is near.
      for (const g of scene.guides) {
        const dist = g.horizontal ? Math.abs(po.y - g.pos) : Math.abs(po.x - g.pos);
        const flash = motion ? Math.max(0, 1 - dist / 48) : 0.15;
        if (flash <= 0.02) continue;
        c.globalAlpha = flash * 0.8;
        c.strokeStyle = colors.snap;
        c.setLineDash([5, 5]);
        c.lineWidth = 1;
        c.beginPath();
        if (g.horizontal) {
          c.moveTo(g.offset + 8, g.pos);
          c.lineTo(g.offset + g.length - 8, g.pos);
        } else {
          c.moveTo(g.pos, g.offset + 8);
          c.lineTo(g.pos, g.offset + g.length - 8);
        }
        c.stroke();
        c.setLineDash([]);
      }

      // Selection box with corner handles; leans toward the pointer.
      const sel = scene.selection;
      const targetRot = motion && pointer.active ? (po.x - (sel.x + sel.w / 2)) * 0.0006 : 0;
      sel.rot += (targetRot - sel.rot) * (motion ? 0.06 : 1);
      const nx = sel.x + sel.w / 2;
      const ny = sel.y + sel.h / 2;
      c.translate(nx, ny);
      c.rotate(sel.rot);
      c.globalAlpha = 0.9;
      c.strokeStyle = colors.teal;
      c.setLineDash([6, 4]);
      c.lineWidth = 1.4;
      c.strokeRect(-sel.w / 2, -sel.h / 2, sel.w, sel.h);
      c.setLineDash([]);
      const hs = 4;
      for (const [hx2, hy2] of [
        [-sel.w / 2, -sel.h / 2],
        [sel.w / 2, -sel.h / 2],
        [-sel.w / 2, sel.h / 2],
        [sel.w / 2, sel.h / 2],
      ] as const) {
        const near = motion && pointer.active && Math.hypot(nx + hx2 - po.x, ny + hy2 - po.y) < 22;
        c.fillStyle = near ? colors.snap : colors.ink;
        c.globalAlpha = near ? 1 : 0.8;
        c.fillRect(hx2 - hs / 2, hy2 - hs / 2, hs, hs);
      }
      c.globalAlpha = 1;
      c.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Vector paths.
      for (const p of scene.paths) tracePath(p, t);

      // Swatch chips — lift near the pointer.
      for (const s of scene.swatches) {
        const near = motion && pointer.active && Math.hypot(s.x + s.size / 2 - po.x, s.y + s.size / 2 - po.y) < 64;
        const lift = near ? -4 : 0;
        c.globalAlpha = 0.92;
        c.fillStyle = s.color;
        const round = 3;
        c.beginPath();
        const sx = s.x;
        const sy = s.y + lift;
        c.roundRect(sx, sy, s.size, s.size, round);
        c.fill();
        c.globalAlpha = 0.35;
        c.strokeStyle = colors.ink;
        c.lineWidth = 1;
        c.stroke();
      }

      // Timeline with keyframe dots and a drifting playhead.
      const tl = scene.timeline;
      c.globalAlpha = 0.55;
      c.strokeStyle = colors.muted;
      c.lineWidth = 1;
      c.beginPath();
      c.moveTo(tl.x, tl.y);
      c.lineTo(tl.x + tl.w, tl.y);
      c.stroke();
      const play = motion ? (t * 26) % tl.w : tl.w * 0.4;
      for (const k of scene.keyframes) {
        const pulse = motion ? Math.max(0, 1 - Math.abs(k.x - (tl.x + play)) / 8) : 0;
        c.globalAlpha = 0.55 + pulse * 0.45;
        c.fillStyle = colors.teal;
        c.beginPath();
        c.moveTo(k.x, tl.y - 5);
        c.lineTo(k.x + 4, tl.y);
        c.lineTo(k.x, tl.y + 5);
        c.lineTo(k.x - 4, tl.y);
        c.closePath();
        c.fill();
      }
      c.globalAlpha = 0.9;
      c.fillStyle = colors.ink;
      c.fillRect(tl.x + play - 1, tl.y - 4, 2, 8);
      c.globalAlpha = 1;

      // Snap labels on slow cycles.
      if (motion) {
        c.font = '10px var(--font-mono, monospace)';
        c.fillStyle = colors.snap;
        for (const label of scene.snapLabels) {
          const a = Math.sin(t * 0.4 + label.phase);
          if (a <= 0.1) continue;
          c.globalAlpha = a * 0.75;
          c.fillText(label.text, label.x, label.y);
        }
      }

      // Coordinate readout near the pointer.
      if (pointer.active) {
        c.globalAlpha = 0.6;
        c.fillStyle = colors.snap;
        c.font = '10px var(--font-mono, monospace)';
        const label = `x ${Math.round(po.x)} · y ${Math.round(po.y)}`;
        c.fillText(label, Math.min(po.x + 16, w - 90), Math.min(po.y + 20, h - 8));
      }
      c.globalAlpha = 1;
    }

    // --- lifecycle -------------------------------------------------------

    function frame(now: number): void {
      const t = now / 1000;
      // One layout read per frame at most, and only after a scroll/resize
      // invalidated the cached origin.
      if (originDirty) refreshOrigin();
      if (pointer.active) {
        po.x += (pointer.x - po.x) * 0.16;
        po.y += (pointer.y - po.y) * 0.16;
      }
      pointer.vx += (0 - pointer.vx) * 0.08;
      pointer.vy += (0 - pointer.vy) * 0.08;
      draw(t);
      if (running) raf = requestAnimationFrame(frame);
    }

    function start(): void {
      if (running) return;
      if (!tabVisible || !inView || !motion) return;
      running = true;
      raf = requestAnimationFrame(frame);
    }

    function stop(): void {
      running = false;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    // Static frame: deterministic, drawn once (also used by reduced motion).
    function drawStatic(): void {
      stop();
      po.x = w * 0.62;
      po.y = h * 0.4;
      pointer.active = false;
      draw(0);
    }

    const onVisibility = (): void => {
      tabVisible = document.visibilityState === 'visible';
      if (tabVisible) start();
      else stop();
    };

    const io = 'IntersectionObserver' in window
      ? new IntersectionObserver(
          (entries) => {
            inView = entries[0]?.isIntersecting ?? true;
            if (inView) start();
            else stop();
          },
          { threshold: 0.05 },
        )
      : null;

    // Resizing rebuilds the scene at the new size; when the loop is not
    // running (reduced motion, offscreen) the static frame has to be redrawn
    // explicitly or the canvas keeps the stale, wrongly-scaled pixels.
    const ro = 'ResizeObserver' in window
      ? new ResizeObserver(() => {
          resize();
          if (!running) drawStatic();
        })
      : null;
    const mo = new MutationObserver(() => {
      colors = readColors();
      scene = createScene(mulberry32(FIELD_SEED), w, h, colors);
      if (!running) drawStatic();
    });

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const onMotionChange = (): void => {
      motion = prefersMotion();
      if (motion) {
        // Motion was off at load, so the interactive listeners were never
        // attached — bind them the first time motion becomes available.
        attachMotionListeners();
        start();
      } else {
        drawStatic();
      }
    };

    const onPointerMove = (e: PointerEvent): void => {
      if (e.pointerType === 'touch') return;
      pointer.vx = pointer.active ? (e.clientX - lastPointer.x) * 0.35 : 0;
      pointer.vy = pointer.active ? (e.clientY - lastPointer.y) * 0.35 : 0;
      lastPointer.x = e.clientX;
      lastPointer.y = e.clientY;
      pointer.x = e.clientX - origin.x;
      pointer.y = e.clientY - origin.y;
      pointer.active = true;
    };

    const onPointerLeave = (): void => {
      pointer.active = false;
    };

    const onScroll = (): void => {
      originDirty = true;
    };

    // Idempotent: safe to call again when the motion preference flips on.
    let motionListenersAttached = false;
    function attachMotionListeners(): void {
      if (motionListenersAttached) return;
      motionListenersAttached = true;
      document.addEventListener('visibilitychange', onVisibility);
      io?.observe(root!);
      window.addEventListener('scroll', onScroll, { passive: true });
      root!.addEventListener('pointermove', onPointerMove, { passive: true });
      root!.addEventListener('pointerleave', onPointerLeave, { passive: true });
    }

    function init(): void {
      resize();
      // The canvas is live: drop the CSS fallback so the two never paint on
      // top of each other (doubling the artwork's ink over the headline).
      root!.dataset.canvasReady = 'true';
      drawStatic();

      // Size, theme and motion-preference tracking are attached regardless of
      // the current motion preference: a reduced-motion visitor still resizes
      // the window and still switches theme, and both must redraw the static
      // frame. Only the animation loop itself is gated on `motion`.
      ro?.observe(root!);
      mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      motionQuery.addEventListener('change', onMotionChange);

      if (!motion) return;

      attachMotionListeners();
      start();
    }

    init();
  }
</script>

