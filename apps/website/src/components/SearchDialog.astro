---
/**
 * Site search dialog.
 *
 * Rendered once per page by Layout.astro and opened by the triggers in
 * SiteHeader.astro (the desktop header button and the mobile menu row) or by
 * `/` and Ctrl/Cmd+K. The index is generated at build time by
 * scripts/search-index.mjs and fetched lazily, so a page load that never
 * opens search transfers none of it.
 *
 * The dialog is a native <dialog> element: top-layer stacking, an inert
 * background, Escape handling, and ::backdrop all come from the platform
 * instead of a hand-rolled focus trap. The input is an ARIA 1.2 combobox
 * controlling a listbox of results, matching the pattern documentation
 * search UIs (Algolia DocSearch, Starlight) have used for years; keyboard
 * focus stays in the input and `aria-activedescendant` tracks the active
 * result.
 *
 * No-JS behaviour: the triggers ship `hidden` and are revealed by this
 * script; without JavaScript nothing is focusable and no dead control is
 * shown.
 */
import { sitePath } from '../lib/siteUrl';

const indexUrl = sitePath('/search-index.json');
const docsUrl = sitePath('/docs');

const suggestions = [
  { title: 'Getting started', url: sitePath('/docs/getting-started') },
  { title: 'Keyboard shortcuts', url: sitePath('/docs/keyboard-shortcuts') },
  { title: 'File formats', url: sitePath('/docs/file-formats') },
  { title: 'Troubleshooting', url: sitePath('/support/troubleshooting') },
  { title: 'Download Varve', url: sitePath('/download') },
];

const magnifier = 'M11 4a7 7 0 1 0 4.2 12.6l4.1 4.1a1 1 0 0 0 1.4-1.4l-4.1-4.1A7 7 0 0 0 11 4Zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10Z';
---

<div
  class="search-root"
  data-search-root
  data-index-url={indexUrl}
  data-docs-url={docsUrl}
>
  <script
    type="application/json"
    data-search-suggestions
    set:html={JSON.stringify(suggestions)}
  />
  <dialog class="search-dialog" data-search-dialog aria-labelledby="search-dialog-title">
    <h2 class="sr-only" id="search-dialog-title">Search Varve</h2>
    <div class="search-field">
      <svg class="search-field__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d={magnifier} fill="currentColor" stroke="none"></path>
      </svg>
      <input
        class="search-field__input"
        data-search-input
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="search-results"
        aria-autocomplete="list"
        aria-labelledby="search-dialog-title"
        placeholder="Search docs, features, and support"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="go"
      />
      <button class="search-field__close" data-search-close type="button" aria-label="Close search">
        esc
      </button>
    </div>
    <div class="search-body">
      <p class="search-status" data-search-status role="status" aria-live="polite"></p>
      <ul
        class="search-results"
        id="search-results"
        role="listbox"
        aria-label="Search results"
        data-search-results
      ></ul>
    </div>
    <div class="search-footer">
      <span class="search-hints" aria-hidden="true">
        <kbd>↑</kbd><kbd>↓</kbd> navigate
        <kbd>↵</kbd> open
        <kbd>esc</kbd> close
      </span>
      <a class="search-footer__all" data-search-docs href={docsUrl}>Browse all docs</a>
    </div>
  </dialog>
</div>

<style is:global>
  .search-dialog {
    width: min(100% - 2rem, 42rem);
    max-height: min(80dvh, 44rem);
    /* audit-spacing: allow command-palette viewport placement */
    margin: 10dvh auto auto;
    padding: 0;
    border: 1px solid var(--border-default);
    border-radius: var(--website-radius-surface);
    background: var(--surface-card);
    color: var(--text-primary);
    box-shadow:
      0 4px 12px oklch(0 0 0 / 0.12),
      0 24px 56px oklch(0 0 0 / 0.22);
    overflow: clip;
  }

  .search-dialog::backdrop {
    background: oklch(0 0 0 / 0.45);
  }

  .search-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-default);
    background: var(--surface-card);
  }

  .search-field:focus-within {
    outline: 2px solid var(--focus-ring);
    outline-offset: -2px;
  }

  .search-field__icon {
    flex: 0 0 auto;
    color: var(--text-subtle);
  }

  .search-field__input {
    flex: 1 1 auto;
    min-inline-size: 0;
    padding: var(--space-3) var(--space-2);
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text-primary);
    font-family: var(--font-interface);
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  .search-field__input::placeholder {
    color: var(--text-subtle);
    opacity: 0.9;
  }

  .search-field__close {
    flex: 0 0 auto;
    min-block-size: 2rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-default);
    border-radius: var(--website-radius-control-compact);
    background: var(--surface-muted);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    cursor: pointer;
  }

  .search-field__close:hover,
  .search-field__close:focus-visible {
    color: var(--text-primary);
    border-color: var(--border-strong, var(--border-default));
  }

  .search-body {
    flex: 1 1 auto;
    min-block-size: 0;
    display: flex;
    flex-direction: column;
  }

  .search-status {
    margin: 0;
    padding: var(--space-3) var(--space-5) 0;
    color: var(--text-subtle);
    font-size: var(--font-size-xs);
  }

  .search-status[data-state='empty'],
  .search-status[data-state='error'] {
    padding-block: 1rem 1.25rem;
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
  }

  .search-results {
    margin: 0;
    padding: var(--space-2);
    list-style: none;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .search-results:empty {
    display: none;
  }

  .search-result {
    display: block;
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--website-radius-control);
    cursor: pointer;
  }

  .search-result + .search-result {
    border-top: 1px solid var(--border-subtle, var(--border-default));
  }

  .search-result:hover,
  .search-result[aria-selected='true'] {
    background: var(--surface-selected);
  }

  .search-result__top {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .search-result__title {
    color: var(--text-primary);
    font-weight: 600;
    font-size: var(--font-size-sm);
  }

  .search-result__section {
    color: var(--text-secondary);
    font-size: var(--font-size-xs);
  }

  .search-result__snippet {
    margin: var(--space-2) 0 0;
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-result__path {
    display: block;
    margin-top: var(--space-2);
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    word-break: break-all;
  }

  .search-result mark {
    background: var(--surface-accent-soft);
    color: inherit;
    border-radius: 2px;
    /* audit-spacing: allow hairline inset for the active-row marker */
    padding: 0 1px;
  }

  .search-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--border-default);
    background: var(--surface-muted);
    font-size: var(--font-size-xs);
    color: var(--text-subtle);
  }

  .search-hints kbd {
    display: inline-block;
    padding: var(--space-05) var(--space-2);
    border: 1px solid var(--border-default);
    border-radius: 4px;
    background: var(--surface-card);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
  }

  .search-hints kbd + kbd {
    margin-inline-start: 0.2rem;
  }

  .search-footer__all {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }

  .search-footer__all:visited {
    color: var(--accent-strong);
  }

  @media (pointer: coarse), (any-pointer: coarse) {
    .search-result {
      min-block-size: var(--touch-target-min);
    }

    .search-field__close {
      min-block-size: var(--touch-target-min);
      min-inline-size: var(--touch-target-min);
    }
  }

  @media (max-width: 480px) {
    .search-dialog {
      width: calc(100% - 1rem);
      max-height: calc(100dvh - 1rem);
      /* audit-spacing: allow command-palette viewport placement */
      margin: 0.5rem auto auto;
    }

    .search-hints {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-dialog,
    .search-result {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .search-dialog {
      border: 1px solid CanvasText;
    }

    .search-result mark {
      background: Highlight;
      color: HighlightText;
    }
  }
</style>

<script>
  import { prepareIndex, searchPrepared, type PreparedIndex } from '../lib/search/rank';
  import type { SearchIndex, SearchResult } from '../lib/search/types';

  interface Suggestion {
    title: string;
    url: string;
  }

  const root = document.querySelector<HTMLElement>('[data-search-root]');
  const dialog = root?.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = root?.querySelector<HTMLInputElement>('[data-search-input]');
  const list = root?.querySelector<HTMLUListElement>('[data-search-results]');
  const status = root?.querySelector<HTMLParagraphElement>('[data-search-status]');
  const closeButton = root?.querySelector<HTMLButtonElement>('[data-search-close]');
  const indexUrl = root?.dataset.indexUrl ?? '/search-index.json';
  const triggers = [...document.querySelectorAll<HTMLElement>('[data-search-open]')];
  const suggestions: Suggestion[] = (() => {
    const node = root?.querySelector<HTMLScriptElement>('[data-search-suggestions]');
    if (!node?.textContent) return [];
    try {
      return JSON.parse(node.textContent) as Suggestion[];
    } catch {
      return [];
    }
  })();

  if (root && dialog && input && list && status) {
    let prepared: PreparedIndex | null = null;
    let loading = false;
    let failed = false;
    let results: SearchResult[] = [];
    let activeIndex = -1;
    let opener: HTMLElement | null = null;

    document.documentElement.dataset.searchReady = 'true';

    const connection = (
      navigator as Navigator & {
        connection?: { saveData?: boolean; effectiveType?: string };
      }
    ).connection;

    function canPrefetch(): boolean {
      if (!connection) return true;
      if (connection.saveData) return false;
      return !['slow-2g', '2g', '3g'].includes(connection.effectiveType ?? '');
    }

    async function loadIndex(): Promise<void> {
      if (prepared || loading || failed) return;
      loading = true;
      setStatus('Loading search…');
      try {
        const response = await fetch(indexUrl, { credentials: 'omit' });
        if (!response.ok) throw new Error(`index request failed: ${response.status}`);
        const payload = (await response.json()) as SearchIndex;
        if (
          payload.version !== 1 ||
          !Array.isArray(payload.pages) ||
          payload.pages.length === 0
        ) {
          throw new Error('unrecognized search index');
        }
        prepared = prepareIndex(payload);
      } catch {
        failed = true;
      } finally {
        loading = false;
      }
      // A prefetch or an in-flight keystroke both land here; render whatever
      // the input holds now rather than the query that started the load.
      if (dialog!.open) runQuery();
    }

    function setStatus(message: string, state?: 'empty' | 'error'): void {
      status!.textContent = message;
      if (state) status!.dataset.state = state;
      else delete status!.dataset.state;
    }

    function clearOptions(): void {
      list!.replaceChildren();
      results = [];
      activeIndex = -1;
      input!.removeAttribute('aria-activedescendant');
    }

    /** Highlight exact (case-insensitive) query terms without injecting HTML. */
    function appendHighlighted(target: HTMLElement, text: string, terms: string[]): void {
      if (!text) return;
      const escaped = terms
        .filter((term) => term.length > 1)
        .map((term) => term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
      if (escaped.length === 0) {
        target.textContent = text;
        return;
      }
      const pattern = new RegExp(`(${escaped.join('|')})`, 'gi');
      let cursor = 0;
      for (const match of text.matchAll(pattern)) {
        const index = match.index ?? 0;
        if (index > cursor) target.append(text.slice(cursor, index));
        const mark = document.createElement('mark');
        mark.textContent = match[0];
        target.append(mark);
        cursor = index + match[0].length;
      }
      if (cursor < text.length) target.append(text.slice(cursor));
    }

    function termList(query: string): string[] {
      return query
        .trim()
        .split(/\s+/)
        .filter((term) => term.length > 1);
    }

    function renderSuggestions(): void {
      clearOptions();
      suggestions.forEach((suggestion, index) => {
        const option = document.createElement('li');
        option.setAttribute('role', 'option');
        option.setAttribute('aria-selected', 'false');
        option.className = 'search-result';
        option.id = `search-option-${index}`;
        const title = document.createElement('span');
        title.className = 'search-result__title';
        title.textContent = suggestion.title;
        option.append(title);
        option.addEventListener('click', () => navigate(suggestion.url));
        list!.append(option);
        results.push({
          url: suggestion.url,
          title: suggestion.title,
          heading: '',
          snippet: '',
          score: 0,
        });
      });
      setActive(0, false);
      setStatus('Popular destinations');
    }

    function renderResults(query: string): void {
      clearOptions();
      if (!prepared) return;
      results = searchPrepared(prepared, query);
      if (results.length === 0) {
        setStatus(`No matches for “${query.trim()}”. Try a different word.`, 'empty');
        return;
      }
      const terms = termList(query);
      results.forEach((result, index) => {
        const option = document.createElement('li');
        option.setAttribute('role', 'option');
        option.setAttribute('aria-selected', 'false');
        option.className = 'search-result';
        option.id = `search-option-${index}`;

        const top = document.createElement('span');
        top.className = 'search-result__top';
        const title = document.createElement('span');
        title.className = 'search-result__title';
        appendHighlighted(title, result.title, terms);
        top.append(title);
        if (result.heading) {
          const section = document.createElement('span');
          section.className = 'search-result__section';
          appendHighlighted(section, result.heading, terms);
          top.append(section);
        }
        option.append(top);

        if (result.snippet) {
          const snippet = document.createElement('p');
          snippet.className = 'search-result__snippet';
          appendHighlighted(snippet, result.snippet, terms);
          option.append(snippet);
        }

        const path = document.createElement('span');
        path.className = 'search-result__path';
        path.textContent = result.url;
        option.append(path);

        option.addEventListener('click', () => navigate(result.url));
        option.addEventListener('pointermove', () => {
          setActive(index, false);
        });
        list!.append(option);
      });
      setActive(0, false);
      setStatus(`${results.length} result${results.length === 1 ? '' : 's'}`);
    }

    function setActive(index: number, focusInput = true): void {
      if (results.length === 0) return;
      const next = (index + results.length) % results.length;
      activeIndex = next;
      for (const [optionIndex, option] of [...list!.querySelectorAll('[role="option"]')].entries()) {
        const isActive = optionIndex === next;
        option.setAttribute('aria-selected', String(isActive));
        if (isActive) {
          option.scrollIntoView({ block: 'nearest' });
        }
      }
      input!.setAttribute('aria-activedescendant', `search-option-${next}`);
      if (focusInput) input!.focus();
    }

    function navigate(url: string): void {
      window.location.assign(url);
    }

    function runQuery(): void {
      const query = input!.value;
      const trimmed = query.trim();
      if (!trimmed) {
        if (prepared) renderSuggestions();
        else if (failed) setStatus('Search is unavailable in this build.', 'error');
        else setStatus('Loading search…');
        return;
      }
      if (prepared) {
        renderResults(trimmed);
      } else if (failed) {
        setStatus('Search is unavailable in this build.', 'error');
      } else if (!loading) {
        void loadIndex().then(() => {
          if (prepared) runQuery();
          else setStatus('Search is unavailable in this build.', 'error');
        });
      }
    }

    function restoreFocus(): void {
      let target = opener;
      if (
        target &&
        (!target.isConnected ||
          target === document.body ||
          target === document.documentElement ||
          target.getClientRects().length === 0 ||
          target.closest('[aria-hidden="true"]'))
      ) {
        target = null;
      }
      if (target) {
        target.focus();
        return;
      }
      const visibleTrigger = triggers.find(
        (trigger) => trigger.getClientRects().length > 0 && !trigger.closest('[aria-hidden="true"]'),
      );
      (visibleTrigger ?? document.querySelector<HTMLElement>('.mobile-menu-toggle'))?.focus();
    }

    function openSearch(event?: Event): void {
      if (dialog!.open) return;
      opener =
        event?.type === 'click'
          ? (event.currentTarget as HTMLElement)
          : (document.activeElement as HTMLElement | null);
      dialog!.showModal();
      input!.focus();
      input!.select();
      runQuery();
    }

    function closeSearch(): void {
      if (dialog!.open) dialog!.close();
    }

    for (const trigger of triggers) {
      trigger.addEventListener('click', openSearch);
    }

    closeButton?.addEventListener('click', closeSearch);

    dialog.addEventListener('close', () => {
      restoreFocus();
    });

    // Backdrop click: the dialog element itself is the only target outside
    // its content box.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeSearch();
    });

    input.addEventListener('input', runQuery);

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        setActive(activeIndex + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        setActive(activeIndex - 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        setActive(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        setActive(results.length - 1);
      } else if (event.key === 'Enter') {
        const result = results[activeIndex];
        if (result) {
          event.preventDefault();
          navigate(result.url);
        }
      }
    });

    document.addEventListener('keydown', (event) => {
      const isModifierK = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k';
      const target = event.target as HTMLElement | null;
      const isEditable =
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        target instanceof HTMLSelectElement ||
        target?.isContentEditable === true;
      if (isModifierK) {
        event.preventDefault();
        if (dialog.open) closeSearch();
        else openSearch();
        return;
      }
      if (event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey && !isEditable) {
        if (dialog.open) return;
        event.preventDefault();
        openSearch();
      }
    });

    if (canPrefetch()) {
      const prefetch = () => {
        void loadIndex();
      };
      const idleCallback = (
        window as Window & {
          requestIdleCallback?: (callback: () => void, options?: { timeout: number }) => number;
        }
      ).requestIdleCallback;
      if (idleCallback) {
        idleCallback(prefetch, { timeout: 4000 });
      } else {
        window.setTimeout(prefetch, 2500);
      }
    }
  }
</script>
