---
/**
 * AnimatedText — vertical ticker phrase rotation for the hero line.
 *
 * The accessible text ("One canvas.") is always present as a plain span;
 * a decorative, aria-hidden rotor changes one visual phrase element at a time
 * with a restrained fade and vertical drift. Only one phrase element exists
 * in the painted layer, so overlap and clipping are impossible.
 *
 * - Reserves its box (min-width set to the widest phrase at runtime, height
 *   from the in-flow static span) so nothing shifts layout.
 * - Reduced motion / `?test-motion=static` / no JS: rotor hidden, static
 *   phrase shown.
 * - No heading-level changes: this is always a span inside an existing
 *   heading.
 * - Lazy init: defers measurement until the host is actually visible, so the
 *   rotor can live inside a variant that starts hidden (display:none).
 */
const DEFAULT_PHRASES = [
  'One canvas.',
  'Vector.',
  'Layout.',
  'Typography.',
  'Motion.',
  'Prototyping.',
  'Print.',
] as const;

interface Props {
  /** Static fallback phrase (also the accessible content). */
  staticText?: string;
  /** Rotation set. First item is shown first and is the loop point. */
  phrases?: readonly string[];
}

const { staticText = 'One canvas.', phrases = DEFAULT_PHRASES } = Astro.props;
---

<span class="hero-phrase" data-animated-phrase>
  <span class="hero-phrase-static">{staticText}</span>
  <span class="hero-phrase-rotor" aria-hidden="true">
    <span class="hero-phrase-current">{phrases[0] ?? staticText}</span>
    <span class="hero-phrase-source" hidden>
      {phrases.map((phrase) => <span class="hero-phrase-source-item">{phrase}</span>)}
    </span>
  </span>
</span>

<script>
  import { prefersMotion } from '../lib/motion';

  /** Half of the full phrase transition. */
  const TRANSITION_MS = 260;
  /** Hold time between phrase transitions. */
  const CYCLE_MS = 3400;

  const hosts = [...document.querySelectorAll<HTMLElement>('[data-animated-phrase]')];
  for (const host of hosts) {
    if (!prefersMotion()) continue;
    const current = host.querySelector<HTMLElement>('.hero-phrase-current');
    const sourceItems = [...host.querySelectorAll<HTMLElement>('.hero-phrase-source-item')];
    const staticEl = host.querySelector<HTMLElement>('.hero-phrase-static');
    if (sourceItems.length > 1 && current && staticEl) {
      const start = (): void => {
        // Reserve the widest phrase so rotation never shifts the layout.
        const probe = document.createElement('span');
        probe.className = 'hero-phrase-probe';
        probe.style.cssText = 'position:absolute;visibility:hidden;white-space:nowrap;';
        host.appendChild(probe);
        let widest = staticEl.getBoundingClientRect().width;
        const phrases = sourceItems.map((item) => item.textContent ?? '');
        for (const phrase of phrases) {
          probe.textContent = phrase;
          widest = Math.max(widest, probe.getBoundingClientRect().width);
        }
        probe.remove();
        host.style.minWidth = `${Math.ceil(widest)}px`;
        host.classList.add('is-rotating');

        let index = 0;
        const timer = window.setInterval(() => {
          current.classList.add('is-leaving');
          window.setTimeout(() => {
            index = (index + 1) % phrases.length;
            current.textContent = phrases[index] ?? '';
            current.classList.remove('is-leaving');
            current.classList.add('is-entering');
            requestAnimationFrame(() => current.classList.remove('is-entering'));
          }, TRANSITION_MS);
        }, CYCLE_MS);

        (host as HTMLElement & { __varvePhraseTimer?: number }).__varvePhraseTimer = timer;
      };

      if (host.offsetParent !== null) {
        start();
      } else {
        const wait = (): void => {
          if (host.offsetParent !== null) start();
          else requestAnimationFrame(wait);
        };
        requestAnimationFrame(wait);
      }
    }
  }
</script>

<style>
  .hero-phrase {
    position: relative;
    display: inline-flex;
    justify-content: center;
    white-space: nowrap;
  }

  /* The static phrase is the in-flow content: it reserves the line box and is
     what search engines, screen readers and copy/paste get. */
  .hero-phrase-static {
    display: inline;
  }

  /* The rotor has no clipping mask: it contains one painted phrase element,
     so there is no adjacent row to leak into the line box. */
  .hero-phrase-rotor {
    position: absolute;
    inset: 0;
    overflow: visible;
    pointer-events: none;
  }

  .hero-phrase-current {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    will-change: opacity, transform;
    transition:
      opacity 0.52s cubic-bezier(0.32, 0.72, 0, 1),
      transform 0.52s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .hero-phrase-source {
    display: none;
  }

  /* Animation runs only when the rotor is enabled by JS AND motion is
     allowed; otherwise the static phrase below it is the visible content. */
  @media (prefers-reduced-motion: no-preference) {
    html:not([data-motion='static']) .hero-phrase.is-rotating .hero-phrase-static {
      opacity: 0;
    }

    html:not([data-motion='static']) .hero-phrase.is-rotating .hero-phrase-current {
      display: flex;
      opacity: 1;
      transform: translateY(0);
    }

    html:not([data-motion='static']) .hero-phrase.is-rotating .hero-phrase-current.is-leaving {
      opacity: 0;
      transform: translateY(-0.18em);
    }

    html:not([data-motion='static']) .hero-phrase.is-rotating .hero-phrase-current.is-entering {
      opacity: 0;
      transform: translateY(0.18em);
    }
  }

  /* Narrow layouts keep the accessible phrase static. The rotor's absolute
     line box is intentionally desktop-only; on phones it can clip against
     the compact hero heading and leave fragments behind during a swap. */
  @media (max-width: 640px) {
    .hero-phrase {
      min-width: 0 !important;
      white-space: normal;
    }

    .hero-phrase-static {
      opacity: 1 !important;
    }

    .hero-phrase-rotor,
    .hero-phrase-current {
      display: none;
    }
  }
</style>
