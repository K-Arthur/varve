---
/**
 * AnimatedText — vertical ticker phrase rotation for the hero line.
 *
 * The accessible text ("One canvas.") is always present as a plain span;
 * a decorative, aria-hidden rotor stacks all phrases in a vertical track
 * and slides it up by one row each cycle. An overflow:hidden container clips
 * the track so only one phrase is ever visible — no overlap is possible.
 *
 * - Reserves its box (min-width set to the widest phrase at runtime, height
 *   from the in-flow static span) so nothing shifts layout.
 * - Reduced motion / `?test-motion=static` / no JS: rotor hidden, static
 *   phrase shown.
 * - No heading-level changes: this is always a span inside an existing
 *   heading.
 * - Lazy init: defers measurement until the host is actually visible, so the
 *   rotor can live inside a variant that starts hidden (display:none).
 */
const DEFAULT_PHRASES = [
  'One canvas.',
  'Vector.',
  'Layout.',
  'Typography.',
  'Motion.',
  'Prototyping.',
  'Print.',
] as const;

interface Props {
  /** Static fallback phrase (also the accessible content). */
  staticText?: string;
  /** Rotation set. First item is shown first and is the loop point. */
  phrases?: readonly string[];
}

const { staticText = 'One canvas.', phrases = DEFAULT_PHRASES } = Astro.props;
---

<span class="hero-phrase" data-animated-phrase>
  <span class="hero-phrase-static">{staticText}</span>
  <span class="hero-phrase-rotor" aria-hidden="true">
    <span class="hero-phrase-track">
      {phrases.map((phrase) => <span class="hero-phrase-item">{phrase}</span>)}
      <span class="hero-phrase-item hero-phrase-item--loop">{phrases[0]}</span>
    </span>
  </span>
</span>

<script>
  import { prefersMotion } from '../lib/motion';

  /** Transition duration in ms — must match the CSS transition duration. */
  const TRANSITION_MS = 700;
  /** Full cycle interval (hold time between slides). */
  const CYCLE_MS = 3000;

  const hosts = [...document.querySelectorAll<HTMLElement>('[data-animated-phrase]')];
  for (const host of hosts) {
    if (!prefersMotion()) continue;
    const items = [...host.querySelectorAll<HTMLElement>('.hero-phrase-item')];
    const staticEl = host.querySelector<HTMLElement>('.hero-phrase-static');
    if (items.length > 1 && staticEl) {
      const start = (): void => {
        // Reserve the widest phrase so rotation never shifts the layout.
        const probe = document.createElement('span');
        probe.className = 'hero-phrase-probe';
        probe.style.cssText = 'position:absolute;visibility:hidden;white-space:nowrap;';
        host.appendChild(probe);
        let widest = staticEl.getBoundingClientRect().width;
        for (const item of items) {
          probe.textContent = item.textContent ?? '';
          widest = Math.max(widest, probe.getBoundingClientRect().width);
        }
        probe.remove();
        host.style.minWidth = `${Math.ceil(widest)}px`;
        host.classList.add('is-rotating');

        const track = host.querySelector<HTMLElement>('.hero-phrase-track');
        if (!track) return;

        // Measure one item's height — all are identical (same font, same line).
        const itemHeight = items[0]?.getBoundingClientRect().height ?? 0;
        if (itemHeight === 0) return;

        let index = 0;
        // Last item is the duplicate of phrase[0] (for seamless loop reset).
        const lastIndex = items.length - 1;

        const timer = window.setInterval(() => {
          index++;
          track.style.transform = `translateY(-${(index * itemHeight).toFixed(1)}px)`;

          // When we reach the duplicate first phrase, snap back to 0
          // without a transition so the loop is seamless.
          if (index >= lastIndex) {
            const snap = (): void => {
              track.style.transition = 'none';
              index = 0;
              track.style.transform = 'translateY(0)';
              void track.offsetHeight;
              track.style.transition = '';
            };
            setTimeout(snap, TRANSITION_MS);
          }
        }, CYCLE_MS);

        (host as HTMLElement & { __varvePhraseTimer?: number }).__varvePhraseTimer = timer;
      };

      if (host.offsetParent !== null) {
        start();
      } else {
        const wait = (): void => {
          if (host.offsetParent !== null) start();
          else requestAnimationFrame(wait);
        };
        requestAnimationFrame(wait);
      }
    }
  }
</script>

<style>
  .hero-phrase {
    position: relative;
    display: inline-flex;
    justify-content: center;
    white-space: nowrap;
  }

  /* The static phrase is the in-flow content: it reserves the line box and is
     what search engines, screen readers and copy/paste get. */
  .hero-phrase-static {
    display: inline;
  }

  /* Asymmetric clip-path: tight at the top (hides the previous phrase's tail)
     and generous at the bottom (0.25em room for descenders like g, p, y).
     overflow:hidden is NOT used because it clips at the padding box and
     cuts descenders. */
  .hero-phrase-rotor {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 -0.25em 0);
  }

  .hero-phrase-track {
    display: flex;
    flex-direction: column;
    transition: transform var(--duration-normal, 0.7s) var(--ease-default, cubic-bezier(0.16, 1, 0.3, 1));
    will-change: transform;
  }

  .hero-phrase-item {
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Animation runs only when the rotor is enabled by JS AND motion is
     allowed; otherwise the static phrase below it is the visible content. */
  @media (prefers-reduced-motion: no-preference) {
    html:not([data-motion='static']) .hero-phrase.is-rotating .hero-phrase-static {
      opacity: 0;
    }
  }

  /* Narrow layouts keep the accessible phrase static. The rotor's absolute
     line box is intentionally desktop-only; on phones it can clip against
     the compact hero heading and leave fragments behind during a swap. */
  @media (max-width: 640px) {
    .hero-phrase {
      min-width: 0 !important;
      white-space: normal;
    }

    .hero-phrase-static {
      opacity: 1 !important;
    }

    .hero-phrase-rotor {
      display: none;
    }
  }
</style>
