---
/**
 * SiteFooter — a deliberate closing composition.
 *
 * Top: download band with the product line and a strong CTA.
 * Middle: brand block (mark + wordmark + one sentence + beta status) next
 * to four link groups.
 * Bottom: legal/status bar (license, privacy, release status, copyright,
 * source, contribution path).
 * Signature: an oversized cropped VARVE wordmark whose strata planes lean
 * subtly toward the pointer on fine pointers (no continuous animation).
 */
import DownloadCTA from './DownloadCTA.astro';
import { sitePath } from '../lib/siteUrl';
import release from '../data/release-manifest.json';

const statusLabel = release.hasRelease && release.version
  ? `Beta ${release.version}`
  : 'Beta · no public release yet';
---

<footer class="site-footer">
  <div class="footer-download-band">
    <div class="container-custom footer-download-inner">
      <div class="footer-download-copy">
        <h2 class="footer-download-title">Free. Source-available. Cross-platform.</h2>
        <p class="footer-download-sub">
          Linux, macOS, and Windows. Your work stays on your machine.
        </p>
      </div>
      <div class="footer-download-actions">
        <DownloadCTA size="large" beta />
        <p class="footer-download-alt">
          <a href={sitePath('/download')}>All platforms and formats</a>
        </p>
      </div>
    </div>
  </div>

  <div class="footer-main container-custom">
    <div class="footer-brand">
      <a href={sitePath('/')} class="footer-brand-lockup">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path class="logo-strata-1" d="M5,6.5 H21 L23.5,12.5 H7.5 Z" />
          <path class="logo-strata-2" d="M7.5,13.5 H23.5 L26,19.5 H10 Z" />
          <path class="logo-strata-3" d="M10,20.5 H26 L28.5,26.5 H12.5 Z" />
        </svg>
        <span>Varve</span>
      </a>
      <p class="footer-brand-desc">
        A local-first design suite for vector, layout, typography, motion,
        prototyping, and print &mdash; built in the open, shaped by its users.
      </p>
      <p class="footer-status" data-footer-status>
        <span class="footer-status-dot" aria-hidden="true"></span>
        {statusLabel}
      </p>
    </div>

    <nav class="footer-columns" aria-label="Footer">
      <div class="footer-section">
        <h3>Product</h3>
        <ul>
          <li><a href={sitePath('/product')}>Overview</a></li>
          <li><a href={sitePath('/features')}>Features</a></li>
          <li><a href={sitePath('/download')}>Download</a></li>
          <li><a href={sitePath('/releases')}>Releases</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>Learn</h3>
        <ul>
          <li><a href={sitePath('/docs')}>Documentation</a></li>
          <li><a href={sitePath('/learn/tutorials')}>Tutorials</a></li>
          <li><a href={sitePath('/learn/examples')}>Examples</a></li>
          <li><a href={sitePath('/learn/community')}>Community</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>Support</h3>
        <ul>
          <li><a href={sitePath('/support/faq')}>FAQ</a></li>
          <li><a href={sitePath('/support/troubleshooting')}>Troubleshooting</a></li>
          <li><a href={sitePath('/support/known-issues')}>Known issues</a></li>
          <li><a href={sitePath('/support/report-issue')}>Report an issue</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>Project</h3>
        <ul>
          <li><a href={sitePath('/contribute')}>Contribute</a></li>
          <li><a href={sitePath('/support-project')}>Support the project</a></li>
          <li><a href={sitePath('/about')}>About</a></li>
          <li><a href={sitePath('/about/license')}>License (FSL-1.1-MIT)</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>Connect</h3>
        <ul>
          <li><a href="https://github.com/K-Arthur/varve" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href="https://github.com/K-Arthur/varve/discussions" target="_blank" rel="noopener noreferrer">Discussions</a></li>
          <li><a href={sitePath('/about/security')}>Security</a></li>
          <li><a href={sitePath('/about/privacy')}>Privacy</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="footer-bottom container-custom">
    <p>&copy; 2024&ndash;2026 K-Arthur. Source-available under FSL-1.1-MIT.</p>
    <p class="footer-bottom-links">
      <a href={sitePath('/about/license')}>License</a>
      <a href={sitePath('/about/privacy')}>Privacy</a>
      <a href={sitePath('/about/security')}>Security</a>
      <a href="https://github.com/K-Arthur/varve" target="_blank" rel="noopener noreferrer">Source</a>
      <a href={sitePath('/contribute')}>Contribute</a>
    </p>
  </div>

  <!-- Closing signature: the wordmark treated as what it actually is inside
       Varve — an editable vector object. It runs full-bleed and is cropped
       top and bottom by two rules, so it reads as a section cut through the
       type rather than a heading that ran out of room. A selection box with
       anchor nodes and a layer chip sits over one glyph, the way a selected
       object looks on the canvas.

       Title case matches the lockup exactly, and mixed case gives the
       editorial serif its ascenders and ball terminals. Entirely decorative:
       aria-hidden, pointer-events: none, unselectable. -->
  <div class="footer-signature" aria-hidden="true" data-footer-signature>
    <span class="footer-signature-word">
      <span class="footer-signature-letter">V</span><span class="footer-signature-letter">a</span><span class="footer-signature-letter">r</span><span class="footer-signature-letter">v</span><span class="footer-signature-letter">e</span>
    </span>

    <span class="footer-signature-selection">
      <span class="footer-signature-node footer-signature-node-tl"></span>
      <span class="footer-signature-node footer-signature-node-tr"></span>
      <span class="footer-signature-node footer-signature-node-bl"></span>
      <span class="footer-signature-node footer-signature-node-br"></span>
      <span class="footer-signature-chip">
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path class="logo-strata-1" d="M5,6.5 H21 L23.5,12.5 H7.5 Z" />
          <path class="logo-strata-2" d="M7.5,13.5 H23.5 L26,19.5 H10 Z" />
          <path class="logo-strata-3" d="M10,20.5 H26 L28.5,26.5 H12.5 Z" />
        </svg>
        Wordmark
      </span>
    </span>
  </div>
</footer>

<script>
  /**
   * Subtle pointer response for the wordmark: each letter's strata lean
   * shifts slightly toward the horizontal pointer position. Runs only on
   * fine pointers with motion enabled; otherwise the signature stays
   * perfectly static. One listener, transform-only updates.
   */
  import { isCoarsePointer, prefersMotion } from '../lib/motion';

  const signature = document.querySelector<HTMLElement>('[data-footer-signature]');
  if (signature && !isCoarsePointer() && prefersMotion()) {
    // Letters only — the strata mark alongside them is not part of the lean.
    const letters = [...signature.querySelectorAll<HTMLElement>('.footer-signature-letter')];
    const frame = (clientX: number): void => {
      const rect = signature.getBoundingClientRect();
      const mid = rect.left + rect.width / 2;
      const ratio = Math.max(-1, Math.min(1, (clientX - mid) / (rect.width / 2 || 1)));
      letters.forEach((letter, i) => {
        const skew = ratio * (i - (letters.length - 1) / 2) * 0.35;
        letter.style.transform = `translateX(${skew.toFixed(2)}px)`;
      });
    };
    let raf = 0;
    document.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          frame(e.clientX);
        });
      },
      { passive: true },
    );
  }
</script>

<style>
  .site-footer {
    background: var(--surface-footer);
    color: var(--text-footer);
    border-top: 1px solid var(--border-footer);
  }

  /* --- Top download band --- */
  .footer-download-band {
    border-bottom: 1px solid var(--border-footer);
    background:
      linear-gradient(115deg, var(--surface-inset) 0%, var(--surface-footer) 60%);
    /* The band is a dark surface in BOTH themes, so the primary CTA inside
       it must use the dark-band accent (light teal, dark text) even when the
       page is in light mode — the light-mode accent (dark teal on dark
       band) measured only 3.06:1 and read as a dark button on a dark
       surface. Scoping the accent tokens here lets the shared .btn-primary
       styles resolve correctly without theme-specific overrides. */
    --accent-primary: var(--accent-dark-band);
    --accent-primary-hover: var(--accent-dark-band-hover);
    --text-on-accent: var(--text-on-accent-dark-band);
  }

  .footer-download-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  .footer-download-title {
    font-family: var(--font-editorial);
    font-size: clamp(1.6rem, 2.7vw + 0.5rem, 2.5rem);
    font-weight: 700;
    font-variation-settings: 'opsz' 144;
    letter-spacing: -0.015em;
    line-height: 1.1;
    /* --text-primary-on-overlay is a light-overlay token: on the dark footer
       band it resolves to 1.04:1. Brand teal on the footer surface is
       10.00:1 (19.07:1 in high-contrast). */
    color: var(--text-footer-heading);
    margin-bottom: 0.5rem;
  }

  .footer-download-sub {
    color: var(--text-footer-muted);
    font-size: 1rem;
  }

  .footer-download-actions {
    flex: 0 0 auto;
    text-align: center;
  }

  .footer-download-alt {
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }

  .footer-download-alt a {
    color: var(--text-footer-link);
  }

  /* --- Brand + columns --- */
  .footer-main {
    display: grid;
    grid-template-columns: minmax(240px, 1.1fr) 2.2fr;
    gap: 3rem;
    padding-top: 3rem;
    padding-bottom: 2.5rem;
  }

  /* Same wordmark treatment as the header: editorial serif, low optical
     size, weight 600. The lockup must read identically everywhere. */
  .footer-brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-editorial);
    font-size: 1.35rem;
    font-weight: 600;
    font-variation-settings: 'opsz' 24;
    letter-spacing: -0.005em;
    color: var(--text-footer);
    text-decoration: none;
  }

  .footer-brand-lockup:visited {
    color: var(--text-footer);
  }

  .footer-brand-desc {
    margin-top: 0.9rem;
    max-width: 30ch;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-footer-muted);
  }

  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--text-footer-muted);
    border: 1px solid var(--border-footer);
    border-radius: 9999px;
    padding: 0.35rem 0.85rem;
  }

  .footer-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--status-partial);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2rem;
  }

  .footer-section h3 {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
    color: var(--text-footer-heading);
  }

  .footer-section ul {
    list-style: none;
  }

  .footer-section li {
    margin-bottom: 0.55rem;
  }

  .footer-section a {
    color: var(--text-footer-link);
    font-size: 0.9375rem;
    /* Link luminance equals muted-text luminance in the footer (both
       oklch L 0.78), so color alone cannot distinguish them (WCAG 1.4.1).
       Underline at rest provides the non-color distinction. */
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in oklch, var(--text-footer-link) 55%, transparent);
  }

  .footer-section a:visited {
    color: var(--text-footer-link);
  }

  .footer-section a:hover {
    color: var(--text-footer-link-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* --- Bottom bar --- */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--border-footer);
    font-size: 0.875rem;
    color: var(--text-footer-muted);
  }

  .footer-bottom-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .footer-bottom-links a {
    color: var(--text-footer-link);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in oklch, var(--text-footer-link) 55%, transparent);
    font-size: 0.875rem;
  }

  .footer-bottom-links a:hover {
    color: var(--text-footer-link-hover);
    text-decoration: underline;
  }

  /* The strata fills have to be declared here as well as in SiteHeader:
     Astro scopes component styles, so the header's rules never reached the
     footer's copies of the mark. Both the brand lockup and the signature
     chip were rendering with the SVG's own `fill="none"` — i.e. invisible. */
  .footer-brand-lockup .logo-strata-1,
  .footer-signature-chip .logo-strata-1 {
    fill: var(--brand-teal);
  }

  .footer-brand-lockup .logo-strata-2,
  .footer-signature-chip .logo-strata-2 {
    fill: var(--brand-sandstone);
  }

  .footer-brand-lockup .logo-strata-3,
  .footer-signature-chip .logo-strata-3 {
    fill: var(--brand-terracotta);
  }

  /* --- Signature wordmark ---
     Full-bleed and edge to edge: the type is sized in vw so it spans the
     viewport at every width instead of sitting as a centred block with
     margins. The container crops it — a rule above, the bottom bar below —
     so it reads as a section cut through the letterforms. */
  .footer-signature {
    position: relative;
    /* A fixed band, not the type's natural height: the wordmark is far
       taller than this, and the crop is the whole point — a section cut
       through the letterforms rather than a word that happens to be big. */
    height: clamp(92px, 15vw, 220px);
    overflow: hidden;
    border-top: 1px solid var(--border-footer);
    margin-top: 1.5rem;
    user-select: none;
    pointer-events: none;
  }

  .footer-signature-word {
    position: absolute;
    left: 0;
    right: 0;
    /* Centred on the band so the crop takes an equal bite from the cap line
       and the baseline. */
    top: 50%;
    transform: translateY(-48%);
    text-align: center;
    white-space: nowrap;
    font-family: var(--font-editorial);
    font-weight: 700;
    font-variation-settings: 'opsz' 144;
    /* Sized to span the viewport, not to fit a content column: "Varve" is
       five glyphs, so reaching edge-to-edge needs roughly 0.42 x viewport
       per em. The container crops the result rather than the type being
       fitted to it — that crop is the effect. */
    font-size: 40vw;
    line-height: 0.68;
    letter-spacing: -0.03em;
    /* Strata gradient through the letterforms, left to right. At this scale
       the gradient reads as one slow colour shift across the word rather
       than as three stripes, which is why it works here and did not at the
       previous, much smaller size. The flat ink stays as the fallback for
       engines without background-clip: text, and as the forced-colors value
       below. */
    color: var(--footer-signature-ink);
    background: linear-gradient(
      100deg,
      var(--brand-teal) 0%,
      var(--brand-sandstone) 52%,
      var(--brand-terracotta) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0.5;
  }

  @supports not ((background-clip: text) or (-webkit-background-clip: text)) {
    .footer-signature-word {
      background: none;
      -webkit-text-fill-color: currentColor;
      opacity: 1;
    }
  }

  @media (forced-colors: active) {
    .footer-signature-word {
      background: none;
      -webkit-text-fill-color: currentColor;
      color: CanvasText;
      opacity: 1;
    }
  }

  .footer-signature-letter {
    display: inline-block;
    transition: transform 0.4s var(--ease-default);
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-signature-letter {
      transition: none;
    }
  }

  /* Selection overlay: the wordmark shown as a selected vector object, the
     way it would look on the canvas. Positioned in percentages of the
     signature box so it tracks the type as the viewport scales. */
  /* Sits over the "r", roughly mid-word — percentages of the signature box,
     so it tracks the type as the viewport scales. Inset from the band edges
     so the chip above it stays inside the crop. */
  .footer-signature-selection {
    position: absolute;
    left: 46%;
    top: 38%;
    width: 12%;
    height: 46%;
    border: 1px solid var(--brand-teal);
    opacity: 0.9;
  }

  .footer-signature-node {
    position: absolute;
    width: 7px;
    height: 7px;
    background: var(--surface-footer);
    border: 1.5px solid var(--brand-teal);
    border-radius: 1px;
  }

  .footer-signature-node-tl {
    top: -4px;
    left: -4px;
  }

  .footer-signature-node-tr {
    top: -4px;
    right: -4px;
  }

  .footer-signature-node-bl {
    bottom: -4px;
    left: -4px;
  }

  .footer-signature-node-br {
    bottom: -4px;
    right: -4px;
  }

  /* Layer chip, like a selected object's name badge on the canvas. */
  .footer-signature-chip {
    position: absolute;
    top: -1.9rem;
    left: -1px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    background: var(--brand-teal);
    color: var(--text-on-accent-dark-band);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .footer-signature-chip svg {
    width: 12px;
    height: 12px;
    flex: 0 0 auto;
  }

  /* Below ~640px the chip and nodes are larger than the glyph they annotate
     and read as clutter; the cropped wordmark alone still carries the
     composition. */
  @media (max-width: 640px) {
    .footer-signature-selection {
      display: none;
    }
  }

  @media (forced-colors: active) {
    .footer-signature-selection {
      display: none;
    }
  }

  @media (max-width: 980px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer-columns {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 720px) {
    .footer-download-inner {
      flex-direction: column;
      text-align: center;
      gap: 1.75rem;
    }

    .footer-columns {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
      justify-content: center;
    }

    .footer-bottom-links {
      justify-content: center;
    }
  }

  @media (max-width: 420px) {
    .footer-columns {
      grid-template-columns: 1fr;
    }
  }
</style>
