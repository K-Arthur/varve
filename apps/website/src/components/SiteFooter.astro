---
/**
 * SiteFooter — a deliberate closing composition.
 *
 * Top: download band with product line and strong CTA.
 * Middle: brand block + organized link columns.
 * Bottom: legal bar.
 * Signature: a full-bleed, cropped Varve wordmark in solid color
 * (no gradient), with a selection box overlaid on one letter —
 * the Affinity-style "the wordmark is a selected design object" concept.
 * The wordmark fills the viewport width and is cropped top and bottom.
 */
import DownloadCTA from './DownloadCTA.astro';
import { CONTACTS } from '@varve/shared';
import { sitePath } from '../lib/siteUrl';
import release from '../data/release-manifest.json';

const statusLabel = release.hasRelease && release.version
  ? `Beta ${release.version}`
  : 'Beta · no public release yet';
---

<footer class="site-footer">
  <div class="footer-download-band">
    <div class="container-custom footer-download-inner">
      <div class="footer-download-copy">
        <h2 class="footer-download-title">Free. Source-available. Cross-platform.</h2>
        <p class="footer-download-sub">
          Linux, macOS, and Windows. Core editing stays local by default.
        </p>
      </div>
      <div class="footer-download-actions">
        <DownloadCTA size="large" beta />
        <p class="footer-download-alt">
          <a href={sitePath('/download')}>All platforms and formats</a>
        </p>
      </div>
    </div>
  </div>

  <div class="footer-main container-custom">
    <div class="footer-brand">
      <h2 class="footer-brand-title">Design without the detour.</h2>
      <a href={sitePath('/')} class="footer-brand-lockup">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path class="logo-varve-1" d="M5,6.5 H21 L23.5,12.5 H7.5 Z" />
          <path class="logo-varve-2" d="M7.5,13.5 H23.5 L26,19.5 H10 Z" />
          <path class="logo-varve-3" d="M10,20.5 H26 L28.5,26.5 H12.5 Z" />
        </svg>
        <span>Varve</span>
      </a>
      <p class="footer-brand-desc">
        A local-first design suite for vector, layout, typography, motion,
        prototyping, and print &mdash; built in the open, shaped by its users.
      </p>
      <p class="footer-status" data-footer-status>
        <span class="footer-status-dot" aria-hidden="true"></span>
        {statusLabel}
      </p>
    </div>

    <nav class="footer-columns" aria-label="Footer">
      <div class="footer-section">
        <h3>Product</h3>
        <ul>
          <li><a href={sitePath('/product')}>Overview</a></li>
          <li><a href={sitePath('/features')}>Features</a></li>
          <li><a href={sitePath('/compare')}>Compare</a></li>
          <li><a href={sitePath('/download')}>Download</a></li>
          <li><a href={sitePath('/releases')}>Releases</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>Learn</h3>
        <ul>
          <li><a href={sitePath('/docs')}>Documentation</a></li>
          <li><a href={sitePath('/learn/tutorials')}>Tutorials</a></li>
          <li><a href={sitePath('/learn/examples')}>Examples</a></li>
          <li><a href={sitePath('/learn/community')}>Community</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>Support</h3>
        <ul>
          <li><a href={sitePath('/contact')}>Contact Varve</a></li>
          <li><a href={`mailto:${CONTACTS.support}`}>Email Support</a></li>
          <li><a href={sitePath('/support/faq')}>FAQ</a></li>
          <li><a href={sitePath('/support/troubleshooting')}>Troubleshooting</a></li>
          <li><a href={sitePath('/support/known-issues')}>Known issues</a></li>
          <li><a href={sitePath('/support/report-issue')}>Report an issue</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>Project</h3>
        <ul>
          <li><a href={sitePath('/contribute')}>Contribute</a></li>
          <li><a href={sitePath('/support-project')}>Support the project</a></li>
          <li><a href={sitePath('/about')}>About</a></li>
          <li><a href={sitePath('/press')}>Press &amp; brand assets</a></li>
          <li><a href={sitePath('/about/license')}>License (FSL-1.1-MIT)</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>Connect</h3>
        <ul>
          <li><a href="https://github.com/K-Arthur/varve" target="_blank" rel="noopener noreferrer" data-analytics-outbound="github">GitHub</a></li>
          <li><a href="https://github.com/K-Arthur/varve/discussions" target="_blank" rel="noopener noreferrer" data-analytics-outbound="community">Discussions</a></li>
          <li><a href={sitePath('/security')}>Security</a></li>
          <li><a href={sitePath('/about/privacy')}>Privacy</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <!-- Closing signature: a clean, high-contrast full-bleed wordmark. The
       oversized crop carries the Affinity/Antigravity reference without
       introducing geometry that does not align with the live glyph. -->
  <div class="footer-signature" aria-hidden="true">
    <svg class="footer-signature-svg" viewBox="0 0 1400 600" role="presentation">
      <text
        class="footer-signature-text"
        x="700"
        y="530"
        text-anchor="middle"
        fill="var(--footer-signature-ink)"
      >Var<tspan class="footer-signature-raised-v" dy="-0.14em">v</tspan><tspan dy="0.14em">e</tspan></text>
    </svg>
  </div>

  <div class="footer-bottom container-custom">
    <p>&copy; 2024&ndash;2026 K-Arthur. Source-available under FSL-1.1-MIT.</p>
    <p class="footer-bottom-links">
      <a href={sitePath('/about/license')}>License</a>
      <a href={sitePath('/about/privacy')}>Privacy</a>
       <a href={sitePath('/security')}>Security</a>
      <a href="https://github.com/K-Arthur/varve" target="_blank" rel="noopener noreferrer">Source</a>
      <a href={sitePath('/contribute')}>Contribute</a>
    </p>
  </div>
</footer>


<style>
  .site-footer {
    background: var(--surface-footer);
    color: var(--text-footer);
    border-top: 1px solid var(--border-footer);
  }

  /* --- Top download band --- */
  .footer-download-band {
    border-bottom: 1px solid var(--border-footer);
    background: var(--surface-inset);
    --accent-primary: var(--accent-dark-band);
    --accent-primary-hover: var(--accent-dark-band-hover);
    --text-on-accent: var(--text-on-accent-dark-band);
  }

  .footer-download-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  .footer-download-title {
    font-family: var(--font-editorial);
    font-size: clamp(1.6rem, 2.7vw + 0.5rem, 2.5rem);
    font-weight: 700;
    font-variation-settings: "opsz" 144;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--text-footer-heading);
    margin-bottom: 0.5rem;
  }

  .footer-download-sub {
    color: var(--text-footer-muted);
    font-size: 1rem;
  }

  .footer-download-actions {
    flex: 0 0 auto;
    text-align: center;
  }

  .footer-download-alt {
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }

  .footer-download-alt a {
    color: var(--text-footer-link);
  }

  /* --- Brand + columns --- */
  .footer-main {
    display: grid;
    grid-template-columns: minmax(240px, 1.1fr) 2.2fr;
    gap: 3rem;
    padding-top: 3rem;
    padding-bottom: 2.5rem;
  }

  .footer-brand-title {
    /* The global h2 rule sets color: var(--text-primary) (dark), which on
       the always-dark footer band measures ~1.04:1. The footer's own text
       color is the light band token; assert it here so the heading follows
       the band, not the page. */
    color: var(--text-footer-heading);
    font-family: var(--font-editorial);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin: 0 0 0.9rem;
  }

  .footer-brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-editorial);
    font-size: 1.35rem;
    font-weight: 600;
    font-variation-settings: "opsz" 24;
    letter-spacing: -0.005em;
    color: var(--text-footer);
    text-decoration: none;
  }

  .footer-brand-lockup:visited {
    color: var(--text-footer);
  }

  .footer-brand-desc {
    margin-top: 0.9rem;
    max-width: 30ch;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-footer-muted);
  }

  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--text-footer-muted);
    border: 1px solid var(--border-footer);
    border-radius: 9999px;
    padding: 0.35rem 0.85rem;
  }

  .footer-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--status-partial);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2rem;
  }

  .footer-section h3 {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
    color: var(--text-footer-heading);
  }

  .footer-section ul {
    list-style: none;
  }

  .footer-section li {
    margin-bottom: 0.55rem;
  }

  .footer-section a {
    color: var(--text-footer-link);
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in oklch, var(--text-footer-link) 55%, transparent);
  }

  .footer-section a:visited {
    color: var(--text-footer-link);
  }

  .footer-section a:hover {
    color: var(--text-footer-link-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* --- Bottom bar --- */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--border-footer);
    font-size: 0.875rem;
    color: var(--text-footer-muted);
  }

  .footer-bottom-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .footer-bottom-links a {
    color: var(--text-footer-link);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in oklch, var(--text-footer-link) 55%, transparent);
    font-size: 0.875rem;
  }

  .footer-bottom-links a:hover {
    color: var(--text-footer-link-hover);
    text-decoration: underline;
  }

  /* Logo varve fills */
  .footer-brand-lockup .logo-varve-1 { fill: var(--brand-teal); }
  .footer-brand-lockup .logo-varve-2 { fill: var(--brand-sandstone); }
  .footer-brand-lockup .logo-varve-3 { fill: var(--brand-terracotta); }

  /* --- Signature wordmark ---
     Antigravity technique: the wordmark band's height tracks the viewport
     width (not a fixed px), with a controlled crop inside its own band.
     The legal row remains separate and readable. */
  .footer-signature {
    position: relative;
    overflow: hidden;
    height: clamp(160px, 20vw, 360px);
    margin-top: 2rem;
    margin-bottom: 0;
    user-select: none;
    pointer-events: none;
  }

  .footer-signature-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .footer-signature-text {
    font-family: var(--font-editorial);
    font-weight: 700;
    font-variation-settings: "opsz" 144;
    font-size: 680px;
    letter-spacing: -12px;
  }

  /* The final v lifts like a selected typographic form, giving the otherwise
     oversized wordmark a distinctive Varve gesture without adding another
     color or decorative line. */
  .footer-signature-raised-v {
    font-weight: 750;
  }

  /* Wordmark animation — clearly visible, still tasteful:
     a slow rise with a letter-spacing settle, then a gentle breathing
     drift. Runs on a loop but is slow and calm. */
  @media (prefers-reduced-motion: no-preference) {
    .footer-signature-text {
      animation:
        fs-rise 1.6s var(--ease-default) both,
        fs-breathe 7s ease-in-out 1.8s infinite;
      transform-origin: 50% 50%;
    }
  }

  @keyframes fs-rise {
    from {
      opacity: 0;
      letter-spacing: -2px;
      transform: translateY(0.35em);
    }
    to {
      opacity: 1;
      letter-spacing: -12px;
      transform: none;
    }
  }

  @keyframes fs-breathe {
    0%, 100% { opacity: 0.96; }
    50% { opacity: 1; }
  }

  @media (forced-colors: active) {
    .footer-signature-text {
      fill: CanvasText;
    }
  }

  @media (max-width: 980px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer-columns {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 720px) {
    .footer-download-inner {
      flex-direction: column;
      text-align: center;
      gap: 1.75rem;
    }

    .footer-columns {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
      justify-content: center;
    }

    .footer-bottom-links {
      justify-content: center;
    }
  }

  @media (max-width: 420px) {
    .footer-columns {
      grid-template-columns: 1fr;
    }
  }
</style>
