---
/**
 * SiteFooter — a deliberate closing composition.
 *
 * Top: download band with the product line and a strong CTA.
 * Middle: brand block (mark + wordmark + one sentence + beta status) next
 * to four link groups.
 * Bottom: legal/status bar (license, privacy, release status, copyright,
 * source, contribution path).
 * Signature: a full-bleed, cropped Varve wordmark drawn as SVG, with a
 * vector-selection overlay showing it as the editable object it would be
 * inside the app. Entirely static — no pointer tracking, no animation.
 */
import DownloadCTA from './DownloadCTA.astro';
import { sitePath } from '../lib/siteUrl';
import release from '../data/release-manifest.json';

const statusLabel = release.hasRelease && release.version
  ? `Beta ${release.version}`
  : 'Beta · no public release yet';
---

<footer class="site-footer">
  <div class="footer-download-band">
    <div class="container-custom footer-download-inner">
      <div class="footer-download-copy">
        <h2 class="footer-download-title">Free. Source-available. Cross-platform.</h2>
        <p class="footer-download-sub">
          Linux, macOS, and Windows. Your work stays on your machine.
        </p>
      </div>
      <div class="footer-download-actions">
        <DownloadCTA size="large" beta />
        <p class="footer-download-alt">
          <a href={sitePath('/download')}>All platforms and formats</a>
        </p>
      </div>
    </div>
  </div>

  <div class="footer-main container-custom">
    <div class="footer-brand">
      <a href={sitePath('/')} class="footer-brand-lockup">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path class="logo-strata-1" d="M5,6.5 H21 L23.5,12.5 H7.5 Z" />
          <path class="logo-strata-2" d="M7.5,13.5 H23.5 L26,19.5 H10 Z" />
          <path class="logo-strata-3" d="M10,20.5 H26 L28.5,26.5 H12.5 Z" />
        </svg>
        <span>Varve</span>
      </a>
      <p class="footer-brand-desc">
        A local-first design suite for vector, layout, typography, motion,
        prototyping, and print &mdash; built in the open, shaped by its users.
      </p>
      <p class="footer-status" data-footer-status>
        <span class="footer-status-dot" aria-hidden="true"></span>
        {statusLabel}
      </p>
    </div>

    <nav class="footer-columns" aria-label="Footer">
      <div class="footer-section">
        <h3>Product</h3>
        <ul>
          <li><a href={sitePath('/product')}>Overview</a></li>
          <li><a href={sitePath('/features')}>Features</a></li>
          <li><a href={sitePath('/download')}>Download</a></li>
          <li><a href={sitePath('/releases')}>Releases</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>Learn</h3>
        <ul>
          <li><a href={sitePath('/docs')}>Documentation</a></li>
          <li><a href={sitePath('/learn/tutorials')}>Tutorials</a></li>
          <li><a href={sitePath('/learn/examples')}>Examples</a></li>
          <li><a href={sitePath('/learn/community')}>Community</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>Support</h3>
        <ul>
          <li><a href={sitePath('/support/faq')}>FAQ</a></li>
          <li><a href={sitePath('/support/troubleshooting')}>Troubleshooting</a></li>
          <li><a href={sitePath('/support/known-issues')}>Known issues</a></li>
          <li><a href={sitePath('/support/report-issue')}>Report an issue</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>Project</h3>
        <ul>
          <li><a href={sitePath('/contribute')}>Contribute</a></li>
          <li><a href={sitePath('/support-project')}>Support the project</a></li>
          <li><a href={sitePath('/about')}>About</a></li>
          <li><a href={sitePath('/about/license')}>License (FSL-1.1-MIT)</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>Connect</h3>
        <ul>
          <li><a href="https://github.com/K-Arthur/varve" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href="https://github.com/K-Arthur/varve/discussions" target="_blank" rel="noopener noreferrer">Discussions</a></li>
          <li><a href={sitePath('/about/security')}>Security</a></li>
          <li><a href={sitePath('/about/privacy')}>Privacy</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="footer-bottom container-custom">
    <p>&copy; 2024&ndash;2026 K-Arthur. Source-available under FSL-1.1-MIT.</p>
    <p class="footer-bottom-links">
      <a href={sitePath('/about/license')}>License</a>
      <a href={sitePath('/about/privacy')}>Privacy</a>
      <a href={sitePath('/about/security')}>Security</a>
      <a href="https://github.com/K-Arthur/varve" target="_blank" rel="noopener noreferrer">Source</a>
      <a href={sitePath('/contribute')}>Contribute</a>
    </p>
  </div>

  <!-- Closing signature: the wordmark treated as what it actually is inside
       Varve — an editable vector object. It runs full-bleed and is cropped
       top and bottom by two rules, so it reads as a section cut through the
       type rather than a heading that ran out of room. A selection box with
       anchor nodes and a layer chip sits over one glyph, the way a selected
       object looks on the canvas.

       Title case matches the lockup exactly, and mixed case gives the
       editorial serif its ascenders and ball terminals. Entirely decorative:
       aria-hidden, pointer-events: none, unselectable. -->
  <div class="footer-signature" aria-hidden="true">
    <svg class="footer-signature-svg" viewBox="0 0 1200 168" role="presentation">
      <defs>
        <linearGradient id="varve-signature-fill" x1="0" y1="0" x2="1" y2="0.3">
          <stop offset="0" stop-color="var(--brand-teal)" />
          <stop offset="0.52" stop-color="var(--brand-sandstone)" />
          <stop offset="1" stop-color="var(--brand-terracotta)" />
        </linearGradient>
      </defs>

      <!-- Baseline sits below the viewBox so the glyphs are cropped at the
           foot: the crop is the effect, not an accident of sizing. -->
      <text
        class="footer-signature-text"
        x="600"
        y="232"
        text-anchor="middle"
        fill="url(#varve-signature-fill)"
      >Varve</text>

      <!-- Selection overlay in the same coordinate space as the type, so it
           stays locked to the "r" at every viewport instead of drifting the
           way percentage positioning over live text does. -->
      <g class="footer-signature-selection">
        <rect x="612" y="74" width="104" height="132" />
        <rect class="footer-signature-node" x="606" y="68" width="12" height="12" />
        <rect class="footer-signature-node" x="710" y="68" width="12" height="12" />
        <rect class="footer-signature-node" x="606" y="200" width="12" height="12" />
        <rect class="footer-signature-node" x="710" y="200" width="12" height="12" />
        <rect class="footer-signature-chip-bg" x="606" y="34" width="132" height="30" rx="6" />
        <text class="footer-signature-chip-text" x="620" y="55">Wordmark</text>
      </g>
    </svg>
  </div>
</footer>


<style>
  .site-footer {
    background: var(--surface-footer);
    color: var(--text-footer);
    border-top: 1px solid var(--border-footer);
  }

  /* --- Top download band --- */
  .footer-download-band {
    border-bottom: 1px solid var(--border-footer);
    background:
      linear-gradient(115deg, var(--surface-inset) 0%, var(--surface-footer) 60%);
    /* The band is a dark surface in BOTH themes, so the primary CTA inside
       it must use the dark-band accent (light teal, dark text) even when the
       page is in light mode — the light-mode accent (dark teal on dark
       band) measured only 3.06:1 and read as a dark button on a dark
       surface. Scoping the accent tokens here lets the shared .btn-primary
       styles resolve correctly without theme-specific overrides. */
    --accent-primary: var(--accent-dark-band);
    --accent-primary-hover: var(--accent-dark-band-hover);
    --text-on-accent: var(--text-on-accent-dark-band);
  }

  .footer-download-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  .footer-download-title {
    font-family: var(--font-editorial);
    font-size: clamp(1.6rem, 2.7vw + 0.5rem, 2.5rem);
    font-weight: 700;
    font-variation-settings: 'opsz' 144;
    letter-spacing: -0.015em;
    line-height: 1.1;
    /* --text-primary-on-overlay is a light-overlay token: on the dark footer
       band it resolves to 1.04:1. Brand teal on the footer surface is
       10.00:1 (19.07:1 in high-contrast). */
    color: var(--text-footer-heading);
    margin-bottom: 0.5rem;
  }

  .footer-download-sub {
    color: var(--text-footer-muted);
    font-size: 1rem;
  }

  .footer-download-actions {
    flex: 0 0 auto;
    text-align: center;
  }

  .footer-download-alt {
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }

  .footer-download-alt a {
    color: var(--text-footer-link);
  }

  /* --- Brand + columns --- */
  .footer-main {
    display: grid;
    grid-template-columns: minmax(240px, 1.1fr) 2.2fr;
    gap: 3rem;
    padding-top: 3rem;
    padding-bottom: 2.5rem;
  }

  /* Same wordmark treatment as the header: editorial serif, low optical
     size, weight 600. The lockup must read identically everywhere. */
  .footer-brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-editorial);
    font-size: 1.35rem;
    font-weight: 600;
    font-variation-settings: 'opsz' 24;
    letter-spacing: -0.005em;
    color: var(--text-footer);
    text-decoration: none;
  }

  .footer-brand-lockup:visited {
    color: var(--text-footer);
  }

  .footer-brand-desc {
    margin-top: 0.9rem;
    max-width: 30ch;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-footer-muted);
  }

  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--text-footer-muted);
    border: 1px solid var(--border-footer);
    border-radius: 9999px;
    padding: 0.35rem 0.85rem;
  }

  .footer-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--status-partial);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2rem;
  }

  .footer-section h3 {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
    color: var(--text-footer-heading);
  }

  .footer-section ul {
    list-style: none;
  }

  .footer-section li {
    margin-bottom: 0.55rem;
  }

  .footer-section a {
    color: var(--text-footer-link);
    font-size: 0.9375rem;
    /* Link luminance equals muted-text luminance in the footer (both
       oklch L 0.78), so color alone cannot distinguish them (WCAG 1.4.1).
       Underline at rest provides the non-color distinction. */
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in oklch, var(--text-footer-link) 55%, transparent);
  }

  .footer-section a:visited {
    color: var(--text-footer-link);
  }

  .footer-section a:hover {
    color: var(--text-footer-link-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* --- Bottom bar --- */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--border-footer);
    font-size: 0.875rem;
    color: var(--text-footer-muted);
  }

  .footer-bottom-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .footer-bottom-links a {
    color: var(--text-footer-link);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in oklch, var(--text-footer-link) 55%, transparent);
    font-size: 0.875rem;
  }

  .footer-bottom-links a:hover {
    color: var(--text-footer-link-hover);
    text-decoration: underline;
  }

  /* The strata fills have to be declared here as well as in SiteHeader:
     Astro scopes component styles, so the header's rules never reached the
     footer's copy of the mark, which fell back to the SVG's own
     `fill="none"` — i.e. rendered invisible. */
  .footer-brand-lockup .logo-strata-1 {
    fill: var(--brand-teal);
  }

  .footer-brand-lockup .logo-strata-2 {
    fill: var(--brand-sandstone);
  }

  .footer-brand-lockup .logo-strata-3 {
    fill: var(--brand-terracotta);
  }

  /* --- Signature wordmark ---
     Drawn as SVG rather than live text. Sizing HTML type to span the viewport
     means guessing a vw value against the font's own advance widths: it held
     at one viewport and broke at the next, leaving a fragment of a glyph and
     an overlay pointing at empty space. An SVG viewBox scales the wordmark to
     the container by construction at every width, and `slice` performs the
     crop — so the composition is identical from 320px to ultrawide, and the
     selection overlay shares the type's coordinate space instead of chasing
     it with percentages. */
  .footer-signature {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--border-footer);
    margin-top: 1.5rem;
    /* Aspect-ratio band: taller than the slice shows, so the glyphs are cut
       at the foot the way a section cut through type would be. */
    height: clamp(88px, 13vw, 190px);
    user-select: none;
    pointer-events: none;
  }

  .footer-signature-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .footer-signature-text {
    font-family: var(--font-editorial);
    font-weight: 700;
    font-variation-settings: 'opsz' 144;
    font-size: 300px;
    letter-spacing: -6px;
    /* The gradient fill is applied via the `fill` attribute; this opacity
       keeps the mark a ground rather than content competing with the links
       above it. */
    opacity: 0.55;
  }

  .footer-signature-selection rect {
    fill: none;
    stroke: var(--brand-teal);
    stroke-width: 2;
  }

  .footer-signature-node {
    fill: var(--surface-footer);
  }

  .footer-signature-chip-bg {
    fill: var(--brand-teal);
    stroke: none;
  }

  .footer-signature-chip-text {
    fill: var(--text-on-accent-dark-band);
    font-family: var(--font-mono);
    font-size: 17px;
    font-weight: 600;
  }

  /* Below ~640px the overlay is larger than the glyph it annotates and reads
     as clutter; the cropped wordmark alone still carries the composition. */
  @media (max-width: 640px) {
    .footer-signature-selection {
      display: none;
    }
  }

  @media (forced-colors: active) {
    .footer-signature-selection {
      display: none;
    }

    .footer-signature-text {
      fill: CanvasText;
      opacity: 1;
    }
  }

  @media (max-width: 980px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer-columns {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 720px) {
    .footer-download-inner {
      flex-direction: column;
      text-align: center;
      gap: 1.75rem;
    }

    .footer-columns {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
      justify-content: center;
    }

    .footer-bottom-links {
      justify-content: center;
    }
  }

  @media (max-width: 420px) {
    .footer-columns {
      grid-template-columns: 1fr;
    }
  }
</style>
