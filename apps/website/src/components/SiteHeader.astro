---
/**
 * SiteHeader — persistent navigation with distinctive Varve identity.
 *
 * Design language: the header borrows from a design tool's interface —
 * a slim navigation rail with the brand mark, centrally composed links
 * with a vector-anchor active indicator, and a subtle technical grid
 * texture that appears on scroll. The 2px strata-gradient spine remains
 * as the brand's signature edge.
 *
 * States:
 *   1. At top: lighter, more transparent, integrates with hero
 *   2. After scroll: slightly compact, elevated/blurred surface
 *   Never shifts layout (scroll-padding-top is fixed).
 *
 * Mobile: full-screen overlay with focus management, Escape close,
 * body scroll lock, safe-area support.
 */
import ThemeToggle from './ThemeToggle.astro';
import DownloadCTA from './DownloadCTA.astro';
import { sitePath } from '../lib/siteUrl';
import release from '../data/release-manifest.json';

const navItems = [
  { href: '/product', label: 'Product' },
  { href: '/features', label: 'Features' },
  { href: '/docs', label: 'Docs' },
  { href: '/support', label: 'Support' },
  { href: '/contribute', label: 'Contribute' },
];

const basePrefix = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const currentPath = Astro.url.pathname.startsWith(basePrefix)
  ? `/${Astro.url.pathname.slice(basePrefix.length)}`
  : Astro.url.pathname;

function isCurrent(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}

const versionLabel = release.hasRelease && release.version
  ? `v${release.version}`
  : null;
---

<header class="site-header" data-site-header>
  <div class="header-grid-texture" aria-hidden="true"></div>
  <nav class="site-nav" aria-label="Main">
    <a href={sitePath('/')} class="site-logo" aria-label="Varve home">
      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path class="logo-strata-1" d="M5,6.5 H21 L23.5,12.5 H7.5 Z" />
        <path class="logo-strata-2" d="M7.5,13.5 H23.5 L26,19.5 H10 Z" />
        <path class="logo-strata-3" d="M10,20.5 H26 L28.5,26.5 H12.5 Z" />
      </svg>
      <span class="site-logo-text">Varve</span>
      {versionLabel && <span class="site-version">{versionLabel}</span>}
    </a>

    <ul class="nav-links" id="site-nav-links">
      {navItems.map((item) => (
        <li>
          <a
            href={sitePath(item.href)}
            class:list={[{ 'nav-active': isCurrent(item.href) }]}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            <span class="nav-link-text">{item.label}</span>
            {isCurrent(item.href) && <span class="nav-active-marker" aria-hidden="true"></span>}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-actions">
      <ThemeToggle />
      <DownloadCTA variant="primary" size="compact" label="Download" class="nav-download-cta" />
      <button
        class="mobile-menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-nav-panel"
        type="button"
      >
        <svg class="menu-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="menu-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile overlay panel -->
  <div class="mobile-nav-panel" id="site-nav-panel" aria-hidden="true">
    <div class="mobile-nav-backdrop"></div>
    <div class="mobile-nav-sheet">
      <div class="mobile-nav-header">
        <a href={sitePath('/')} class="mobile-nav-logo" aria-label="Varve home">
          <svg width="24" height="24" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <path class="logo-strata-1" d="M5,6.5 H21 L23.5,12.5 H7.5 Z" />
            <path class="logo-strata-2" d="M7.5,13.5 H23.5 L26,19.5 H10 Z" />
            <path class="logo-strata-3" d="M10,20.5 H26 L28.5,26.5 H12.5 Z" />
          </svg>
          <span>Varve</span>
        </a>
        <div class="mobile-nav-actions">
          <ThemeToggle />
          <button class="mobile-menu-close" aria-label="Close menu" type="button">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
      <nav class="mobile-nav-links" aria-label="Mobile navigation">
        {navItems.map((item) => (
          <a
            href={sitePath(item.href)}
            class:list={['mobile-nav-link', { 'is-active': isCurrent(item.href) }]}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <div class="mobile-nav-footer">
        <DownloadCTA size="large" beta />
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
  const panel = document.querySelector<HTMLElement>('#site-nav-panel');
  const closeBtn = document.querySelector<HTMLButtonElement>('.mobile-menu-close');
  const backdrop = panel?.querySelector<HTMLElement>('.mobile-nav-backdrop');
  const navLinks = panel?.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link');

  let isOpen = false;

  function openMenu() {
    if (!panel || !toggle) return;
    isOpen = true;
    panel.setAttribute('aria-hidden', 'false');
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Close menu');
    document.body.style.overflow = 'hidden';
    // Focus first link after animation. The panel close uses a delayed
    // visibility transition (0.3s), so a rAF that lands after Escape could
    // still move focus into the closing sheet and steal it from the toggle
    // (CI caught this: Escape + rAF race on fast runners, 2026-08-12).
    // Guard on isOpen so the handoff only happens while the menu stays open.
    requestAnimationFrame(() => {
      if (isOpen) navLinks?.[0]?.focus();
    });
  }

  function closeMenu(returnFocus = false) {
    if (!panel || !toggle) return;
    isOpen = false;
    panel.setAttribute('aria-hidden', 'true');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open menu');
    document.body.style.overflow = '';
    if (returnFocus) toggle.focus();
  }

  toggle?.addEventListener('click', () => {
    isOpen ? closeMenu(true) : openMenu();
  });

  closeBtn?.addEventListener('click', () => closeMenu(true));
  backdrop?.addEventListener('click', () => closeMenu(false));

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) closeMenu(true);
  });

  // Close on nav link click
  navLinks?.forEach((link) => {
    link.addEventListener('click', () => closeMenu(false));
  });

  // Close on resize to desktop
  const desktopQuery = window.matchMedia('(min-width: 769px)');
  desktopQuery.addEventListener('change', (e) => {
    if (e.matches && isOpen) closeMenu(false);
  });

  // Trap focus inside panel when open
  panel?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !isOpen) return;
    const focusable = panel.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
    );
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last?.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first?.focus();
    }
  });

  // Glass scroll state
  if (header) {
    let ticking = false;
    const THRESHOLD = 8;
    const apply = () => {
      ticking = false;
      header.dataset.scrolled = window.scrollY > THRESHOLD ? 'true' : 'false';
    };
    apply();
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(apply);
    }, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--surface-header);
    border-bottom: 1px solid var(--border-default);
    transition:
      background-color var(--duration-base) var(--ease-default),
      border-color var(--duration-base) var(--ease-default),
      box-shadow var(--duration-base) var(--ease-default);
  }

  /* The strata spine: brand's three bands as a 2px hairline. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--brand-teal) 0%,
      var(--brand-sandstone) 50%,
      var(--brand-terracotta) 100%
    );
    z-index: 1;
  }

  /* Subtle grid texture that appears on scroll — a quiet nod to the
     design tool's canvas grid. */
  .header-grid-texture {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 24px 24px;
    transition: opacity var(--duration-base) var(--ease-default);
  }

  .site-header[data-scrolled='true'] .header-grid-texture {
    opacity: 0.3;
  }

  /* Glass state on scroll */
  .site-header[data-scrolled='true'] {
    background: color-mix(in oklab, var(--surface-header) 82%, transparent);
    border-bottom-color: var(--border-subtle);
    box-shadow: 0 1px 0 var(--border-subtle), 0 12px 24px -18px oklch(0 0 0 / 0.35);
  }



  /* Scroll-state changes must not animate for reduced-motion users — the
     full-page screenshot stitch also relies on this: the scroll-driven
     background/border/opacity transitions left the header mid-animation
     between the two stability passes and fullPage captures never settled
     (CI, 2026-08-12). */
  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header[data-scrolled='true'] .header-grid-texture {
      transition: none;
    }
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .site-header[data-scrolled='true'] {
      backdrop-filter: blur(12px) saturate(1.5);
      -webkit-backdrop-filter: blur(12px) saturate(1.5);
    }
  }

  .site-nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.65rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    position: relative;
    z-index: 2;
  }

  /* Logo lockup */
  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-primary);
    text-decoration: none;
    flex: 0 0 auto;
  }

  .site-logo:visited {
    color: var(--text-primary);
  }

  .site-logo svg {
    width: 28px;
    height: 28px;
    overflow: visible;
  }

  .site-logo-text {
    font-family: var(--font-editorial);
    font-weight: 600;
    font-variation-settings: 'opsz' 24;
    font-size: 1.25rem;
    letter-spacing: -0.005em;
  }

  /* Version badge: tiny, unobtrusive, always truthful */
  .site-version {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.15em 0.45em;
    border-radius: 0.25rem;
    background: var(--surface-accent-soft);
    color: var(--accent-primary);
    line-height: 1;
    vertical-align: middle;
  }

  /* Logo strata hover: the three bands fan out a hair */
  .logo-strata-1,
  .logo-strata-2,
  .logo-strata-3 {
    transition: transform var(--duration-fast) var(--ease-default);
    transform-box: fill-box;
    transform-origin: center;
  }

  .logo-strata-1 { fill: var(--brand-teal); }
  .logo-strata-2 { fill: var(--brand-sandstone); }
  .logo-strata-3 { fill: var(--brand-terracotta); }

  @media (prefers-reduced-motion: no-preference) {
    .site-logo:hover .logo-strata-1 {
      transform: translate(-1px, -1px);
    }
    .site-logo:hover .logo-strata-3 {
      transform: translate(1px, 1px);
    }
  }

  /* Nav links with anchor-marker active state */
  .nav-links {
    display: flex;
    list-style: none;
    gap: 0.25rem;
    margin: 0 auto;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    padding: 0.45rem 0.85rem;
    border-radius: 0.375rem;
    position: relative;
    transition:
      color var(--duration-quick) var(--ease-default),
      background-color var(--duration-quick) var(--ease-default);
  }

  .nav-links a:visited {
    color: var(--text-secondary);
  }

  .nav-links a:hover {
    color: var(--text-link);
    background: var(--surface-muted);
  }

  .nav-links a.nav-active {
    color: var(--text-primary);
    background: var(--surface-selected);
    font-weight: 600;
  }

  /* Active marker: a small diamond below the active link — the vector
     anchor node motif translated into navigation. */
  .nav-active-marker {
    width: 5px;
    height: 5px;
    background: var(--accent-primary);
    transform: rotate(45deg);
    border-radius: 1px;
    position: absolute;
    bottom: 2px;
    left: 50%;
    margin-left: -2.5px;
  }

  /* Desktop actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: 0 0 auto;
  }

  :global(.nav-download-cta) {
    padding: 0.45rem 0.9rem;
    font-size: 0.875rem;
    border-radius: 9999px;
    position: relative;
    transition:
      background-color var(--duration-quick) var(--ease-default),
      box-shadow var(--duration-quick) var(--ease-default);
  }

  :global(.nav-download-cta:hover),
  :global(.nav-download-cta:focus-visible) {
    box-shadow: 0 2px 10px -2px color-mix(in oklab, var(--accent-primary) 55%, transparent);
  }

  /* Mobile toggle */
  .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.45rem;
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    position: relative;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
  }

  .mobile-menu-toggle:hover,
  .mobile-menu-toggle:focus-visible {
    color: var(--text-primary);
    background: var(--surface-muted);
  }

  .menu-icon-close {
    display: none;
  }

  .mobile-menu-toggle[aria-expanded='true'] .menu-icon-open {
    display: none;
  }

  .mobile-menu-toggle[aria-expanded='true'] .menu-icon-close {
    display: block;
  }

  /* --- Mobile overlay panel --- */
  .mobile-nav-panel {
    display: none;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }

    .mobile-menu-toggle {
      display: flex;
    }

    .nav-actions {
      gap: 0.4rem;
    }

    :global(.nav-download-cta .download-cta-beta) {
      display: none;
    }

    .site-nav {
      padding: 0.55rem 1rem;
    }

    /* Full-screen overlay */
    .mobile-nav-panel {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 200;
      pointer-events: none;
      /* The closed sheet is translated 100% off-canvas; transform does not
         remove it from scrollWidth, which made the page overflow at 320px
         (measured: /features overflowed by 14px, 2026-08-12). visibility
         removes the closed panel from the scrollable overflow entirely,
         and the open state's visibility change happens after the slide
         transition starts, so the animation is unaffected. */
      visibility: hidden;
    }

    .mobile-nav-panel[aria-hidden='false'] {
      pointer-events: auto;
      visibility: visible;
      /* Delay visibility so the slide-in is visible: hidden -> visible
         applies immediately on open; visible -> hidden waits for the slide
         to finish on close. */
      transition: visibility 0s 0s;
    }
    .mobile-nav-panel[aria-hidden='true'] {
      transition: visibility 0s 0.3s;
    }

    .mobile-nav-backdrop {
      position: absolute;
      inset: 0;
      background: oklch(0 0 0 / 0.5);
      opacity: 0;
      transition: opacity 0.25s var(--ease-default);
    }

    .mobile-nav-panel[aria-hidden='false'] .mobile-nav-backdrop {
      opacity: 1;
    }

    .mobile-nav-sheet {
      position: absolute;
      top: 0;
      right: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: var(--surface-page);
      border-left: 0;
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform 0.3s var(--ease-default);
      box-shadow: -8px 0 24px oklch(0 0 0 / 0.15);
    }

    .mobile-nav-panel[aria-hidden='false'] .mobile-nav-sheet {
      transform: translateX(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .mobile-nav-sheet {
        transition: none;
      }
      .mobile-nav-backdrop {
        transition: none;
      }
    }

    .mobile-nav-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--border-default);
    }

    .mobile-nav-logo {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text-primary);
      text-decoration: none;
      font-family: var(--font-editorial);
      font-weight: 600;
      font-variation-settings: 'opsz' 24;
      font-size: 1.15rem;
    }

    .mobile-nav-logo:visited {
      color: var(--text-primary);
    }

    .mobile-nav-logo svg {
      width: 24px;
      height: 24px;
    }

    .mobile-nav-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .mobile-menu-close {
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.4rem;
      color: var(--text-secondary);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .mobile-menu-close:hover,
    .mobile-menu-close:focus-visible {
      color: var(--text-primary);
      background: var(--surface-muted);
    }

    .mobile-nav-links {
      flex: 1;
      display: flex;
      flex-direction: column;
      padding: 0.75rem;
      gap: 0.15rem;
      overflow-y: auto;
    }

    .mobile-nav-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.85rem 1rem;
      color: var(--text-secondary);
      font-weight: 500;
      font-size: 1.05rem;
      text-decoration: none;
      border-radius: 0.5rem;
      transition:
        color var(--duration-quick) var(--ease-default),
        background-color var(--duration-quick) var(--ease-default);
    }

    .mobile-nav-link:visited {
      color: var(--text-secondary);
    }

    .mobile-nav-link:hover,
    .mobile-nav-link:focus-visible {
      color: var(--text-primary);
      background: var(--surface-muted);
    }

    .mobile-nav-link.is-active {
      color: var(--text-primary);
      background: var(--surface-selected);
      font-weight: 600;
    }

    .mobile-nav-footer {
      padding: 1rem 1.25rem;
      border-top: 1px solid var(--border-default);
    }

    .mobile-nav-footer :global(.btn) {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 420px) {
    :global(.nav-download-cta) {
      display: none;
    }
  }

  /* Safe area inset for notched devices */
  @supports (padding: env(safe-area-inset-right)) {
    .mobile-nav-sheet {
      padding-right: env(safe-area-inset-right);
    }
  }
</style>
