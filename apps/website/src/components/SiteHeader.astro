---
/** Shared, theme-aware navigation for the Varve marketing site. */
import ThemeToggle from './ThemeToggle.astro';
import DownloadCTA from './DownloadCTA.astro';
import { sitePath } from '../lib/siteUrl';
import release from '../data/release-manifest.json';
import {
  allNavigationLinks,
  isExactNavigationRoute,
  isNavigationSectionActive,
  navigationGroups,
  primaryNavigation,
} from '../data/siteNavigation';

const basePrefix = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const routePath = Astro.url.pathname.startsWith(basePrefix)
  ? `/${Astro.url.pathname.slice(basePrefix.length)}`
  : Astro.url.pathname;
const currentPath = routePath.replace(/\/+$/, '') || '/';
const versionLabel = release.hasRelease && release.version ? `v${release.version}` : null;
const demoHref = sitePath('/try/');

function isCurrent(href: string): boolean {
  return isExactNavigationRoute(currentPath, href);
}

function linkClass(href: string): string[] {
  return isCurrent(href) ? ['nav-link', 'nav-link-current'] : ['nav-link'];
}
---

<header class="site-header" data-site-header>
  <nav class="site-nav" aria-label="Main">
    <a href={sitePath('/')} class="site-logo" aria-label="Varve home">
      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path class="logo-varve-1" d="M5,6.5 H21 L23.5,12.5 H7.5 Z" />
        <path class="logo-varve-2" d="M7.5,13.5 H23.5 L26,19.5 H10 Z" />
        <path class="logo-varve-3" d="M10,20.5 H26 L28.5,26.5 H12.5 Z" />
      </svg>
      <span class="site-logo-text">Varve</span>
      {versionLabel && <span class="site-version">{versionLabel}</span>}
    </a>

    <ul class="nav-links" id="site-nav-links">
      {primaryNavigation.map((item) => (
        <li>
          <a
            href={sitePath(item.href)}
            class:list={[
              ...linkClass(item.href),
              { 'nav-section-current': isNavigationSectionActive(currentPath, [item]) },
            ]}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
            {isCurrent(item.href) && <span class="nav-active-marker" aria-hidden="true"></span>}
          </a>
        </li>
      ))}
      {navigationGroups.map((group) => {
        const active = isNavigationSectionActive(currentPath, group.links);
        return (
          <li class="nav-disclosure" data-nav-disclosure>
            <details data-nav-details>
              <summary
                class:list={['nav-link', 'nav-disclosure-summary', { 'nav-section-current': active }]}
                aria-controls={group.id}
              >
                {group.label}
                <svg class="nav-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m4 6 4 4 4-4" />
                </svg>
                {active && <span class="nav-active-marker" aria-hidden="true"></span>}
              </summary>
              <ul class="nav-popover" id={group.id} aria-label={`${group.label} links`}>
                {group.links.map((item) => (
                  <li>
                    <a
                      href={sitePath(item.href)}
                      class:list={['nav-popover-link', { 'nav-link-current': isCurrent(item.href) }]}
                      aria-current={isCurrent(item.href) ? 'page' : undefined}
                    >
                      <span class="nav-popover-label">{item.label}</span>
                      <span class="nav-popover-description">{item.description}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        );
      })}
    </ul>

    <div class="nav-actions">
      <button class="nav-search-trigger" type="button" data-search-open aria-label="Search the site">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M11 4a7 7 0 1 0 4.2 12.6l4.1 4.1a1 1 0 0 0 1.4-1.4l-4.1-4.1A7 7 0 0 0 11 4Zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10Z" />
        </svg>
        <span>Search</span>
        <kbd aria-hidden="true">/</kbd>
      </button>
      <div class="desktop-theme-toggle"><ThemeToggle /></div>
      <a
        href={demoHref}
        class="nav-demo-link"
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-demo-launch
      >
        Try in browser<span class="sr-only"> (opens in a new tab)</span>
      </a>
      <DownloadCTA variant="default" size="compact" platformLabel="Download" class="nav-download-cta" />
      <details class="mobile-nav-fallback">
        <summary class="mobile-menu-fallback-trigger">Menu</summary>
        <nav class="mobile-fallback-panel" aria-label="Main menu">
          <ul>
            {allNavigationLinks.map((item) => (
              <li>
                <a href={sitePath(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
          <a class="mobile-fallback-demo" href={demoHref} target="_blank" rel="noopener noreferrer">
            Try in browser<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </nav>
      </details>
      <button
        class="mobile-menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-nav-panel"
        type="button"
        hidden
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<dialog class="mobile-nav-dialog" id="site-nav-panel" aria-labelledby="mobile-nav-title" data-mobile-nav-dialog>
  <div class="mobile-nav-sheet">
    <h2 class="sr-only" id="mobile-nav-title">Site navigation</h2>
    <div class="mobile-nav-header">
      <a href={sitePath('/')} class="mobile-nav-logo" aria-label="Varve home">
        <svg width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path class="logo-varve-1" d="M5,6.5 H21 L23.5,12.5 H7.5 Z" />
          <path class="logo-varve-2" d="M7.5,13.5 H23.5 L26,19.5 H10 Z" />
          <path class="logo-varve-3" d="M10,20.5 H26 L28.5,26.5 H12.5 Z" />
        </svg>
        <span>Varve</span>
      </a>
      <div class="mobile-nav-header-actions">
        <div class="mobile-theme-toggle"><ThemeToggle /></div>
        <button class="mobile-menu-close" type="button" aria-label="Close menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="m18 6-12 12M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <div class="mobile-nav-scroll">
      <div class="mobile-nav-utilities">
        <button class="mobile-nav-search" type="button" data-search-open>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M11 4a7 7 0 1 0 4.2 12.6l4.1 4.1a1 1 0 0 0 1.4-1.4l-4.1-4.1A7 7 0 0 0 11 4Zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10Z" />
          </svg>
          Search the site
        </button>
        <a class="mobile-nav-demo" href={demoHref} target="_blank" rel="noopener noreferrer" data-analytics-demo-launch>
          Try in browser<span class="sr-only"> (opens in a new tab)</span>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M6 3h7v7M13 3 6 10M11 9v4H3V5h4" />
          </svg>
        </a>
      </div>
      <nav class="mobile-nav-links" aria-label="Main menu">
        {primaryNavigation.map((item) => (
          <a
            href={sitePath(item.href)}
            class:list={['mobile-nav-link', { 'nav-link-current': isCurrent(item.href) }]}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
        {navigationGroups.map((group) => (
          <section class="mobile-nav-group" aria-labelledby={`mobile-${group.id}-heading`}>
            <h2 id={`mobile-${group.id}-heading`}>{group.label}</h2>
            {group.links.map((item) => (
              <a
                href={sitePath(item.href)}
                class:list={['mobile-nav-link', 'mobile-nav-child', { 'nav-link-current': isCurrent(item.href) }]}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </section>
        ))}
      </nav>
      <div class="mobile-nav-download">
        <DownloadCTA size="large" beta />
      </div>
    </div>
  </div>
</dialog>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menuDialog = document.querySelector<HTMLDialogElement>('[data-mobile-nav-dialog]');
  const menuToggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
  const menuClose = document.querySelector<HTMLButtonElement>('.mobile-menu-close');
  const homeLink = document.querySelector<HTMLAnchorElement>('.site-logo');
  const desktopDisclosures = [...document.querySelectorAll<HTMLDetailsElement>('[data-nav-details]')];
  const phoneLayout = window.matchMedia('(max-width: 47.999rem)');
  let previousScrollY = 0;
  let previousBodyStyles: { overflow: string; position: string; top: string; width: string } | null = null;

  function closeDisclosures(except?: HTMLDetailsElement) {
    for (const disclosure of desktopDisclosures) {
      if (disclosure !== except) disclosure.open = false;
    }
  }

  for (const disclosure of desktopDisclosures) {
    disclosure.addEventListener('toggle', () => {
      if (disclosure.open) closeDisclosures(disclosure);
    });
  }

  document.addEventListener('focusin', (event) => {
    for (const disclosure of desktopDisclosures) {
      if (disclosure.open && !disclosure.contains(event.target as Node)) disclosure.open = false;
    }
  });

  document.addEventListener('pointerdown', (event) => {
    if (!desktopDisclosures.some((disclosure) => disclosure.contains(event.target as Node))) {
      closeDisclosures();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const activeDisclosure = desktopDisclosures.find((disclosure) => disclosure.open);
    if (!activeDisclosure) return;
    event.preventDefault();
    const hadFocus = activeDisclosure.contains(document.activeElement);
    activeDisclosure.open = false;
    if (hadFocus) activeDisclosure.querySelector<HTMLElement>('summary')?.focus();
  });

  function syncMenuToggle() {
    const isOpen = menuDialog?.open ?? false;
    menuToggle?.setAttribute('aria-expanded', String(isOpen));
    menuToggle?.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
  }

  menuToggle?.addEventListener('click', () => {
    if (!menuDialog) return;
    if (menuDialog.open) {
      menuDialog.close();
      return;
    }
    closeDisclosures();
    previousScrollY = window.scrollY;
    previousBodyStyles = {
      overflow: document.body.style.overflow,
      position: document.body.style.position,
      top: document.body.style.top,
      width: document.body.style.width,
    };
    document.body.style.position = 'fixed';
    document.body.style.top = `-${previousScrollY}px`;
    document.body.style.width = '100%';
    document.body.style.overflow = 'hidden';
    menuDialog.showModal();
    syncMenuToggle();
    menuClose?.focus();
  });

  menuClose?.addEventListener('click', () => menuDialog?.close());
  menuDialog?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab') return;
    const focusable = [...menuDialog.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
    )].filter((element) => element.getClientRects().length > 0);
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && (document.activeElement === first || !menuDialog.contains(document.activeElement))) {
      event.preventDefault();
      last?.focus();
    } else if (!event.shiftKey && (document.activeElement === last || !menuDialog.contains(document.activeElement))) {
      event.preventDefault();
      first?.focus();
    }
  });
  menuDialog?.addEventListener('click', (event) => {
    if (event.target === menuDialog) menuDialog.close();
  });
  menuDialog?.addEventListener('close', () => {
    const restoreScrollY = previousScrollY;
    if (previousBodyStyles) {
      document.body.style.overflow = previousBodyStyles.overflow;
      document.body.style.position = previousBodyStyles.position;
      document.body.style.top = previousBodyStyles.top;
      document.body.style.width = previousBodyStyles.width;
      previousBodyStyles = null;
    }
    syncMenuToggle();
    if (!phoneLayout.matches) homeLink?.focus({ preventScroll: true });
    else menuToggle?.focus({ preventScroll: true });
    // Native dialog focus restoration can scroll the sticky header back into
    // view after the close event. Restore the saved page offset after that
    // focus handoff has settled instead of racing it synchronously.
    requestAnimationFrame(() => window.scrollTo(0, restoreScrollY));
  });

  phoneLayout.addEventListener('change', (event) => {
    if (!event.matches && menuDialog?.open) menuDialog.close();
  });

  if (header && menuDialog && menuToggle) {
    document.documentElement.setAttribute('data-site-nav-enhanced', '');
  }
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    background: var(--surface-header);
    border-block-end: 1px solid var(--border-default);
    box-shadow: 0 1px 0 transparent;
    transition: border-color var(--duration-quick) var(--ease-default),
      box-shadow var(--duration-quick) var(--ease-default);
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    block-size: 2px;
    background: linear-gradient(90deg, var(--brand-teal), var(--brand-sandstone), var(--brand-terracotta));
  }

  .site-header[data-scrolled='true'] {
    border-color: var(--border-subtle);
    box-shadow: var(--elevation-shadow-raised);
  }

  .site-nav {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-control-group);
    max-inline-size: 1280px;
    min-block-size: var(--component-large-height);
    margin-inline: auto;
    padding: var(--space-2) var(--space-page-inline);
  }

  .site-logo,
  .mobile-nav-logo {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    gap: var(--space-icon-label);
    color: var(--text-primary);
    text-decoration: none;
  }

  .site-logo { min-block-size: var(--component-large-height); }

  .site-logo:visited,
  .mobile-nav-logo:visited {
    color: var(--text-primary);
  }

  .site-logo svg { inline-size: 28px; block-size: 28px; }
  .site-logo-text,
  .mobile-nav-logo span {
    font-family: var(--font-editorial);
    font-size: 1.25rem;
    font-weight: 600;
    font-variation-settings: 'opsz' 24;
    letter-spacing: -0.005em;
  }

  .site-version {
    padding: 0.15em 0.45em;
    border-radius: var(--website-radius-control-compact);
    background: var(--surface-accent-soft);
    color: var(--accent-primary);
    font-family: var(--font-mono);
    font-size: var(--type-interface-micro-size);
    font-weight: 600;
    line-height: 1;
  }

  .logo-varve-1 { fill: var(--brand-teal); }
  .logo-varve-2 { fill: var(--brand-sandstone); }
  .logo-varve-3 { fill: var(--brand-terracotta); }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-1), 0.8vw, var(--space-3));
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .nav-links > li { position: relative; }
  .nav-links a,
  .nav-disclosure-summary {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--component-large-height);
    padding: var(--space-2) var(--space-3);
    border: 1px solid transparent;
    border-radius: var(--website-radius-control-compact);
    background: transparent;
    color: var(--text-secondary);
    font-family: var(--font-interface);
    font-size: var(--type-interface-control-size);
    font-weight: 550;
    line-height: 1.25;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--duration-quick) var(--ease-default),
      border-color var(--duration-quick) var(--ease-default), color var(--duration-quick) var(--ease-default);
  }

  .nav-links a:visited { color: var(--text-secondary); }
  .nav-disclosure-summary { list-style: none; }
  .nav-disclosure-summary::-webkit-details-marker { display: none; }

  .nav-links a:hover,
  .nav-disclosure-summary:hover,
  .nav-disclosure details[open] > .nav-disclosure-summary {
    border-color: var(--border-default);
    background: var(--surface-muted);
    color: var(--text-primary);
  }

  .nav-links a:active,
  .nav-disclosure-summary:active { background: var(--interaction-pressed-surface); }

  .nav-links a.nav-section-current,
  .nav-disclosure-summary.nav-section-current {
    background: var(--surface-selected);
    color: var(--text-primary);
    font-weight: 650;
  }

  .nav-links a.nav-section-current:active,
  .nav-disclosure-summary.nav-section-current:active { background: var(--interaction-pressed-surface); }

  .nav-active-marker {
    position: absolute;
    inset-block-end: 4px;
    inset-inline-start: calc(50% - 3px);
    inline-size: 6px;
    block-size: 6px;
    transform: rotate(45deg);
    border-radius: 1px;
    background: var(--accent-primary);
  }

  .nav-chevron { transition: transform var(--duration-quick) var(--ease-default); }
  .nav-disclosure details[open] > .nav-disclosure-summary .nav-chevron { transform: rotate(180deg); }

  .nav-popover {
    position: absolute;
    inset-block-start: calc(100% + var(--space-2));
    inset-inline-start: 50%;
    z-index: 5;
    display: grid;
    inline-size: min(21rem, calc(100vw - var(--space-6)));
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-2);
    transform: translateX(-50%);
    border: 1px solid var(--border-default);
    border-radius: var(--website-radius-surface);
    background: var(--surface-card);
    box-shadow: var(--elevation-shadow-overlay);
    list-style: none;
  }

  .nav-popover-link {
    display: grid !important;
    gap: var(--space-1) !important;
    min-block-size: unset !important;
    padding: var(--space-3) !important;
    border-radius: var(--website-radius-control-compact) !important;
    color: var(--text-primary) !important;
    white-space: normal !important;
  }

  .nav-popover-link:hover,
  .nav-popover-link.nav-link-current {
    background: var(--surface-selected) !important;
  }

  .nav-popover-label { font-weight: 650; }
  .nav-popover-description { color: var(--text-secondary); font-size: var(--type-interface-micro-size); line-height: 1.4; }

  .nav-actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--space-control-group);
  }

  .nav-search-trigger {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--component-large-height);
    padding-inline: var(--space-3);
    border: 1px solid var(--border-default);
    border-radius: var(--website-radius-control-compact);
    background: var(--surface-muted);
    color: var(--text-secondary);
    font: 500 var(--type-interface-control-size)/1.25 var(--font-interface);
    cursor: pointer;
  }

  .nav-search-trigger kbd {
    padding-inline: var(--space-2);
    border: 1px solid var(--border-default);
    border-radius: var(--website-radius-control-compact);
    background: var(--surface-card);
    color: var(--text-secondary);
    font: inherit;
  }

  .nav-search-trigger:hover { background: var(--surface-card-hover); color: var(--text-primary); }
  .nav-search-trigger:active { background: var(--interaction-pressed-surface); }
  :global(html[data-search-ready]) .nav-search-trigger { display: inline-flex; }

  .nav-demo-link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--component-large-height);
    padding-inline: var(--space-3);
    border: 1px solid var(--border-interactive);
    border-radius: var(--website-radius-control);
    color: var(--text-link);
    font-family: var(--font-interface);
    font-size: var(--type-interface-control-size);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-demo-link:visited { color: var(--text-link); }
  .nav-demo-link:hover { background: var(--surface-accent-soft); color: var(--text-primary); }
  :global(.nav-download-cta) { min-block-size: var(--component-large-height); padding: var(--space-2) var(--space-3); white-space: nowrap; }
  :global(.nav-download-cta:hover) { box-shadow: 0 2px 10px -2px color-mix(in oklab, var(--accent-primary) 45%, transparent); }

  @media (pointer: coarse), (any-pointer: coarse) {
    .site-logo,
    .nav-links a,
    .nav-disclosure-summary,
    .nav-search-trigger,
    .nav-demo-link { min-block-size: var(--touch-target-min); }
    :global(.nav-download-cta) { min-block-size: var(--touch-target-min); }
  }

  .mobile-menu-toggle,
  .mobile-nav-fallback { display: none; }

  .mobile-nav-dialog {
    position: fixed;
    inset: 0;
    inline-size: 100%;
    max-inline-size: none;
    block-size: 100%;
    max-block-size: none;
    margin: 0;
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
    overflow: hidden;
    border: 0;
    background: transparent;
    color: var(--text-primary);
  }

  .mobile-nav-dialog::backdrop { background: oklch(0 0 0 / 0.48); }
  .mobile-nav-dialog[open] { display: block; }

  .mobile-nav-sheet {
    display: flex;
    flex-direction: column;
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 0;
    overflow: hidden;
    background: var(--surface-page);
    color: var(--text-primary);
  }

  .mobile-nav-header {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-block-end: 1px solid var(--border-default);
    background: var(--surface-header);
  }

  .mobile-nav-logo { font-size: 1.15rem; }
  .mobile-nav-logo svg { inline-size: 26px; block-size: 26px; }
  .mobile-nav-header-actions { display: flex; align-items: center; gap: var(--space-3); }

  .mobile-menu-close,
  .mobile-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--touch-target-min);
    block-size: var(--touch-target-min);
    padding: 0;
    border: 1px solid transparent;
