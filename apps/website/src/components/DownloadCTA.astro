---
/**
 * DownloadCTA — the site's primary download action.
 *
 * Enhancement-only platform labelling:
 *  - when the release manifest reports a published release, the label
 *    becomes "Download for Linux / macOS / Windows" (or the generic
 *    "Download Varve" when the platform cannot be detected);
 *  - before any release exists it stays "Download the beta";
 *  - every variant links to the canonical /download page, which is the one
 *    place architecture, checksums and requirements are resolved.
 *
 * The swap never starts a download by itself and never changes the
 * destination; it only makes the existing path feel native.
 */
import { sitePath } from '../lib/siteUrl';
import release from '../data/release-manifest.json';

interface Props {
  variant?: 'primary' | 'secondary';
  size?: 'compact' | 'large';
  /** Extra class names for layout context (e.g. hero-specific margins). */
  class?: string;
  /** Show a small beta chip next to the label. */
  beta?: boolean;
  /** Static label override (used by the compact header control). */
  label?: string;
}

const {
  variant = 'primary',
  size = 'large',
  class: className,
  beta = false,
  label,
} = Astro.props;

const hasRelease = release.hasRelease === true;
const fallbackLabel = label ?? (hasRelease ? 'Download Varve' : 'Download the beta');
---

<a href={sitePath('/download')} class:list={['btn', `btn-${variant}`, `download-cta`, `download-cta-${size}`, className]} data-download-cta data-has-release={hasRelease ? 'true' : 'false'}>
  <span class="download-cta-label" data-cta-label>{fallbackLabel}</span>
  {beta && <span class="download-cta-beta">beta</span>}
</a>

<script>
  /**
   * Platform label enhancement. Detection is best-effort:
   *  - navigator.userAgentData.platform when available (Chromium),
   *  - UA sniffing otherwise (case-insensitive, order-safe).
   * Unknown platforms keep the static fallback label — the page still
   * works with zero JS, on exotic agents, and under reduced UA headers.
   */
  const link = document.querySelector<HTMLAnchorElement>('[data-download-cta]');
  const label = document.querySelector<HTMLElement>('[data-cta-label]');
  if (link && label) {
    function detectPlatform(): 'linux' | 'macos' | 'windows' | null {
      const uaData = (navigator as Navigator & { userAgentData?: { platform?: string } })
        .userAgentData;
      const platform = uaData?.platform ?? '';
      const ua = navigator.userAgent;
      if (/^win/i.test(platform) || /windows/i.test(ua)) return 'windows';
      if (/^mac/i.test(platform) || /macintosh|mac os x/i.test(ua)) return 'macos';
      if (/^linux/i.test(platform) || /linux/i.test(ua)) return 'linux';
      return null;
    }
    const platform = detectPlatform();
    if (platform) {
      const names = { linux: 'Linux', macos: 'macOS', windows: 'Windows' } as const;
      // Platform labels are only truthful once a release exists; before
      // that the generic beta label stays on all platforms.
      if (link.dataset.hasRelease === 'true') {
        label.textContent = `Download for ${names[platform]}`;
      }
    }
  }
</script>

<style>
  .download-cta {
    text-decoration: none;
  }

  .download-cta-label {
    display: inline-block;
    text-align: center;
    white-space: nowrap;
  }

  /* Reserve width so the label swap never shifts the layout. */
  .download-cta-large .download-cta-label {
    min-width: 15ch;
  }

  .download-cta-compact .download-cta-label {
    min-width: 11ch;
  }

  .download-cta-beta {
    display: inline-block;
    font-size: 0.72em;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.15em 0.55em;
    border-radius: 9999px;
    border: 1px solid currentColor;
    opacity: 0.9;
  }
</style>
