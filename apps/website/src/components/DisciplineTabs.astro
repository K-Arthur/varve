---
/**
 * DisciplineTabs — "One canvas, many disciplines."
 *
 * Six disciplines, each with a design-tool glyph, headline, honest copy
 * and a link to the matching feature page. Tablist pattern: roving
 * tabindex, arrow-key navigation, aria-selected, labelled panels. The
 * first panel is active in the static markup, so the section is complete
 * without JavaScript.
 */
import { sitePath } from '../lib/siteUrl';

interface Discipline {
  id: string;
  name: string;
  headline: string;
  body: string;
  points: string[];
  href: string;
  glyph: 'vector' | 'layout' | 'type' | 'motion' | 'prototype' | 'print';
}

const disciplines: Discipline[] = [
  {
    id: 'vector',
    name: 'Vector',
    headline: 'Precision paths, native speed',
    body: 'Shapes, bezier paths with handles, boolean operations, node editing, and sticky snap &mdash; computed by a native Rust geometry engine, replayed to canvas.',
    points: ['Pen and pencil with live handles', 'Boolean operations and node editing', 'Sticky snapping with smart guides'],
    href: '/features/vector-tools',
    glyph: 'vector',
  },
  {
    id: 'layout',
    name: 'Layout',
    headline: 'Pages, frames, and flexible layout',
    body: 'Multi-page documents, frames with constraints, and flex-based auto-layout &mdash; the same document model across design and print pages.',
    points: ['Multi-page documents with master pages', 'Flex and auto-layout', 'Frames with constraints'],
    href: '/features/canvas',
    glyph: 'layout',
  },
  {
    id: 'typography',
    name: 'Typography',
    headline: 'Text that reads like a book',
    body: 'Multi-line text with OpenType features, variable fonts, text-on-path, CJK line breaking, and Unicode-aware layout foundations — with canonical shaping still being integrated.',
    points: ['OpenType features and variable fonts', 'Text on path and inline editing', 'CJK line breaking'],
    href: '/features/typography',
    glyph: 'type',
  },
  {
    id: 'motion',
    name: 'Motion',
    headline: 'Timelines, not afterthoughts',
    body: 'Keyframes, easing curves, and Smart Animate on a real timeline &mdash; exported to CSS, Lottie, and video for the web and beyond.',
    points: ['Timeline keyframes and easing', 'Smart Animate between states', 'CSS, Lottie, and video export'],
    href: '/features/motion',
    glyph: 'motion',
  },
  {
    id: 'prototype',
    name: 'Prototyping',
    headline: 'Interactions without handoff',
    body: 'Trigger-based prototype interactions with transitions and navigation &mdash; test the flow in the same document you design.',
    points: ['Triggers, actions, and transitions', 'Click-through navigation', 'Same document, no sync step'],
    href: '/features/motion',
    glyph: 'prototype',
  },
  {
    id: 'print',
    name: 'Print',
    headline: 'Born for print production',
    body: 'CMYK colour management, ICC profiles, PDF/X export with crop marks, and halftone screening &mdash; poster to booklet without leaving the app.',
    points: ['CMYK and ICC colour management', 'PDF/X-1a and PDF/X-4 export', 'Crop marks and bleed'],
    href: '/features/export',
    glyph: 'print',
  },
];
---

<section class="disciplines" aria-labelledby="disciplines-title">
  <div class="container-custom">
    <div class="disciplines-head">
      <p class="disciplines-eyebrow">What you can do</p>
      <h2 id="disciplines-title" class="disciplines-title">Six disciplines. One document.</h2>
      <p class="disciplines-intro">
        Most work spans categories. Varve keeps the vector, the layout, the
        type, the motion, and the print run in one document &mdash; one layer
        system, one set of shortcuts.
      </p>
    </div>

    <div class="disciplines-body" data-reveal>
      <div class="disciplines-tabs" role="tablist" aria-label="Design disciplines">
        {disciplines.map((d, i) => (
          <button
            type="button"
            role="tab"
            id={`discipline-tab-${d.id}`}
            aria-selected={i === 0}
            aria-controls={`discipline-panel-${d.id}`}
            tabindex={i === 0 ? 0 : -1}
            data-discipline-tab={d.id}
          >
            <span class="discipline-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <svg class="discipline-glyph" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {d.glyph === 'vector' && (
                <>
                  <path d="M4 20 L14 10" />
                  <circle cx="17" cy="7" r="2.5" />
                  <circle cx="6" cy="18" r="2" />
                  <path d="M17 9.5 L19 7.5" opacity="0.6" />
                </>
              )}
              {d.glyph === 'layout' && (
                <>
                  <rect x="3" y="4" width="18" height="16" rx="1" />
                  <path d="M3 9h18M9 20V9" opacity="0.6" />
                </>
              )}
              {d.glyph === 'type' && (
                <>
                  <path d="M5 19 L9.5 6 H14.5 L19 19" />
                  <path d="M8 14.5h8" opacity="0.6" />
                </>
              )}
              {d.glyph === 'motion' && (
                <>
                  <path d="M3 17V7l5 6V7l5 6V7l5 6V7" opacity="0.6" />
                  <circle cx="20.5" cy="17" r="1.5" fill="currentColor" stroke="none" />
                </>
              )}
              {d.glyph === 'prototype' && (
                <>
                  <circle cx="12" cy="12" r="9" />
                  <path d="M10 8.5v7l6-3.5z" />
                </>
              )}
              {d.glyph === 'print' && (
                <>
                  <rect x="4" y="3" width="16" height="18" rx="1" />
                  <path d="M4 8h16" opacity="0.6" />
                  <path d="M8 3v18M16 3v18" opacity="0.4" />
                </>
              )}
            </svg>
            <span class="discipline-name">{d.name}</span>
          </button>
        ))}
      </div>

      {disciplines.map((d, i) => (
        <div
          class:list={['discipline-panel', { active: i === 0 }]}
          id={`discipline-panel-${d.id}`}
          role="tabpanel"
          aria-labelledby={`discipline-tab-${d.id}`}
          tabindex="0"
          data-discipline-panel={d.id}
        >
          <div class="discipline-panel-head">
            <span class="discipline-panel-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="discipline-headline">{d.headline}</h3>
          </div>
          <p class="discipline-body" set:html={d.body} />
          <ul class="discipline-points">
            {d.points.map((point) => <li>{point}</li>)}
          </ul>
          <a href={sitePath(d.href)} class="discipline-link">
            Explore {d.name.toLowerCase()} in Varve
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-discipline-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-discipline-panel]')];

  function activate(tab: HTMLButtonElement) {
    const id = tab.dataset.disciplineTab ?? '';
    for (const t of tabs) {
      const active = t === tab;
      t.setAttribute('aria-selected', String(active));
      t.tabIndex = active ? 0 : -1;
    }
    for (const panel of panels) {
      panel.classList.toggle('active', panel.dataset.disciplinePanel === id);
    }
  }

  for (const tab of tabs) {
    tab.addEventListener('click', () => activate(tab));
    tab.addEventListener('keydown', (e) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key)) return;
      e.preventDefault();
      const index = tabs.indexOf(tab);
      let next: HTMLButtonElement;
      if (e.key === 'Home') next = tabs[0];
      else if (e.key === 'End') next = tabs[tabs.length - 1];
      else if (e.key === 'ArrowLeft') next = tabs[(index - 1 + tabs.length) % tabs.length];
      else next = tabs[(index + 1) % tabs.length];
      activate(next);
      next.focus();
    });
  }
</script>

<style>
  .disciplines {
    padding: clamp(4rem, 9vh, 7rem) 0;
  }

  .disciplines-head {
    max-width: 720px;
    margin-bottom: 3rem;
  }

  .disciplines-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .disciplines-title {
    font-size: clamp(2rem, 3.5vw + 0.5rem, 3.25rem);
    font-family: var(--font-editorial);
    font-weight: 700;
    font-variation-settings: 'opsz' 144;
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .disciplines-intro {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 52ch;
  }

  .disciplines-body {
    display: grid;
    grid-template-columns: minmax(180px, 0.7fr) minmax(0, 1.6fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 1rem;
    padding: 1rem;
  }

  .disciplines-tabs {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-right: 1px solid var(--border-default);
    padding-right: 0.75rem;
  }

  .disciplines-tabs [role='tab'] {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 0.8rem;
    border: none;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    font-weight: 500;
    font-size: 0.9rem;
    cursor: pointer;
    text-align: left;
    transition:
      background-color var(--duration-fast) var(--ease-default),
      color var(--duration-fast) var(--ease-default);
  }

  .discipline-num {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    /* Full text-muted, no opacity reduction: at 10.4px it must meet 4.5:1.
       opacity: 0.6 measured 2.92:1 against the card (axe, 2026-08-12) even
       though the numeral is aria-hidden decorative. */
    color: var(--text-muted);
    min-width: 1.4em;
  }

  .disciplines-tabs [role='tab'][aria-selected='true'] .discipline-num {
    color: var(--accent-primary);
    opacity: 1;
  }

  .disciplines-tabs [role='tab']:hover {
    background: var(--surface-muted);
    color: var(--text-primary);
  }

  .disciplines-tabs [role='tab'][aria-selected='true'] {
    background: var(--surface-accent-soft);
    color: var(--accent-primary);
  }

  .discipline-glyph {
    flex: 0 0 auto;
    opacity: 0.85;
  }

  .discipline-panel {
    display: none;
    padding: 1rem 1.25rem 1rem 0.5rem;
  }

  .discipline-panel.active {
    display: block;
  }

  .discipline-panel-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .discipline-panel-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--accent-primary);
    /* Keep the index at full accent contrast; it remains decorative via
       aria-hidden, but visible text still needs to meet WCAG AA. */
    opacity: 1;
    flex: 0 0 auto;
  }

  .discipline-headline {
    font-size: clamp(1.3rem, 2vw + 0.4rem, 1.8rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0;
  }

  .discipline-body {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .discipline-points {
    list-style: none;
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .discipline-points li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  .discipline-points li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border: 1.5px solid var(--accent-primary);
    transform: rotate(45deg);
  }

  .discipline-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
  }

  @media (max-width: 720px) {
    .disciplines-body {
      grid-template-columns: 1fr;
    }

    .disciplines-tabs {
      flex-direction: row;
      overflow-x: auto;
      border-right: none;
      border-bottom: 1px solid var(--border-default);
      padding-right: 0;
      padding-bottom: 0.5rem;
      scrollbar-width: thin;
    }

    .disciplines-tabs [role='tab'] {
      white-space: nowrap;
    }

    .discipline-panel {
      padding: 1rem 0.5rem;
    }
  }
</style>
