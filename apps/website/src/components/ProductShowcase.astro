---
import Button from './Button.astro';
import ScreenshotZoom from './ScreenshotZoom.astro';
/**
 * ProductShowcase — real Varve application UI, driven by the screenshot
 * manifest (apps/website/src/data/screenshot-manifest.json).
 *
 * Every image, caption and alt comes from the manifest, which is produced
 * by the deterministic capture pipeline (`pnpm screenshots:product`) rather
 * than by hand. Missing or skipped scenes degrade to a clear placeholder
 * instead of a broken image or a silently stale screenshot.
 *
 * Fit policy: each scene is displayed at its own aspect ratio. A scene is
 * never forced into a shared crop window, because doing so cut away the part
 * of a panel its caption described (see `lib/screenshot.ts`).
 */
import { sitePath } from '../lib/siteUrl';
import { PRODUCT_STATUS } from '@varve/shared';
import { getScene, type ScreenshotScene } from '../lib/screenshot';

/** Only captured scenes are renderable; a skipped scene has no file on disk. */
const captured = (key: string): ScreenshotScene | null => getScene(key);

const PRIMARY = captured('workspace');
const TABLET = captured('tablet-workspace');
// Cropped details, each showing one thing: canvas artwork, type, panel state.
// A *full* application frame is deliberately excluded: at a third of the page
// width a 1200x750 window scales to about 18% and its text is unreadable, which
// is the reason detail scenes are cropped at capture time in the first place.
// Whatever the pipeline could not capture simply drops out of the row.
const DETAILS = ['vector', 'typography', 'tablet-controls', 'layers', 'motion']
  .map(captured)
  .filter((s): s is ScreenshotScene => s !== null)
  .filter((s) => (s.kind ?? 'full') !== 'full')
  .slice(0, 3);
---

<section class="showcase" aria-labelledby="showcase-title">
  <div class="container-custom showcase-grid">
    <div class="showcase-copy">
      <p class="showcase-eyebrow">The real interface</p>
      <h2 id="showcase-title" class="showcase-title">
        One application,<br />every discipline.
      </h2>
      <p class="showcase-text">
        This is Varve as it runs today &mdash; the same document model, layer
        system, and shortcuts across vector, layout, typography, motion, print,
        and email work. Six task workspaces share the document; Logo tools stay
        in Design and Code export is available from any workspace. The beta
        label is deliberate: the interface you see is the interface you get.
      </p>
      <Button variant="secondary" href={sitePath('/docs/getting-started/interface')}>
        Tour the interface
      </Button>
      <p class="showcase-text showcase-presentation-link">
        <a href={sitePath('/features/presentations')}>Explore presentation authoring in Design</a>
        <span> · source-build preview</span>
      </p>
    </div>

    <div class="showcase-stage">
      {PRIMARY ? (
        <figure class="showcase-window">
          <div class="window-chrome" aria-hidden="true">
            <span class="window-brand" aria-hidden="true">
              <span class="window-brand__bar window-brand__bar--top"></span>
              <span class="window-brand__bar window-brand__bar--middle"></span>
              <span class="window-brand__bar window-brand__bar--bottom"></span>
            </span>
            <span class="window-title">Varve workspace</span>
            <span class="window-separator" aria-hidden="true"></span>
            <span class="window-context">Real interface &middot; {PRODUCT_STATUS.label}</span>
          </div>
          <ScreenshotZoom
            scene={PRIMARY}
            loading="eager"
            fetchpriority="high"
            sizes="(min-width: 1100px) 860px, 100vw"
            label="View the full window"
          />
          {PRIMARY.caption && <figcaption>{PRIMARY.caption}</figcaption>}
        </figure>
      ) : (
        <div class="showcase-placeholder" role="img" aria-label="Varve interface screenshot unavailable">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <path d="M3 9h18M9 21V9"></path>
          </svg>
          <p>
            This screenshot is temporarily unavailable. The rest of this page still describes how
            Varve works &mdash; see the <a href={sitePath('/features')}>feature pages</a> or the
            <a href={sitePath('/docs')}>documentation</a> for the same information.
          </p>
        </div>
      )}

      {DETAILS.length > 0 && (
        <div class="showcase-details" data-reveal>
          {DETAILS.map((scene) => (
            <figure class="showcase-detail">
              <ScreenshotZoom
                scene={scene}
                loading="lazy"
                sizes="(min-width: 980px) 30vw, 100vw"
                label="View full size"
              />
              {scene.caption && <figcaption>{scene.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}
    </div>
  </div>

  {TABLET && (
    <div class="showcase-tablet container-custom" data-reveal>
      <div class="showcase-tablet__copy">
        <p class="showcase-eyebrow">Tablet editing</p>
        <h3 class="showcase-tablet__title">Keep the canvas in reach.</h3>
        <p class="showcase-text">
          A responsive workspace keeps the same Varve document on screen, with touch-sized
          controls for selection, alignment, and tool modifiers when a keyboard is not at hand.
        </p>
        <Button variant="secondary" href={sitePath('/docs/touch-and-pen')}>
          Explore touch and pen support
        </Button>
      </div>
      <figure class="showcase-tablet__figure">
        <ScreenshotZoom
          scene={TABLET}
          loading="lazy"
          sizes="(min-width: 1100px) 66vw, 100vw"
          label="View the full tablet workspace"
        />
        {TABLET.caption && <figcaption>{TABLET.caption}</figcaption>}
      </figure>
    </div>
  )}
</section>

<style>
  .showcase {
    background: var(--surface-sunken);
    /* No bottom edge: the following band owns the boundary line, so the two
       adjacent sections do not render a doubled 2px seam. */
    /* audit-spacing: allow editorial section rhythm */
    padding: clamp(4rem, 8vh, 6.5rem) 0;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.85fr) minmax(0, 1.6fr);
    /* audit-spacing: allow editorial two-column rhythm */
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .showcase-eyebrow {
    font-size: var(--type-interface-caption-size);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }

  .showcase-title {
    font-size: var(--type-marketing-feature-size);
    font-family: var(--type-marketing-feature-family);
    font-weight: var(--type-marketing-feature-weight);
    font-variation-settings: 'opsz' 144;
    letter-spacing: -0.025em;
    line-height: var(--type-marketing-feature-line-height);
    color: var(--text-primary);
    margin-bottom: var(--space-5);
  }

  .showcase-text {
    font-size: var(--type-content-lead-size);
    line-height: var(--type-content-lead-line-height);
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
    max-width: 44ch;
  }

  .showcase-stage {
    min-width: 0;
  }

  .showcase-tablet {
    display: grid;
    grid-template-columns: minmax(220px, 0.7fr) minmax(0, 1.6fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .showcase-tablet__copy {
    max-width: 46ch;
  }

  .showcase-tablet__title {
    margin: 0 0 var(--space-5);
    color: var(--text-primary);
    font-family: var(--type-marketing-feature-family);
    font-size: var(--type-marketing-feature-size);
    font-weight: var(--type-marketing-feature-weight);
    letter-spacing: -0.025em;
    line-height: var(--type-marketing-feature-line-height);
  }

  .showcase-tablet__figure {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--website-radius-card);
    background: var(--surface-card);
    box-shadow:
      0 1px 2px oklch(0 0 0 / 0.06),
      0 4px 12px oklch(0 0 0 / 0.08),
      0 20px 48px -18px oklch(0 0 0 / 0.3);
  }

  .showcase-tablet__figure :global(.screenshot-image),
  .showcase-tablet__figure :global(.screenshot-image img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .showcase-tablet__figure figcaption {
    border-top: 1px solid var(--border-default);
    padding: var(--space-4) var(--space-5);
    color: var(--text-muted);
    font-size: var(--type-interface-caption-size);
  }

  .showcase-window {
    margin: 0;
    border-radius: var(--website-radius-card);
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: var(--surface-card);
    box-shadow:
      0 1px 2px oklch(0 0 0 / 0.06),
      0 4px 12px oklch(0 0 0 / 0.08),
      0 20px 48px -18px oklch(0 0 0 / 0.3);
  }

  .window-chrome {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--component-default-height);
    padding: var(--space-2) var(--space-4);
    background: var(--surface-muted);
    border-bottom: 1px solid var(--border-default);
  }

  .window-brand {
    display: grid;
    gap: var(--space-1);
    width: 1rem;
    flex: 0 0 1rem;
  }

  .window-brand__bar {
    display: block;
    height: 3px;
    border-radius: 1px;
    transform: skewX(-18deg);
  }

  .window-brand__bar--top {
    width: 0.78rem;
    margin-inline-start: 0.08rem;
    background: var(--brand-teal);
  }

  .window-brand__bar--middle {
    width: 0.86rem;
    margin-inline-start: 0.12rem;
    background: var(--brand-sandstone);
  }

  .window-brand__bar--bottom {
    width: 0.92rem;
    margin-inline-start: 0.16rem;
    background: var(--brand-terracotta);
  }

  .window-title {
    color: var(--text-primary);
    font-size: var(--type-interface-micro-size);
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .window-separator {
    width: 1px;
    height: 1rem;
    background: var(--border-default);
  }

  .window-context {
    overflow: hidden;
    color: var(--text-muted);
    font-size: var(--type-interface-micro-size);
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    letter-spacing: 0.01em;
  }

  .showcase-window :global(.screenshot-image img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .showcase-window figcaption {
    font-size: var(--type-interface-caption-size);
    color: var(--text-muted);
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid var(--border-default);
  }

  .showcase-placeholder {
    border: 1px dashed var(--border-strong);
    border-radius: var(--website-radius-card);
    padding: var(--space-8) var(--space-7);
    text-align: center;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }

  .showcase-details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-6);
    /* Caption rows sit at different heights because the crops have genuinely
       different shapes. Aligning to the top keeps each image at its own aspect
       ratio; forcing a shared ratio is what previously cropped content away. */
    align-items: start;
  }

  .showcase-detail {
    margin: 0;
    border-radius: var(--website-radius-control-compact);
    overflow: hidden;
    border: 1px solid var(--border-default);
    background: var(--surface-card);
    /* Panel crops are narrower than their column on small screens; centre them
       at their intrinsic size rather than stretching them past 1:1. */
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .showcase-detail :global(.screenshot-image),
  .showcase-detail :global(.screenshot-image img) {
    display: block;
  }

  .showcase-detail figcaption {
    font-size: var(--type-interface-caption-size);
    color: var(--text-muted);
    padding: var(--space-3) var(--space-4);
    width: 100%;
  }

  @media (max-width: 980px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }

    .showcase-copy {
      max-width: 56ch;
    }

    .showcase-tablet {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .showcase-details {
      grid-template-columns: 1fr;
    }
  }
</style>
