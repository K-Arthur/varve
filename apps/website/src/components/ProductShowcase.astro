---
/**
 * ProductShowcase — real Varve application UI, driven by the screenshot
 * manifest (apps/website/src/data/screenshot-manifest.json).
 *
 * Every image, caption and alt comes from the manifest, which is produced
 * by the deterministic capture pipeline (`pnpm screenshots:product`) rather
 * than by hand. Missing or skipped scenes degrade to a clear placeholder
 * instead of a broken image or a silently stale screenshot.
 */
import { sitePath } from '../lib/siteUrl';
import { PRODUCT_STATUS } from '@varve/shared';
import manifest from '../data/screenshot-manifest.json';

type SceneMeta = {
  file: string;
  alt: string;
  caption: string;
  feature?: string;
  theme: 'light' | 'dark';
  status?: 'captured' | 'skipped';
  reason?: string;
  width?: number;
  height?: number;
};

const scenes = manifest.scenes as unknown as Record<string, SceneMeta>;

/** Only captured scenes are renderable; a skipped scene has no file on disk. */
const captured = (key: string): SceneMeta | null => {
  const scene = scenes[key];
  return scene && scene.status === 'captured' ? scene : null;
};

const PRIMARY = captured('workspace');
// Cropped details, each showing one thing: canvas artwork, type, panel state.
// Whatever the pipeline could not capture simply drops out of the row.
const DETAILS = ['vector', 'typography', 'layers', 'motion']
  .map(captured)
  .filter((s): s is SceneMeta => s !== null)
  .slice(0, 3);
---

<section class="showcase" aria-labelledby="showcase-title">
  <div class="container-custom showcase-grid">
    <div class="showcase-copy">
      <p class="showcase-eyebrow">The real interface</p>
      <h2 id="showcase-title" class="showcase-title">
        One application,<br />every discipline.
      </h2>
      <p class="showcase-text">
        This is Varve as it runs today &mdash; the same document model, layer
        system, and shortcuts across vector, layout, typography, motion, and
        print work. The beta label is deliberate: the interface you see is
        the interface you get.
      </p>
      <a href={sitePath('/docs/getting-started/interface')} class="btn btn-secondary">
        Tour the interface
      </a>
    </div>

    <div class="showcase-stage">
      {PRIMARY ? (
        <figure class="showcase-window">
          <div class="window-chrome" aria-hidden="true">
            <span class="window-dot"></span>
            <span class="window-dot"></span>
            <span class="window-dot"></span>
            <span class="window-title">Varve &mdash; {PRODUCT_STATUS.label}</span>
          </div>
          <img
            src={sitePath(`/screenshots/${PRIMARY.file}`)}
            alt={PRIMARY.alt}
            width={PRIMARY.width ?? 1440}
            height={PRIMARY.height ?? 900}
            loading="eager"
            decoding="async"
          />
          {PRIMARY.caption && <figcaption>{PRIMARY.caption}</figcaption>}
        </figure>
      ) : (
        <div class="showcase-placeholder" role="img" aria-label="Varve interface screenshot not yet captured">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <path d="M3 9h18M9 21V9"></path>
          </svg>
          <p>Product screenshots are generated by the capture pipeline. Run <code>pnpm screenshots:product</code> to produce them.</p>
        </div>
      )}

      {DETAILS.length > 0 && (
        <div class="showcase-details" data-reveal>
          {DETAILS.map((scene) => (
            <figure class="showcase-detail">
              <img
                src={sitePath(`/screenshots/${scene.file}`)}
                alt={scene.alt}
                width={scene.width ?? 832}
                height={scene.height ?? 620}
                loading="lazy"
                decoding="async"
              />
              {scene.caption && <figcaption>{scene.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .showcase {
    background: var(--surface-sunken);
    border-bottom: 1px solid var(--border-default);
    padding: clamp(4rem, 8vh, 6.5rem) 0;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.85fr) minmax(0, 1.6fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .showcase-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .showcase-title {
    font-size: clamp(2rem, 3.5vw + 0.5rem, 3.25rem);
    font-family: var(--font-editorial);
    font-weight: 700;
    font-variation-settings: 'opsz' 144;
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .showcase-text {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 1.75rem;
    max-width: 44ch;
  }

  .showcase-stage {
    min-width: 0;
  }

  .showcase-window {
    margin: 0;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: var(--surface-card);
    box-shadow:
      0 1px 2px oklch(0 0 0 / 0.08),
      0 18px 48px -18px oklch(0 0 0 / 0.35);
  }

  .window-chrome {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    background: var(--surface-muted);
    border-bottom: 1px solid var(--border-default);
  }

  .window-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-strong);
    opacity: 0.6;
  }

  .window-title {
    margin-left: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .showcase-window img {
    display: block;
    width: 100%;
    height: auto;
  }

  .showcase-window figcaption {
    font-size: 0.875rem;
    color: var(--text-muted);
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--border-default);
  }

  .showcase-placeholder {
    border: 1px dashed var(--border-strong);
    border-radius: 0.75rem;
    padding: 3rem 2rem;
    text-align: center;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .showcase-placeholder code {
    background: var(--surface-code);
    color: var(--text-code);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
  }

  .showcase-details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .showcase-detail {
    margin: 0;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--border-default);
    background: var(--surface-card);
  }

  /* The detail crops have deliberately different shapes (a wide canvas crop,
     a tall panel crop). A shared aspect ratio keeps the row aligned; the
     intrinsic width/height attributes still reserve the box, so swapping a
     scene never shifts the layout. */
  .showcase-detail img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center top;
  }

  .showcase-detail figcaption {
    font-size: 0.8125rem;
    color: var(--text-muted);
    padding: 0.6rem 0.75rem;
  }

  @media (max-width: 980px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }

    .showcase-copy {
      max-width: 56ch;
    }
  }

  @media (max-width: 720px) {
    .showcase-details {
      grid-template-columns: 1fr;
    }
  }
</style>
