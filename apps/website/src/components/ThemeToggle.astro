---
/**
 * Theme switcher — the single interactive controller for site themes.
 *
 * The site exposes exactly two themes: light and dark. First-time visitors
 * without a persisted choice follow the OS (prefers-color-scheme); the first
 * explicit click persists that choice. Legacy localStorage values ("system",
 * "high-contrast", anything invalid) resolve to the OS preference and are
 * migrated to an explicit light/dark value on the next click.
 *
 * State lives in the pre-paint inline script in Layout.astro
 * (window.__varveTheme); this component only renders the control and wires
 * clicks to that API. The root's data-theme-mode remains "system" until the
 * first explicit click; data-theme always exposes the resolved palette.
 */
const choices = [
  { value: 'light', label: 'Light theme', icon: 'sun' },
  { value: 'dark', label: 'Dark theme', icon: 'moon' },
] as const;
---

<div class="theme-switcher" role="radiogroup" aria-label="Theme">
  {choices.map((choice) => (
    <button
      class="theme-option"
      data-theme-choice={choice.value}
      aria-checked="false"
      role="radio"
      tabindex="0"
      title={choice.label}
      aria-label={choice.label}
      type="button"
    >
      {choice.value === 'light' ? (
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
      ) : (
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      )}
      <span class="sr-only">{choice.label}</span>
    </button>
  ))}
</div>

<script>
  /**
   * Wires the two theme buttons to window.__varveTheme.
   *
   * Runs as a deferred module after the DOM is parsed. Every interaction
   * goes through the shared API: write() persists, apply() sets
   * html[data-theme], and the buttons mirror aria-checked + a visible
   * active state. No competing controllers exist.
   */
  const groups = document.querySelectorAll<HTMLElement>('.theme-switcher');
  function refreshSelection() {
    const api = window.__varveTheme;
    if (!api) return;
    const state = api.state();
    for (const group of groups) {
      for (const button of group.querySelectorAll<HTMLButtonElement>('.theme-option')) {
        const active = button.dataset.themeChoice === state.theme;
        button.setAttribute('aria-checked', String(active));
        button.tabIndex = active ? 0 : -1;
        button.classList.toggle('active', active);
      }
    }
  }

  function selectInGroup(groupButtons: HTMLButtonElement[], index: number) {
    const button = groupButtons[index];
    const api = window.__varveTheme;
    if (!button || !api) return;
    api.write(button.dataset.themeChoice ?? '');
    api.apply();
    refreshSelection();
    button.focus();
  }

  for (const group of groups) {
    const groupButtons = [...group.querySelectorAll<HTMLButtonElement>('.theme-option')];
    for (const button of groupButtons) {
      button.addEventListener('click', () => {
        const choice = button.dataset.themeChoice ?? '';
        const api = window.__varveTheme;
        if (!api) return;
        // The first explicit click converts the automatic OS-driven state
        // into a persisted choice (write() migrates legacy values too).
        api.write(choice);
        api.apply();
        refreshSelection();
      });

      button.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const index = groupButtons.indexOf(button);
        const nextIndex =
          event.key === 'Home'
            ? 0
            : event.key === 'End'
              ? groupButtons.length - 1
              : (index + (event.key === 'ArrowRight' ? 1 : -1) + groupButtons.length) %
                groupButtons.length;
        selectInGroup(groupButtons, nextIndex);
      });
    }
  }

  refreshSelection();
  window.addEventListener('varve:theme-change', refreshSelection);
</script>

<style>
  .theme-switcher {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.125rem;
    background: var(--surface-muted);
    border: 1px solid var(--border-default);
    border-radius: var(--website-radius-pill);
  }

  .theme-option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--website-radius-pill);
    cursor: pointer;
    color: var(--text-secondary);
    transition:
      background-color var(--duration-quick) var(--ease-default),
      color var(--duration-quick) var(--ease-default),
      border-color var(--duration-quick) var(--ease-default);
  }

  .theme-option:hover {
    color: var(--text-link);
  }

  .theme-option:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  /* The active choice gets a visible fill — not just an icon change. */
  .theme-option[aria-checked='true'] {
    background: var(--surface-card);
    color: var(--text-primary);
    border-color: var(--border-strong);
    box-shadow: 0 1px 2px oklch(0 0 0 / 0.12);
  }

  @media (forced-colors: active) {
    .theme-switcher {
      border-color: ButtonBorder;
    }

    .theme-option[aria-checked='true'] {
      background: Highlight;
      color: HighlightText;
      border-color: Highlight;
    }
  }
</style>
