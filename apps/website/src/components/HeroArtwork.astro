---
/**
 * HeroArtwork — the hero's centerpiece visual.
 *
 * Inspiration references (Behance: Spora, Agento, Protera) each anchor their
 * hero with one bold, tactile visual — a photo, a 3D object, an abstract
 * render. Varve's equivalent has to be about *designing*, not a generic
 * product shot: a small tilted stack of artboards, gradient-filled in the
 * brand's strata colours, with a visible vector path and anchor nodes drawn
 * across the top sheet — the same vocabulary as the DesignField background,
 * rendered once, crisply, as a static centerpiece rather than ambient noise.
 *
 * Placement: absolutely positioned within `.hero` (which is already
 * `position: relative; overflow: hidden` for the DesignField), independent
 * of the centered text column — so it never interacts with Hero's layout or
 * DesignField's safe-zone math. Desktop only (see the media query): on
 * narrow viewports the hero is already a tall stack of centered text, and
 * there is no free corner to put this without crowding it.
 *
 * A single self-contained inline SVG: no image request, no build step, a
 * few KB of markup. Pointer tilt is a small independent listener (mirrors
 * the pattern in DesignCursor.astro) rather than coupling to DesignField's
 * internal state, so the two components stay decoupled.
 */
---

<div class="hero-artwork" aria-hidden="true" data-hero-artwork>
  <svg viewBox="0 0 220 220" width="220" height="220" fill="none">
    <defs>
      <linearGradient id="ha-terra" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="var(--brand-terracotta)" />
        <stop offset="1" stop-color="var(--df-terra)" />
      </linearGradient>
      <linearGradient id="ha-sand" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="var(--brand-sandstone)" />
        <stop offset="1" stop-color="var(--df-sand)" />
      </linearGradient>
      <linearGradient id="ha-teal" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="var(--brand-teal)" />
        <stop offset="1" stop-color="var(--df-teal)" />
      </linearGradient>
      <filter id="ha-shadow" x="-40%" y="-40%" width="180%" height="180%">
        <feDropShadow dx="0" dy="10" stdDeviation="14" flood-opacity="0.28" />
      </filter>
    </defs>

    <g filter="url(#ha-shadow)">
      <!-- Back artboard: terracotta, most rotation. -->
      <rect x="38" y="58" width="118" height="148" rx="10" fill="url(#ha-terra)" transform="rotate(-9 97 132)" opacity="0.92" />
      <!-- Middle artboard: sandstone. -->
      <rect x="46" y="46" width="118" height="148" rx="10" fill="url(#ha-sand)" transform="rotate(4 105 120)" opacity="0.95" />
      <!-- Front artboard: teal, holds the vector path. -->
      <rect x="40" y="34" width="130" height="160" rx="12" fill="var(--surface-card)" stroke="url(#ha-teal)" stroke-width="2" transform="rotate(-2 105 114)" />
    </g>

    <!-- The front sheet's content, in the same local frame as its rect
         (rotate -2 about 105,114), so it rides along with the artboard. -->
    <g transform="rotate(-2 105 114)">
      <!-- A single open bezier path with two anchors and handle tangents —
           the vector-tools vocabulary, legible at this size. -->
      <path d="M62 150 C 78 108, 128 168, 148 90" stroke="var(--df-ink)" stroke-width="2" stroke-linecap="round" />
      <line x1="62" y1="150" x2="80" y2="122" stroke="var(--df-muted)" stroke-width="1" stroke-dasharray="2 3" />
      <line x1="148" y1="90" x2="130" y2="118" stroke="var(--df-muted)" stroke-width="1" stroke-dasharray="2 3" />
      <circle cx="62" cy="150" r="4" fill="var(--surface-card)" stroke="var(--df-ink)" stroke-width="1.6" />
      <circle cx="148" cy="90" r="4" fill="var(--surface-card)" stroke="var(--df-ink)" stroke-width="1.6" />
      <circle cx="105" cy="120" r="3.2" fill="var(--df-snap)" />

      <!-- A tiny swatch row, top-right of the sheet. -->
      <rect x="118" y="52" width="10" height="10" rx="2.5" fill="var(--brand-teal)" />
      <rect x="132" y="52" width="10" height="10" rx="2.5" fill="var(--brand-sandstone)" />
      <rect x="146" y="52" width="10" height="10" rx="2.5" fill="var(--brand-terracotta)" />
    </g>
  </svg>
</div>

<script>
  import { isCoarsePointer, prefersMotion } from '../lib/motion';

  const host = document.querySelector<HTMLElement>('[data-hero-artwork]');
  if (host) {
    if (isCoarsePointer() || !prefersMotion()) {
      // No tilt on touch or under reduced motion — the artwork stays put,
      // which is a perfectly good static illustration on its own.
    } else {
      let raf = 0;
      let targetX = 0;
      let targetY = 0;
      let curX = 0;
      let curY = 0;

      const loop = (): void => {
        curX += (targetX - curX) * 0.12;
        curY += (targetY - curY) * 0.12;
        host.style.transform = `perspective(700px) rotateX(${curY}deg) rotateY(${curX}deg)`;
        if (Math.abs(targetX - curX) > 0.01 || Math.abs(targetY - curY) > 0.01) {
          raf = requestAnimationFrame(loop);
        } else {
          raf = 0;
        }
      };

      const ensureLoop = (): void => {
        if (!raf) raf = requestAnimationFrame(loop);
      };

      window.addEventListener(
        'pointermove',
        (e) => {
          if (e.pointerType !== 'mouse') return;
          const rect = host.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          // Cap the tilt at a few degrees — a hint of depth, not a gimbal.
          targetX = Math.max(-6, Math.min(6, ((e.clientX - cx) / rect.width) * 10));
          targetY = Math.max(-6, Math.min(6, -((e.clientY - cy) / rect.height) * 10));
          ensureLoop();
        },
        { passive: true },
      );

      window.addEventListener(
        'blur',
        () => {
          targetX = 0;
          targetY = 0;
          ensureLoop();
        },
        { passive: true },
      );
    }
  }
</script>

<style>
  .hero-artwork {
    display: none;
    position: absolute;
    /* Bottom-right of the hero, clear of the centered text column and
       outside the DesignField's safe-zone ellipse (which only guarantees
       clearance around the centre — this sits at the edge). */
    right: clamp(1rem, 4vw, 4.5rem);
    bottom: clamp(0.5rem, 3vh, 2.5rem);
    width: clamp(140px, 14vw, 200px);
    height: auto;
    pointer-events: none;
    will-change: transform;
    z-index: 1;
  }

  .hero-artwork svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Desktop only — see the component doc comment. 1100px clears the point
     where the hero's centered copy starts approaching full width. */
  @media (min-width: 1100px) {
    .hero-artwork {
      display: block;
    }
  }

  @media (forced-colors: active) {
    .hero-artwork {
      display: none;
    }
  }
</style>
