---
/**
 * HeroArtwork — the hero's centerpiece: a 3D-feeling geometric construction.
 *
 * Inspired by the geometric construction reference (Bezier handles, anchor
 * nodes, measurement annotations, construction circles, angle markers) and
 * the AGENTO reference (central sculptural object with technical frame).
 *
 * This is a CSS/SVG composition: layered artboards in perspective with a
 * vector path, control handles, measurement labels, and construction
 * geometry — a "living design object" being actively built. No WebGL.
 * The 3D feel comes from CSS perspective transforms on stacked layers.
 *
 * Desktop only (1100px+). Reduced to nothing on mobile.
 */
---

<div class="hero-artwork" aria-hidden="true" data-hero-artwork>
  <!-- Layer stack: three planes at different Z-depths for parallax -->
  <div class="ha-layer ha-layer-back">
    <svg viewBox="0 0 300 300" fill="none">
      <!-- Construction circle (dashed) -->
      <circle cx="150" cy="140" r="110" stroke="var(--df-grid)" stroke-width="0.8" stroke-dasharray="4 6" opacity="0.4" />
      <!-- Angle annotation -->
      <text x="265" y="60" font-family="ui-monospace, monospace" font-size="9" fill="var(--df-muted)" opacity="0.5">30°</text>
      <path d="M250 65 L255 55" stroke="var(--df-muted)" stroke-width="0.6" opacity="0.5" />
      <!-- Measurement label -->
      <text x="150" y="255" font-family="ui-monospace, monospace" font-size="9" fill="var(--df-muted)" text-anchor="middle" opacity="0.5">164</text>
    </svg>
  </div>

  <div class="ha-layer ha-layer-mid">
    <svg viewBox="0 0 300 300" fill="none">
      <!-- Outer construction shape: octagonal path with anchor nodes -->
      <path d="M150 25 L235 60 L270 140 L235 220 L150 255 L65 220 L30 140 L65 60 Z"
        stroke="var(--df-ink)" stroke-width="1.8" fill="none" />
      <!-- Anchor nodes on the outer shape -->
      <rect x="145" y="20" width="10" height="10" rx="1" fill="var(--surface-page)" stroke="var(--df-ink)" stroke-width="1.4" />
      <rect x="230" y="55" width="10" height="10" rx="1" fill="var(--surface-page)" stroke="var(--df-ink)" stroke-width="1.4" />
      <rect x="265" y="135" width="10" height="10" rx="1" fill="var(--surface-page)" stroke="var(--df-ink)" stroke-width="1.4" />
      <rect x="230" y="215" width="10" height="10" rx="1" fill="var(--surface-page)" stroke="var(--df-ink)" stroke-width="1.4" />
      <rect x="145" y="250" width="10" height="10" rx="1" fill="var(--surface-page)" stroke="var(--df-ink)" stroke-width="1.4" />
      <rect x="60" y="215" width="10" height="10" rx="1" fill="var(--surface-page)" stroke="var(--df-ink)" stroke-width="1.4" />
      <rect x="25" y="135" width="10" height="10" rx="1" fill="var(--surface-page)" stroke="var(--df-ink)" stroke-width="1.4" />
      <rect x="60" y="55" width="10" height="10" rx="1" fill="var(--surface-page)" stroke="var(--df-ink)" stroke-width="1.4" />
      <!-- Construction circles (dashed) at key nodes -->
      <circle cx="150" cy="25" r="22" stroke="var(--df-grid)" stroke-width="0.6" stroke-dasharray="3 5" opacity="0.35" />
      <circle cx="270" cy="140" r="18" stroke="var(--df-grid)" stroke-width="0.6" stroke-dasharray="3 5" opacity="0.35" />
      <circle cx="150" cy="255" r="20" stroke="var(--df-grid)" stroke-width="0.6" stroke-dasharray="3 5" opacity="0.35" />
      <circle cx="30" cy="140" r="18" stroke="var(--df-grid)" stroke-width="0.6" stroke-dasharray="3 5" opacity="0.35" />
      <!-- Measurement annotations -->
      <text x="195" y="42" font-family="ui-monospace, monospace" font-size="8" fill="var(--df-muted)" opacity="0.5">132</text>
      <text x="95" y="42" font-family="ui-monospace, monospace" font-size="8" fill="var(--df-muted)" opacity="0.5">164</text>
    </svg>
  </div>

  <div class="ha-layer ha-layer-front">
    <svg viewBox="0 0 300 300" fill="none">
      <!-- The main bezier curve: a flowing S-curve through the construction -->
      <path d="M60 230 C 90 160, 180 200, 200 120 S 250 60, 260 80"
        stroke="var(--df-ink)" stroke-width="2.5" stroke-linecap="round" fill="none" />

      <!-- Bezier handle lines from the first anchor -->
      <line x1="60" y1="230" x2="40" y2="180" stroke="var(--df-muted)" stroke-width="0.8" stroke-dasharray="2 3" />
      <circle cx="40" cy="180" r="3" fill="var(--df-muted)" />
      <!-- Bezier handle lines from the end anchor -->
      <line x1="260" y1="80" x2="280" y2="50" stroke="var(--df-muted)" stroke-width="0.8" stroke-dasharray="2 3" />
      <circle cx="280" cy="50" r="3" fill="var(--df-muted)" />

      <!-- Anchor nodes (filled squares when selected) -->
      <rect x="54" y="224" width="12" height="12" rx="1.5" fill="var(--brand-teal)" stroke="var(--surface-page)" stroke-width="1.5" />
      <rect x="254" y="74" width="12" height="12" rx="1.5" fill="var(--brand-teal)" stroke="var(--surface-page)" stroke-width="1.5" />

      <!-- Mid-curve control point -->
      <circle cx="140" cy="175" r="3.5" fill="var(--brand-sandstone)" stroke="var(--surface-page)" stroke-width="1" />

      <!-- Selection bounding box around the curve -->
      <rect x="50" y="55" width="220" height="185" stroke="var(--brand-teal)" stroke-width="1.2" stroke-dasharray="5 4" fill="none" opacity="0.5" />

      <!-- Corner handles on the selection box -->
      <rect x="45" y="50" width="10" height="10" rx="1" fill="var(--surface-page)" stroke="var(--brand-teal)" stroke-width="1" />
      <rect x="265" y="50" width="10" height="10" rx="1" fill="var(--surface-page)" stroke="var(--brand-teal)" stroke-width="1" />
      <rect x="45" y="235" width="10" height="10" rx="1" fill="var(--surface-page)" stroke="var(--brand-teal)" stroke-width="1" />
      <rect x="265" y="235" width="10" height="10" rx="1" fill="var(--surface-page)" stroke="var(--brand-teal)" stroke-width="1" />

      <!-- Color swatches -->
      <rect x="55" y="42" width="11" height="11" rx="2.5" fill="var(--brand-teal)" />
      <rect x="70" y="42" width="11" height="11" rx="2.5" fill="var(--brand-sandstone)" />
      <rect x="85" y="42" width="11" height="11" rx="2.5" fill="var(--brand-terracotta)" />

      <!-- Tool label chip -->
      <rect x="230" y="38" width="40" height="16" rx="4" fill="var(--brand-teal)" opacity="0.15" />
      <text x="238" y="50" font-family="ui-monospace, monospace" font-size="8" fill="var(--brand-teal)" font-weight="600">pen</text>

      <!-- Alignment guides (very faint crosshairs) -->
      <line x1="150" y1="15" x2="150" y2="285" stroke="var(--df-snap)" stroke-width="0.4" stroke-dasharray="3 5" opacity="0.2" />
      <line x1="15" y1="140" x2="285" y2="140" stroke="var(--df-snap)" stroke-width="0.4" stroke-dasharray="3 5" opacity="0.2" />
    </svg>
  </div>
</div>

<script>
  import { isCoarsePointer, prefersMotion } from '../lib/motion';

  const host = document.querySelector<HTMLElement>('[data-hero-artwork]');
  if (host) {
    if (isCoarsePointer() || !prefersMotion()) {
      // Static on touch or reduced motion
    } else {
      let raf = 0;
      let targetX = 0;
      let targetY = 0;
      let curX = 0;
      let curY = 0;

      const loop = (): void => {
        curX += (targetX - curX) * 0.08;
        curY += (targetY - curY) * 0.08;
        host.style.transform = `perspective(900px) rotateX(${curY}deg) rotateY(${curX}deg)`;
        if (Math.abs(targetX - curX) > 0.01 || Math.abs(targetY - curY) > 0.01) {
          raf = requestAnimationFrame(loop);
        } else {
          raf = 0;
        }
      };

      const ensureLoop = (): void => {
        if (!raf) raf = requestAnimationFrame(loop);
      };

      window.addEventListener(
        'pointermove',
        (e) => {
          if (e.pointerType !== 'mouse') return;
          const rect = host.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          targetX = Math.max(-8, Math.min(8, ((e.clientX - cx) / rect.width) * 12));
          targetY = Math.max(-8, Math.min(8, -((e.clientY - cy) / rect.height) * 12));
          ensureLoop();
        },
        { passive: true },
      );

      window.addEventListener('blur', () => {
        targetX = 0;
        targetY = 0;
        ensureLoop();
      }, { passive: true });
    }
  }
</script>

<style>
  .hero-artwork {
    display: none;
    position: absolute;
    right: clamp(0rem, 3vw, 4rem);
    bottom: clamp(0rem, 2vh, 2rem);
    width: clamp(200px, 22vw, 320px);
    height: clamp(200px, 22vw, 320px);
    pointer-events: none;
    will-change: transform;
    z-index: 1;
    transform-style: preserve-3d;
  }

  /* Three layers at different Z-depths for parallax/3D feel */
  .ha-layer {
    position: absolute;
    inset: 0;
  }

  .ha-layer svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ha-layer-back {
    transform: translateZ(-30px) scale(0.92);
    opacity: 0.5;
  }

  .ha-layer-mid {
    transform: translateZ(-10px) scale(0.97);
    opacity: 0.75;
  }

  .ha-layer-front {
    transform: translateZ(0);
  }

  @media (min-width: 1100px) {
    .hero-artwork {
      display: block;
    }
  }

  @media (forced-colors: active) {
    .hero-artwork {
      display: none;
    }
  }
</style>
