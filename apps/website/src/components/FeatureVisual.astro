---
/**
 * FeatureVisual — one product screenshot on a feature page, resolved from the
 * screenshot manifest (apps/website/src/data/screenshot-manifest.json).
 *
 * Feature pages used to hardcode `/screenshots/<file>.png` with a hand-written
 * alt and caption. That kept working only as long as nobody re-cropped or
 * renamed a scene: the file reference is validated, but the prose beside it is
 * not, so a scene could start showing something else while the page kept
 * describing the old capture. Taking `scene` instead of a path means the alt
 * text and caption always come from whatever the pipeline actually captured.
 *
 * A scene that was skipped renders nothing at all, rather than a broken image.
 *
 * Placement semantics: a feature page shows one image at one job (overview,
 * detail, or result). Fit is decided by the scene's captured kind, so a tall
 * panel crop is shown at its intrinsic width instead of being stretched or
 * cropped into the surrounding layout.
 */
import ScreenshotZoom from './ScreenshotZoom.astro';
import { getScene } from '../lib/screenshot';

interface Props {
  /** Scene id in the manifest, e.g. "workspaces". */
  scene: string;
  /** Override the manifest caption when a page needs more specific framing. */
  caption?: string;
  /** Priority hint for an above-the-fold hero visual. */
  priority?: boolean;
  sizes?: string;
}

const { scene, caption, priority = false, sizes = '(min-width: 1100px) 760px, 100vw' } = Astro.props;
const shot = getScene(scene);
---

{
  shot && (
    <figure class="feature-visual">
      <ScreenshotZoom
        scene={shot}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        sizes={sizes}
        label="View full size"
      />
      {(caption ?? shot.caption) && <figcaption>{caption ?? shot.caption}</figcaption>}
    </figure>
  )
}

<style>
  .feature-visual {
    /* audit-spacing: allow optical tuck toward the preceding copy */
    margin: -1rem 0 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .feature-visual :global(.screenshot-image) {
    display: block;
    width: 100%;
    border: 1px solid var(--border-default);
    border-radius: var(--website-radius-card);
    box-shadow: var(--elevation-shadow-raised);
    background: var(--surface-card);
    overflow: hidden;
  }

  /* The screenshot keeps its own aspect ratio. `object-fit: contain` is used
     only to guarantee the whole capture stays visible if a consumer constrains
     the height; nothing here crops a scene. */
  .feature-visual :global(.screenshot-image img) {
    display: block;
    height: auto;
    object-fit: contain;
  }

  .feature-visual figcaption {
    margin-top: var(--space-4);
    color: var(--text-secondary);
    font-size: var(--type-interface-caption-size);
    line-height: 1.5;
    text-align: center;
  }
</style>
