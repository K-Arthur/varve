---
/**
 * TrustStrip — quick product facts in a hard band, no cards.
 * Four oversized facts: local-first, no subscription, source-available,
 * cross-platform. Reads fast and earns the headline's claims.
 */
---

<section class="trust-strip" aria-label="Varve at a glance">
  <div class="container-custom trust-grid">
    <div class="trust-item" data-reveal>
      <span class="trust-kicker">Account</span>
      <strong class="trust-word">No account</strong>
      <span class="trust-note">Core editing works offline. No sign-up, no cloud sync.</span>
    </div>
    <div class="trust-item" data-reveal data-reveal-delay="80">
      <span class="trust-kicker">Pricing</span>
      <strong class="trust-word">Free forever</strong>
      <span class="trust-note">The Community Edition is free, and stays free. No subscription, no paywall.</span>
    </div>
    <div class="trust-item" data-reveal data-reveal-delay="160">
      <span class="trust-kicker">Platform</span>
      <strong class="trust-word">Native on Linux</strong>
      <span class="trust-note">First-class Linux support with a Rust rendering engine. Also on macOS and Windows.</span>
    </div>
    <div class="trust-item" data-reveal data-reveal-delay="240">
      <span class="trust-kicker">Code</span>
      <strong class="trust-word">Source-available</strong>
      <span class="trust-note">FSL-1.1-MIT. Converts to MIT after two years.</span>
    </div>
  </div>
</section>

<style>
  .trust-strip {
    border-bottom: 1px solid var(--border-default);
    background:
      linear-gradient(135deg,
        color-mix(in oklab, var(--brand-teal) 4%, var(--surface-sunken)) 0%,
        var(--surface-sunken) 50%,
        color-mix(in oklab, var(--brand-sandstone) 3%, var(--surface-sunken)) 100%
      );
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .trust-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-left: 1px solid var(--border-default);
    padding: 0 1.5rem;
  }

  .trust-item:first-child {
    border-left: none;
    padding-left: 0;
  }

  .trust-item:last-child {
    padding-right: 0;
  }

  .trust-kicker {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .trust-word {
    font-family: var(--font-editorial);
    font-size: clamp(1.5rem, 2vw + 0.7rem, 2.25rem);
    font-weight: 700;
    font-variation-settings: 'opsz' 96;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    line-height: 1.1;
  }

  .trust-note {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 0;
    }

    .trust-item {
      border-left: none;
      padding-left: 0;
    }

    .trust-item:nth-child(-n+2) {
      border-bottom: 1px solid var(--border-default);
      padding-bottom: 2rem;
    }

    .trust-item:nth-child(odd) {
      padding-right: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .trust-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .trust-item {
      border-bottom: 1px solid var(--border-default);
      padding-bottom: 1.75rem;
    }

    .trust-item:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .trust-item:nth-child(-n+2) {
      border-bottom: 1px solid var(--border-default);
    }
  }
</style>
