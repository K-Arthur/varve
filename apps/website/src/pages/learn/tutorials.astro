---
import Layout from '../../layouts/Layout.astro';
import { sitePath } from '../../lib/siteUrl';
---

<Layout title="Tutorials" description="Step-by-step Varve tutorials: getting started, vector design, layout, typography, motion, and print workflows.">
  <div class="container-custom">
    <div class="learn-page">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={sitePath('/learn')}>Learn</a> / Tutorials
      </nav>

      <h1>Tutorials</h1>
      <p class="learn-intro">
        Step-by-step tutorials to help you get started with Varve.
      </p>

      <div class="tutorials-grid">
        <div class="tutorial-card">
          <h2>Getting Started with Varve</h2>
          <p>
            Learn the basics of Varve's interface, tools, and workflow. This tutorial covers installation, first launch, and creating your first design.
          </p>
          <div class="tutorial-meta">
            <span class="tutorial-level">Beginner</span>
            <span class="tutorial-time">15 minutes</span>
          </div>
          <a href={sitePath('/docs/getting-started')} class="btn-secondary">Start Tutorial</a>
        </div>

        <div class="tutorial-card">
          <h2>Vector Design Basics</h2>
          <p>
            Master shape primitives, path editing, and boolean operations. Learn how to create precise vector graphics using Varve's geometry tools.
          </p>
          <div class="tutorial-meta">
            <span class="tutorial-level">Beginner</span>
            <span class="tutorial-time">20 minutes</span>
          </div>
          <a href={sitePath('/features/vector-tools')} class="btn-secondary">Learn More</a>
        </div>

        <div class="tutorial-card">
          <h2>Typography and Text</h2>
          <p>
            Work with text elements, font families, and typography controls. Learn about text properties, alignment, and text-on-path capabilities.
          </p>
          <div class="tutorial-meta">
            <span class="tutorial-level">Intermediate</span>
            <span class="tutorial-time">25 minutes</span>
          </div>
          <a href={sitePath('/features/typography')} class="btn-secondary">Learn More</a>
        </div>

        <div class="tutorial-card">
          <h2>Motion and Prototyping</h2>
          <p>
            Create timeline-based animations and prototype interactions. Learn about Smart Animate, easing curves, and export to CSS/Lottie.
          </p>
          <div class="tutorial-meta">
            <span class="tutorial-level">Advanced</span>
            <span class="tutorial-time">30 minutes</span>
          </div>
          <a href={sitePath('/features/motion')} class="btn-secondary">Learn More</a>
        </div>

        <div class="tutorial-card">
          <h2>Export and Code Generation</h2>
          <p>
            Export your designs to various formats including SVG, React/Tailwind, Flutter, and SwiftUI. Learn about export settings and code generation options.
          </p>
          <div class="tutorial-meta">
            <span class="tutorial-level">Intermediate</span>
            <span class="tutorial-time">20 minutes</span>
          </div>
          <a href={sitePath('/features/export')} class="btn-secondary">Learn More</a>
        </div>
      </div>

      <div class="learn-cta">
        <h2>Want to contribute?</h2>
        <p>Help create tutorials for the community. See the <a href={sitePath('/contribute')}>contribution guidelines</a>.</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .learn-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 0;
  }
  
  .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }
  
  .breadcrumb a {
    color: var(--text-secondary);
  }
  
  .learn-page h1 {
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }
  
  .learn-intro {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: 3rem;
  }
  
  .tutorials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }
  
  .tutorial-card {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 0.75rem;
    padding: 2rem;
    transition: all var(--duration-fast) var(--ease-default);
  }
  
  .tutorial-card:hover {
    border-color: var(--border-accent);
    transform: translateY(-2px);
  }
  
  .tutorial-card h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }
  
  .tutorial-card p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  
  .tutorial-meta {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  
  .tutorial-level,
  .tutorial-time {
    font-size: 0.875rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: var(--surface-muted);
    color: var(--text-secondary);
  }
  
  .learn-cta {
    text-align: center;
    padding: 3rem 0;
    border-top: 1px solid var(--border-default);
  }
  
  .learn-cta h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }
  
  .learn-cta p {
    color: var(--text-secondary);
  }
</style>
