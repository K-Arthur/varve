---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Tutorials - Strata Learn">
  <div class="container-custom">
    <div class="learn-page">
      <nav class="breadcrumb">
        <a href="/learn">Learn</a> / Tutorials
      </nav>

      <h1>Tutorials</h1>
      <p class="learn-intro">
        Step-by-step tutorials to help you get started with Strata.
      </p>

      <div class="tutorial-status">
        <div class="status-card">
          <h3>Tutorials Coming Soon</h3>
          <p>Tutorials are being developed. In the meantime, check the <a href="/docs">documentation</a> for getting started guides.</p>
          <p>Want to help write tutorials? See the <a href="/contribute">contribution guidelines</a>.</p>
        </div>
      </div>

      <div class="planned-tutorials">
        <h2>Planned Tutorials</h2>
        <ul>
          <li>Your First Design - Create a simple UI layout</li>
          <li>Vector Design - Working with shapes and paths</li>
          <li>Typography - Using text and typography features</li>
          <li>Color & Effects - Using blend modes and effects</li>
          <li>Motion - Creating animations with the timeline</li>
          <li>Prototyping - Creating interactive prototypes</li>
          <li>Export - Exporting to code and PDF</li>
        </ul>
      </div>

      <div class="learn-cta">
        <h2>Want to contribute?</h2>
        <p>Help create tutorials for the community. See the <a href="/contribute">contribution guidelines</a>.</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .learn-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 0;
  }
  
  .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }
  
  .breadcrumb a {
    color: var(--color-neutral-600);
  }
  
  .learn-page h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--color-neutral-900);
  }
  
  .learn-intro {
    font-size: 1.125rem;
    color: var(--color-neutral-600);
    margin-bottom: 3rem;
  }
  
  .tutorial-status {
    margin-bottom: 3rem;
  }
  
  .status-card {
    background: var(--color-sandstone-50);
    border: 1px solid var(--color-sandstone-400);
    border-radius: 0.75rem;
    padding: 2rem;
    text-align: center;
  }
  
  .status-card h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--color-neutral-900);
  }
  
  .status-card p {
    color: var(--color-neutral-600);
    margin-bottom: 0.75rem;
  }
  
  .status-card a {
    color: var(--color-teal-600);
  }
  
  .planned-tutorials {
    margin-bottom: 3rem;
  }
  
  .planned-tutorials h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--color-neutral-900);
  }
  
  .planned-tutorials ul {
    list-style: none;
  }
  
  .planned-tutorials li {
    margin-bottom: 0.75rem;
    padding-left: 1.5rem;
    position: relative;
    color: var(--color-neutral-600);
  }
  
  .planned-tutorials li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-teal-400);
  }
  
  .learn-cta {
    text-align: center;
    padding: 3rem 0;
    border-top: 1px solid var(--color-neutral-200);
  }
  
  .learn-cta h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--color-neutral-900);
  }
  
  .learn-cta p {
    color: var(--color-neutral-600);
  }
</style>
