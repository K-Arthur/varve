---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Examples - Strata Learn">
  <div class="container-custom">
    <div class="learn-page">
      <nav class="breadcrumb">
        <a href="/learn">Learn</a> / Examples
      </nav>

      <h1>Examples</h1>
      <p class="learn-intro">
        Example files and projects to learn from.
      </p>

      <div class="examples-grid">
        <div class="example-card">
          <h3>UI Component Library</h3>
          <p>
            A collection of common UI components built with Strata. Includes buttons, cards, inputs, and navigation elements ready to use in your designs.
          </p>
          <div class="example-meta">
            <span class="example-type">Components</span>
            <span class="example-status">Planned</span>
          </div>
        </div>

        <div class="example-card">
          <h3>Mobile App Mockups</h3>
          <p>
            Example mobile app designs showcasing Strata's vector tools and layout capabilities. Includes iOS and Android frame templates.
          </p>
          <div class="example-meta">
            <span class="example-type">Templates</span>
            <span class="example-status">Planned</span>
          </div>
        </div>

        <div class="example-card">
          <h3>Icon Set</h3>
          <p>
            A comprehensive icon set created entirely in Strata. Demonstrates precision vector work and export to SVG format.
          </p>
          <div class="example-meta">
            <span class="example-type">Icons</span>
            <span class="example-status">Planned</span>
          </div>
        </div>

        <div class="example-card">
          <h3>Brand Identity System</h3>
          <p>
            Complete brand identity example including logo variations, color palette, typography system, and brand guidelines document.
          </p>
          <div class="example-meta">
            <span class="example-type">Branding</span>
            <span class="example-status">Planned</span>
          </div>
        </div>

        <div class="example-card">
          <h3>Animation Showcase</h3>
          <p>
            Interactive animations and motion design examples. Demonstrates timeline animation, Smart Animate, and export to CSS/Lottie.
          </p>
          <div class="example-meta">
            <span class="example-type">Motion</span>
            <span class="example-status">Planned</span>
          </div>
        </div>
      </div>

      <div class="learn-cta">
        <h2>Want to contribute?</h2>
        <p>Share your example files with the community. See the <a href="/contribute">contribution guidelines</a>.</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .learn-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 0;
  }
  
  .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }
  
  .breadcrumb a {
    color: var(--color-neutral-600);
  }
  
  .learn-page h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--color-neutral-900);
  }
  
  .learn-intro {
    font-size: 1.125rem;
    color: var(--color-neutral-600);
    margin-bottom: 3rem;
  }
  
  .examples-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }
  
  .example-card {
    background: white;
    border: 1px solid var(--color-neutral-200);
    border-radius: 0.75rem;
    padding: 2rem;
    transition: all 0.2s;
  }
  
  .example-card:hover {
    border-color: var(--color-teal-400);
    transform: translateY(-2px);
  }
  
  .example-card h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--color-neutral-900);
  }
  
  .example-card p {
    color: var(--color-neutral-600);
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  
  .example-meta {
    display: flex;
    gap: 0.5rem;
  }
  
  .example-type,
  .example-status {
    font-size: 0.875rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: var(--color-neutral-100);
    color: var(--color-neutral-600);
  }
  
  .example-status {
    background: var(--color-sandstone-100);
    color: var(--color-sandstone-700);
  }
  
  .learn-cta {
    text-align: center;
    padding: 3rem 0;
    border-top: 1px solid var(--color-neutral-200);
  }
  
  .learn-cta h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--color-neutral-900);
  }
  
  .learn-cta p {
    color: var(--color-neutral-600);
  }
</style>
