---
import Layout from '../../layouts/Layout.astro';
import { sitePath } from '../../lib/siteUrl';
---

<Layout title="Examples" description="Example files and projects to learn from — real Varve documents you can open, inspect, and remix.">
  <div class="container-custom">
    <div class="learn-page">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={sitePath('/learn')}>Learn</a> / Examples
      </nav>

      <h1>Examples</h1>
      <p class="learn-intro">
        Example files and projects to learn from.
      </p>

      <div class="examples-grid">
        <div class="example-card">
          <h2>UI Component Library</h2>
          <p>
            A collection of common UI components built with Varve. Includes buttons, cards, inputs, and navigation elements ready to use in your designs.
          </p>
          <div class="example-meta">
            <span class="example-type">Components</span>
            <span class="example-status">Planned</span>
          </div>
        </div>

        <div class="example-card">
          <h2>Mobile App Mockups</h2>
          <p>
            Example mobile app designs showcasing Varve's vector tools and layout capabilities. Includes iOS and Android frame templates.
          </p>
          <div class="example-meta">
            <span class="example-type">Templates</span>
            <span class="example-status">Planned</span>
          </div>
        </div>

        <div class="example-card">
          <h2>Icon Set</h2>
          <p>
            A comprehensive icon set created entirely in Varve. Demonstrates precision vector work and export to SVG format.
          </p>
          <div class="example-meta">
            <span class="example-type">Icons</span>
            <span class="example-status">Planned</span>
          </div>
        </div>

        <div class="example-card">
          <h2>Brand Identity System</h2>
          <p>
            Complete brand identity example including logo variations, color palette, typography system, and brand guidelines document.
          </p>
          <div class="example-meta">
            <span class="example-type">Branding</span>
            <span class="example-status">Planned</span>
          </div>
        </div>

        <div class="example-card">
          <h2>Animation Showcase</h2>
          <p>
            Interactive animations and motion design examples. Demonstrates timeline animation, Smart Animate, and export to CSS/Lottie.
          </p>
          <div class="example-meta">
            <span class="example-type">Motion</span>
            <span class="example-status">Planned</span>
          </div>
        </div>
      </div>

      <div class="learn-cta">
        <h2>Want to contribute?</h2>
        <p>Share your example files with the community. See the <a href={sitePath('/contribute')}>contribution guidelines</a>.</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .learn-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 0;
  }
  
  .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }
  
  .breadcrumb a {
    color: var(--text-secondary);
  }
  
  .learn-page h1 {
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }
  
  .learn-intro {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: 3rem;
  }
  
  .examples-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }
  
  .example-card {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 0.75rem;
    padding: 2rem;
    transition: all var(--duration-fast) var(--ease-default);
  }
  
  .example-card:hover {
    border-color: var(--border-accent);
    transform: translateY(-2px);
  }
  
  .example-card h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }
  
  .example-card p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  
  .example-meta {
    display: flex;
    gap: 0.5rem;
  }
  
  .example-type,
  .example-status {
    font-size: 0.875rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: var(--surface-muted);
    color: var(--text-secondary);
  }
  
  .example-status {
    background: var(--surface-warning);
    color: var(--text-warning);
  }
  
  .learn-cta {
    text-align: center;
    padding: 3rem 0;
    border-top: 1px solid var(--border-default);
  }
  
  .learn-cta h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }
  
  .learn-cta p {
    color: var(--text-secondary);
  }
</style>
