---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import BentoGrid from '../components/BentoGrid.astro';
import BentoCard from '../components/BentoCard.astro';
---

<Layout title="Strata - Local-first, cross-platform design suite">
  <section class="hero">
    <div class="container-custom">
      <div class="hero-content">
        <h1 class="hero-title">
          Local-first, cross-platform design suite
        </h1>
        <p class="hero-subtitle">
          Native Rust performance. No cloud lock-in. No subscription.
        </p>
        <div class="hero-ctas">
          <Button href="/download" variant="primary">
            Download for Your Platform
          </Button>
          <Button href="/product" variant="secondary">
            Learn More
          </Button>
        </div>
        <p class="hero-platforms">
          Linux • macOS • Windows
        </p>
      </div>
    </div>
  </section>

  <section class="features-preview">
    <div class="container-custom">
      <h2 class="section-title">Built for serious design work</h2>
      <BentoGrid cols={2}>
        <BentoCard>
          <h3>Canvas & Rendering</h3>
          <p>86fps IR-replay rendering, infinite canvas, precision tools with native Rust performance</p>
        </BentoCard>
        <BentoCard>
          <h3>Motion & Prototyping</h3>
          <p>Timeline-based animation, Smart Animate, prototype interactions with code export</p>
        </BentoCard>
        <BentoCard>
          <h3>Export & Code Generation</h3>
          <p>SVG, React/Tailwind, Flutter, SwiftUI — export your designs to production code</p>
        </BentoCard>
        <BentoCard>
          <h3>Vector & Typography</h3>
          <p>Complete vector tools, text engine, color management with CMYK support</p>
        </BentoCard>
      </BentoGrid>
    </div>
  </section>

  <section class="story-section">
    <div class="container-custom">
      <div class="story-content">
        <h2 class="section-title">Built independently</h2>
        <p class="story-text">
          Strata is built by one designer-developer, committed to transparent development, honest limitations, and community input. No VC pressure, no feature creep, just focused tools for designers.
        </p>
        <Button href="/about" variant="secondary">Read the story</Button>
      </div>
    </div>
  </section>

  <section class="download-preview">
    <div class="container-custom">
      <h2 class="section-title">Download Strata</h2>
      <p class="download-subtitle">Free forever. AGPL-3.0-or-later licensed. Your designs stay on your machine.</p>
      <Button href="/download" variant="primary">Download Now</Button>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-surface-sunken) 0%, var(--color-surface-app) 100%);
    padding: 6rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .hero-content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: var(--color-text-primary);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }
  
  .hero-ctas {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 1.5rem;
  }
  
  .hero-platforms {
    font-size: 0.875rem;
    color: var(--color-neutral-500);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .features-preview {
    padding: 5rem 0;
  }
  
  .section-title {
    font-size: 2.25rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 3rem;
    color: var(--color-text-primary);
  }

  .story-section {
    background: var(--color-surface-sunken);
    color: var(--color-text-primary);
    padding: 5rem 0;
  }

  .story-section .section-title {
    color: var(--color-text-primary);
  }

  .story-content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .story-text {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: 2rem;
    color: var(--color-text-secondary);
  }

  .download-preview {
    padding: 5rem 0;
    text-align: center;
  }

  .download-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }
  
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }
    
    .hero-subtitle {
      font-size: 1rem;
    }
    
    .hero-ctas {
      flex-direction: column;
    }
    
    .section-title {
      font-size: 1.75rem;
    }
  }
</style>
