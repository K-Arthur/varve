---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Strata - Local-first, cross-platform design suite">
  <section class="hero">
    <div class="container-custom">
      <div class="hero-content">
        <h1 class="hero-title">
          Local-first, cross-platform design suite
        </h1>
        <p class="hero-subtitle">
          Native Rust performance. No cloud lock-in. No subscription.
        </p>
        <div class="hero-ctas">
          <a href="/download" class="btn-primary">
            Download for Your Platform
          </a>
          <a href="/product" class="btn-secondary">
            Learn More
          </a>
        </div>
        <p class="hero-platforms">
          Linux • macOS • Windows
        </p>
      </div>
    </div>
  </section>

  <section class="features-preview">
    <div class="container-custom">
      <h2 class="section-title">Built for serious design work</h2>
      <div class="features-grid">
        <div class="feature-card">
          <h3>Canvas & Rendering</h3>
          <p>86fps IR-replay rendering, infinite canvas, precision tools with native Rust performance</p>
        </div>
        <div class="feature-card">
          <h3>Motion & Prototyping</h3>
          <p>Timeline-based animation, Smart Animate, prototype interactions with code export</p>
        </div>
        <div class="feature-card">
          <h3>Export & Code Generation</h3>
          <p>SVG, React/Tailwind, Flutter, SwiftUI — export your designs to production code</p>
        </div>
        <div class="feature-card">
          <h3>Vector & Typography</h3>
          <p>Complete vector tools, text engine, color management with CMYK support</p>
        </div>
      </div>
    </div>
  </section>

  <section class="story-section">
    <div class="container-custom">
      <div class="story-content">
        <h2 class="section-title">Built independently</h2>
        <p class="story-text">
          Strata is built by one designer-developer, committed to transparent development, honest limitations, and community input. No VC pressure, no feature creep, just focused tools for designers.
        </p>
        <a href="/about" class="btn-secondary">Read the story</a>
      </div>
    </div>
  </section>

  <section class="download-preview">
    <div class="container-custom">
      <h2 class="section-title">Download Strata</h2>
      <p class="download-subtitle">Free forever. AGPL-3.0-or-later licensed. Your designs stay on your machine.</p>
      <a href="/download" class="btn-primary">Download Now</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-teal-50) 0%, white 100%);
    padding: 6rem 0;
    border-bottom: 1px solid var(--color-neutral-200);
  }
  
  .hero-content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }
  
  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: var(--color-neutral-900);
  }
  
  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-neutral-600);
    margin-bottom: 2rem;
  }
  
  .hero-ctas {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 1.5rem;
  }
  
  .hero-platforms {
    font-size: 0.875rem;
    color: var(--color-neutral-500);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .features-preview {
    padding: 5rem 0;
  }
  
  .section-title {
    font-size: 2.25rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 3rem;
    color: var(--color-neutral-900);
  }
  
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }
  
  .feature-card {
    background: white;
    border: 1px solid var(--color-neutral-200);
    border-radius: 0.75rem;
    padding: 2rem;
    transition: all 0.2s;
  }
  
  .feature-card:hover {
    border-color: var(--color-teal-400);
    transform: translateY(-2px);
  }
  
  .feature-card h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--color-neutral-900);
  }
  
  .feature-card p {
    color: var(--color-neutral-600);
    line-height: 1.6;
  }
  
  .story-section {
    background: var(--color-neutral-900);
    color: white;
    padding: 5rem 0;
  }
  
  .story-section .section-title {
    color: white;
  }
  
  .story-content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  
  .story-text {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: 2rem;
    color: var(--color-neutral-200);
  }
  
  .story-section .btn-secondary {
    background: transparent;
    border-color: var(--color-teal-400);
    color: var(--color-teal-400);
  }
  
  .story-section .btn-secondary:hover {
    background: var(--color-teal-600);
    border-color: var(--color-teal-600);
    color: white;
  }
  
  .download-preview {
    padding: 5rem 0;
    text-align: center;
  }
  
  .download-subtitle {
    font-size: 1.125rem;
    color: var(--color-neutral-600);
    margin-bottom: 2rem;
  }
  
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }
    
    .hero-subtitle {
      font-size: 1rem;
    }
    
    .hero-ctas {
      flex-direction: column;
    }
    
    .section-title {
      font-size: 1.75rem;
    }
  }
</style>
