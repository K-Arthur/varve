---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import BentoGrid from '../components/BentoGrid.astro';
import BentoCard from '../components/BentoCard.astro';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Varve',
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Linux, macOS, Windows',
  description:
    'Varve is a local-first design suite for vector, layout, typography, motion, prototyping, and print production. Free and source-available under FSL-1.1-MIT.',
  softwareVersion: 'beta',
  license: 'FSL-1.1-MIT',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<Layout
  title="Varve — free design suite for vector, layout, motion, and print"
  description="Varve is a free, local-first design suite for vector, layout, typography, motion, prototyping, and print — one application on Linux, macOS, and Windows. No subscription, no account, no uploads."
  structuredData={softwareSchema}
>
  <section class="hero">
    <div class="container-custom">
      <div class="hero-content">
        <h1 class="hero-title">
          Design across disciplines.<br/>One canvas.
        </h1>
        <p class="hero-subtitle">
          Varve is a free, local-first design suite that keeps vector, layout, typography, motion, prototyping, and print production in one application — on Linux, macOS, and Windows. No subscription, no account, no uploads: your work stays on your machine.
        </p>
        <div class="hero-ctas">
          <Button href="/download" variant="primary">
            Download the beta
          </Button>
          <Button href="/product" variant="secondary">
            What is Varve?
          </Button>
        </div>
        <p class="hero-platforms">
          Linux • macOS • Windows &nbsp;·&nbsp; Free and source-available (FSL-1.1-MIT)
        </p>
      </div>
    </div>
  </section>

  <section class="features-preview">
    <div class="container-custom">
      <h2 class="section-title">More creative work, fewer applications</h2>
      <BentoGrid cols={2}>
        <BentoCard>
          <h3>Vector and illustration</h3>
          <p>Shapes, bezier paths with handles, boolean operations, layers, groups, and precision snapping — backed by a native Rust geometry engine.</p>
        </BentoCard>
        <BentoCard>
          <h3>Layout and typography</h3>
          <p>Flex and auto-layout, text rendering with OpenType features and variable fonts, frames with constraints, and multi-page documents.</p>
        </BentoCard>
        <BentoCard>
          <h3>Motion and prototyping</h3>
          <p>Timeline-based animation with keyframes and easing, prototype interactions with triggers and transitions, export to CSS, Lottie, and video.</p>
        </BentoCard>
        <BentoCard>
          <h3>Color, effects, and print</h3>
          <p>RGB and CMYK color management, blend modes, shadows, blur, adjustment layers, halftone screening, and PDF/X export with crop marks.</p>
        </BentoCard>
      </BentoGrid>
    </div>
  </section>

  <section class="workflow-section">
    <div class="container-custom">
      <div class="workflow-content">
        <h2 class="section-title">Designed for connected workflows</h2>
        <p class="workflow-text">
          Varve is built around the idea that creative work does not always fit neatly into one category. A poster needs vector shapes, typography, and print output. A social media set needs layout, animation, and export. A UI needs components, prototyping, and developer handoff.
        </p>
        <p class="workflow-text">
          Instead of switching between separate applications for each task, Varve keeps your work in one environment with one document model, one layer system, and one set of shortcuts.
        </p>
      </div>
    </div>
  </section>

  <section class="story-section">
    <div class="container-custom">
      <div class="story-content">
        <h2 class="section-title">Built in the open</h2>
        <p class="story-text">
          Varve is built by one designer-developer with input from its community. Development is transparent — architecture decisions, known limitations, and progress are documented publicly. No VC pressure, no hidden agenda, just focused tools shaped by the people who use them.
        </p>
        <Button href="/about" variant="secondary">Read the story</Button>
      </div>
    </div>
  </section>

  <section class="download-preview">
    <div class="container-custom">
      <h2 class="section-title">Try Varve beta</h2>
      <p class="download-subtitle">
        Varve is in active beta. Core features are functional, but you may encounter rough edges. Recommended for testing, exploration, and influencing development — not yet for critical production work without backups.
      </p>
      <Button href="/download" variant="primary">Download the beta</Button>
      <p class="download-note">
        Free and source-available under FSL-1.1-MIT. Your designs stay on your machine.
      </p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, var(--surface-sunken) 0%, var(--surface-page) 100%);
    padding: 6rem 0;
    border-bottom: 1px solid var(--border-default);
  }

  .hero-content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }
  
  .hero-ctas {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 1.5rem;
  }
  
  .hero-platforms {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .features-preview {
    padding: 5rem 0;
  }
  
  .section-title {
    font-size: 2.25rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 3rem;
    color: var(--text-primary);
  }

  .workflow-section {
    padding: 5rem 0;
  }

  .workflow-content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .workflow-text {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
  }

  .story-section {
    background: var(--surface-sunken);
    color: var(--text-primary);
    padding: 5rem 0;
  }

  .story-section .section-title {
    color: var(--text-primary);
  }

  .story-content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .story-text {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: 2rem;
    color: var(--text-secondary);
  }

  .download-preview {
    padding: 5rem 0;
    text-align: center;
  }

  .download-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .download-note {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-top: 1rem;
  }
  
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }
    
    .hero-subtitle {
      font-size: 1rem;
    }
    
    .hero-ctas {
      flex-direction: column;
    }
    
    .section-title {
      font-size: 1.75rem;
    }
  }
</style>
