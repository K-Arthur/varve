---
import Layout from '../layouts/Layout.astro';
import { sitePath } from '../lib/siteUrl';
import StatusPill from '../components/StatusPill.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
---

<Layout title="Features" description="Explore what Varve can do today — vector design, raster editing, layout, typography, motion, prototyping, color management, and code export.">
  <div class="container-custom">
    <div class="features-page">
      <h1 class="page-hero-title">Features</h1>
      <p class="page-hero-sub">
        Vector, layout, typography, motion, and print — all in one application. Honest status for each area. Varve is in beta — features are functional but evolving.
      </p>

      <div class="features-grid">
        <a href={sitePath('/features/background-removal')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Background Removal</h2>
          <p>Fast, Auto, and High quality subject cutouts that keep the mask local and undoable</p>
        </a>

        <a href={sitePath('/features/image-enhancement')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16.5 9 11l3.5 3.5L16 11l4 5.5"/><path d="M5 5h14v14H5z" opacity=".45"/><path d="M8 8h.01"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Image Enhance</h2>
          <p>Denoise, upscale, or combine both through one local-first workflow with explicit quality boundaries</p>
        </a>

        <a href={sitePath('/features/depth-aware-effects')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="7"/><path d="M12 5a7 7 0 0 0 0 14" opacity=".45"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Depth-aware effects</h2>
          <p>Non-destructive Depth Blur with focus picking, depth previews, and depth-range masks from a reusable local DepthMap</p>
        </a>

        <a href={sitePath('/features/asset-search')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/><path d="M7.5 10.5h6" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Local Asset Search</h2>
          <p>Find assets by filename, recognized text, tags, and a measured path toward visual description</p>
        </a>

        <a href={sitePath('/features/object-selection')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5h14v14H5z" opacity="0.45"/><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Object Selection</h2>
          <p>Select an object locally, refine the mask with include/exclude prompts, and reuse it across edits without destructive deletion</p>
        </a>

        <a href={sitePath('/features/visual-awareness')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2" opacity="0.6"/></svg>
          </div>
          <StatusPill status="planned" label="In development" class="feature-card-pill" />
          <h2>Visual Awareness</h2>
          <p>Task-specific visual assistance for composition, editable masks, effects, and future anchors</p>
        </a>

        <a href={sitePath('/features/canvas')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="1"/><path d="M3 9h18M9 21V9" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Canvas & Rendering</h2>
          <p>Infinite canvas, viewport culling, sticky snap, rulers, guides, grid overlays, multi-page documents</p>
        </a>

        <a href={sitePath('/features/vector-tools')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20 L14 10"/><circle cx="17" cy="7" r="2.5"/><circle cx="6" cy="18" r="2"/><path d="M17 9.5 L19 7.5" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Vector Tools</h2>
          <p>Shapes, pen and pencil with bezier handles, boolean operations, node editing, layers, groups, frames</p>
        </a>

        <a href={sitePath('/features/typography')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19 L9.5 6 H14.5 L19 19"/><path d="M8 14.5h8" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Typography</h2>
          <p>Multi-line text, OpenType features, variable fonts, text-on-path, inline editing, CJK line breaking</p>
        </a>

        <a href={sitePath('/features/color-effects')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" opacity="0.5"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Color & Effects</h2>
          <p>Native CMYK document colors, precision-aware working values, ICC profiles, effects, adjustments, and halftone</p>
        </a>

        <a href={sitePath('/features/print-production')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Print Production</h2>
          <p>CMYK via ICC profiles, PDF/X-1a and PDF/X-4 export, crop and registration marks, bleed guides, and preflight checks</p>
        </a>

        <a href={sitePath('/features/asset-similarity')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5M7 10h6M10 7v6" opacity="0.6"/></svg>
          </div>
          <StatusPill status="experimental" class="feature-card-pill" />
          <h2>Asset Similarity</h2>
          <p>Find visually related images and near-duplicate variants locally in an open document</p>
        </a>

        <a href={sitePath('/features/motion')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17V7l5 6V7l5 6V7l5 6V7" opacity="0.6"/><circle cx="20.5" cy="17" r="1.5" fill="currentColor" stroke="none"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Motion & Prototyping</h2>
          <p>Timeline animation, keyframes, easing, Smart Animate, prototype interactions, CSS/Lottie/video export</p>
        </a>

        <a href={sitePath('/features/export')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Export & Code Generation</h2>
          <p>SVG, React/Tailwind, Flutter, SwiftUI, PDF with CMYK, PDF/X-1a and PDF/X-4, per-node export settings</p>
        </a>

        <a href={sitePath('/features/local-first')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18.5V8.7L12 4l8 4.7v9.8"/><path d="M8 20v-5h8v5M3 20h18" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Local-first Storage</h2>
          <p>Native document paths, portable project references, durable app data, and safe packaged-build storage</p>
        </a>

        <a href={sitePath('/features/workspaces')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Workspaces</h2>
          <p>Seven task-focused workspaces with per-mode panels, toolbar, inspector, and status bar customization</p>
        </a>
      </div>

      <ClosingCTA
        title="Explore Varve"
        accentWord="features."
        text="See what Varve can do for your design workflow."
      />
    </div>
  </div>
</Layout>

<style>
  .features-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 0;
  }
  
  .features-page .page-hero-title {
    margin-bottom: 0.75rem;
  }

  .features-page .page-hero-sub {
    margin-bottom: 2.5rem;
  }
  
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  
  .feature-card {
    position: relative;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 0.75rem;
    padding: 1.75rem;
    padding-top: 3.25rem;
    transition:
      transform var(--duration-fast) var(--ease-default),
      border-color var(--duration-fast) var(--ease-default),
      box-shadow var(--duration-fast) var(--ease-default);
    text-decoration: none;
    display: block;
  }

  /* Feature icon: a small colored tile with the design-tool glyph.
     Uses the brand strata colors in rotation: teal, sandstone, terracotta. */
  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.625rem;
    margin-bottom: 0.75rem;
    color: var(--accent-primary);
    background: var(--surface-accent-soft);
  }

  .feature-card:nth-child(2) .feature-icon {
    color: var(--brand-sandstone);
    background: color-mix(in oklab, var(--brand-sandstone) 12%, var(--surface-card));
  }

  .feature-card:nth-child(3) .feature-icon {
    color: var(--brand-terracotta);
    background: color-mix(in oklab, var(--brand-terracotta) 12%, var(--surface-card));
  }

  .feature-card:nth-child(4) .feature-icon {
    color: var(--brand-teal);
    background: color-mix(in oklab, var(--brand-teal) 12%, var(--surface-card));
  }

  .feature-card:nth-child(5) .feature-icon {
    color: var(--brand-sandstone);
    background: color-mix(in oklab, var(--brand-sandstone) 12%, var(--surface-card));
  }

  .feature-card:nth-child(6) .feature-icon {
    color: var(--brand-terracotta);
    background: color-mix(in oklab, var(--brand-terracotta) 12%, var(--surface-card));
  }

  @media (prefers-reduced-motion: no-preference) {
    .feature-card:hover {
      border-color: var(--border-accent);
      transform: translateY(-2px);
      box-shadow: var(--elevation-shadow-raised);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card:hover {
      border-color: var(--border-accent);
    }
  }

  .feature-card h2 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .feature-card p {
    color: var(--text-secondary);
    margin-bottom: 0;
    line-height: 1.6;
    font-size: 0.9375rem;
  }

  /* Position the StatusPill in the top-right corner of the card */
  :global(.feature-card-pill) {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }
</style>
