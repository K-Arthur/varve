---
import Layout from '../layouts/Layout.astro';
import { sitePath } from '../lib/siteUrl';
import StatusPill from '../components/StatusPill.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
---

<Layout title="Features - Varve" description="Explore what Varve can do today — vector design, raster editing, layout, typography, motion, prototyping, color management, and code export.">
  <div class="container-custom">
    <div class="features-page">
      <h1 class="page-hero-title">Features</h1>
      <p class="page-hero-sub">
        What Varve can do today, with honest status indicators for each area. Varve is in beta — features are functional but evolving.
      </p>

      <div class="features-grid">
        <a href={sitePath('/features/canvas')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="1"/><path d="M3 9h18M9 21V9" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Canvas & Rendering</h2>
          <p>Infinite canvas, viewport culling, sticky snap, rulers, guides, grid overlays, multi-page documents</p>
        </a>

        <a href={sitePath('/features/vector-tools')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20 L14 10"/><circle cx="17" cy="7" r="2.5"/><circle cx="6" cy="18" r="2"/><path d="M17 9.5 L19 7.5" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Vector Tools</h2>
          <p>Shapes, pen and pencil with bezier handles, boolean operations, node editing, layers, groups, frames</p>
        </a>

        <a href={sitePath('/features/typography')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19 L9.5 6 H14.5 L19 19"/><path d="M8 14.5h8" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Typography</h2>
          <p>Multi-line text, OpenType features, variable fonts, text-on-path, inline editing, CJK line breaking</p>
        </a>

        <a href={sitePath('/features/color-effects')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" opacity="0.5"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Color & Effects</h2>
          <p>Native CMYK document colors, precision-aware working values, ICC profiles, effects, adjustments, and halftone</p>
        </a>

        <a href={sitePath('/features/motion')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17V7l5 6V7l5 6V7l5 6V7" opacity="0.6"/><circle cx="20.5" cy="17" r="1.5" fill="currentColor" stroke="none"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Motion & Prototyping</h2>
          <p>Timeline animation, keyframes, easing, Smart Animate, prototype interactions, CSS/Lottie/video export</p>
        </a>

        <a href={sitePath('/features/export')} class="feature-card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Export & Code Generation</h2>
          <p>SVG, React/Tailwind, Flutter, SwiftUI, PDF with CMYK, PDF/X-1a and PDF/X-4, per-node export settings</p>
        </a>
      </div>

      <ClosingCTA
        title="Explore Varve"
        accentWord="features."
        text="See what Varve can do for your design workflow."
      />
    </div>
  </div>
</Layout>

<style>
  .features-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 0;
  }
  
  .features-page .page-hero-title {
    margin-bottom: 0.75rem;
  }

  .features-page .page-hero-sub {
    margin-bottom: 2.5rem;
  }
  
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  
  .feature-card {
    position: relative;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 0.75rem;
    padding: 1.75rem;
    padding-top: 3.25rem;
    transition:
      transform var(--duration-fast) var(--ease-default),
      border-color var(--duration-fast) var(--ease-default),
      box-shadow var(--duration-fast) var(--ease-default);
    text-decoration: none;
    display: block;
  }

  /* Feature icon: a small colored tile with the design-tool glyph.
     Uses the brand strata colors in rotation: teal, sandstone, terracotta. */
  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.625rem;
    margin-bottom: 0.75rem;
    color: var(--accent-primary);
    background: var(--surface-accent-soft);
  }

  .feature-card:nth-child(2) .feature-icon {
    color: var(--brand-sandstone);
    background: color-mix(in oklab, var(--brand-sandstone) 12%, var(--surface-card));
  }

  .feature-card:nth-child(3) .feature-icon {
    color: var(--brand-terracotta);
    background: color-mix(in oklab, var(--brand-terracotta) 12%, var(--surface-card));
  }

  .feature-card:nth-child(4) .feature-icon {
    color: var(--brand-teal);
    background: color-mix(in oklab, var(--brand-teal) 12%, var(--surface-card));
  }

  .feature-card:nth-child(5) .feature-icon {
    color: var(--brand-sandstone);
    background: color-mix(in oklab, var(--brand-sandstone) 12%, var(--surface-card));
  }

  .feature-card:nth-child(6) .feature-icon {
    color: var(--brand-terracotta);
    background: color-mix(in oklab, var(--brand-terracotta) 12%, var(--surface-card));
  }

  @media (prefers-reduced-motion: no-preference) {
    .feature-card:hover {
      border-color: var(--border-accent);
      transform: translateY(-2px);
      box-shadow: var(--elevation-shadow-raised);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card:hover {
      border-color: var(--border-accent);
    }
  }

  .feature-card h2 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .feature-card p {
    color: var(--text-secondary);
    margin-bottom: 0;
    line-height: 1.6;
    font-size: 0.9375rem;
  }

  /* Position the StatusPill in the top-right corner of the card */
  :global(.feature-card-pill) {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }
</style>
