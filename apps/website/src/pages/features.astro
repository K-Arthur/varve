---
import Layout from '../layouts/Layout.astro';
import { sitePath } from '../lib/siteUrl';
import StatusPill from '../components/StatusPill.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
---

<Layout title="Features" description="Explore what Varve can do today — vector design, raster editing, layout, typography, motion, prototyping, color management, and code export.">
  <div class="container-custom">
    <div class="features-page">
      <h1 class="page-hero-title">Features</h1>
      <p class="page-hero-sub">
        Vector, layout, typography, motion, and print — all in one application. Honest status for each area. Varve is in beta — features are functional but evolving.
      </p>

      <div class="features-grid site-card-grid">
        <a href={sitePath('/features/background-removal')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Background Removal</h2>
          <p>Fast, Auto, and High quality subject cutouts that keep the mask local and undoable</p>
        </a>

        <a href={sitePath('/features/generative-editing')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v14H4z" opacity=".45"/><path d="M7 12h4M9 10v4M15 9v6M13 12h4"/><circle cx="18" cy="7" r="2"/></svg>
          </div>
          <StatusPill status="experimental" label="Local preview" class="feature-card-pill" />
          <h2>Generative Editing</h2>
          <p>Paint a region to fill or remove it locally, review the result, and accept it as a new editable layer</p>
        </a>

        <a href={sitePath('/features/image-enhancement')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16.5 9 11l3.5 3.5L16 11l4 5.5"/><path d="M5 5h14v14H5z" opacity=".45"/><path d="M8 8h.01"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Image Enhance</h2>
          <p>Denoise, upscale, or combine both through one local-first workflow with explicit quality boundaries</p>
        </a>

        <a href={sitePath('/features/raw-hdr-photo')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v12H4z" opacity=".45"/><path d="M8 14 11 10l2.5 3 2-2.5L19 14"/><path d="M7 4v2M17 4v2"/></svg>
          </div>
          <StatusPill status="partial" label="Verified subset" class="feature-card-pill" />
          <h2>RAW &amp; HDR Photo</h2>
          <p>Develop supported DNG sensor data, merge reviewed brackets, and keep a truthful SDR rendition beside a float master</p>
        </a>

        <a href={sitePath('/features/colorization')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8" opacity=".35"/><path d="M12 4v16M4 12h16" opacity=".55"/><circle cx="8" cy="8" r="2"/><circle cx="16" cy="16" r="2"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Colorize &amp; Recolor</h2>
          <p>Tint grayscale work, constrain a palette, transfer a reference look, or review local photo colorization without overwriting the source</p>
        </a>

        <a href={sitePath('/features/image-treatments')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="7"/><path d="M5 12h14M12 5v14" opacity=".45"/><path d="M4 4l2 2M18 18l2 2"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Image Treatments</h2>
          <p>Non-destructive fine texture, local contrast, dehaze, vignette, grain, and highlight glow for images and rendered objects</p>
        </a>

        <a href={sitePath('/features/depth-aware-effects')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="7"/><path d="M12 5a7 7 0 0 0 0 14" opacity=".45"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Depth-aware effects</h2>
          <p>Reusable relative DepthMaps for non-destructive Depth Blur, sampled depth-range masks, localized adjustments, and offline refinement</p>
        </a>

        <a href={sitePath('/features/asset-search')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/><path d="M7.5 10.5h6" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Local Asset Search</h2>
          <p>Find assets by filename, recognized text, tags, and a measured path toward visual description</p>
        </a>

        <a href={sitePath('/features/object-selection')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5h14v14H5z" opacity="0.45"/><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Object Selection</h2>
          <p>Select an object locally with prompts, or start from a one-click foreground estimate and refine it into an editable mask</p>
        </a>

        <a href={sitePath('/features/mockups')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="3" width="12" height="18" rx="2"/><path d="M9 6h6" opacity="0.6"/><path d="M8 10h8v7H8z" opacity="0.45"/><circle cx="12" cy="19" r="0.5"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Mockups</h2>
          <p>Place live artwork on replaceable surfaces, author photo templates with clip and occluder masks, and export the composed presentation</p>
        </a>

        <a href={sitePath('/features/visual-awareness')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2" opacity="0.6"/></svg>
          </div>
          <StatusPill status="planned" label="In development" class="feature-card-pill" />
          <h2>Visual Awareness</h2>
          <p>Task-specific visual assistance for composition, editable masks, effects, and future anchors</p>
        </a>

        <a href={sitePath('/features/canvas')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="1"/><path d="M3 9h18M9 21V9" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Canvas & Rendering</h2>
          <p>Infinite canvas, viewport culling, sticky snap, rulers, guides, grid overlays, multi-page documents</p>
        </a>

        <a href={sitePath('/features/retouching')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17c3-6 6-9 8-9s5 3 8 9"/><path d="M4 12c3-4 6-6 8-6s5 2 8 6" opacity=".5"/><circle cx="12" cy="15" r="2.5"/><path d="M19 5.5v3M17.5 7h3" opacity=".7"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Frequency Separation &amp; Liquify</h2>
          <p>Split tone from texture for independent retouching, and reshape raster content with a re-editable, non-destructive deformation field</p>
        </a>

        <a href={sitePath('/features/precision-editing')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h10M4 18h16"/><path d="M17 9v6M14 12h6" opacity=".6"/><circle cx="17" cy="6" r="2"/><circle cx="17" cy="18" r="2"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Precision Editing</h2>
          <p>Exact nudges, scoped snap help, explicit alignment references, and predictable spacing modes</p>
        </a>

        <a href={sitePath('/features/auto-layout')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3" opacity=".35"/><rect x="6" y="6" width="5" height="12" rx="1"/><rect x="14" y="8" width="4" height="8" rx="1"/><path d="M12.5 4v16" stroke-dasharray="1.5 2" opacity=".65"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Auto Layout</h2>
          <p>Responsive stacks and grids with literal percentages, signed spacing, constraints, borders, and overlap order</p>
        </a>

        <a href={sitePath('/features/layers')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m4 7 8-4 8 4-8 4-8-4Z"/><path d="m4 12 8 4 8-4"/><path d="m4 17 8 4 8-4" opacity=".6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Layers & Drag and Drop</h2>
          <p>Reorder, reparent, and place multi-selections while preserving hierarchy, spacing, and one-step undo</p>
        </a>

        <a href={sitePath('/features/clipboard')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="16" rx="2"/><path d="M9 4.5V3h6v1.5M8 9h8M8 13h5M8 17h3" opacity="0.65"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Reliable Clipboard</h2>
          <p>Move editable layers, images, SVG, text, and their supported dependencies without losing the document context</p>
        </a>

        <a href={sitePath('/features/vector-tools')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20 L14 10"/><circle cx="17" cy="7" r="2.5"/><circle cx="6" cy="18" r="2"/><path d="M17 9.5 L19 7.5" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Vector Tools</h2>
          <p>Shapes, pen and pencil with bezier handles, region-level Shape Builder operations, booleans, node editing, layers, groups, frames</p>
        </a>

        <a href={sitePath('/features/strokes')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17 10 5l4 8 2-4 4 8"/><path d="M4 20h16" opacity=".55"/><circle cx="10" cy="5" r="1.4" fill="currentColor" stroke="none"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Stroke System</h2>
          <p>Editable outlines for shapes, paths, text, and images with gradients, alignment, dashes, markers, and pressure-aware paths</p>
        </a>

        <a href={sitePath('/features/typography')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19 L9.5 6 H14.5 L19 19"/><path d="M8 14.5h8" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Typography</h2>
          <p>Multi-line text, OpenType features, variable fonts, text-on-path, inline editing, CJK line breaking</p>
        </a>

        <a href={sitePath('/features/comic-lettering')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5h-5l-3.5 4v-4h-2.5A2.5 2.5 0 0 1 4 13.5Z"/><path d="M8 8h8M8 11h5" opacity=".6"/></svg>
          </div>
          <StatusPill status="partial" label="Built foundation" class="feature-card-pill" />
          <h2>Comic Lettering</h2>
          <p>Editable balloons, tails, caption styles, sound-effect text, and overflow-aware lettering for comic and webtoon pages</p>
        </a>

        <a href={sitePath('/features/color-effects')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" opacity="0.5"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Color & Effects</h2>
          <p>Native CMYK document colors, precision-aware working values, ICC profiles, effects, adjustments, and halftone</p>
        </a>

        <a href={sitePath('/features/layer-effects')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10"/><circle cx="18" cy="17" r="2"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Layer Effects</h2>
          <p>Alpha-aware shadows, blur, glow, glass, and meaningful stage-aware stacking for editable layers</p>
        </a>

        <a href={sitePath('/features/effect-studio')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h6M7 16h3"/><circle cx="17" cy="15" r="2"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Effect Studio</h2>
          <p>Browse, compare, tune, and apply curated editable treatments without flattening the source</p>
        </a>

        <a href={sitePath('/features/shader-effects')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="12" rx="2"/><path d="M7 11c1.5-3 3-3 4.5 0s3 3 4.5 0" opacity=".6"/><path d="M9 20h6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Shader Effects</h2>
          <p>Print screens, optical bloom, analog signal, refracted light, and palette treatments with verified software fallback</p>
        </a>

        <a href={sitePath('/features/gradient-maps')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18V6M4 18h16"/><path d="M6 15c2-7 4 2 6-4s4 1 6-4"/><circle cx="6" cy="15" r="1" fill="currentColor" stroke="none"/><circle cx="18" cy="7" r="1" fill="currentColor" stroke="none"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Gradient Maps</h2>
          <p>Scoped, non-destructive tonal grades with editable ramps, imported presets, alpha control, and deterministic preview</p>
        </a>

        <a href={sitePath('/features/print-production')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Print Production</h2>
          <p>CMYK via ICC profiles, PDF/X-1a and PDF/X-4 export, crop and registration marks, bleed guides, and preflight checks</p>
        </a>

        <a href={sitePath('/features/asset-similarity')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5M7 10h6M10 7v6" opacity="0.6"/></svg>
          </div>
          <StatusPill status="experimental" class="feature-card-pill" />
          <h2>Asset Similarity</h2>
          <p>Find visually related images and near-duplicate variants locally in an open document</p>
        </a>

        <a href={sitePath('/features/motion')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17V7l5 6V7l5 6V7l5 6V7" opacity="0.6"/><circle cx="20.5" cy="17" r="1.5" fill="currentColor" stroke="none"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Motion & Prototyping</h2>
          <p>Timeline animation, keyframes, easing, Smart Animate, prototype interactions, CSS/Lottie/video export</p>
        </a>

        <a href={sitePath('/features/export')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Export & Code Generation</h2>
          <p>SVG, React/Tailwind, Flutter, SwiftUI, PDF with CMYK, PDF/X-1a and PDF/X-4, per-node export settings</p>
        </a>

        <a href={sitePath('/features/local-first')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18.5V8.7L12 4l8 4.7v9.8"/><path d="M8 20v-5h8v5M3 20h18" opacity="0.6"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
          <h2>Local-first Storage</h2>
          <p>Native document paths, portable project references, durable app data, and safe packaged-build storage</p>
        </a>

        <a href={sitePath('/features/workspaces')} class="feature-card site-card site-card--interactive">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          </div>
          <StatusPill status="available" class="feature-card-pill" />
