  // Maps the manifest's arch identifiers to the two recommendation families.
  const ARCH_KEYS = {
    x86_64: 'x64',
    amd64: 'x64',
    x64: 'x64',
    aarch64: 'arm64',
    arm64: 'arm64',
  } as Record<string, 'arm64' | 'x64'>;

  // The visitor's explicit choice, stored locally (this machine only — no
  // network, no tracking). It overrides the browser-based recommendation so
  // the recommendation is never a forced redirection.
  const CHOICE_KEY = 'varve:download:choice';
  interface Choice {
    platform?: string;
    arch?: 'arm64' | 'x64';
    dismissed?: boolean;
  }

  function readChoice(): Choice | null {
    try {
      const raw = localStorage.getItem(CHOICE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw) as Choice;
      return parsed && typeof parsed === 'object' ? parsed : null;
    } catch {
      return null;
    }
  }

  function writeChoice(choice: Choice) {
    try {
      localStorage.setItem(CHOICE_KEY, JSON.stringify(choice));
    } catch {
      // Storage unavailable (private mode, disabled) — the recommendation
      // still works for this visit; it just is not persisted.
    }
  }

  const detection = detect({
    userAgent: navigator.userAgent,
    maxTouchPoints: navigator.maxTouchPoints,
    screenWidth: window.screen.width,
    screenHeight: window.screen.height,
  });

  const mobileNotice = document.getElementById('mobile-download-notice');
  if (mobileNotice && detection.mobile) {
    mobileNotice.hidden = false;
  }

  const platformTabs = document.querySelectorAll<HTMLButtonElement>('.platform-tab');
  const platformSections = document.querySelectorAll<HTMLElement>('.platform-section');
  const banner = document.getElementById('detection-banner');

  function activatePlatform(tab: HTMLButtonElement) {
    const platform = tab.getAttribute('data-platform');
    platformTabs.forEach(function (t) {
      const active = t === tab;
      t.classList.toggle('active', active);
      t.setAttribute('aria-selected', String(active));
      t.tabIndex = active ? 0 : -1;
    });
    platformSections.forEach(function (section) {
      const active = section.id === 'platform-' + platform;
      section.classList.toggle('active', active);
    });
  }

  platformTabs.forEach(function (tab) {
    // A click on a platform tab is an explicit choice: remember it (local
    // only) so the recommendation follows the visitor, not the other way.
    tab.addEventListener('click', function () {
      writeChoice({ platform: tab.getAttribute('data-platform') ?? undefined });
    });

    // Arrow-key / Home / End navigation between tabs, per the tablist pattern.
    tab.addEventListener('keydown', function (event) {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight' && event.key !== 'Home' && event.key !== 'End') {
        return;
      }
      event.preventDefault();
      const index = Array.prototype.indexOf.call(platformTabs, tab);
      let next;
      if (event.key === 'Home') next = platformTabs[0];
      else if (event.key === 'End') next = platformTabs[platformTabs.length - 1];
      else if (event.key === 'ArrowLeft') next = platformTabs[(index - 1 + platformTabs.length) % platformTabs.length];
      else next = platformTabs[(index + 1) % platformTabs.length];
      activatePlatform(next);
      next.focus();
    });
  });

  // "Checksums & requirements" links in the quick-download grid point at
  // `#platform-<id>`, but that section is `display:none` until its tab is
  // active — a plain anchor jump would land on a hidden element. Activate
  // the matching tab first, then let the native hash navigation (still
  // dispatched by the browser after this handler) scroll to it.
  document.querySelectorAll<HTMLAnchorElement>('[data-jump-platform]').forEach(function (link) {
    link.addEventListener('click', function () {
      const platform = link.getAttribute('data-jump-platform');
      const tab = document.querySelector('.platform-tab[data-platform="' + platform + '"]');
      if (tab instanceof HTMLButtonElement) activatePlatform(tab);
    });
  });

  // Copy-to-clipboard for checksums, with a polite announcement.
  const copyButtons = document.querySelectorAll<HTMLButtonElement>('.copy-button');
  const liveRegion = document.createElement('div');
  liveRegion.setAttribute('role', 'status');
  liveRegion.setAttribute('aria-live', 'polite');
  liveRegion.className = 'visually-hidden';
  document.body.appendChild(liveRegion);

  copyButtons.forEach(function (button) {
    button.addEventListener('click', async function () {
      const target = document.getElementById(button.getAttribute('data-copy-target') ?? '');
      if (!(target instanceof HTMLElement)) return;
      const text = target.textContent ?? '';
      const previous = button.textContent;
      const describedBy = button.getAttribute('aria-describedby') ?? '';
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      liveRegion.textContent = button.textContent + ' checksum for ' + describedBy.replace(/^checksum-label-/, '');
      setTimeout(function () {
        button.textContent = previous;
      }, 2000);
    });
  });

  // --- Recommendation -----------------------------------------------
  // Bots, mobile visitors and privacy-reduced UAs get no recommendation at
  // all: no banner, no chips, no tab preselect. Everyone else gets the
  // browser-based best guess unless they already made an explicit choice
  // (localStorage) — which always wins and is never forced back.
  let recommendation: DetectionResult | null = null;
  let showBanner = false;

  if (!detection.bot && !detection.mobile && !detection.reducedUa) {
    const choice = readChoice();
    if (choice?.dismissed) {
      recommendation = null;
    } else if (choice?.platform) {
      recommendation = {
        platform: choice.platform as DetectionResult['platform'],
        arch: choice.arch ?? 'unknown',
        macArchHint: 'none',
        bot: false,
        mobile: false,
        reducedUa: false,
      };
    } else if (detection.platform !== 'unknown') {
      recommendation = detection;
      showBanner = true;
    }
  }

  function clearRecommendationMarkers() {
    document.querySelectorAll<HTMLElement>('.recommend-chip, .arch-chip').forEach(function (chip) {
      chip.hidden = true;
    });
    document.querySelectorAll('.quick-architecture.recommended-arch').forEach(function (row) {
      row.classList.remove('recommended-arch');
    });
  }

  function applyRecommendation() {
    if (!recommendation || recommendation.platform === 'unknown') return;

    const tab = document.querySelector('.platform-tab[data-platform="' + recommendation.platform + '"]');
    if (tab instanceof HTMLButtonElement) activatePlatform(tab);

    const column = document.querySelector(
      '.quick-download-col[data-platform-col="' + recommendation.platform + '"]',
    );
    if (!column) return;

    const platformChip = column.querySelector<HTMLElement>('.recommend-chip');
    if (platformChip) platformChip.hidden = false;

    const archKey = recommendation.arch;
    if (archKey !== 'unknown') {
      const rows = Array.from(column.querySelectorAll<HTMLElement>('.quick-architecture'));
      const keys = rows.map((row) => row.getAttribute('data-arch') ?? '');
      const ordered = orderArchitectures(keys, archKey);
      if (ordered.join() !== keys.join()) {
        const orderMap = new Map(rows.map((row, index) => [row, ordered.indexOf(keys[index])]));
        rows
          .slice()
          .sort((a, b) => (orderMap.get(a) ?? 99) - (orderMap.get(b) ?? 99))
          .forEach((row) => column.appendChild(row));
      }
      rows.forEach(function (row) {
        const rowArch = ARCH_KEYS[row.getAttribute('data-arch') ?? ''] ?? 'unknown';
        row.classList.toggle('recommended-arch', rowArch === archKey);
        const chip = row.querySelector<HTMLElement>('.arch-chip');
        if (chip) chip.hidden = rowArch !== archKey;
      });
    }

    if (showBanner && banner) {
      const copy = recommendationCopy(recommendation);
      if (copy) {
        banner.style.display = 'block';
        banner.innerHTML =
          copy +
          ' <a href="#choose-platform" data-dismiss-recommend>Choose another platform</a>.';
      }
    }
  }

  // The dismiss link is injected into the banner after this script runs, so
  // the handler is delegated from the document rather than attached at eval.
  document.addEventListener('click', function (event) {
    const target = (event.target as Element | null)?.closest?.('[data-dismiss-recommend]');
    if (!target) return;
    writeChoice({ dismissed: true });
    if (banner) banner.style.display = 'none';
    clearRecommendationMarkers();
  });

  // Clicking a quick-download button records the platform+architecture
  // choice, so the next visit recommends exactly what this visitor chose.
  document.querySelectorAll<HTMLAnchorElement>('.quick-download-btn, .quick-download-alts a').forEach(function (link) {
    link.addEventListener('click', function () {
      const column = link.closest<HTMLElement>('.quick-download-col');
      const row = link.closest<HTMLElement>('.quick-architecture');
      const platform = column?.getAttribute('data-platform-col') ?? undefined;
      const arch = row ? ARCH_KEYS[row.getAttribute('data-arch') ?? ''] ?? undefined : undefined;
      writeChoice({ platform, arch });
    });
  });

  applyRecommendation();
</script>
