---
import release from '../data/release-manifest.json';
import Layout from '../layouts/Layout.astro';

// Every download control on this page is rendered from the generated release
// manifest (scripts/release/update-website-manifest.mjs). Nothing about
// versions, filenames, sizes or checksums is hand-typed here — the previous
// version of this page hardcoded "~200MB", version 0.0.0, and an AUR command
// for a package that does not exist, none of which any process kept true.
interface Artifact {
  filename: string;
  arch: string;
  format: string;
  label: string;
  size: string;
  sha256: string;
  url: string;
  title?: string;
  blurb?: string;
  caveat?: string;
  install?: string;
}

const PLATFORM_LABELS: Record<string, string> = {
  linux: 'Linux',
  macos: 'macOS',
  windows: 'Windows',
};

const REQUIREMENTS: Record<string, string[]> = {
  linux: [
    'OS: any x86-64 distribution with glibc 2.35 or newer (Ubuntu 22.04+, Fedora 38+, Arch, CachyOS)',
    'CPU: x86-64',
    'RAM: 4 GB minimum, 8 GB recommended',
    'Display: Wayland or X11',
    'Storage: 500 MB',
  ],
  macos: [
    'OS: macOS 13 Ventura or later',
    'CPU: Apple Silicon',
    'RAM: 4 GB minimum, 8 GB recommended',
    'Storage: 500 MB',
  ],
  windows: [
    'OS: Windows 10 (1809) or Windows 11',
    'CPU: x86-64',
    'RAM: 4 GB minimum, 8 GB recommended',
    'Storage: 500 MB',
  ],
};

// Resolved here rather than inline in the template: Astro's parser reads the
// `<` of a TypeScript generic inside a JSX expression as the start of a tag.
const platformMap = release.platforms as unknown as Record<string, Artifact[]>;
const available = ['linux', 'macos', 'windows']
  .filter((id) => (platformMap[id]?.length ?? 0) > 0)
  .map((id) => ({
    id,
    label: PLATFORM_LABELS[id] ?? id,
    artifacts: platformMap[id],
    requirements: REQUIREMENTS[id] ?? [],
  }));
const first = available[0]?.id;
---

<Layout
  title="Download Varve"
  description="Download Varve for Linux, macOS, or Windows. Source-available under FSL-1.1-MIT."
>
  <div class="container-custom">
    <div class="download-page">
      <h1>Download Varve</h1>
      <p class="download-intro">
        Source-available under FSL-1.1-MIT. Your designs stay on your machine.
      </p>

      {!release.hasRelease && (
        <div class="prerelease-notice">
          <strong>There is no public release yet.</strong>
          <p>
            Varve is still in development and no installer has been published. This page will
            list downloads, sizes and SHA-256 checksums as soon as the first release is tagged.
            Until then there is nothing to install — please do not download Varve-branded
            builds from anywhere else.
          </p>
          <p>
            <a href={release.releaseUrl} target="_blank" rel="noopener noreferrer">
              Watch the releases page
            </a> to be notified.
          </p>
        </div>
      )}

      {release.hasRelease && (
        <>
          <div class="prerelease-notice">
            <strong>
              Varve {release.version} is {release.prerelease ? 'an early preview' : 'a young release'}.
            </strong>
            <p>
              Expect bugs and incomplete tools. The <code>.strata</code> document format may still
              change in ways that break older files. <strong>Keep backups of anything you care
              about.</strong> See <a href="/support/known-issues">known issues</a> and
              <a href="/releases">release notes</a>.
            </p>
          </div>

          {!release.signed && (
            <div class="integrity-notice">
              <h3>These builds are not code-signed</h3>
              <p>
                Varve does not yet have code-signing certificates, so your operating system
                cannot verify who built these files. That is a statement about this project's
                budget, not about the files — but you cannot tell the difference without
                checking, so please check.
              </p>
              <p>
                <strong>Verify your download</strong> against the published checksum before
                running it:
              </p>
              <code class="code-block">sha256sum -c SHA256SUMS.txt</code>
              <p class="download-meta">
                macOS: <code>shasum -a 256 -c SHA256SUMS.txt</code> &middot; Windows PowerShell:
                <code>Get-FileHash .\Varve-*.exe -Algorithm SHA256</code>
              </p>
              <p>
                <a href={release.checksumsUrl} target="_blank" rel="noopener noreferrer">
                  Download SHA256SUMS.txt
                </a>
                &middot;
                <a href={release.sbomUrl} target="_blank" rel="noopener noreferrer">
                  Software bill of materials
                </a>
              </p>
            </div>
          )}

          <div id="detection-banner" class="detection-banner" style="display:none;"></div>

          <div class="platform-selector" id="choose-platform">
            {available.map((p) => (
              <button class:list={['platform-tab', { active: p.id === first }]} data-platform={p.id}>
                {p.label}
              </button>
            ))}
          </div>

          {available.map((p) => (
            <div class:list={['platform-section', { active: p.id === first }]} id={`platform-${p.id}`}>
              <h2>{p.label}</h2>

              <div class="download-options">
                {p.artifacts.map((artifact) => (
                  <div class:list={['download-option', { recommended: artifact.format === 'appimage' }]}>
                    <div class="option-header">
                      <h3>{artifact.title ?? artifact.label}</h3>
                      {artifact.format === 'appimage' && <span class="badge recommended">Recommended</span>}
                    </div>
                    <p>{artifact.blurb}</p>
                    <a href={artifact.url} class="btn-primary" download>
                      Download {artifact.size}
                    </a>
                    <p class="download-meta">
                      {artifact.filename} &middot; {artifact.arch}
                    </p>
                    {artifact.install && <code class="code-block">{artifact.install}</code>}
                    {artifact.caveat && <p class="download-meta"><strong>Note:</strong> {artifact.caveat}</p>}
                    <details>
                      <summary class="download-meta">SHA-256</summary>
                      <code class="code-block">{artifact.sha256}</code>
                    </details>
                  </div>
                ))}
              </div>

              <div class="system-requirements">
                <h3>System requirements</h3>
                <ul>
                  {p.requirements.map((requirement) => <li>{requirement}</li>)}
                </ul>
              </div>
            </div>
          ))}

          <div class="release-info">
            <h3>This release</h3>
            <p><strong>Version:</strong> {release.version}</p>
            <p><strong>Released:</strong> {release.releaseDate}</p>
            <p><strong>Channel:</strong> {release.prerelease ? 'Prerelease' : 'Stable'}</p>
            <p>
              <a href={release.releaseUrl} target="_blank" rel="noopener noreferrer">
                Full release notes on GitHub
              </a>
            </p>
          </div>
        </>
      )}
    </div>
  </div>
</Layout>


<style>
  .download-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 0;
  }
  
  .download-page h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--color-neutral-900);
  }
  
  .download-intro {
    font-size: 1.125rem;
    color: var(--color-neutral-600);
    margin-bottom: 3rem;
  }
  
  .platform-selector {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-neutral-200);
  }
  
  .platform-tab {
    padding: 1rem 2rem;
    background: none;
    border: none;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-neutral-600);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
  }
  
  .platform-tab:hover {
    color: var(--color-teal-600);
  }
  
  .platform-tab.active {
    color: var(--color-teal-600);
    border-bottom-color: var(--color-teal-600);
  }
  
  .platform-section {
    display: none;
  }
  
  .platform-section.active {
    display: block;
  }
  
  .platform-section h2 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-neutral-900);
  }
  
  .platform-note {
    color: var(--color-neutral-600);
    margin-bottom: 2rem;
  }
  
  .download-options {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  
  .download-option {
    background: white;
    border: 1px solid var(--color-neutral-200);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }
  
  .download-option.recommended {
    border-color: var(--color-teal-400);
    background: linear-gradient(135deg, var(--color-teal-50) 0%, white 100%);
  }
  
  .option-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  
  .option-header h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
  }
  
  .badge {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
  }
  
  .badge.recommended {
    background: var(--color-teal-600);
    color: white;
  }
  
  .download-option p {
    color: var(--color-neutral-600);
    margin-bottom: 1rem;
  }
  
  .download-meta {
    font-size: 0.875rem;
    color: var(--color-neutral-500);
    margin-top: 0.75rem;
  }
  
  .code-block {
    display: block;
    background: var(--color-neutral-900);
    color: var(--color-neutral-100);
    padding: 0.75rem 1rem;
    border-radius: 0.375rem;
    font-family: monospace;
    font-size: 0.875rem;
    margin: 1rem 0;
  }
  
  .system-requirements {
    background: var(--color-neutral-100);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  
  .system-requirements h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  
  .system-requirements ul {
    list-style: none;
  }
  
  .system-requirements li {
    margin-bottom: 0.5rem;
    color: var(--color-neutral-700);
  }
  
  .system-requirements strong {
    color: var(--color-neutral-900);
  }
  
  .release-info,
  .integrity-notice {
    background: white;
    border: 1px solid var(--color-neutral-200);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  
  .release-info h3,
  .integrity-notice h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  
  .release-info p {
    color: var(--color-neutral-600);
    margin-bottom: 0.5rem;
  }
  
  .integrity-notice p {
    color: var(--color-neutral-600);
  }

    .prerelease-notice {
    background: var(--color-terracotta-50);
    border: 1px solid var(--color-terracotta-200, #fecaca);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    font-size: 0.9375rem;
    color: var(--color-neutral-700);
    line-height: 1.6;
  }

  .prerelease-notice a {
    color: var(--color-teal-600);
    text-decoration: underline;
  }

  .detection-banner {
    background: var(--color-teal-50);
    border: 1px solid var(--color-teal-200);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    font-size: 0.9375rem;
    color: var(--color-neutral-700);
  }

  .detection-banner a {
    color: var(--color-teal-600);
    text-decoration: underline;
  }
</style>

<script>
  const PLATFORM_NAMES = {
    linux: 'Linux',
    macos: 'macOS',
    windows: 'Windows',
    unknown: 'your platform',
  };

  function detectPlatform() {
    const ua = navigator.userAgent;
    if (ua.includes('Linux') && !ua.includes('Mac')) return 'linux';
    if (ua.includes('Mac')) return 'macos';
    if (ua.includes('Windows')) return 'windows';
    return 'unknown';
  }

  function setActivePlatform(platform: string) {
    const tab = document.querySelector('.platform-tab[data-platform="' + platform + '"]');
    if (tab instanceof HTMLElement) tab.click();
  }

  function showDetectionBanner(platform: string) {
    const banner = document.getElementById('detection-banner');
    if (!banner) return;
    if (platform === 'unknown') return;
    banner.style.display = 'block';
    banner.innerHTML = 'We detected you&rsquo;re on <strong>' + PLATFORM_NAMES[platform as keyof typeof PLATFORM_NAMES] + '</strong>. The recommended download is shown below. <a href="#choose-platform" style="margin-left:0.5rem;">Choose another platform</a>.';
  }

  const platformTabs = document.querySelectorAll('.platform-tab');
  const platformSections = document.querySelectorAll('.platform-section');

  platformTabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      const platform = tab.getAttribute('data-platform');
      platformTabs.forEach(function(t) { t.classList.remove('active'); });
      tab.classList.add('active');
      platformSections.forEach(function(section) {
        section.classList.remove('active');
        if (section.id === 'platform-' + platform) {
          section.classList.add('active');
        }
      });
    });
  });

  const detected = detectPlatform();
  if (detected !== 'unknown') {
    setActivePlatform(detected);
    showDetectionBanner(detected);
  }
</script>
