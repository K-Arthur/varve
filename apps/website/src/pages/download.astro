---
import release from '../data/release-manifest.json';
import Layout from '../layouts/Layout.astro';
import { sitePath } from '../lib/siteUrl';
import { primaryFormatFor } from '../lib/download-detection';
import { PRODUCT_STATUS, type ProductStatusStage } from '@varve/shared';

// Channel label: the product stage (not just the GitHub prerelease flag)
// decides how a release is described — a "Stable"-tagged release of a product
// that is still in beta is described as Beta. The comparison goes through a
// union-typed parameter rather than a narrowed const: TypeScript 6 narrows
// `const x: ProductStatusStage = PRODUCT_STATUS.stage` to the current literal
// ('beta'), which makes the `=== 'stable'` comparison an unreachable-code
// error. A parameter keeps the union, so the comparison stays legal the day
// the stage becomes 'stable'.
function isStableStage(stage: ProductStatusStage): boolean {
  return stage === 'stable';
}
const channelLabel = release.prerelease ? 'Prerelease' : isStableStage(PRODUCT_STATUS.stage) ? 'Stable' : 'Beta';
const analyticsReleaseChannel = release.prerelease
  ? 'prerelease'
  : isStableStage(PRODUCT_STATUS.stage)
    ? 'stable'
    : 'beta';

function analyticsArchitecture(arch: string): 'x64' | 'arm64' | 'unknown' {
  const normalized = arch.toLowerCase();
  if (normalized.includes('arm') || normalized.includes('aarch')) return 'arm64';
  if (normalized.includes('x64') || normalized.includes('x86_64') || normalized.includes('amd64')) return 'x64';
  return 'unknown';
}

function architectureLabel(arch: string): string {
  const normalized = arch.toLowerCase();
  if (normalized.includes('arm') || normalized.includes('aarch')) return 'ARM64';
  if (normalized.includes('x64') || normalized.includes('x86_64') || normalized.includes('amd64')) {
    return 'x86_64';
  }
  return arch;
}

function analyticsPackageType(format: string): 'appimage' | 'deb' | 'rpm' | 'dmg' | 'nsis' | 'unknown' {
  return format === 'appimage' || format === 'deb' || format === 'rpm' || format === 'dmg' || format === 'nsis'
    ? format
    : 'unknown';
}

// Every download control on this page is rendered from the generated release
// manifest (scripts/release/update-website-manifest.mjs). Nothing about
// versions, filenames, sizes or checksums is hand-typed here — the previous
// version of this page hardcoded "~200MB", version 0.0.0, and an AUR command
// for a package that does not exist, none of which any process kept true.
interface Artifact {
  filename: string;
  arch: string;
  architectureLabel?: string;
  format: string;
  label: string;
  size: string;
  sha256: string;
  url: string;
  sbomUrl?: string;
  title?: string;
  blurb?: string;
  caveat?: string;
  install?: string;
}

const PLATFORM_LABELS: Record<string, string> = {
  linux: 'Linux',
  macos: 'macOS',
  windows: 'Windows',
};

// Per-platform trust copy, derived ONLY from the verification state recorded in
// the generated release manifest (release.signing). The same logic lives in
// scripts/release/website-release-data.mjs (platformTrustLabel) for tests; this
// page keeps a self-contained copy so the site build cannot depend on files
// outside the package.
interface PlatformSigning {
  windows?: { signed?: boolean; publisher?: string | null };
  macos?: { signed?: boolean; notarized?: boolean; stapled?: boolean; publisher?: string | null };
}

function platformTrustLabel(
  platform: string,
  signing: PlatformSigning,
): { badge: string; detail: string; signed: boolean } {
  if (platform === 'windows') {
    const s = signing.windows;
    if (s?.signed) {
      const publisher = s.publisher ? s.publisher.replace(/^CN=/, '') : 'the verified publisher';
      return {
        badge: 'Digitally signed',
        detail: `Signature verified: ${publisher}. SmartScreen may still warn until reputation builds.`,
        signed: true,
      };
    }
    return {
      badge: 'Not code-signed',
      detail:
        'Unsigned build: Windows will show "Windows protected your PC". Choose More info, then Run anyway.',
      signed: false,
    };
  }
  if (platform === 'macos') {
    const s = signing.macos;
    if (s?.signed && s.notarized && s.stapled) {
      return {
        badge: 'Developer ID signed and notarized',
        detail: 'Signed, notarized by Apple, and the notarization ticket is stapled.',
        signed: true,
      };
    }
    if (s?.signed && !s.notarized) {
      return {
        badge: 'Signed but NOT notarized',
        detail:
          'A signature exists but Apple notarization did not verify. Treat like an unsigned build: ' +
          'macOS will refuse to open it.',
        signed: false,
      };
    }
    return {
      badge: 'Not code-signed',
      detail:
        'Unsigned and not notarised: macOS will refuse to open it. Use System Settings > Privacy & Security > Open Anyway. Do not disable Gatekeeper.',
      signed: false,
    };
  }
  return {
    badge: 'SHA-256 + provenance',
    detail:
      'Verified by SHA-256 checksum, SBOM and GitHub build provenance. Linux has no platform code-signing certificate.',
    signed: false,
  };
}

const REQUIREMENTS: Record<string, string[]> = {
  linux: [
    'OS: any distribution with glibc 2.35 or newer (Ubuntu 22.04+, Fedora 38+, Arch, CachyOS)',
    'Libraries: WebKitGTK 4.1, GTK3, librsvg2, OpenSSL, fontconfig',
    'CPU: choose the download labeled x86_64 or ARM64 to match your Linux machine',
    'RAM: 4 GB minimum, 8 GB recommended',
    'Display: Wayland or X11',
    'Storage: 500 MB minimum free disk',
  ],
  macos: [
    'OS: macOS 13 Ventura or later',
    'CPU: Apple Silicon only. There is no Intel macOS build — the on-device AI depends on ONNX Runtime, whose upstream discontinued macOS Intel binaries; see the FAQ for details.',
    'RAM: 4 GB minimum, 8 GB recommended',
    'Storage: 500 MB minimum free disk',
  ],
  windows: [
    'OS: Windows 10 (version 1809) or Windows 11',
    'CPU: choose the download labeled x86_64 or ARM64 to match your Windows device',
    'RAM: 4 GB minimum, 8 GB recommended',
    'Storage: 500 MB minimum free disk',
  ],
};

// Resolved here rather than inline in the template: Astro's parser reads the
// `<` of a TypeScript generic inside a JSX expression as the start of a tag.
const platformMap = release.platforms as unknown as Record<string, Artifact[]>;
// `signing` may be absent from generated files produced before the signing
// block existed; treat it as empty, never as signed.
const signing = ((release as Record<string, unknown>).signing ?? {}) as PlatformSigning;
const available = ['linux', 'macos', 'windows']
  .filter((id) => (platformMap[id]?.length ?? 0) > 0)
  .map((id) => ({
    id,
    label: PLATFORM_LABELS[id] ?? id,
    artifacts: platformMap[id],
    requirements: REQUIREMENTS[id] ?? [],
    trust: platformTrustLabel(id, signing),
  }));
const first = available[0]?.id;

/**
 * Quick-download grid data: one primary artifact per architecture (the one
 * the detailed sections also mark "Recommended", selected by the shared
 * primaryFormatFor rule) plus the alternates, and a compact one-line
 * requirements summary. All derived from the same `available` data the
 * detailed tabbed sections below use — nothing here is a second, separately
 * maintained copy of the release data.
 */

// The single primary-format decision per platform, reused by the quick grid
// AND the detailed sections so the two can never disagree about which
// artifact is "the download".
const platformPrimaryFormat: Record<string, string> = {};
for (const p of available) {
  platformPrimaryFormat[p.id] = primaryFormatFor(
    p.id,
    p.artifacts.map((artifact) => artifact.format),
  );
}

const quickPlatforms = available.map((p) => {
  const primaryFormat = platformPrimaryFormat[p.id];
  const architectures = [...new Set(p.artifacts.map((artifact) => artifact.arch))].map((arch) => {
    const artifacts = p.artifacts.filter((artifact) => artifact.arch === arch);
    const primary = artifacts.find((artifact) => artifact.format === primaryFormat) ?? artifacts[0]!;
    return {
      arch,
      label: primary.architectureLabel ?? architectureLabel(arch),
      primary,
      alternates: artifacts.filter((artifact) => artifact !== primary),
    };
  });
  return {
    ...p,
    architectures,
  };
});

/** Install command of a platform's primary artifact, for the install steps. */
function primaryInstallCommand(p: (typeof available)[number]): string | null {
  const primaryFormat = platformPrimaryFormat[p.id];
  const primary =
    p.artifacts.find((artifact) => artifact.format === primaryFormat) ?? p.artifacts[0];
  return primary?.install ?? null;
}

const PLATFORM_ICON: Record<string, string> = {
  linux: 'terminal',
  macos: 'window',
  windows: 'grid',
};
// OS-level code signing applies to Windows and macOS only; Linux is
// integrity-verified (checksums + SBOM + provenance). "All signed" therefore
// means every OS-signable platform present in this release verifies.
const osSignable = available.filter((p) => p.id === 'windows' || p.id === 'macos');
const anySigned = osSignable.some((p) => p.trust.signed);
const allSigned = osSignable.length > 0 && osSignable.every((p) => p.trust.signed);
---

<Layout
  title="Download Varve"
  description="Download Varve beta for Linux, macOS, and Windows — free and source-available under FSL-1.1-MIT. SHA-256 checksums, SBOMs, and system requirements."
>
  <div class="container-custom">
    <div class="download-page">
      <h1>Download Varve</h1>
      <p class="download-intro">
        Source-available under FSL-1.1-MIT. Core editing is local-first; optional network
        features are disclosed and user-controlled.
      </p>

      <div class="mobile-download-notice" id="mobile-download-notice" hidden>
        <strong>Varve is a desktop application.</strong>
        <p>
          There are no mobile or tablet builds. Open this page on Linux, macOS, or Windows to
          choose a desktop download, or send the release link to a desktop device.
        </p>
      </div>

      {!release.hasRelease && (
        <div class="prerelease-notice">
          <strong>There is no public release yet.</strong>
          <p>
            Varve is still in development and no installer has been published. This page will
            list downloads, sizes and SHA-256 checksums when the first release is tagged. Until
            then there is nothing to install — please do not download Varve-branded builds from
            anywhere else.
          </p>
          <p>
            <a href={release.releaseUrl} target="_blank" rel="noopener noreferrer">
              Watch the releases page
            </a> to be notified.
          </p>
        </div>
      )}

      {release.hasRelease && release.integrity === 'unverified' && (
        <div class="integrity-notice">
          <h2>Release data is not verified</h2>
          <p>
            The published release does not carry the integrity files this page requires
            (release manifest, checksums and SBOMs). Download links are hidden until the
            release is complete, rather than pointing at files that may not be what they
            claim to be.
          </p>
          <p>
            <a href={release.releaseUrl} target="_blank" rel="noopener noreferrer">
              Check the release on GitHub
            </a>
          </p>
        </div>
      )}

      {release.hasRelease && release.integrity === 'verified' && (
        <>
          <div class="try-browser-banner">
            <p>
              <strong>Or try it right now</strong> — no download required.
              The full editor runs in your browser with the WASM engine.
            </p>
            <a
              href={sitePath('/try/')}
              class="try-browser-link"
              target="_blank"
              rel="noopener noreferrer"
              data-analytics-demo-launch
            >
              Try Varve in your browser
            </a>
          </div>

          <div class="quick-download">
            <div class="quick-download-header">
              <h2 class="quick-download-title">
                Varve <span class="version-badge">{release.version}</span>
                <span class="channel-badge">{channelLabel}</span>
              </h2>
              <p class="quick-download-sub">Pick your platform and architecture. Full checksums and requirements are below.</p>
            </div>

            <div class="quick-download-grid">
              {quickPlatforms.map((p) => (
                <div class="quick-download-col" data-platform-col={p.id}>
                  <div class="quick-download-platform">
                    <span class="platform-icon" data-icon={PLATFORM_ICON[p.id]} aria-hidden="true">
                      {PLATFORM_ICON[p.id] === 'terminal' && (
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                          <path d="m7 9 3 3-3 3"></path>
                          <path d="M13 15h4"></path>
                        </svg>
                      )}
                      {PLATFORM_ICON[p.id] === 'window' && (
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
                          <path d="M3 9h18"></path>
                        </svg>
                      )}
                      {PLATFORM_ICON[p.id] === 'grid' && (
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="3" y="3" width="8" height="8" rx="1"></rect>
                          <rect x="13" y="3" width="8" height="8" rx="1"></rect>
                          <rect x="3" y="13" width="8" height="8" rx="1"></rect>
                          <rect x="13" y="13" width="8" height="8" rx="1"></rect>
                        </svg>
                      )}
                    </span>
                    <span class="platform-name">{p.label}</span>
                    <span class="recommend-chip" hidden>Recommended</span>
                  </div>

                  {p.architectures.map((architecture) => (
                    <div class="quick-architecture" data-arch={architecture.arch}>
                      <div class="quick-architecture-label">
                        {architecture.label}
                        <span class="arch-chip" hidden>Recommended for you</span>
                      </div>
                      <a
                        href={architecture.primary.url}
                        class="btn-primary quick-download-btn"
                        download
                        data-analytics-download="true"
                        data-analytics-platform={p.id}
                        data-analytics-architecture={analyticsArchitecture(architecture.primary.arch)}
                        data-analytics-package-type={analyticsPackageType(architecture.primary.format)}
                        data-analytics-release={release.version}
                        data-analytics-release-channel={analyticsReleaseChannel}
                      >
                        Download {architecture.primary.size}
                      </a>
                      {architecture.alternates.length > 0 && (
                        <div class="quick-download-alts">
                          {architecture.alternates.map((alternate) => (
                            <a
                              href={alternate.url}
                              class="alt-link"
                              download
                              data-analytics-download="true"
                              data-analytics-platform={p.id}
                              data-analytics-architecture={analyticsArchitecture(alternate.arch)}
                              data-analytics-package-type={analyticsPackageType(alternate.format)}
                              data-analytics-release={release.version}
                              data-analytics-release-channel={analyticsReleaseChannel}
                            >
                              {alternate.title ?? alternate.label} &middot; {alternate.size}
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}

                  <a href={`#platform-${p.id}`} class="quick-download-detail-link" data-jump-platform={p.id}>
                    Checksums &amp; requirements &rsaquo;
                  </a>
                </div>
              ))}
            </div>
          </div>

          <div class="prerelease-notice">
            <strong>
              Varve {release.version} is {release.prerelease ? 'an early preview' : 'a young release'}.
            </strong>
            <p>
              Expect bugs and incomplete tools. The <code>.varve</code> document format may still
              change in ways that break older files. <strong>Keep backups of anything you care
              about.</strong> See <a href={sitePath('/support/known-issues')}>known issues</a> and
              <a href={sitePath('/releases')}>release notes</a>.
            </p>
          </div>

          {!allSigned && (
            <div class="integrity-notice">
              <h2>{anySigned ? 'Some builds are not code-signed' : 'These builds are not code-signed'}</h2>
              <p>
                {anySigned
                  ? 'Code-signing certificates are still being rolled out per platform. Where a platform is not signed, your operating system cannot verify who built that file — check the platform note below and verify your download.'
                  : 'Varve does not yet have code-signing certificates, so your operating system cannot verify who built these files. That is a statement about this project\'s budget, not about the files — but you cannot tell the difference without checking, so please check.'}
              </p>
              <p>
                <strong>Verify your download</strong> against the published checksum before
                running it:
              </p>
              <code class="code-block">sha256sum -c SHA256SUMS.txt</code>
              <p class="download-meta">
                macOS: <code>shasum -a 256 -c SHA256SUMS.txt</code> &middot; Windows PowerShell:
                <code>Get-FileHash .\Varve-*.exe -Algorithm SHA256</code>
              </p>
              <p>
                <a href={release.checksumsUrl} target="_blank" rel="noopener noreferrer">
                  Download SHA256SUMS.txt
                </a>
                &middot;
                <a href={release.sbomUrl} target="_blank" rel="noopener noreferrer">
                  Software bill of materials
                </a>
              </p>
              <p class="download-meta">
                A checksum detects corruption or a swapped file, but it does not prove who
                built the file — an attacker who can replace the download can replace the
                checksum too. Treat unsigned builds as unsigned, and prefer the GitHub release
                page as the download source.
              </p>
            </div>
          )}

          {allSigned && (
            <div class="integrity-notice">
              <h2>Signatures verified</h2>
              <p>
                Every platform in this release was verified after building: Windows installers
                carry a valid Authenticode signature, the macOS app is Developer ID signed,
                notarized by Apple, and stapled. Linux artifacts ship with SHA-256 checksums,
                an SBOM, and GitHub build provenance.
              </p>
              <p>
                <a href={release.checksumsUrl} target="_blank" rel="noopener noreferrer">
                  Download SHA256SUMS.txt
                </a>
                &middot;
                <a href={release.sbomUrl} target="_blank" rel="noopener noreferrer">
                  Software bill of materials
                </a>
              </p>
              <p class="download-meta">
                A signature identifies who built the file and proves it was not modified after
                signing. New signatures can still trigger a one-time OS warning until the
                publisher builds reputation — this is normal and does not mean the file is bad.
              </p>
            </div>
          )}

          <div id="detection-banner" class="detection-banner" style="display:none;"></div>

          <div
            class="platform-selector"
            id="choose-platform"
            role="tablist"
            aria-label="Choose an operating system"
          >
            {available.map((p) => (
              <button
                class:list={['platform-tab', { active: p.id === first }]}
                data-platform={p.id}
                id={`platform-tab-${p.id}`}
                role="tab"
                aria-selected={p.id === first}
                aria-controls={`platform-${p.id}`}
                tabindex={p.id === first ? 0 : -1}
              >
                {p.label}
              </button>
            ))}
          </div>

          {available.map((p) => (
            <div
              class:list={['platform-section', { active: p.id === first }]}
              id={`platform-${p.id}`}
              role="tabpanel"
              aria-labelledby={`platform-tab-${p.id}`}
              tabindex="0"
            >
              <h2>{p.label}</h2>

              <p class="download-meta trust-line">
                <span class="trust-badge">{p.trust.badge}</span> {p.trust.detail}
              </p>

              {p.id === 'linux' && (
                <div class="format-tradeoffs">
                  <h3>Which package should I choose?</h3>
                  <ul>
                    <li>
                      <strong>Debian package (.deb)</strong> — recommended for Debian, Ubuntu and
                      derivatives: installs system-wide and updates through apt, and pulls in the
                      WebKitGTK dependency automatically.
                    </li>
                    <li>
                      <strong>AppImage</strong> — a single portable file that runs on any
                      distribution without installing. It needs FUSE2 (or
                      <code>--appimage-extract-and-run</code>) and a system WebKitGTK library.
                    </li>
                    <li>
                      <strong>RPM package (.rpm)</strong> — for Fedora, RHEL and derivatives;
                      updates through dnf.
                    </li>
                  </ul>
                </div>
              )}

              <div class="download-options">
                {p.artifacts.map((artifact) => (
                  <div class:list={['download-option', { recommended: artifact.format === platformPrimaryFormat[p.id] }]}>
                    <div class="download-option-head">
                      {artifact.format === platformPrimaryFormat[p.id] && <span class="badge recommended">Recommended</span>}
                    </div>
                    <p>{artifact.blurb}</p>
                    <a
                      href={artifact.url}
                      class="btn-primary"
                      download
                      data-analytics-download="true"
                      data-analytics-platform={p.id}
                      data-analytics-architecture={analyticsArchitecture(artifact.arch)}
                      data-analytics-package-type={analyticsPackageType(artifact.format)}
                      data-analytics-release={release.version}
                      data-analytics-release-channel={analyticsReleaseChannel}
                    >
                      Download {artifact.size}
                    </a>
                    <p class="download-meta">
                      <span class="architecture-badge">{artifact.architectureLabel ?? architectureLabel(artifact.arch)}</span>{' '}
                      {artifact.filename}
                    </p>
                    {artifact.install && <code class="code-block">{artifact.install}</code>}
                    {artifact.caveat && <p class="download-meta"><strong>Note:</strong> {artifact.caveat}</p>}
                    <div class="checksum-block">
                      <p class="download-meta" id={`checksum-label-${artifact.filename}`}>
                        SHA-256 of {artifact.filename}
                      </p>
                      <div class="checksum-row">
                        <code class="code-block checksum-value" id={`checksum-${artifact.filename}`}>
                          {artifact.sha256}
                        </code>
                        <button
                          type="button"
                          class="copy-button"
                          data-copy-target={`checksum-${artifact.filename}`}
                          aria-describedby={`checksum-label-${artifact.filename}`}
                        >
                          Copy
                        </button>
                      </div>
                      {artifact.sbomUrl && (
                        <p class="download-meta">
                          <a href={artifact.sbomUrl} target="_blank" rel="noopener noreferrer">
                            Software bill of materials for this package
                          </a>
                        </p>
                      )}
                    </div>
                  </div>
                ))}
              </div>

              <div class="system-requirements">
                <h3>System requirements</h3>
                <ul>
                  {p.requirements.map((requirement) => <li>{requirement}</li>)}
                </ul>
              </div>
            </div>
          ))}

          <div class="release-info">
            <h3>This release</h3>
            <p><strong>Version:</strong> {release.version}</p>
            <p><strong>Released:</strong> {release.releaseDate}</p>
            <p><strong>Channel:</strong> {channelLabel}</p>
            <p>
              <a href={release.releaseUrl} target="_blank" rel="noopener noreferrer">
                Full release notes on GitHub
              </a>
            </p>
          </div>

          <div class="updates-info">
            <h2>Keeping Varve up to date</h2>
            {release.updater ? (
              <>
                <p>
                  Varve checks for updates only after you choose to allow it. On first launch you are
                  asked whether Varve may periodically check for newer versions; you can change or
                  revoke that choice at any time in Settings &rarr; Updates. Update checks send only
                  your current version, platform, architecture and channel to Varve's release
                  endpoint — no account, document data or device identifier.
                </p>
                <p>
                  Downloads are cryptographically verified against a signature embedded in the
                  installed app before anything is installed, and Varve never restarts over unsaved
                  design work.
                </p>
                <ul>
                  <li>
                    <strong>AppImage:</strong> self-updates in place when the file is in a writable
                    location. If the AppImage cannot be replaced (read-only folder, moved after
                    launch), Varve explains what happened and offers the manual update path.
                  </li>
                  <li>
                    <strong>Windows (NSIS):</strong> updates install through the installer with a
                    visible progress window, and installation happens only after your approval.
                    {!release.signed && ' Windows may show a SmartScreen warning for unsigned builds — choose More info, then Run anyway.'}
                  </li>
                  <li>
                    <strong>macOS:</strong> updates the installed app in your Applications folder.
                    If you are running Varve from the mounted DMG or a Gatekeeper-translocated copy,
                    move it into Applications first.
                    {!release.signed && ' macOS may block unsigned builds — use System Settings > Privacy & Security to allow it.'}
                  </li>
                  <li>
                    <strong>Debian / RPM packages:</strong> installed files are owned by your package
                    manager. Varve does not overwrite them; use your package manager to install newer
                    versions from the release page.
                  </li>
                </ul>
                <p class="download-meta">
                  Updates are cryptographically signed and verified. {!release.signed && 'Platform code-signing (Apple Developer ID, Windows Authenticode) is not yet provisioned — see the '}
                  <a href={sitePath('/docs/updates')}>Updates guide</a>
                  {!release.signed && ' for platform-specific details.'}
                </p>
              </>
            ) : (
              <>
                <p>
                  The current release does not include an in-app updater. To update, download the
                  latest installer from this page or from{' '}
                  <a href={release.releaseUrl} target="_blank" rel="noopener noreferrer">
                    GitHub Releases
                  </a>{' '}
                  and install it over your existing copy. Your documents and settings are preserved.
