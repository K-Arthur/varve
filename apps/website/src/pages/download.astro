</style>

<script>
  const PLATFORM_NAMES = {
    linux: 'Linux',
    macos: 'macOS',
    windows: 'Windows',
    unknown: 'your platform',
  };

  function detectPlatform() {
    const ua = navigator.userAgent;
    if (/android|iphone|ipad|ipod|mobile|tablet|webos|iemobile|opera mini/i.test(ua)) {
      return 'unknown';
    }
    if (ua.includes('Linux') && !ua.includes('Mac')) return 'linux';
    if (ua.includes('Mac')) return 'macos';
    if (ua.includes('Windows')) return 'windows';
    return 'unknown';
  }

  function detectArchitecture() {
    const ua = navigator.userAgent;
    if (/arm64|aarch64|armv8/i.test(ua)) return 'arm64';
    if (/x86_64|x64|win64|amd64/i.test(ua)) return 'x64';
    return 'unknown';
  }

  function isMobileOrTablet() {
    const ua = navigator.userAgent;
    const touchDevice = navigator.maxTouchPoints > 1;
    return /android|iphone|ipad|ipod|mobile|tablet|webos|iemobile|opera mini/i.test(ua)
      || (touchDevice && Math.min(screen.width, screen.height) < 1024);
  }

  function showDetectionBanner(platform: string, architecture: string) {
    const banner = document.getElementById('detection-banner');
    if (!banner) return;
    if (platform === 'unknown') return;
    const architectureHint = architecture === 'arm64'
      ? ' The browser hints that this may be an ARM64 device.'
      : architecture === 'x64'
        ? ' The browser hints that this may be an x86_64 device.'
        : '';
    banner.style.display = 'block';
    banner.innerHTML = 'We detected you&rsquo;re on <strong>' + PLATFORM_NAMES[platform as keyof typeof PLATFORM_NAMES] + '</strong>.' + architectureHint + ' Choose the architecture-labeled download below; this browser hint may be wrong. <a href="#choose-platform" style="margin-left:0.5rem;">Choose another platform</a>.';
  }

  const platformTabs = document.querySelectorAll<HTMLButtonElement>('.platform-tab');
  const platformSections = document.querySelectorAll<HTMLElement>('.platform-section');
  const mobileNotice = document.getElementById('mobile-download-notice');

  if (mobileNotice && isMobileOrTablet()) {
    mobileNotice.hidden = false;
  }

  function activatePlatform(tab: HTMLButtonElement) {
    const platform = tab.getAttribute('data-platform');
    platformTabs.forEach(function (t) {
      const active = t === tab;
      t.classList.toggle('active', active);
      t.setAttribute('aria-selected', String(active));
      t.tabIndex = active ? 0 : -1;
    });
    platformSections.forEach(function (section) {
      const active = section.id === 'platform-' + platform;
      section.classList.toggle('active', active);
    });
  }

  platformTabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      activatePlatform(tab);
    });

    // Arrow-key / Home / End navigation between tabs, per the tablist pattern.
    tab.addEventListener('keydown', function (event) {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight' && event.key !== 'Home' && event.key !== 'End') {
        return;
      }
      event.preventDefault();
      const index = Array.prototype.indexOf.call(platformTabs, tab);
      let next;
      if (event.key === 'Home') next = platformTabs[0];
      else if (event.key === 'End') next = platformTabs[platformTabs.length - 1];
      else if (event.key === 'ArrowLeft') next = platformTabs[(index - 1 + platformTabs.length) % platformTabs.length];
      else next = platformTabs[(index + 1) % platformTabs.length];
      activatePlatform(next);
      next.focus();
    });
  });

  // "Checksums & requirements" links in the quick-download grid point at
  // `#platform-<id>`, but that section is `display:none` until its tab is
  // active — a plain anchor jump would land on a hidden element. Activate
  // the matching tab first, then let the native hash navigation (still
  // dispatched by the browser after this handler) scroll to it.
  document.querySelectorAll<HTMLAnchorElement>('[data-jump-platform]').forEach(function (link) {
    link.addEventListener('click', function () {
      const platform = link.getAttribute('data-jump-platform');
      const tab = document.querySelector('.platform-tab[data-platform="' + platform + '"]');
      if (tab instanceof HTMLButtonElement) activatePlatform(tab);
    });
  });

  // Copy-to-clipboard for checksums, with a polite announcement.
  const copyButtons = document.querySelectorAll<HTMLButtonElement>('.copy-button');
  const liveRegion = document.createElement('div');
  liveRegion.setAttribute('role', 'status');
  liveRegion.setAttribute('aria-live', 'polite');
  liveRegion.className = 'visually-hidden';
  document.body.appendChild(liveRegion);

  copyButtons.forEach(function (button) {
    button.addEventListener('click', async function () {
      const target = document.getElementById(button.getAttribute('data-copy-target') ?? '');
      if (!(target instanceof HTMLElement)) return;
      const text = target.textContent ?? '';
      const previous = button.textContent;
      const describedBy = button.getAttribute('aria-describedby') ?? '';
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      liveRegion.textContent = button.textContent + ' checksum for ' + describedBy.replace(/^checksum-label-/, '');
      setTimeout(function () {
        button.textContent = previous;
      }, 2000);
    });
  });

  const detected = detectPlatform();
  const detectedArchitecture = detectArchitecture();
  if (detected !== 'unknown') {
    const tab = document.querySelector('.platform-tab[data-platform="' + detected + '"]');
    if (tab instanceof HTMLButtonElement) activatePlatform(tab);
    showDetectionBanner(detected, detectedArchitecture);
  }
</script>
