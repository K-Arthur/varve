---
import Layout from '../layouts/Layout.astro';
import { sitePath } from '../lib/siteUrl';
---

<Layout title="Page Not Found" noindex description="The page you're looking for doesn't exist or has been moved.">
  <div class="container-custom">
    <div class="error-page">
      <h1>404</h1>
      <h2>Page Not Found</h2>
      <p>The page you're looking for doesn't exist or has been moved.</p>
      <div class="error-actions">
        <a href={sitePath('/')} class="btn-primary">Go Home</a>
        <a href={sitePath('/docs')} class="btn-secondary">View Documentation</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .error-page {
    text-align: center;
    padding: 6rem 0;
  }
  
  .error-page h1 {
    font-size: 6rem;
    font-family: var(--font-editorial);
    font-weight: 700;
    font-variation-settings: 'opsz' 144;
    letter-spacing: -0.015em;
    color: var(--text-link);
    margin-bottom: 1rem;
  }
  
  .error-page h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }
  
  .error-page p {
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }
  
  .error-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }
</style>
