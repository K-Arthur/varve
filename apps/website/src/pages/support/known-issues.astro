---
import Layout from '../../layouts/Layout.astro';
import { sitePath } from '../../lib/siteUrl';
import StatusPill from '../../components/StatusPill.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';

interface KnownIssue {
  title: string;
  status: 'partial' | 'planned' | 'experimental';
  description: string;
  workaround?: string;
  category: string;
}

const issues: KnownIssue[] = [
  {
    title: 'Complex script shaping not supported',
    status: 'planned',
    description: 'Complex scripts requiring shaping (Arabic, Devanagari, Thai) are not supported. Latin, CJK, and simple scripts work correctly.',
    workaround: 'Use Latin or CJK scripts.',
    category: 'Typography',
  },
  {
    title: 'BiDi text layout not implemented',
    status: 'planned',
    description: 'Bidirectional text (mixed left-to-right and right-to-left) layout is not implemented.',
    workaround: 'Use single-direction text.',
    category: 'Typography',
  },
  {
    title: 'Rich text per-span editing limited',
    status: 'partial',
    description: 'The rich text data model exists and inline editing works, but per-span formatting (different styles within a single text node) is limited in the UI.',
    workaround: 'Use separate text nodes for different styles.',
    category: 'Typography',
  },
  {
    title: 'Bleed not visualized on canvas',
    status: 'planned',
    description: 'Bleed is an export-time parameter and is not visualized on canvas. You cannot see bleed margins while designing.',
    workaround: 'Use guides to manually mark bleed areas.',
    category: 'Color & Print',
  },
  {
    title: '8-bit color storage only',
    status: 'experimental',
    description: 'Color storage is always 8-bit RGBA. No 16-bit, floating-point, or CMYK storage at the document level.',
    category: 'Color & Print',
  },
  {
    title: 'No artboard-local coordinate space',
    status: 'planned',
    description: 'Canvas uses global coordinates. There is no artboard-local coordinate space.',
    category: 'Canvas & Tools',
  },
  {
    title: 'Collaboration is UI scaffolding only',
    status: 'experimental',
    description: 'Collaboration features (PresenceIndicator, CollabCursorOverlay) are UI scaffolding with no transport or wire protocol. Real-time collaboration does not work.',
    workaround: 'Use version control (git) for collaboration.',
    category: 'Collaboration',
  },
  {
    title: 'No state machine inspector',
    status: 'planned',
    description: 'State machine inspector for complex prototype flows is not implemented.',
    workaround: 'Use timeline-based animation for now.',
    category: 'Motion',
  },
  {
    title: 'No rigging or IK',
    status: 'planned',
    description: 'Rigging and inverse kinematics (IK) are not implemented. Types are defined but rendering is deferred.',
    workaround: 'Use manual keyframing for animation.',
    category: 'Motion',
  },
];

const categories = [...new Set(issues.map((i) => i.category))];
---

<Layout title="Known Issues" description="Current known issues and limitations in Varve: complex script shaping, collaboration scaffolding, canvas bleed visualization, and platform constraints.">
  <div class="container-custom">
    <div class="support-page">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={sitePath('/support')}>Support</a> / Known Issues
      </nav>

      <h1 class="page-hero-title">Known Issues</h1>
      <p class="page-hero-sub">
        Current limitations and known issues in Varve. These are tracked and will be addressed in future releases.
      </p>

      {categories.map((category) => (
        <section class="known-issues-section" aria-labelledby={`section-${category}`}>
          <h2 id={`section-${category}`} class="section-title">{category}</h2>
          <div class="issues-list">
            {issues.filter((i) => i.category === category).map((issue) => (
              <article class="issue-card">
                <div class="issue-card-header">
                  <h3 class="issue-title">{issue.title}</h3>
                  <StatusPill status={issue.status} />
                </div>
                <p class="issue-description">{issue.description}</p>
                {issue.workaround && (
                  <p class="issue-workaround">
                    <strong>Workaround:</strong> {issue.workaround}
                  </p>
                )}
              </article>
            ))}
          </div>
        </section>
      ))}

      <ClosingCTA
        title="Want to help fix these?"
        accentWord="issues."
        text="See the contribution guidelines to help implement these features."
        showDownload={false}
      />
    </div>
  </div>
</Layout>

<style>
  .support-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 0;
  }

  .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    color: var(--text-muted);
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .known-issues-section {
    margin-bottom: 3rem;
  }

  .known-issues-section .section-title {
    margin-bottom: 1.25rem;
  }

  .issues-list {
    display: grid;
    gap: 1rem;
  }

  .issue-card {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    position: relative;
    transition: border-color var(--duration-fast) var(--ease-default);
  }

  .issue-card:hover {
    border-color: var(--border-strong);
  }

  .issue-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .issue-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .issue-description {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
  }

  .issue-workaround {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
  }

  .issue-workaround strong {
    color: var(--text-secondary);
    font-weight: 600;
  }
</style>
