---
import Layout from '../../layouts/Layout.astro';
import { sitePath } from '../../lib/siteUrl';
import StatusPill from '../../components/StatusPill.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';

interface KnownIssue {
  title: string;
  status: 'partial' | 'planned' | 'experimental';
  description: string;
  workaround?: string;
  category: string;
}

const issues: KnownIssue[] = [
  {
    title: 'Complex-script glyph shaping is still approximate in the live canvas',
    status: 'partial',
    description: 'Varve now has a standards-based shaping contract, Unicode source maps, and a HarfBuzz-compatible WASM adapter in the engine. The live Canvas2D renderer still uses browser measurement and fillText in this migration stage, so Arabic, Devanagari, Thai, and other contextual scripts are not yet guaranteed to match the canonical glyph layout across fonts and exports.',
    workaround: 'For production-critical output, verify the selected font and export result. Basic Latin and CJK workflows remain the most predictable while the shaped-glyph renderer is integrated.',
    category: 'Typography',
  },
  {
    title: 'Mixed-direction layout is not yet wired through every consumer',
    status: 'partial',
    description: 'The engine resolves paragraph embedding levels, visual run order, logical-to-visual mappings, and mirrored punctuation through a UAX #9 adapter. The live renderer, line wrapping, caret geometry, and export paths still need to consume the same canonical snapshot for mixed LTR/RTL text to be production-complete.',
    workaround: 'Keep mixed-direction text short while validating it, and check the final export. Explicit paragraph direction can make intent clearer than Auto for authored text.',
    category: 'Typography',
  },
  {
    title: 'Rich text per-span editing is still being integrated',
    status: 'partial',
    description: 'Logical paragraph/run indexing, grapheme-safe formatting transactions, property removal, text replacement, and mixed bold/italic inspector state are now in place. Insertion-style state, full paragraph controls, composition transactions, and canonical shaped rendering for every span are still incomplete.',
    workaround: 'Use the rich-span inspector for supported character properties and verify mixed-style text after editing. Separate text nodes remain the safest fallback for production-critical compositions.',
    category: 'Typography',
  },
  {
    title: 'Canonical glyph layout is not yet the sole rendering authority',
    status: 'partial',
    description: 'The engine exposes a derived layout snapshot containing glyph clusters, lines, caret stops, selection fragments, bounds, diagnostics, and cache identity. The existing canvas, text-on-path, mask, and export consumers are being migrated incrementally and may still use independent browser measurement paths.',
    workaround: 'Treat complex-script, mixed-direction, and font-loading results as beta behavior and inspect exported output before delivery.',
    category: 'Typography',
  },
  {
    title: 'Collaboration is UI scaffolding only',
    status: 'experimental',
    description: 'Collaboration features (PresenceIndicator, CollabCursorOverlay) are UI scaffolding with no transport or wire protocol. Real-time collaboration does not work.',
    workaround: 'Use version control (git) for collaboration.',
    category: 'Collaboration',
  },
  {
    title: 'No state machine inspector',
    status: 'planned',
    description: 'State machine inspector for complex prototype flows is not implemented.',
    workaround: 'Use timeline-based animation for now.',
    category: 'Motion',
  },
  {
    title: 'No rigging or IK',
    status: 'planned',
    description: 'Rigging and inverse kinematics (IK) are not implemented. Types are defined but rendering is deferred.',
    workaround: 'Use manual keyframing for animation.',
    category: 'Motion',
  },
];

const categories = [...new Set(issues.map((i) => i.category))];
---

<Layout title="Known Issues" description="Current known issues and limitations in Varve, including the in-progress Unicode text layout migration, collaboration scaffolding, print visualization, and platform constraints.">
  <div class="container-custom">
    <div class="support-page">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={sitePath('/support')}>Support</a> / Known Issues
      </nav>

      <h1 class="page-hero-title">Known Issues</h1>
      <p class="page-hero-sub">
        Current limitations and known issues in Varve. These are tracked and will be addressed in future releases.
      </p>
      <p class="known-issues-review">
        Typography entries were reviewed on 13 August 2026 against the current engine and website implementation. “Partial” means foundations exist but the complete user-facing path is not yet guaranteed.
      </p>

      {categories.map((category) => (
        <section class="known-issues-section" aria-labelledby={`section-${category}`}>
          <h2 id={`section-${category}`} class="section-title">{category}</h2>
          <div class="issues-list">
            {issues.filter((i) => i.category === category).map((issue) => (
              <article class="issue-card">
                <div class="issue-card-header">
                  <h3 class="issue-title">{issue.title}</h3>
                  <StatusPill status={issue.status} />
                </div>
                <p class="issue-description">{issue.description}</p>
                {issue.workaround && (
                  <p class="issue-workaround">
                    <strong>Workaround:</strong> {issue.workaround}
                  </p>
                )}
              </article>
            ))}
          </div>
        </section>
      ))}

      <ClosingCTA
        title="Want to help fix these?"
        accentWord="issues."
        text="See the contribution guidelines to help implement these features."
        showDownload={false}
      />
    </div>
  </div>
</Layout>

<style>
  .support-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 0;
  }

  .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    color: var(--text-muted);
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .known-issues-section {
    margin-bottom: 3rem;
  }

  .known-issues-review {
    background: var(--surface-muted);
    border-left: 3px solid var(--border-accent);
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: -1rem 0 2.5rem;
    padding: 0.875rem 1rem;
  }

  .known-issues-section .section-title {
    margin-bottom: 1.25rem;
  }

  .issues-list {
    display: grid;
    gap: 1rem;
  }

  .issue-card {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    position: relative;
    transition: border-color var(--duration-fast) var(--ease-default);
  }

  .issue-card:hover {
    border-color: var(--border-strong);
  }

  .issue-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .issue-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .issue-description {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
  }

  .issue-workaround {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
  }

  .issue-workaround strong {
    color: var(--text-secondary);
    font-weight: 600;
  }
</style>
