---
import Layout from '../../layouts/Layout.astro';
import { sitePath } from '../../lib/siteUrl';
import StatusPill from '../../components/StatusPill.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';

interface KnownIssue {
  title: string;
  status: 'partial' | 'planned' | 'experimental';
  description: string;
  workaround?: string;
  category: string;
  related?: { href: string; label: string }[];
}

const issues: KnownIssue[] = [
  {
    title: 'Prompt-conditioned generative Fill, Replace, and Expand are not shipped',
    status: 'partial',
    description: 'The current local Fill and Remove paths perform promptless reconstruction; entering a prompt does not make those models follow a natural-language instruction. Prompt-conditioned modes remain gated. Browser AI-quality Expand requires the user to install the local LaMa model and still awaits independent real-photo qualification; the browser Fast/PatchMatch route stays disabled after visible edge striping.',
    workaround: 'Use the documented promptless workflow where available, inspect the mask edge and result at 100%, and keep the source recoverable. Do not rely on a prompt to direct these local reconstruction paths.',
    category: 'Feature & availability boundaries',
    related: [{ href: '/docs/tools/generative-editing', label: 'Generative Editing guide' }],
  },
  {
    title: 'The browser demo is a bounded sample experience',
    status: 'experimental',
    description: 'The browser build exposes a limited workspace set and browser-local storage. Desktop-only Print production, on-device inference, and Motion and Email authoring are outside the demo; installed-app and offline behavior also depend on browser support and storage permission.',
    workaround: 'Review the demo guide before moving important work into the browser, and use a supported desktop installer for workflows the demo does not include.',
    category: 'Feature & availability boundaries',
    related: [{ href: '/docs/browser-demo', label: 'Browser Demo & Offline guide' }],
  },
  {
    title: 'Presentation authoring and local plugins remain experimental',
    status: 'experimental',
    description: 'Presentation output is a raster screen PDF or numbered PNG archive; PDF text is not searchable and the PDF has no tagged accessibility structure. Local plugins are bounded Wasm packages for selected-layer analysis and batch renaming, not a marketplace or a general-purpose extension host.',
    workaround: 'Check the task-specific guide before depending on either workflow for production delivery. Keep an editable source document and verify exported presentation output separately.',
    category: 'Feature & availability boundaries',
    related: [
      { href: '/docs/presentations', label: 'Presentation authoring guide' },
      { href: '/docs/plugins', label: 'Local plugins guide' },
    ],
  },
  {
    title: 'Token Sync is manual and does not write back to the source',
    status: 'partial',
    description: 'Varve can import and re-import supported DTCG token files, review a three-way merge, and export canonical JSON. It does not watch a file in the background, use a Git-backed source, write changes into the original file, or claim vendor-dialect interoperability.',
    workaround: 'Keep the source under your normal version control, re-import it when it changes, review conflicts, and check exported tokens in the downstream tool that will consume them.',
    category: 'Feature & availability boundaries',
    related: [{ href: '/docs/tools/design-tokens', label: 'Design Tokens guide' }],
  },
  {
    title: 'Mockup surfaces are bounded 2D mappings, not a full 3D renderer',
    status: 'partial',
    description: 'Mockups support flat, four-corner perspective, bounded front-facing cylindrical, and folded-mesh envelope surfaces. They do not provide cameras, hidden backsides, lighting, calibrated displacement maps, or Photoshop smart-object re-rendering. PDF/X stops until a mockup is flattened; code exports warn that mockups are outside vector-structure output.',
    workaround: 'Use a supported surface and export format, then inspect the composed result. Flatten the mockup before PDF/X delivery.',
    category: 'Feature & availability boundaries',
    related: [{ href: '/docs/tools/mockups', label: 'Mockups guide' }],
  },
  {
    title: 'RAW and model-assisted photo support is format- and route-specific',
    status: 'partial',
    description: 'RAW development covers a documented DNG camera subset, not every camera format or encoding. Some image workflows need an optional local model download; a capability available in the desktop app is not automatically available in the bounded browser demo.',
    workaround: 'Check the supported inputs and model requirements in the RAW/HDR and image-tool guides before planning a production workflow.',
    category: 'Feature & availability boundaries',
    related: [
      { href: '/docs/tools/raw-hdr-photo', label: 'RAW & HDR Photo guide' },
      { href: '/docs/tools/image-enhancement', label: 'Image Enhancement guide' },
    ],
  },
  {
    title: 'Complex-script glyph shaping is still approximate in the live canvas',
    status: 'partial',
    description: 'Varve now has a standards-based shaping contract, Unicode source maps, and a HarfBuzz-compatible WASM adapter in the engine. The live Canvas2D renderer still uses browser measurement and fillText in this migration stage, so Arabic, Devanagari, Thai, and other contextual scripts are not yet guaranteed to match the canonical glyph layout across fonts and exports.',
    workaround: 'For production-critical output, verify the selected font and export result. Basic Latin and CJK workflows remain the most predictable while the shaped-glyph renderer is integrated.',
    category: 'Typography',
  },
  {
    title: 'Mixed-direction layout is canonical in the engine, but not yet in every consumer',
    status: 'partial',
    description: 'The engine now resolves UAX #9 embedding levels, script itemization, per-line visual run ordering, word-level line breaking (never inside a grapheme), cluster-safe caret stops, hit testing, and selection geometry through one canonical paragraph layout pipeline. The inline editor and pointer tools still use the legacy textarea/canvas path, and export consumers are being migrated incrementally.',
    workaround: 'Keep mixed-direction text short while validating it, and check the final export. Explicit paragraph direction can make intent clearer than Auto for authored text.',
    category: 'Typography',
  },
  {
    title: 'Rich text per-span editing is still being integrated',
    status: 'partial',
    description: 'Logical paragraph/run indexing, grapheme-safe formatting transactions, property removal, text replacement, and mixed bold/italic inspector state are now in place. Insertion-style state, full paragraph controls, composition transactions, and canonical shaped rendering for every span are still incomplete.',
    workaround: 'Use the rich-span inspector for supported character properties and verify mixed-style text after editing. Separate text nodes remain the safest fallback for production-critical compositions.',
    category: 'Typography',
  },
  {
    title: 'Canonical glyph layout is not yet the sole rendering authority',
    status: 'partial',
    description: 'The engine exposes a derived layout snapshot containing glyph clusters, lines, caret stops, selection fragments, bounds, diagnostics, and cache identity. The existing canvas, text-on-path, mask, and export consumers are being migrated incrementally and may still use independent browser measurement paths.',
    workaround: 'Treat complex-script, mixed-direction, and font-loading results as beta behavior and inspect exported output before delivery.',
    category: 'Typography',
  },
  {
    title: 'Collaboration is UI scaffolding only',
    status: 'experimental',
    description: 'Collaboration features (PresenceIndicator, CollabCursorOverlay) are UI scaffolding with no transport or wire protocol. Real-time collaboration does not work.',
    workaround: 'Use version control (git) for collaboration.',
    category: 'Collaboration',
  },
  {
    title: 'No state machine inspector',
    status: 'planned',
    description: 'State machine inspector for complex prototype flows is not implemented.',
    workaround: 'Use timeline-based animation for now.',
    category: 'Motion',
  },
  {
    title: 'No rigging or IK',
    status: 'planned',
    description: 'Rigging and inverse kinematics (IK) are not implemented. Types are defined but rendering is deferred.',
    workaround: 'Use manual keyframing for animation.',
    category: 'Motion',
  },
  {
    title: 'Browser raster and GPU previews remain display-precision',
    status: 'partial',
    description: 'Native CMYK document values and precision-aware working buffers are supported. Browser raster decode and Canvas2D ImageData surfaces remain on the sRGB/RGBA8 display path, while the current WebGPU preview target is also RGBA8. Profile-aware raster decode, CMYK raster-plane import, and high-precision GPU targets are still being integrated.',
    workaround: 'Use native desktop PDF/X or print export as the print authority, and treat the browser preview as directional. Verify the exported proof when color accuracy is production-critical.',
    category: 'Color Management',
  },
  {
    title: 'Raster exports do not include bleed',
    status: 'partial',
    description: 'Bleed is part of the print workflow: it is configured on the page, visualized on the canvas, and honored by PDF/X exports (page boxes and trim geometry). Raster formats (PNG/JPEG) still export the artwork\u2019s visual bounds only — the canonical page-plus-bleed bounds exist in the export plan but the standard export dialog does not use them.',
    workaround: 'For raster deliverables with bleed, export at a larger scale and trim in post, or use the PDF/X path when the destination accepts PDF.',
    category: 'Print & Export',
  },
  {
    title: 'Multi-page PDF/X execution is still limited',
    status: 'partial',
    description: 'The native PDF/X path now emits distinct MediaBox, BleedBox, TrimBox, CropBox, and ArtBox values for the single-page production export path. Multi-page PDF execution and complete printer-mark preview are still being integrated.',
    workaround: 'Export and inspect a PDF/X proof per page when the document contains multiple print pages.',
    category: 'Print & Export',
  },
  {
    title: 'Screen PDFs have no trim or bleed boxes',
    status: 'partial',
    description: 'The plain PDF export writes a MediaBox only. TrimBox and BleedBox are emitted only by the PDF/X path, so screen PDFs carry no print geometry metadata.',
    workaround: 'Use PDF/X for any file destined for print.',
    category: 'Print & Export',
  },
  {
    title: 'Crop marks are not previewed on the canvas',
    status: 'partial',
    description: 'Bleed and trim guides are visualized on the canvas, and trim corner marks are shown with the print guides. The full printer mark set (crop/registration marks, color bars) is rendered only at PDF/X export time \u2014 there is no canvas print-preview of the exported mark layout.',
    workaround: 'Export a PDF/X proof to review the mark layout before sending to print.',
    category: 'Print & Export',
  },
  {
    title: 'Missing bleed coverage is not detected automatically',
    status: 'planned',
    description: 'Preflight flags documents with no bleed, bleed below the recommended minimum, or non-uniform bleed, but cannot detect artwork that stops exactly at the trim edge. A production-preflight coverage check that inspects painted content in the bleed region is a future enhancement.',
    workaround: 'Turn on the bleed guides while designing and check that backgrounds and images reach the bleed boundary by eye.',
    category: 'Print & Export',
  },
];

const categories = [...new Set(issues.map((i) => i.category))];
---

<Layout title="Known Issues & Limitations" description="Current implementation gaps, experimental workflows, format and platform limits in Varve, with task-specific guides and workarounds.">
  <div class="container-custom">
    <div class="support-page">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={sitePath('/support')}>Support</a> / Known Issues
      </nav>

      <h1 class="page-hero-title">Known Issues &amp; Limitations</h1>
      <p class="page-hero-sub">
        Current implementation gaps, experimental workflows, and platform or format limits. Status labels distinguish incomplete foundations from workflows that are gated or still experimental; linked guides describe what works today.
      </p>
      <p class="known-issues-review">
        Reviewed 9 October 2026 against the v0.5.0 source tag, retained implementation, release notes, and linked guides. The color entry distinguishes native document values and working precision from browser display surfaces; print entries reflect the current export pipeline: bleed is configurable per page, visualized on the canvas, and honored by PDF/X. “Partial” means foundations exist but the complete user-facing path is not yet guaranteed. Some limits below are deliberate or qualification-dependent, not promised fixes for the next release.
      </p>

      {categories.map((category) => (
        <section class="known-issues-section" aria-labelledby={`section-${category}`}>
          <h2 id={`section-${category}`} class="section-title">{category}</h2>
          <div class="issues-list">
            {issues.filter((i) => i.category === category).map((issue) => (
              <article class="issue-card site-card site-card--status">
                <div class="issue-card-header">
                  <h3 class="issue-title">{issue.title}</h3>
                  <StatusPill status={issue.status} />
                </div>
                <p class="issue-description">{issue.description}</p>
                {issue.workaround && (
                  <p class="issue-workaround">
                    <strong>Workaround:</strong> {issue.workaround}
                  </p>
                )}
                {issue.related?.map((link) => (
                  <p class="issue-guide"><a href={sitePath(link.href)}>{link.label} →</a></p>
                ))}
              </article>
            ))}
          </div>
        </section>
      ))}

      <ClosingCTA
        title="Want to help fix these"
        accentWord="issues?"
        text="See the contribution guidelines to help implement these features."
        showDownload={false}
      />
    </div>
  </div>
</Layout>

<style>
  .support-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 0;
  }

  .breadcrumb {
    font-size: var(--type-interface-readout-size);
    margin-bottom: 1.5rem;
    color: var(--text-muted);
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .known-issues-section {
    margin-bottom: 3rem;
  }

  .known-issues-review {
    background: var(--surface-muted);
    border-left: 3px solid var(--border-accent);
    color: var(--text-secondary);
    font-size: var(--type-interface-control-size);
    line-height: 1.6;
    margin: 1.5rem 0 2.5rem;
    padding: 0.875rem 1rem;
  }

  .known-issues-section .section-title {
    margin-bottom: 1.25rem;
  }

  .issues-list {
    display: grid;
    gap: var(--space-4);
  }

  .issue-card {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--website-radius-card);
    padding: 1.25rem 1.5rem;
    position: relative;
    transition: border-color var(--duration-fast) var(--ease-default);
  }

  .issue-card:hover {
    border-color: var(--border-strong);
  }

  .issue-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .issue-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .issue-description {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.5rem;
    font-size: var(--type-interface-control-size);
  }

  .issue-workaround {
    color: var(--text-muted);
    font-size: var(--type-interface-readout-size);
    line-height: 1.5;
    margin: 0;
  }

  .issue-workaround strong {
    color: var(--text-secondary);
    font-weight: 600;
  }

  .issue-guide {
    margin: 0.5rem 0 0;
    font-size: var(--type-interface-readout-size);
  }

  .issue-guide a {
    color: var(--text-link);
  }
</style>
