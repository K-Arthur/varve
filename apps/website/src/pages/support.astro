---
import Layout from '../layouts/Layout.astro';
import { sitePath } from '../lib/siteUrl';
---

<Layout title="Support" description="Get help with Varve: documentation, FAQ, troubleshooting, known issues, and bug reporting. Community help is available on GitHub Discussions.">
  <div class="container-custom">
    <div class="support-page">
      <h1>Support</h1>
      <p class="support-intro">
        Get help with Varve through documentation, community forums, and issue tracking.
      </p>

      <div class="support-sections">
        <section class="support-section">
          <h2>Self-Service Resources</h2>
          <p>Find answers quickly through documentation and FAQs</p>
          <ul>
            <li><a href={sitePath('/docs')}>Documentation</a> - Comprehensive guides and tutorials</li>
            <li><a href={sitePath('/support/faq')}>FAQ</a> - Frequently asked questions</li>
            <li><a href={sitePath('/support/troubleshooting')}>Troubleshooting</a> - Common issues and solutions</li>
            <li><a href={sitePath('/support/known-issues')}>Known Issues</a> - Current limitations and workarounds</li>
          </ul>
        </section>

        <section class="support-section">
          <h2>Community Support</h2>
          <p>Get help from the community through GitHub Discussions</p>
          <ul>
            <li><a href="https://github.com/K-Arthur/varve/discussions">GitHub Discussions</a> - Ask questions, share workflows</li>
            <li><a href="https://github.com/K-Arthur/varve/issues">GitHub Issues</a> - Report bugs, request features</li>
          </ul>
          <p class="support-note">
            Community support is provided by volunteers. Response times vary from 24-72 hours.
          </p>
        </section>

        <section class="support-section">
          <h2>Report a Bug</h2>
          <p>Help improve Varve by reporting issues with detailed information</p>
          <a href={sitePath('/support/report-issue')} class="btn-primary">Report an Issue</a>
        </section>

        <section class="support-section">
          <h2>Response Time Expectations</h2>
          <p>
            As a solo-developer project, issues are typically reviewed within 1 week. Critical bugs are prioritized. 
            Feature requests are added to the roadmap for consideration with no guaranteed timeline.
            For faster responses, community forums are recommended.
          </p>
        </section>
      </div>

      <div class="support-cta">
        <h2>Still need help?</h2>
        <p>
          Check the <a href={sitePath('/docs')}>documentation</a> or search 
          <a href="https://github.com/K-Arthur/varve/discussions">GitHub Discussions</a> for similar issues.
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .support-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 0;
  }
  
  .support-page h1 {
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-family: var(--font-editorial);
    font-weight: 700;
    font-variation-settings: 'opsz' 144;
    letter-spacing: -0.015em;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }
  
  .support-intro {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: 3rem;
  }
  
  .support-sections {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  
  .support-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }
  
  .support-section p {
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }
  
  .support-section ul {
    list-style: none;
  }
  
  .support-section li {
    margin-bottom: 0.5rem;
    padding-left: 1.5rem;
    position: relative;
  }
  
  .support-section li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--text-link-hover);
  }
  
  .support-note {
    background: var(--surface-muted);
    border-radius: 0.375rem;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-top: 1rem;
  }
  
  .support-cta {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 0.75rem;
    padding: 2rem;
    text-align: center;
  }
  
  .support-cta h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }
  
  .support-cta p {
    color: var(--text-secondary);
  }
</style>
