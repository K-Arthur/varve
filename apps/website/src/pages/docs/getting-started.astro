---
import Layout from '../../layouts/Layout.astro';
import { sitePath } from '../../lib/siteUrl';
import shotManifest from '../../data/screenshot-manifest.json';
import '../../styles/docs-prose.css';

const shots = shotManifest.scenes as unknown as Record<
  string,
  { file: string; alt: string; caption: string; width?: number; height?: number }
>;
const workspaceShot = shots.workspace;

const firstDocHowTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Create your first document in Varve',
  description: 'Steps to create and save a new design document in Varve.',
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Open the home screen', text: 'Click "New Document" on the home screen.' },
    { '@type': 'HowToStep', position: 2, name: 'Choose dimensions', text: 'Choose a preset or enter custom dimensions.' },
    { '@type': 'HowToStep', position: 3, name: 'Name your document', text: 'Name your document.' },
    { '@type': 'HowToStep', position: 4, name: 'Create', text: 'Click "Create".' },
  ],
};
---

<Layout title="Getting Started — Varve Docs" description="Install Varve on Linux, macOS, or Windows, and open your first document. System requirements and first steps for the current beta release." structuredData={firstDocHowTo}>
  <div class="container-custom">
    <div class="docs-page">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={sitePath('/docs')}>Documentation</a> / Getting Started
      </nav>

      <h1 class="site-page-title">Getting Started</h1>
      <p class="docs-intro">
        Installation and first steps with Varve.
      </p>

      <section class="docs-section">
        <h2>Installation</h2>
        <p>Get the latest release from the{' '}
        <a href={sitePath('/download')}>download page</a>, which lists
        packages, checksums, and system requirements for each platform.
        This is an early beta: expect rough edges, and keep backups of
        anything you care about. The instructions below describe each
        platform's installer.</p>
        
        <h3>Linux</h3>
        <ul>
          <li><strong>AppImage (Recommended):</strong> Download the AppImage, make it executable, and run it:</li>
        </ul>
        <code class="code-block">chmod +x Varve-*.AppImage && ./Varve-*.AppImage</code>
        <ul>
          <li><strong>deb:</strong> Install the downloaded file so dependencies resolve: <code>sudo apt install ./Varve-*.deb</code> (do not use <code>dpkg -i</code> alone).</li>
          <li><strong>rpm:</strong> Install the downloaded file: <code>sudo dnf install ./Varve-*.rpm</code>.</li>
        </ul>
        <p>
          <strong>ChromeOS (Chromebook):</strong> start with the browser route — open{' '}
          <a href={sitePath('/try/')}>varve.studio/try/</a> in Chrome, which needs no
          setup, or install it as a web app. The optional Linux `.deb` route (only when
          the Linux development environment is enabled) is covered in{' '}
          <a href={sitePath('/docs/chromeos-linux')}>Varve on ChromeOS</a>, and the
          trade-offs between all three routes are in{' '}
          <a href={sitePath('/docs/chromebook')}>Varve on Chromebook</a>.
        </p>

        <h3>macOS</h3>
        <p>Download the dmg and drag Varve to your Applications folder. Requires macOS 13 Ventura or later and an Apple Silicon Mac — there is no Intel build yet.</p>

        <h3>Windows</h3>
        <p>Download the NSIS installer (.exe) and run it. Requires Windows 10 or Windows 11.</p>
      </section>

      <section class="docs-section">
        <h2>First Launch</h2>
        <p>When you first launch Varve, you'll see the home screen with options to:</p>
        <ul>
          <li>Create a new document</li>
          <li>Open an existing document</li>
          <li>View recent documents</li>
        </ul>
        <figure class="docs-figure">
          <img
            src={sitePath(`/screenshots/${workspaceShot.file}`)}
            alt={workspaceShot.alt}
            width={workspaceShot.width ?? 1440}
            height={workspaceShot.height ?? 900}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{workspaceShot.caption}</figcaption>
        </figure>
      </section>

      <section class="docs-section">
        <h2>Creating Your First Document</h2>
        <ol>
          <li>Click "New Document" on the home screen</li>
          <li>Choose a preset or enter custom dimensions</li>
          <li>Name your document</li>
          <li>Click "Create"</li>
        </ol>
      </section>

      <section class="docs-section">
        <h2>Basic Workflow</h2>
        <ul>
          <li><strong>Toolbar:</strong> Select tools from the floating palette at the bottom centre of the canvas (View &gt; Toolbar at Top moves it to the top and remembers the choice)</li>
          <li><strong>Canvas:</strong> Scroll to pan (two axes on a trackpad), Ctrl/Cmd + scroll to zoom at the cursor, or drag with the middle button held to pan with any tool</li>
          <li><strong>Layers:</strong> View and manage layers in the layers panel (right side)</li>
          <li><strong>Properties:</strong> Edit properties in the inspector panel (F6)</li>
          <li><strong>Export:</strong> Export via File > Export or the export panel</li>
        </ul>
      </section>

      <section class="docs-section">
        <h2>Keyboard Shortcuts</h2>
        <p>Common shortcuts:</p>
        <ul>
          <li><code>V</code> - Select tool</li>
          <li><code>R</code> - Rectangle tool</li>
          <li><code>O</code> - Ellipse tool</li>
          <li><code>T</code> - Text tool</li>
          <li><code>F6</code> - Toggle inspector</li>
          <li><code>Ctrl+Z</code> - Undo</li>
          <li><code>Ctrl+Shift+Z</code> - Redo</li>
        </ul>
        <p>See the <a href={sitePath('/docs/keyboard-shortcuts')}>full keyboard shortcuts reference</a>.</p>
      </section>

      <section class="docs-section">
        <h2>Next Steps</h2>
        <ul>
          <li><a href={sitePath('/docs/getting-started/interface')}>Interface Overview</a> - Learn about the Varve interface</li>
          <li><a href={sitePath('/docs/getting-started/first-project')}>Your First Project</a> - Tutorial for your first design</li>
          <li><a href={sitePath('/features')}>Features</a> - Deep dives into Varve's capabilities</li>
          <li><a href={sitePath('/support')}>Support</a> - Get help if you're stuck</li>
        </ul>
      </section>

      <div class="docs-cta">
        <h2>Need help?</h2>
        <p>Check the <a href={sitePath('/support/faq')}>FAQ</a> or ask in <a href="https://github.com/K-Arthur/varve/discussions">GitHub Discussions</a>.</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .docs-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 0;
  }

  .docs-page h1 { font-variation-settings: 'opsz' 144; letter-spacing: -0.015em; }

  .docs-section ol {
    list-style: none;
    counter-reset: item;
  }

  .docs-section ol li {
    counter-increment: item;
    margin-bottom: 0.75rem;
    padding-left: 2.5rem;
    position: relative;
  }

  .docs-section ol li::before {
    content: counter(item);
    position: absolute;
    left: 0;
    width: 1.5rem;
    height: 1.5rem;
    background: var(--status-built);
    color: var(--text-on-status);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--type-interface-micro-size);
    font-weight: 600;
  }

  .docs-figure {
    margin: 1.5rem 0;
    border: 1px solid var(--border-default);
    border-radius: var(--website-radius-surface);
    overflow: hidden;
    background: var(--surface-card);
  }

  .docs-figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  .docs-figure figcaption {
    font-size: 0.875rem;
    color: var(--text-muted);
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--border-default);
  }
</style>
