---
import Layout from '../../../layouts/Layout.astro';
import { sitePath } from '../../../lib/siteUrl';
---

<Layout
  title="Grid Systems — Varve Docs"
  description="Use Varve's document grids, pixel grid, baseline and isometric overlays, and frame-owned layout guides."
>
  <div class="container-custom">
    <main class="grid-docs-page">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={sitePath('/docs')}>Documentation</a> / Grid systems
      </nav>

      <header class="grid-hero">
        <div class="grid-hero__copy">
          <p class="eyebrow">Canvas systems / precision</p>
          <h1>Every grid has a job.</h1>
          <p class="grid-hero__intro">
            Varve separates alignment, pixel inspection, typography, and frame composition so
            your guides stay useful instead of becoming visual noise.
          </p>
          <div class="grid-hero__facts" aria-label="Grid system principles">
            <span>Document-authored</span>
            <span>Camera-aware</span>
            <span>Export-safe</span>
          </div>
        </div>

        <div class="grid-hero__visual" aria-label="Illustration of independent canvas grids">
          <div class="mock-toolbar">
            <span class="mock-toolbar__dot"></span>
            <span>Canvas 1</span>
            <span class="mock-toolbar__status">Grid on</span>
          </div>
          <div class="mock-canvas">
            <span class="mock-ruler mock-ruler--top">0&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 480&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 960</span>
            <span class="mock-ruler mock-ruler--side">0<br /><br />240<br /><br />480</span>
            <div class="mock-grid-lines"></div>
            <div class="mock-artboard">
              <div class="mock-artboard__guide mock-artboard__guide--one"></div>
              <div class="mock-artboard__guide mock-artboard__guide--two"></div>
              <div class="mock-artboard__shape"></div>
              <span class="mock-artboard__label">Frame guide</span>
            </div>
          </div>
          <div class="mock-legend">
            <span><i class="swatch swatch--grid"></i>Document grid</span>
            <span><i class="swatch swatch--guide"></i>Frame guide</span>
          </div>
        </div>
      </header>

      <section class="grid-overview" aria-labelledby="grid-family-title">
        <div class="section-heading">
          <p class="eyebrow">The grid family</p>
          <h2 id="grid-family-title">Four systems. One clear canvas.</h2>
          <p>Choose the guide that matches the decision you are making.</p>
        </div>
        <div class="grid-family">
          <article class="grid-family__card grid-family__card--document">
            <span class="grid-family__number">01</span>
            <h3>Document grid</h3>
            <p>Align and snap objects against a saved X/Y lattice with its own origin and rotation.</p>
            <span class="grid-family__tag">Alignment</span>
          </article>
          <article class="grid-family__card grid-family__card--pixel">
            <span class="grid-family__number">02</span>
            <h3>Pixel grid</h3>
            <p>Inspect raster detail at high zoom. Display and integer-pixel snapping stay separate.</p>
            <span class="grid-family__tag">Inspection</span>
          </article>
          <article class="grid-family__card grid-family__card--type">
            <span class="grid-family__number">03</span>
            <h3>Baseline and isometric</h3>
            <p>Use document-authored rhythm and axes when type or perspective needs a visual check.</p>
            <span class="grid-family__tag">Typography / axes</span>
          </article>
          <article class="grid-family__card grid-family__card--layout">
            <span class="grid-family__number">04</span>
            <h3>Frame layout guides</h3>
            <p>Show reusable columns, rows, or uniform boundaries without rearranging children.</p>
            <span class="grid-family__tag">Composition</span>
          </article>
        </div>
      </section>

      <section class="grid-detail grid-detail--document" aria-labelledby="document-grid-title">
        <div class="grid-detail__copy">
          <p class="eyebrow">01 / Alignment</p>
          <h2 id="document-grid-title">Document grid</h2>
          <p>
            The document grid is the dependable lattice for movement. Its geometry travels with the
            file, while view controls decide when that geometry is shown.
          </p>
          <a class="text-link" href={sitePath('/docs/getting-started/interface')}>Find it in the inspector <span aria-hidden="true">→</span></a>
        </div>
        <div class="control-card" aria-label="Document grid controls">
          <div class="control-card__header">
            <span class="control-card__title">Document Grid</span>
            <span class="control-card__badge">Saved in document</span>
          </div>
          <div class="control-card__row"><span>Show grid</span><span class="fake-switch fake-switch--on" aria-hidden="true"></span></div>
          <div class="control-card__row"><span>Snap to document grid</span><span class="fake-switch fake-switch--on" aria-hidden="true"></span></div>
          <div class="control-card__row"><span>Enable snapping globally</span><span class="fake-switch" aria-hidden="true"></span></div>
          <div class="control-card__row control-card__row--values"><span>Spacing X / Y</span><strong>8 / 12 px</strong></div>
          <div class="control-card__row control-card__row--values"><span>Origin</span><strong>0, 0</strong></div>
        </div>
      </section>

      <section class="grid-detail grid-detail--pixel" aria-labelledby="pixel-grid-title">
        <div class="pixel-preview" aria-label="Illustration of pixel inspection">
          <div class="pixel-preview__zoom">800%</div>
          <div class="pixel-preview__art">
            <span></span><span></span><span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span><span></span><span></span>
          </div>
          <div class="pixel-preview__caption">One square = one document pixel</div>
        </div>
        <div class="grid-detail__copy">
          <p class="eyebrow">02 / Inspection</p>
          <h2 id="pixel-grid-title">Pixel, baseline, and isometric overlays</h2>
          <p>
            Pixel-grid display is a high-zoom view preference. Pixel snapping is a separate choice,
            so a close inspection never forces a movement decision.
          </p>
          <p>
            Baseline and isometric overlays are authored document settings. Their step, origin,
            axes, and visibility follow the same camera projection as the artwork.
          </p>
        </div>
      </section>

      <section class="layout-guide-section" aria-labelledby="layout-guide-title">
        <div class="layout-guide-section__intro">
          <p class="eyebrow">03 / Composition</p>
          <h2 id="layout-guide-title">Frame layout guides</h2>
          <p>
            Layout guides belong to a frame, not to the auto-layout algorithm. Add one or more
            authored guides and choose columns, rows, or uniform tracks with their own count, size,
            gutter, margins, color, visibility, and snapping.
          </p>
          <p class="layout-guide-section__note">
            They never arrange or resize children. They simply make the frame's intended structure
            visible and give its children useful snap targets.
          </p>
        </div>
        <div class="layout-guide-visual" aria-label="Illustration of frame layout guides">
          <div class="layout-guide-visual__frame">
            <span class="layout-guide-visual__label">Hero frame</span>
            <i></i><i></i><i></i><i></i><i></i>
            <div class="layout-guide-visual__content">Content stays where you put it.</div>
          </div>
          <div class="layout-guide-visual__meta"><span>Columns</span><strong>4</strong><span>Gutter</span><strong>24 px</strong></div>
        </div>
      </section>

      <section class="troubleshooting" aria-labelledby="troubleshooting-title">
        <div class="section-heading section-heading--compact">
          <p class="eyebrow">Quick diagnosis</p>
          <h2 id="troubleshooting-title">When a guide is not visible</h2>
        </div>
        <ol class="troubleshooting__list">
          <li><span>01</span><div><strong>Check the global switch.</strong><p>Turn on Show layout guides in the Document Grid section.</p></div></li>
          <li><span>02</span><div><strong>Check the local switch.</strong><p>The frame and each authored guide can be hidden independently.</p></div></li>
          <li><span>03</span><div><strong>Check the active scope.</strong><p>Guides outside the active page, canvas, master, or isolation scope stay out of view.</p></div></li>
          <li><span>04</span><div><strong>Check the geometry.</strong><p>Margins, count, fixed size, and gutter must fit inside the owning frame.</p></div></li>
        </ol>
      </section>

      <aside class="grid-cta" aria-labelledby="grid-cta-title">
        <div>
          <p class="eyebrow">Keep exploring</p>
          <h2 id="grid-cta-title">Build a canvas that explains itself.</h2>
          <p>See how Varve's camera, rulers, guides, and rendering pipeline stay in sync.</p>
        </div>
        <div class="grid-cta__links">
          <a class="button button--primary" href={sitePath('/features/canvas')}>Canvas &amp; Rendering</a>
          <a class="button button--quiet" href={sitePath('/docs/getting-started/interface')}>Interface Overview</a>
        </div>
      </aside>
    </main>
  </div>
</Layout>

<style>
  .grid-docs-page { max-width: 1080px; margin: 0 auto; padding: 2.5rem 0 6rem; }
  .breadcrumb { color: var(--text-secondary); font-size: .875rem; margin-bottom: 2rem; }
  .breadcrumb a, .text-link { color: var(--text-link); }
  .eyebrow { color: var(--accent-primary); font-size: .72rem; font-weight: 750; letter-spacing: .14em; margin: 0 0 .75rem; text-transform: uppercase; }
  .grid-hero { align-items: center; background: linear-gradient(135deg, var(--surface-accent-soft), var(--surface-card) 58%); border: 1px solid var(--border-accent); border-radius: var(--website-radius-card); display: grid; gap: clamp(2rem, 6vw, 5rem); grid-template-columns: minmax(0, .9fr) minmax(360px, 1.1fr); margin-bottom: 6rem; overflow: hidden; padding: clamp(2rem, 6vw, 5rem); }
  .grid-hero h1 { color: var(--text-primary); font: 700 clamp(3rem, 7vw, 5.5rem)/.92 var(--font-editorial); letter-spacing: -.045em; margin: 0 0 1.5rem; max-width: 570px; }
  .grid-hero__intro { color: var(--text-secondary); font-size: clamp(1.05rem, 2vw, 1.3rem); line-height: 1.65; margin: 0; max-width: 510px; }
  .grid-hero__facts { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 2rem; }
  .grid-hero__facts span, .grid-family__tag { border: 1px solid var(--border-default); border-radius: 99px; color: var(--text-secondary); font-size: .72rem; font-weight: 700; letter-spacing: .04em; padding: .45rem .7rem; }
  .grid-hero__visual { background: var(--surface-inset); border: 1px solid var(--border-default); border-radius: var(--website-radius-card); box-shadow: var(--elevation-shadow-raised); min-width: 0; padding: 1rem; transform: rotate(1.5deg); }
  .mock-toolbar { align-items: center; color: #dce7eb; display: flex; font-size: .72rem; gap: .5rem; padding: .25rem .25rem .85rem; }
  .mock-toolbar__dot { background: var(--accent-primary); border-radius: 50%; height: .45rem; width: .45rem; }
  .mock-toolbar__status { background: rgba(45, 211, 198, .16); border: 1px solid rgba(45, 211, 198, .4); border-radius: 99px; color: #70e4d6; margin-left: auto; padding: .2rem .5rem; }
  .mock-canvas { background: #e6edf0; border-radius: .35rem; height: 250px; overflow: hidden; position: relative; }
  .mock-ruler { color: #6e7f86; font: 600 .55rem/1 monospace; position: absolute; z-index: 2; }
  .mock-ruler--top { left: 2.25rem; right: .75rem; top: .7rem; }
  .mock-ruler--side { left: .75rem; top: 2.25rem; }
  .mock-grid-lines { background-image: linear-gradient(to right, rgba(19, 103, 101, .22) 1px, transparent 1px), linear-gradient(to bottom, rgba(19, 103, 101, .22) 1px, transparent 1px); background-size: 25px 25px; inset: 2rem .65rem .65rem 2rem; position: absolute; transform: rotate(-4deg) scale(1.08); }
  .mock-artboard { background: #fff; box-shadow: 0 12px 22px rgba(20, 50, 58, .18); height: 155px; left: 22%; position: absolute; top: 23%; transform: rotate(2deg); width: 58%; }
  .mock-artboard__guide { border-left: 2px solid #f18d67; bottom: 0; position: absolute; top: 0; width: 0; }
  .mock-artboard__guide--one { left: 25%; }
  .mock-artboard__guide--two { right: 25%; }
  .mock-artboard__shape { background: linear-gradient(135deg, #116f70, #53d3c0); border-radius: 50%; height: 55px; left: 38%; position: absolute; top: 49px; width: 55px; }
  .mock-artboard__label { bottom: .45rem; color: #df7959; font: 700 .52rem/1 var(--font-ui); position: absolute; right: .5rem; }
  .mock-legend { color: #c4d0d4; display: flex; flex-wrap: wrap; font-size: .62rem; gap: 1rem; padding: .85rem .25rem .1rem; }
  .mock-legend span { align-items: center; display: inline-flex; gap: .35rem; }
  .swatch { border-radius: 50%; display: inline-block; height: .5rem; width: .5rem; }
  .swatch--grid { background: #4dc8bd; }
  .swatch--guide { background: #f18d67; }
  .grid-overview { margin-bottom: 6rem; }
  .section-heading { margin-bottom: 2rem; max-width: 650px; }
  .section-heading h2, .grid-detail h2, .layout-guide-section h2, .troubleshooting h2, .grid-cta h2 { color: var(--text-primary); font: 700 clamp(1.9rem, 4vw, 3rem)/1.05 var(--font-editorial); letter-spacing: -.025em; margin: 0 0 .9rem; }
  .section-heading > p:last-child { color: var(--text-secondary); font-size: 1.08rem; line-height: 1.65; margin: 0; }
  .grid-family { display: grid; gap: 1rem; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .grid-family__card { background: var(--surface-card); border: 1px solid var(--border-default); border-radius: var(--website-radius-surface); display: flex; flex-direction: column; min-height: 230px; padding: 1.35rem; position: relative; }
  .grid-family__card::before { background: var(--accent-primary); content: ''; height: 3px; left: 1.35rem; position: absolute; right: 1.35rem; top: 0; }
  .grid-family__card--pixel::before { background: #e99c63; }
  .grid-family__card--type::before { background: #8e7aca; }
  .grid-family__card--layout::before { background: #dd6d62; }
  .grid-family__number { color: var(--text-tertiary); font: 700 .7rem/1 monospace; margin-bottom: 2.2rem; }
  .grid-family__card h3 { color: var(--text-primary); font-size: 1.05rem; margin: 0 0 .65rem; }
  .grid-family__card p { color: var(--text-secondary); font-size: .92rem; line-height: 1.6; margin: 0; }
  .grid-family__tag { align-self: flex-start; font-size: .65rem; margin-top: auto; padding: .3rem .5rem; }
  .grid-detail { align-items: center; display: grid; gap: clamp(2rem, 7vw, 7rem); grid-template-columns: minmax(0, .85fr) minmax(320px, 1.15fr); margin-bottom: 6rem; }
  .grid-detail--document { background: var(--surface-accent-soft); border: 1px solid var(--border-accent); border-radius: var(--website-radius-card); padding: clamp(2rem, 5vw, 4rem); }
  .grid-detail__copy p:not(.eyebrow) { color: var(--text-secondary); line-height: 1.75; margin: 0 0 1rem; }
  .text-link { font-size: .9rem; font-weight: 700; text-decoration: none; }
  .text-link span { display: inline-block; margin-left: .25rem; transition: transform .2s ease; }
  .text-link:hover span { transform: translateX(3px); }
  .control-card { background: var(--surface-card); border: 1px solid var(--border-default); border-radius: var(--website-radius-surface); box-shadow: var(--elevation-shadow-raised); padding: 1.25rem; }
  .control-card__header, .control-card__row { align-items: center; display: flex; justify-content: space-between; }
  .control-card__header { border-bottom: 1px solid var(--border-default); padding-bottom: 1rem; }
  .control-card__title { color: var(--text-primary); font-weight: 750; }
  .control-card__badge { color: var(--accent-primary); font-size: .65rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .control-card__row { border-bottom: 1px solid var(--border-subtle, var(--border-default)); color: var(--text-secondary); font-size: .84rem; gap: 1rem; padding: .9rem 0; }
  .control-card__row:last-child { border-bottom: 0; padding-bottom: .1rem; }
  .control-card__row--values strong { color: var(--text-primary); font-size: .8rem; }
  .fake-switch { background: var(--surface-muted); border: 1px solid var(--border-default); border-radius: 99px; display: inline-block; height: 1.2rem; position: relative; width: 2.1rem; }
  .fake-switch::after { background: var(--text-tertiary); border-radius: 50%; content: ''; height: .8rem; left: .15rem; position: absolute; top: .15rem; width: .8rem; }
  .fake-switch--on { background: var(--accent-primary); border-color: var(--accent-primary); }
  .fake-switch--on::after { background: #fff; left: 1.05rem; }
  .grid-detail--pixel { grid-template-columns: minmax(320px, 1.1fr) minmax(0, .9fr); }
  .pixel-preview { background: #172126; border: 1px solid var(--border-default); border-radius: var(--website-radius-card); box-shadow: var(--elevation-shadow-raised); padding: 1.25rem; }
  .pixel-preview__zoom { color: #88d8d0; font: 700 .7rem/1 monospace; letter-spacing: .08em; margin-bottom: 1rem; text-align: right; }
  .pixel-preview__art { aspect-ratio: 1.5; background-color: #edf4f4; background-image: linear-gradient(rgba(17, 111, 112, .26) 1px, transparent 1px), linear-gradient(90deg, rgba(17, 111, 112, .26) 1px, transparent 1px); background-size: 10% 10%; display: grid; grid-template-columns: repeat(6, 1fr); overflow: hidden; }
  .pixel-preview__art span:nth-child(1), .pixel-preview__art span:nth-child(2), .pixel-preview__art span:nth-child(7), .pixel-preview__art span:nth-child(8) { background: #ec896a; }
  .pixel-preview__art span:nth-child(3), .pixel-preview__art span:nth-child(4), .pixel-preview__art span:nth-child(9), .pixel-preview__art span:nth-child(10) { background: #2bbcae; }
  .pixel-preview__caption { color: #b7c5c8; font-size: .7rem; margin-top: .85rem; }
  .layout-guide-section { align-items: center; background: var(--surface-muted); border: 1px solid var(--border-default); border-radius: var(--website-radius-card); display: grid; gap: clamp(2rem, 6vw, 5rem); grid-template-columns: minmax(0, 1fr) minmax(300px, .9fr); margin-bottom: 6rem; overflow: hidden; padding: clamp(2rem, 5vw, 4rem); }
  .layout-guide-section__intro > p:not(.eyebrow) { color: var(--text-secondary); line-height: 1.75; margin: 0 0 1rem; }
  .layout-guide-section__note { border-left: 3px solid #dd6d62; color: var(--text-primary) !important; font-weight: 650; padding-left: 1rem; }
  .layout-guide-visual { background: #1d252b; border-radius: var(--website-radius-surface); padding: 1.25rem; }
  .layout-guide-visual__frame { aspect-ratio: 1.2; background: #f8fbfb; border: 1px solid #c5d3d4; position: relative; }
  .layout-guide-visual__label { color: #52666c; font: 700 .6rem/1 var(--font-ui); left: .75rem; position: absolute; top: .75rem; }
  .layout-guide-visual__frame i { border-left: 2px solid #dd6d62; bottom: 0; position: absolute; top: 0; width: 0; }
  .layout-guide-visual__frame i:nth-of-type(1) { left: 18%; }
  .layout-guide-visual__frame i:nth-of-type(2) { left: 39%; }
  .layout-guide-visual__frame i:nth-of-type(3) { left: 60%; }
  .layout-guide-visual__frame i:nth-of-type(4) { left: 81%; }
  .layout-guide-visual__frame i:nth-of-type(5) { border-left-color: #2bbcae; left: 50%; opacity: .9; }
  .layout-guide-visual__content { color: #698087; font-size: .7rem; left: 0; position: absolute; right: 0; text-align: center; top: 53%; }
  .layout-guide-visual__meta { color: #bac8ca; display: flex; font-size: .65rem; gap: .5rem; justify-content: flex-end; margin-top: .9rem; }
  .layout-guide-visual__meta strong { color: #8fe3d8; }
  .troubleshooting { margin-bottom: 6rem; }
  .section-heading--compact { margin-bottom: 1.5rem; }
  .troubleshooting__list { display: grid; gap: .75rem; grid-template-columns: repeat(2, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; }
  .troubleshooting__list li { align-items: flex-start; background: var(--surface-card); border: 1px solid var(--border-default); border-radius: var(--website-radius-surface); display: flex; gap: 1rem; padding: 1.15rem; }
  .troubleshooting__list li > span { color: var(--accent-primary); font: 700 .7rem/1 monospace; padding-top: .25rem; }
  .troubleshooting__list strong { color: var(--text-primary); font-size: .9rem; }
  .troubleshooting__list p { color: var(--text-secondary); font-size: .86rem; line-height: 1.55; margin: .35rem 0 0; }
  .grid-cta { align-items: center; background: var(--surface-footer); border-radius: var(--website-radius-card); color: var(--text-footer); display: flex; gap: 2rem; justify-content: space-between; padding: clamp(2rem, 5vw, 3.5rem); }
  .grid-cta .eyebrow { color: var(--accent-dark-band); }
  .grid-cta h2 { color: var(--text-footer-heading); font-size: clamp(1.8rem, 4vw, 2.8rem); }
  .grid-cta p:not(.eyebrow) { color: var(--text-footer-muted); line-height: 1.6; margin: 0; }
  .grid-cta__links { display: flex; flex-shrink: 0; flex-wrap: wrap; gap: .75rem; }
  .button { border-radius: 99px; display: inline-block; font-size: .85rem; font-weight: 750; padding: .75rem 1.1rem; text-decoration: none; }
  .button--primary { background: var(--accent-dark-band); color: var(--text-on-accent-dark-band); }
  .button--quiet { border: 1px solid var(--border-footer); color: var(--text-footer-link); }
  @media (max-width: 850px) {
    .grid-hero { grid-template-columns: 1fr; }
    .grid-hero__visual { max-width: 620px; width: 100%; }
    .grid-family { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid-detail, .grid-detail--pixel, .layout-guide-section { grid-template-columns: 1fr; }
    .grid-detail__copy { max-width: 650px; }
    .grid-detail--pixel .pixel-preview { max-width: 620px; }
    .grid-cta { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 560px) {
    .grid-docs-page { padding: 1.5rem 0 4rem; }
    .breadcrumb { margin-bottom: 1.5rem; }
    .grid-hero { border-radius: var(--website-radius-surface); margin-bottom: 4rem; padding: 1.5rem; }
    .grid-hero h1 { font-size: clamp(2.8rem, 15vw, 4.2rem); }
    .grid-hero__visual { padding: .75rem; transform: none; }
    .mock-canvas { height: 190px; }
    .mock-artboard { height: 120px; }
    .mock-artboard__shape { height: 42px; top: 39px; width: 42px; }
    .grid-overview, .grid-detail, .layout-guide-section, .troubleshooting { margin-bottom: 4rem; }
    .grid-family, .troubleshooting__list { grid-template-columns: 1fr; }
    .grid-family__card { min-height: 190px; }
    .grid-family__number { margin-bottom: 1.5rem; }
    .grid-detail--document, .layout-guide-section { border-radius: var(--website-radius-surface); padding: 1.5rem; }
    .grid-detail--pixel { display: flex; flex-direction: column-reverse; }
    .pixel-preview { padding: .85rem; }
    .grid-cta { border-radius: var(--website-radius-surface); padding: 1.5rem; }
  }
</style>
