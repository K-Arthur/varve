  .breadcrumb a { color: var(--text-secondary); }
  h1 { color: var(--text-primary); font: 700 clamp(2rem, 5vw, 2.8rem)/1.1 var(--font-editorial); margin-bottom: 1rem; }
  .docs-intro { color: var(--text-secondary); font-size: 1.15rem; margin-bottom: 3rem; }
  .docs-section { margin-bottom: 2.5rem; }
  .docs-section h2 { border-bottom: 2px solid var(--border-accent); color: var(--text-primary); font-size: 1.45rem; margin-bottom: 1rem; padding-bottom: .5rem; }
  .docs-section p, .docs-section li { color: var(--text-secondary); line-height: 1.8; }
  .docs-section li { margin-bottom: .5rem; }
  .docs-section a { color: var(--text-link); }
  .docs-note { border-left: 3px solid var(--accent-primary); padding-left: 1rem; }
</style>
