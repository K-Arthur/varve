---
import Layout from '../../layouts/Layout.astro';
import { sitePath } from '../../lib/siteUrl';
---

<Layout title="Keyboard Shortcuts — Varve Docs" description="The complete Varve keyboard shortcut reference: selection, tools, transform, layers, text, view, and workspace modes.">
  <div class="container-custom">
    <div class="docs-page">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={sitePath('/docs')}>Documentation</a> / Keyboard Shortcuts
      </nav>

      <h1>Keyboard Shortcuts</h1>
      <p class="docs-intro">
        Quick reference for Varve keyboard shortcuts.
      </p>

      <section class="shortcuts-section">
        <h2>Tools</h2>
        <div class="shortcuts-grid">
          <div class="shortcut-item">
            <code>V</code>
            <span>Select tool</span>
          </div>
          <div class="shortcut-item">
            <code>R</code>
            <span>Rectangle tool</span>
          </div>
          <div class="shortcut-item">
            <code>O</code>
            <span>Ellipse tool</span>
          </div>
          <div class="shortcut-item">
            <code>L</code>
            <span>Line tool</span>
          </div>
          <div class="shortcut-item">
            <code>T</code>
            <span>Text tool</span>
          </div>
          <div class="shortcut-item">
            <code>P</code>
            <span>Pen tool</span>
          </div>
          <div class="shortcut-item">
            <code>H</code>
            <span>Hand tool (pan)</span>
          </div>
          <div class="shortcut-item">
            <code>Z</code>
            <span>Zoom tool</span>
          </div>
        </div>
      </section>

      <section class="shortcuts-section">
        <h2>View</h2>
        <div class="shortcuts-grid">
          <div class="shortcut-item">
            <code>Ctrl + 0</code>
            <span>Zoom to 100%</span>
          </div>
          <div class="shortcut-item">
            <code>Shift + 1</code>
            <span>Fit all in view</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + +</code>
            <span>Zoom in</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + -</code>
            <span>Zoom out</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + B</code>
            <span>Toggle Layers panel</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + B</code>
            <span>Toggle Inspector panel</span>
          </div>
          <div class="shortcut-item">
            <code>Space + Drag</code>
            <span>Pan canvas</span>
          </div>
          <div class="shortcut-item">
            <code>Mouse wheel</code>
            <span>Pan canvas</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl/Cmd + Mouse wheel</code>
            <span>Zoom around the pointer</span>
          </div>
          <div class="shortcut-item">
            <code>Arrow / Shift + Arrow (Hand)</code>
            <span>Pan by 48 / 192 CSS pixels</span>
          </div>
        </div>
      </section>

      <section class="shortcuts-section">
        <h2>Node editing</h2>
        <div class="shortcuts-grid">
          <div class="shortcut-item">
            <code>Double-click segment</code>
            <span>Insert a node at the nearest curve position</span>
          </div>
          <div class="shortcut-item">
            <code>Shift + C</code>
            <span>Corner/cusp mode</span>
          </div>
          <div class="shortcut-item">
            <code>Shift + S</code>
            <span>Smooth tangent mode</span>
          </div>
          <div class="shortcut-item">
            <code>Shift + Y</code>
            <span>Symmetric tangent and length mode</span>
          </div>
          <div class="shortcut-item">
            <code>Shift + A</code>
            <span>Automatic neighbor-based smoothing</span>
          </div>
          <div class="shortcut-item">
            <code>Arrow / Shift + Arrow</code>
            <span>Nudge selected anchors by the small or big amount</span>
          </div>
          <div class="shortcut-item">
            <code>Delete / Backspace</code>
            <span>Delete selected anchors when the contour remains valid</span>
          </div>
          <div class="shortcut-item">
            <code>Escape</code>
            <span>Cancel an active node drag; press again to exit node editing</span>
          </div>
        </div>
        <p class="shortcuts-note">
          Use Shift+click to add or remove anchors. The on-canvas node panel provides numeric local
          coordinates and relative handle vectors when a pointer drag is not practical.
        </p>
      </section>

      <section class="shortcuts-section">
        <h2>Edit</h2>
        <div class="shortcuts-grid">
          <div class="shortcut-item">
            <code>Ctrl + Z</code>
            <span>Undo</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + Z</code>
            <span>Redo</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + C</code>
            <span>Copy</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + V</code>
            <span>Paste</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + X</code>
            <span>Cut</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + D</code>
            <span>Duplicate</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + A</code>
            <span>Select all</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + A</code>
            <span>Deselect all</span>
          </div>
          <div class="shortcut-item">
            <code>Delete</code>
            <span>Delete selection</span>
          </div>
        </div>
      </section>

      <section class="shortcuts-section">
        <h2>Precision placement</h2>
        <div class="shortcuts-grid">
          <div class="shortcut-item">
            <code>Arrow keys</code>
            <span>Exact nudge of the canvas selection by the configured small amount</span>
          </div>
          <div class="shortcut-item">
            <code>Shift + Arrow</code>
            <span>Exact nudge by the configured big amount</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl/Cmd + Drag</code>
            <span>Temporarily bypass pointer snapping while preserving the drag relationship</span>
          </div>
          <div class="shortcut-item">
            <code>Escape</code>
            <span>Finish an active nudge or cancel an active pointer preview, depending on context</span>
          </div>
        </div>
        <p class="shortcuts-note">
          Arrow keys stay with a focused text/number field, slider, toolbar, dialog, or IME. Set
          nudge amounts in <a href={sitePath('/docs/settings')}>Settings &amp; Preferences</a> and
          use the Inspector for numeric coordinates and alignment/distribution commands. With the
          Hand tool active, Arrow and Shift+Arrow pan the viewport instead of nudging an object.
        </p>
      </section>

      <section class="shortcuts-section">
        <h2>Workspaces</h2>
        <div class="shortcuts-grid">
          <div class="shortcut-item">
            <code>Ctrl + Shift + 1</code>
            <span>Design workspace</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + 2</code>
            <span>Print workspace</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + 3</code>
            <span>Draw workspace</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + 4</code>
            <span>Photo workspace</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + 5</code>
            <span>Motion workspace</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + 6</code>
            <span>Logo workspace</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + 7</code>
            <span>Email workspace</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + 9</code>
            <span>Codegen workspace</span>
          </div>
        </div>
      </section>

      <section class="shortcuts-section">
        <h2>Panels</h2>
        <div class="shortcuts-grid">
          <div class="shortcut-item">
            <code>F6</code>
            <span>Toggle inspector</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Alt + T</code>
            <span>Toggle timeline</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + L</code>
            <span>Toggle layers</span>
          </div>
        </div>
      </section>

      <section class="shortcuts-section">
        <h2>Popovers, menus, and dialogs</h2>
        <div class="shortcuts-grid">
          <div class="shortcut-item">
            <code>Escape</code>
            <span>Close the open popover, menu, or dialog and return focus to the control that opened it</span>
          </div>
          <div class="shortcut-item">
            <code>Tab / Shift + Tab</code>
            <span>Move through a popover's controls; leaving the last control closes it and continues in the page</span>
          </div>
          <div class="shortcut-item">
            <code>Enter / Space</code>
            <span>Open the focused popover trigger, or choose the focused option in a list</span>
          </div>
          <div class="shortcut-item">
            <code>Arrow keys</code>
            <span>Move between options in an open list such as Tool options, Filters, or the workspace filter</span>
          </div>
          <div class="shortcut-item">
            <code>Letter keys</code>
            <span>Type-ahead: jump to the next list option starting with the typed text</span>
          </div>
        </div>
        <p class="shortcuts-note">
          Selecting a tool that has settings opens its Tool options beside the palette, but focus
          stays on the canvas so the tool remains immediately usable. Opening the same popover with
          Enter or Space moves focus into it instead, and Escape always closes it and returns focus
          to its button.
        </p>
      </section>

      <section class="shortcuts-section">
        <h2>File</h2>
        <div class="shortcuts-grid">
          <div class="shortcut-item">
            <code>Ctrl + N</code>
            <span>New document</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + O</code>
            <span>Open document</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + S</code>
            <span>Save document</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + S</code>
            <span>Save as</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + E</code>
            <span>Export</span>
          </div>
        </div>
      </section>

      <section class="shortcuts-section">
        <h2>Layers</h2>
        <div class="shortcuts-grid">
          <div class="shortcut-item">
            <code>Ctrl + G</code>
            <span>Group selection</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + G</code>
            <span>Ungroup</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + ]</code>
            <span>Bring forward</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + [</code>
            <span>Send backward</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + ]</code>
            <span>Bring to front</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + [</code>
            <span>Send to back</span>
          </div>
        </div>
      </section>

      <div class="docs-cta">
        <h2>More Documentation</h2>
        <p>See the <a href={sitePath('/docs')}>documentation hub</a> for more guides.</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .docs-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 0;
  }
  
  .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }
  
  .breadcrumb a {
    color: var(--text-secondary);
  }
  
  .docs-page h1 {
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-family: var(--font-editorial);
    font-weight: 700;
    font-variation-settings: 'opsz' 144;
    letter-spacing: -0.015em;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }
  
  .docs-intro {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: 3rem;
  }
  
  .shortcuts-section {
    margin-bottom: 3rem;
  }
  
  .shortcuts-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }
  
  .shortcuts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr));
    gap: 1rem;
  }
  
  .shortcut-item {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--website-radius-control);
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  .shortcut-item code {
    background: var(--surface-muted);
    padding: 0.25rem 0.5rem;
    border-radius: var(--website-radius-control-compact);
    font-family: monospace;
    font-size: 0.875rem;
    font-weight: 600;
    min-width: 120px;
    text-align: center;
  }
  
  .shortcut-item span {
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .shortcuts-note {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 1rem;
  }

  .shortcuts-note a {
    color: var(--text-link);
  }
  
  .docs-cta {
    text-align: center;
    padding: 3rem 0;
    border-top: 1px solid var(--border-default);
  }
  
  .docs-cta h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }
  
  .docs-cta p {
    color: var(--text-secondary);
  }
</style>
