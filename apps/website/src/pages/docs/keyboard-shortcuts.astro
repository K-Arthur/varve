---
import Layout from '../../layouts/Layout.astro';
import { sitePath } from '../../lib/siteUrl';
---

<Layout title="Keyboard Shortcuts — Varve Docs" description="The complete Varve keyboard shortcut reference: selection, tools, transform, layers, text, view, and workspace modes.">
  <div class="container-custom">
    <div class="docs-page">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={sitePath('/docs')}>Documentation</a> / Keyboard Shortcuts
      </nav>

      <h1>Keyboard Shortcuts</h1>
      <p class="docs-intro">
        Quick reference for Varve keyboard shortcuts.
      </p>

      <section class="shortcuts-section">
        <h2>Tools</h2>
        <div class="shortcuts-grid">
          <div class="shortcut-item">
            <code>V</code>
            <span>Select tool</span>
          </div>
          <div class="shortcut-item">
            <code>R</code>
            <span>Rectangle tool</span>
          </div>
          <div class="shortcut-item">
            <code>O</code>
            <span>Ellipse tool</span>
          </div>
          <div class="shortcut-item">
            <code>L</code>
            <span>Line tool</span>
          </div>
          <div class="shortcut-item">
            <code>T</code>
            <span>Text tool</span>
          </div>
          <div class="shortcut-item">
            <code>P</code>
            <span>Pen tool</span>
          </div>
          <div class="shortcut-item">
            <code>H</code>
            <span>Hand tool (pan)</span>
          </div>
          <div class="shortcut-item">
            <code>Z</code>
            <span>Zoom tool</span>
          </div>
        </div>
      </section>

      <section class="shortcuts-section">
        <h2>View</h2>
        <div class="shortcuts-grid">
          <div class="shortcut-item">
            <code>Ctrl + 0</code>
            <span>Zoom to 100%</span>
          </div>
          <div class="shortcut-item">
            <code>Shift + 1</code>
            <span>Fit all in view</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + +</code>
            <span>Zoom in</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + -</code>
            <span>Zoom out</span>
          </div>
          <div class="shortcut-item">
            <code>Space + Drag</code>
            <span>Pan canvas</span>
          </div>
          <div class="shortcut-item">
            <code>Mouse wheel</code>
            <span>Zoom in/out</span>
          </div>
        </div>
      </section>

      <section class="shortcuts-section">
        <h2>Edit</h2>
        <div class="shortcuts-grid">
          <div class="shortcut-item">
            <code>Ctrl + Z</code>
            <span>Undo</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + Z</code>
            <span>Redo</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + C</code>
            <span>Copy</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + V</code>
            <span>Paste</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + X</code>
            <span>Cut</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + D</code>
            <span>Duplicate</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + A</code>
            <span>Select all</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + A</code>
            <span>Deselect all</span>
          </div>
          <div class="shortcut-item">
            <code>Delete</code>
            <span>Delete selection</span>
          </div>
        </div>
      </section>

      <section class="shortcuts-section">
        <h2>Workspaces</h2>
        <div class="shortcuts-grid">
          <div class="shortcut-item">
            <code>Ctrl + Shift + 1</code>
            <span>Design workspace</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + 2</code>
            <span>Print workspace</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + 3</code>
            <span>Draw workspace</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + 4</code>
            <span>Photo workspace</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + 5</code>
            <span>Motion workspace</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + 6</code>
            <span>Logo workspace</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + 7</code>
            <span>Email workspace</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + 9</code>
            <span>Codegen workspace</span>
          </div>
        </div>
      </section>

      <section class="shortcuts-section">
        <h2>Panels</h2>
        <div class="shortcuts-grid">
          <div class="shortcut-item">
            <code>F6</code>
            <span>Toggle inspector</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Alt + T</code>
            <span>Toggle timeline</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + L</code>
            <span>Toggle layers</span>
          </div>
        </div>
      </section>

      <section class="shortcuts-section">
        <h2>File</h2>
        <div class="shortcuts-grid">
          <div class="shortcut-item">
            <code>Ctrl + N</code>
            <span>New document</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + O</code>
            <span>Open document</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + S</code>
            <span>Save document</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + S</code>
            <span>Save as</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + E</code>
            <span>Export</span>
          </div>
        </div>
      </section>

      <section class="shortcuts-section">
        <h2>Layers</h2>
        <div class="shortcuts-grid">
          <div class="shortcut-item">
            <code>Ctrl + G</code>
            <span>Group selection</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + G</code>
            <span>Ungroup</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + ]</code>
            <span>Bring forward</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + [</code>
            <span>Send backward</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + ]</code>
            <span>Bring to front</span>
          </div>
          <div class="shortcut-item">
            <code>Ctrl + Shift + [</code>
            <span>Send to back</span>
          </div>
        </div>
      </section>

      <div class="docs-cta">
        <h2>More Documentation</h2>
        <p>See the <a href={sitePath('/docs')}>documentation hub</a> for more guides.</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .docs-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 0;
  }
  
  .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }
  
  .breadcrumb a {
    color: var(--text-secondary);
  }
  
  .docs-page h1 {
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-family: var(--font-editorial);
    font-weight: 700;
    font-variation-settings: 'opsz' 144;
    letter-spacing: -0.015em;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }
  
  .docs-intro {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: 3rem;
  }
  
  .shortcuts-section {
    margin-bottom: 3rem;
  }
  
  .shortcuts-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }
  
  .shortcuts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr));
    gap: 1rem;
  }
  
  .shortcut-item {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  .shortcut-item code {
    background: var(--surface-muted);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-family: monospace;
    font-size: 0.875rem;
    font-weight: 600;
    min-width: 120px;
    text-align: center;
  }
  
  .shortcut-item span {
    color: var(--text-secondary);
    font-size: 0.875rem;
  }
  
  .docs-cta {
    text-align: center;
    padding: 3rem 0;
    border-top: 1px solid var(--border-default);
  }
  
  .docs-cta h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }
  
  .docs-cta p {
    color: var(--text-secondary);
  }
</style>
