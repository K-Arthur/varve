---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="License — Varve">
  <div class="container-custom">
    <div class="license-page">
      <h1>License</h1>

      <section class="license-section">
        <h2>Functional Source License, Version 1.1, MIT Future License</h2>
        <p>
          Varve is licensed under the <strong>Functional Source License, Version 1.1,
          MIT Future License</strong> (FSL-1.1-MIT). This is a source-available license
          that balances open access with the ability to sustain continued development,
          using fixed, predictable terms rather than a custom grant.
        </p>
      </section>

      <section class="license-section">
        <h2>What FSL-1.1-MIT Means</h2>
        <p>
          You may use, copy, modify, create derivative works, publicly perform, publicly
          display, and redistribute Varve for any <strong>Permitted Purpose</strong> —
          which is any purpose other than a <strong>Competing Use</strong>. A Competing Use
          means making Varve available to others in a commercial product or service that
          substitutes for Varve, substitutes for another product or service we offer using
          Varve, or offers substantially similar functionality. Permitted Purposes
          specifically include:
        </p>
        <ul>
          <li><strong>Use</strong> Varve for any purpose — personal, commercial, or educational</li>
          <li><strong>Modify</strong> the source code</li>
          <li><strong>Share</strong> copies of the software with others</li>
          <li><strong>Study</strong> how the software works</li>
          <li><strong>Develop</strong> plugins and extensions</li>
          <li><strong>Redistribute</strong> your modifications, provided you keep the license notices intact</li>
        </ul>
        <p>
          Competing uses — offering Varve (or a substitute for it) as a commercial product
          or hosted service to others — require a separate commercial license.
        </p>
      </section>

      <section class="license-section">
        <h2>Two-Year Conversion to MIT</h2>
        <p>
          Each release of Varve automatically converts to the <strong>MIT license</strong>
          on the second anniversary of its first public availability. This means:
        </p>
        <ul>
          <li>All code eventually becomes fully open-source under the permissive MIT license</li>
          <li>If development stops, previously released versions become MIT-licensed over time</li>
          <li>The community can freely fork and continue development on MIT-licensed code</li>
        </ul>
      </section>

      <section class="license-section">
        <h2>User Rights Summary</h2>
        <table class="license-table">
          <tr>
            <td>Use for personal projects</td>
            <td class="allowed">Allowed</td>
          </tr>
          <tr>
            <td>Use for commercial work (client designs)</td>
            <td class="allowed">Allowed</td>
          </tr>
          <tr>
            <td>Use within your organisation</td>
            <td class="allowed">Allowed</td>
          </tr>
          <tr>
            <td>Modify source code</td>
            <td class="allowed">Allowed</td>
          </tr>
          <tr>
            <td>Distribute official binaries</td>
            <td class="allowed">Allowed</td>
          </tr>
          <tr>
            <td>Distribute modified source code</td>
            <td class="allowed">Allowed</td>
          </tr>
          <tr>
            <td>Develop and sell plugins</td>
            <td class="allowed">Allowed</td>
          </tr>
          <tr>
            <td>Competing use (substitute product or service)</td>
            <td class="restricted">Requires license</td>
          </tr>
          <tr>
            <td>Offering as a competing hosted service</td>
            <td class="restricted">Requires license</td>
          </tr>
          <tr>
            <td>Removing Varve branding</td>
            <td class="restricted">Requires license</td>
          </tr>
        </table>
      </section>

      <section class="license-section">
        <h2>Contributions</h2>
        <p>
          Contributions to Varve are accepted under FSL-1.1-MIT (and subsequently the
          MIT change license after two years). Contributors retain copyright to their work.
          See the <a href="/contribute/guidelines">contribution guidelines</a> for the
          project's current status on external contributions.
        </p>
      </section>

      <section class="license-section">
        <h2>Third-Party Components</h2>
        <p>
          Varve includes third-party software under its own license terms. Full attribution
          is provided in the <code>THIRD_PARTY_NOTICES</code> file in the repository.
          Key components:
        </p>
        <ul>
          <li>Lucide icons — ISC License</li>
          <li>Phosphor icons — MIT License</li>
          <li>Geist font — SIL Open Font License 1.1</li>
          <li>IBM Plex Sans font — SIL Open Font License 1.1</li>
          <li>ONNX Runtime — MIT License</li>
          <li>ONNX AI models (u2netp, Real-ESRGAN) — MIT and BSD-3-Clause</li>
        </ul>
      </section>

      <section class="license-section">
        <h2>Copyright</h2>
        <p>
          Copyright 2024-2026 K-Arthur (Varve Founder).
        </p>
        <p>
          "Varve" is a trademark of K-Arthur. See the
          <a href="https://github.com/K-Arthur/varve/blob/main/TRADEMARKS.md">Trademark Policy</a>
          for usage guidelines.
        </p>
      </section>

      <div class="license-cta">
        <a href="https://github.com/K-Arthur/varve/blob/main/LICENSE" class="btn-primary" target="_blank" rel="noopener noreferrer">
          View the LICENSE File on GitHub
        </a>
        <a href="https://fsl.software/" class="btn-secondary" target="_blank" rel="noopener noreferrer">
          Official FSL-1.1-MIT Text
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .license-page {
    max-width: 700px;
    margin: 0 auto;
    padding: 3rem 0;
  }

  .license-page h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 2rem;
    color: var(--color-neutral-900);
  }

  .license-section {
    margin-bottom: 3rem;
  }

  .license-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--color-neutral-900);
  }

  .license-section p {
    color: var(--color-neutral-600);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .license-section ul {
    list-style: none;
    margin-bottom: 1rem;
  }

  .license-section li {
    color: var(--color-neutral-600);
    line-height: 1.8;
    margin-bottom: 0.75rem;
    padding-left: 1.5rem;
    position: relative;
  }

  .license-section li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-teal-400);
    font-weight: bold;
  }

  .license-section strong {
    color: var(--color-neutral-900);
  }

  .license-section code {
    background: var(--color-neutral-100);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
  }

  .license-note {
    background: var(--color-neutral-50);
    border: 1px solid var(--color-neutral-200);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }

  .license-note p {
    margin-bottom: 0;
  }

  .license-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1rem;
  }

  .license-table tr {
    border-bottom: 1px solid var(--color-neutral-200);
  }

  .license-table td {
    padding: 0.75rem 0;
    color: var(--color-neutral-700);
  }

  .license-table td:first-child {
    font-weight: 500;
    color: var(--color-neutral-900);
  }

  .license-table td.allowed {
    color: #16a34a;
    font-weight: 600;
    text-align: right;
  }

  .license-table td.restricted {
    color: #dc2626;
    font-weight: 600;
    text-align: right;
  }

  .license-cta {
    display: flex;
    gap: 1rem;
    padding: 2rem 0;
    border-top: 1px solid var(--color-neutral-200);
  }

  @media (max-width: 768px) {
    .license-page h1 {
      font-size: 2rem;
    }

    .license-cta {
      flex-direction: column;
    }
  }
</style>
