---
import Layout from '../layouts/Layout.astro';
import { sitePath } from '../lib/siteUrl';
---

<Layout title="Documentation — Varve Docs" description="Varve documentation: installation, getting started, interface overview, keyboard shortcuts, tools, and technical architecture.">
  <div class="container-custom">
    <div class="docs-page">
      <h1 class="page-hero-title">Documentation</h1>
      <p class="page-hero-sub">
        Installation and first steps, tool-by-tool guides, keyboard shortcuts,
        file formats, and the rendering architecture behind Varve.
      </p>

      <div class="docs-grid site-card-grid">
        <div class="docs-card site-card site-card--surface">
          <h2>Getting Started</h2>
          <p>Installation, first steps, and basic workflows</p>
          <ul>
            <li><a href={sitePath('/docs/getting-started')}>Installation Guide</a></li>
            <li><a href={sitePath('/docs/getting-started/interface')}>Interface Overview</a></li>
            <li><a href={sitePath('/docs/getting-started/first-project')}>Your First Project</a></li>
          </ul>
        </div>

        <div class="docs-card site-card site-card--surface">
          <h2>Reference</h2>
          <p>Quick reference for keyboard shortcuts and settings</p>
          <ul>
            <li><a href={sitePath('/docs/keyboard-shortcuts')}>Keyboard Shortcuts</a></li>
            <li><a href={sitePath('/docs/settings')}>Settings & Preferences</a></li>
            <li><a href={sitePath('/docs/updates')}>Updates</a></li>
            <li><a href={sitePath('/docs/file-formats')}>File Formats</a></li>
          </ul>
        </div>

        <div class="docs-card site-card site-card--surface">
          <h2>Technical</h2>
          <p>Architecture and technical documentation</p>
          <ul>
            <li><a href={sitePath('/docs/architecture')}>Architecture Overview</a></li>
            <li><a href={sitePath('/docs/rendering')}>Rendering Pipeline</a></li>
            <li><a href={sitePath('/docs/development-workflow')}>Development Workflow</a></li>
            <li><a href="https://github.com/K-Arthur/varve/blob/main/AGENTS.md">Development Guide (AGENTS.md)</a></li>
          </ul>
        </div>

        <div class="docs-card docs-card--wide site-card site-card--surface">
          <h2>Tools & Features</h2>
          <p>Comprehensive guide to all tools and capabilities</p>
          <ul>
            <li><a href={sitePath('/docs/tools/vector')}>Vector Tools</a></li>
            <li><a href={sitePath('/docs/tools/typography')}>Typography</a></li>
            <li><a href={sitePath('/docs/tools/color')}>Color & Effects</a></li>
            <li><a href={sitePath('/docs/tools/effect-studio')}>Effect Studio</a></li>
            <li><a href={sitePath('/docs/tools/image-treatments')}>Image Treatments</a></li>
            <li><a href={sitePath('/docs/tools/image-conversion')}>Image Conversion</a></li>
            <li><a href={sitePath('/docs/tools/frame-interpolation')}>Frame Interpolation</a></li>
            <li><a href={sitePath('/docs/tools/object-selection')}>Object Selection</a></li>
            <li><a href={sitePath('/docs/tools/generative-editing')}>Generative Editing</a></li>
            <li><a href={sitePath('/docs/tools/depth-blur')}>Depth Blur</a></li>
            <li><a href={sitePath('/docs/tools/visual-awareness')}>Visual Awareness</a></li>
            <li><a href={sitePath('/features/asset-search')}>Asset Search</a></li>
            <li><a href={sitePath('/docs/tools/asset-similarity')}>Asset Similarity</a></li>
            <li><a href={sitePath('/docs/tools/motion')}>Motion & Prototyping</a></li>
            <li><a href={sitePath('/docs/tools/grids')}>Grid Systems</a></li>
            <li><a href={sitePath('/features/clipboard')}>Clipboard & Interoperability</a></li>
            <li><a href={sitePath('/docs/tools/export')}>Export & Code Generation</a></li>
            <li><a href={sitePath('/docs/workspaces')}>Workspaces</a></li>
          </ul>
        </div>
      </div>

      <div class="docs-note">
        <h3>Documentation Status</h3>
        <p>
          Documentation is being actively developed. For the most up-to-date information, see the{' '}
          <a href="https://github.com/K-Arthur/varve">GitHub repository</a> and{' '}
          <a href="https://github.com/K-Arthur/varve/discussions">GitHub Discussions</a>.
        </p>
        <p>
          Want to help improve documentation? See the{' '}
          <a href={sitePath('/contribute')}>contribution guidelines</a>.
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .docs-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 0;
  }
  
  .docs-page .page-hero-title {
    margin-bottom: 0.75rem;
  }

  .docs-page .page-hero-sub {
    margin-bottom: 2.5rem;
  }
  
  .docs-grid {
    display: grid;
    /* Three short reference cards, then the full-width tools catalogue. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin-bottom: 3rem;
    /* Cards size to their own content. The old stretch behaviour turned the
       three-link Getting Started card into a mostly-empty 400px box beside
       the long Tools & Features list. */
    align-items: start;
  }

  /* The long tools catalogue spans the full grid width and flows its links
     into columns, so every card stays close to its natural height. */
  .docs-card--wide {
    grid-column: 1 / -1;
  }

  .docs-card--wide ul {
    columns: 3;
    column-gap: var(--space-6);
  }

  .docs-card--wide li {
    break-inside: avoid;
  }

  @media (max-width: 760px) {
    .docs-grid {
      grid-template-columns: 1fr;
    }

    .docs-card--wide ul {
      columns: 1;
    }
  }
  
  .docs-card {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--website-radius-card);
    padding: 1.5rem;
  }
  
  .docs-card h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }
  
  .docs-card p {
    color: var(--text-secondary);
    margin-bottom: 1rem;
    font-size: 0.9375rem;
  }
  
  .docs-card ul {
    list-style: none;
  }
  
  .docs-card li {
    margin-bottom: 0.5rem;
  }
  
  .docs-card a {
    color: var(--text-link);
    font-size: 0.9375rem;
  }
  
  .docs-note {
    background: var(--surface-muted);
    border-radius: var(--website-radius-card);
    padding: 1.5rem;
  }
  
  .docs-note h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  
  .docs-note p {
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }
</style>
