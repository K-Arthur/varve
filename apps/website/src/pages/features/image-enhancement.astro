---
import Layout from '../../layouts/Layout.astro';
import StatusPill from '../../components/StatusPill.astro';
import { sitePath } from '../../lib/siteUrl';
import manifest from '../../data/screenshot-manifest.json';

type ScreenshotScene = { file: string; alt: string; width?: number; height?: number; status?: string };
const scenes = (manifest as { scenes: Record<string, ScreenshotScene> }).scenes;
const enhanceShot = scenes['enhance-dialog-auto']?.status === 'captured' ? scenes['enhance-dialog-auto'] : null;
---

<Layout
  title="Image Enhance"
  description="Clean up noise and enlarge images through one local-first Enhance workflow in Varve."
>
  <div class="container-custom">
    <main class="enhance-page">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={sitePath('/features')}>Features</a> / Image Enhance
      </nav>

      <header class="page-hero">
        <StatusPill status="available" />
        <h1>Enhance images without leaving the canvas.</h1>
        <p>
          Denoise, upscale, or combine both in one focused workflow. Varve keeps
          restoration local, bounded, and explicit about what each operation can do.
        </p>
      </header>

      <section class="workflow" aria-labelledby="workflow-title">
        <div>
          <p class="eyebrow">One workflow</p>
          <h2 id="workflow-title">From source pixels to a considered result.</h2>
          <p>
            Choose the task you actually need. Denoise uses a task-specific local
            model; Deblur reduces motion and defocus blur with a validated model;
            Upscale uses the existing CPU or AI path; Restore + Upscale runs
            only those selected stages, in order.
          </p>
        </div>
        {enhanceShot && (
          <figure class="enhance-shot">
            <img
              src={sitePath(`/screenshots/${enhanceShot.file}`)}
              alt={enhanceShot.alt}
              width={enhanceShot.width ?? 1440}
              height={enhanceShot.height ?? 900}
              loading="lazy"
            />
            <figcaption>
              The Enhance dialog in Auto mode — it detected noise on a real photo and
              recommended a task in plain language.
            </figcaption>
          </figure>
        )}
        <div class="pipeline" aria-label="Enhance workflow stages">
          <div class="pipeline-step"><span>01</span><strong>Source image</strong><small>Existing pixels stay intact</small></div>
          <div class="pipeline-arrow" aria-hidden="true">→</div>
          <div class="pipeline-step pipeline-step--accent"><span>02</span><strong>Enhance</strong><small>Denoise, deblur, upscale, or both</small></div>
          <div class="pipeline-arrow" aria-hidden="true">→</div>
          <div class="pipeline-step"><span>03</span><strong>New layer</strong><small>Review before replacing</small></div>
        </div>
      </section>

      <section class="capabilities" aria-labelledby="capabilities-title">
        <p class="eyebrow">Available today</p>
        <h2 id="capabilities-title">Useful improvements, with honest boundaries.</h2>
        <div class="capability-grid">
          <article><h3>Denoise</h3><p>Reduce sensor noise and grain while preserving the alpha channel and keeping the source available for comparison.</p></article>
          <article><h3>Deblur</h3><p>Reduce motion and defocus blur with a validated local model — preview a bounded crop before committing to full-resolution work.</p></article>
          <article><h3>Upscale</h3><p>Choose bounded CPU resampling, pixel-art scaling, or the local Real-ESRGAN path for supported image work.</p></article>
          <article><h3>Restore + Upscale</h3><p>Compose only the stages you selected. Restoration runs before enlargement so noise is not simply made larger.</p></article>
          <article><h3>Auto / Recommended</h3><p>A quick local analysis suggests what your image actually needs, in plain language, with a confidence number you can override.</p></article>
        </div>
      </section>

      <aside class="honesty" aria-labelledby="honesty-title">
        <h2 id="honesty-title">Designed for faithful work.</h2>
        <p>
          JPEG artifact removal is not offered: no model has passed Varve's
          design-content quality checks for that task. Every operation stays
          explicit about what it can and cannot do, and no operation silently
          substitutes a different task when its model is unavailable.
        </p>
        <a href={sitePath('/docs/tools/image-enhancement')}>Read the image enhancement guide →</a>
      </aside>
    </main>
  </div>
</Layout>

<style>
  .enhance-page { max-width: 900px; margin: 0 auto; padding: 3rem 0 5rem; }
  .breadcrumb { font-size: .875rem; margin-bottom: 2.5rem; color: var(--text-secondary); }
  .breadcrumb a { color: var(--text-secondary); }
  .page-hero { max-width: 680px; margin-bottom: 4rem; }
  .page-hero h1 { margin: 1rem 0; font: 700 clamp(2.3rem, 6vw, 4rem)/1.05 var(--font-editorial); color: var(--text-primary); letter-spacing: -.025em; }
  .page-hero p { color: var(--text-secondary); font-size: 1.2rem; line-height: 1.7; }
  .eyebrow { color: var(--accent-primary); font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .workflow, .honesty { border: 1px solid var(--border-default); border-radius: 1rem; background: var(--surface-card); padding: clamp(1.5rem, 4vw, 3rem); }
  .workflow h2, .capabilities h2, .honesty h2 { color: var(--text-primary); font-size: clamp(1.6rem, 3vw, 2.3rem); margin: .5rem 0 1rem; }
  .workflow p, .honesty p { color: var(--text-secondary); line-height: 1.75; }
  .enhance-shot { margin: 2rem 0 0; }
  .enhance-shot img { width: 100%; height: auto; border: 1px solid var(--border-default); border-radius: .8rem; }
  .enhance-shot figcaption { color: var(--text-tertiary); font-size: .8rem; margin-top: .5rem; }
  .pipeline { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: stretch; gap: .75rem; margin-top: 2rem; }
  .pipeline-step { display: flex; flex-direction: column; gap: .45rem; padding: 1rem; border: 1px solid var(--border-default); border-radius: .7rem; }
  .pipeline-step--accent { border-color: var(--border-accent); background: var(--surface-accent-soft); }
  .pipeline-step span { color: var(--text-tertiary); font-size: .7rem; }
  .pipeline-step strong { color: var(--text-primary); }
  .pipeline-step small { color: var(--text-secondary); line-height: 1.4; }
  .pipeline-arrow { align-self: center; color: var(--accent-primary); font-size: 1.25rem; }
  .capabilities { padding: 4rem 0; }
  .capability-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .capability-grid article { border-top: 2px solid var(--border-accent); padding-top: 1rem; }
  .capability-grid h3 { color: var(--text-primary); margin: 0 0 .5rem; }
  .capability-grid p { color: var(--text-secondary); line-height: 1.65; margin: 0; }
  .honesty a { color: var(--text-link); font-weight: 600; }
  @media (max-width: 680px) { .pipeline { grid-template-columns: 1fr; } .pipeline-arrow { transform: rotate(90deg); justify-self: center; } .capability-grid { grid-template-columns: 1fr; } }
</style>
