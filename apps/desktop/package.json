{
  "name": "@varve/desktop",
  "version": "0.2.1",
  "private": true,
  "description": "Varve desktop app (Tauri 2) — Vite + React frontend.",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/copy-onnx-wasm.mjs",
    "dev": "vite",
    "prebuild": "node ../../scripts/copy-onnx-wasm.mjs",
    "build": "node ../../scripts/security/validate-client-env.mjs --app desktop && tsc --noEmit && vite build",
    "build:wdio": "node ../../scripts/security/validate-client-env.mjs --app desktop && tsc --noEmit && vite build --mode wdio",
    "prebuild:try": "node ../../scripts/copy-onnx-wasm.mjs",
    "build:try": "node ../../scripts/security/validate-client-env.mjs --app desktop && tsc --noEmit && VITE_DEMO=1 VITE_BASE_URL=/try/ vite build --outDir dist-try",
    "preview": "vite preview",
    "tauri": "tauri",
    "pretauri:dev": "node scripts/pre-tauri-dev.mjs",
    "tauri:dev": "tauri dev",
    "posttauri:dev": "echo '[info] Dev mode (build) — no icon steps needed'",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@varve/editor": "workspace:*",
    "@varve/engine": "workspace:*",
    "@varve/home": "workspace:*",
    "@varve/platform": "workspace:*",
    "@varve/scene": "workspace:*",
    "@varve/shared": "workspace:*",
    "@varve/ui": "workspace:*",
    "onnxruntime-web": "^1.27.0"
  },
  "license": "FSL-1.1-MIT"
}
