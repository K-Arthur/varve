{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Varve",
  "version": "0.1.1",
  "identifier": "dev.varve.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Varve",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'", "'wasm-unsafe-eval'", "blob:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:", "blob:", "https:"],
        "font-src": ["'self'", "data:"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "https://github.com",
          "https://huggingface.co",
          "https://raw.githubusercontent.com",
          "https://www.googleapis.com",
          "https://*.githubusercontent.com",
          "https://*.huggingface.co",
          "https://*.hf.co",
          "https://api.iconify.design",
          "https://api.simplesvg.com",
          "https://api.unisvg.com",
          "https://plausible.io"
        ],
        "worker-src": ["'self'"],
        "media-src": ["'self'", "blob:", "data:"],
        "object-src": ["'none'"],
        "frame-src": ["'none'"],
        "base-uri": ["'self'"],
        "form-action": ["'none'"],
        "manifest-src": ["'self'"]
      },
      "devCsp": {
        "default-src": ["'self'"],
        "script-src": ["'self'", "'wasm-unsafe-eval'", "blob:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:", "blob:", "https:"],
        "font-src": ["'self'", "data:"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "ws://localhost:1420",
          "https://github.com",
          "https://huggingface.co",
          "https://raw.githubusercontent.com",
          "https://www.googleapis.com",
          "https://*.githubusercontent.com",
          "https://*.huggingface.co",
          "https://*.hf.co",
          "https://api.iconify.design",
          "https://api.simplesvg.com",
          "https://api.unisvg.com",
          "https://plausible.io"
        ],
        "worker-src": ["'self'"],
        "media-src": ["'self'", "blob:", "data:"],
        "object-src": ["'none'"],
        "frame-src": ["'none'"],
        "base-uri": ["'self'"],
        "form-action": ["'none'"],
        "manifest-src": ["'self'"]
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm", "nsis", "dmg"],
    "resources": ["onnxruntime-libs/**/*"],
    "fileAssociations": [
      {
        "ext": ["varve"],
        "name": "Varve Document",
        "description": "Varve design document",
        "mimeType": "application/x-varve",
        "role": "Editor"
      },
      {
        "ext": ["strata"],
        "name": "Varve Document (legacy)",
        "description": "Varve design document (legacy Strata format)",
        "mimeType": "application/x-strata",
        "role": "Editor"
      }
    ],
    "publisher": "K-Arthur (Varve Founder)",
    "homepage": "https://github.com/K-Arthur/varve",
    "copyright": "Copyright 2024-2026 K-Arthur — FSL-1.1-MIT",
    "category": "GraphicsAndDesign",
    "shortDescription": "Local-first design suite",
    "longDescription": "Varve is a local-first design suite for vector, layout, typography, motion, prototyping, and print production. Runs natively on Linux, macOS, and Windows. Your designs stay on your machine. Source-available under FSL-1.1-MIT.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "/usr/share/icons/hicolor": "icons/hicolor/"
        }
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libglib2.0-0",
          "libsoup-3.0-0",
          "librsvg2-2",
          "libssl3",
          "libgdk-pixbuf-2.0-0",
          "libcairo2",
          "libpango-1.0-0",
          "libfontconfig1"
        ],
        "desktopTemplate": "linux/dev.varve.desktop.desktop",
        "files": {
          "/usr/share/icons/hicolor/16x16/apps/dev.varve.desktop.png": "icons/hicolor/16x16/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/22x22/apps/dev.varve.desktop.png": "icons/hicolor/22x22/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/24x24/apps/dev.varve.desktop.png": "icons/hicolor/24x24/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/32x32/apps/dev.varve.desktop.png": "icons/hicolor/32x32/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/48x48/apps/dev.varve.desktop.png": "icons/hicolor/48x48/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/64x64/apps/dev.varve.desktop.png": "icons/hicolor/64x64/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/96x96/apps/dev.varve.desktop.png": "icons/hicolor/96x96/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/128x128/apps/dev.varve.desktop.png": "icons/hicolor/128x128/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/256x256/apps/dev.varve.desktop.png": "icons/hicolor/256x256/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/512x512/apps/dev.varve.desktop.png": "icons/hicolor/512x512/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/1024x1024/apps/dev.varve.desktop.png": "icons/hicolor/1024x1024/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/scalable/apps/dev.varve.desktop.svg": "icons/hicolor/scalable/apps/dev.varve.desktop.svg",
          "/usr/share/icons/hicolor/symbolic/apps/dev.varve.desktop-symbolic.svg": "icons/hicolor/symbolic/apps/dev.varve.desktop-symbolic.svg",
          "/usr/share/mime/packages/dev.varve.desktop.xml": "linux/dev.varve.desktop.xml"
        }
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "glib2", "librsvg2", "openssl", "fontconfig"],
        "epoch": 0,
        "desktopTemplate": "linux/dev.varve.desktop.desktop",
        "files": {
          "/usr/share/icons/hicolor/16x16/apps/dev.varve.desktop.png": "icons/hicolor/16x16/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/22x22/apps/dev.varve.desktop.png": "icons/hicolor/22x22/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/24x24/apps/dev.varve.desktop.png": "icons/hicolor/24x24/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/32x32/apps/dev.varve.desktop.png": "icons/hicolor/32x32/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/48x48/apps/dev.varve.desktop.png": "icons/hicolor/48x48/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/64x64/apps/dev.varve.desktop.png": "icons/hicolor/64x64/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/96x96/apps/dev.varve.desktop.png": "icons/hicolor/96x96/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/128x128/apps/dev.varve.desktop.png": "icons/hicolor/128x128/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/256x256/apps/dev.varve.desktop.png": "icons/hicolor/256x256/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/512x512/apps/dev.varve.desktop.png": "icons/hicolor/512x512/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/1024x1024/apps/dev.varve.desktop.png": "icons/hicolor/1024x1024/apps/dev.varve.desktop.png",
          "/usr/share/icons/hicolor/scalable/apps/dev.varve.desktop.svg": "icons/hicolor/scalable/apps/dev.varve.desktop.svg",
          "/usr/share/icons/hicolor/symbolic/apps/dev.varve.desktop-symbolic.svg": "icons/hicolor/symbolic/apps/dev.varve.desktop-symbolic.svg",
          "/usr/share/mime/packages/dev.varve.desktop.xml": "linux/dev.varve.desktop.xml"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "frameworks": [],
      "exceptionDomain": null
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "wix": {
        "language": ["en-US"]
      },
      "nsis": {}
    }
  }
}
