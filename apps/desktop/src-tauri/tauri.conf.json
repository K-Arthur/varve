{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strata Desktop",
  "version": "0.0.0",
  "identifier": "dev.strata.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Strata",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Strata",
        "url": "splashscreen.html",
        "width": 360,
        "height": 280,
        "decorations": false,
        "center": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Strata Contributors",
    "homepage": "https://github.com/strata/strata",
    "copyright": "Copyright 2024-2026 Strata Contributors — AGPL-3.0-or-later",
    "category": "GraphicsAndDesign",
    "shortDescription": "Local-first cross-platform design tool",
    "longDescription": "Strata is a local-first, cross-platform design suite for UI and print. It runs natively on Linux, macOS, and Windows via a Tauri + Rust engine with a React frontend. No cloud, no lock-in.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libglib2.0-0",
          "libsoup-3.0-0",
          "librsvg2-2",
          "libssl3",
          "libgdk-pixbuf-2.0-0",
          "libcairo2",
          "libpango-1.0-0",
          "libfontconfig1"
        ],
        "files": {}
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "glib2", "librsvg2", "openssl", "fontconfig"],
        "epoch": 0,
        "files": {}
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "frameworks": [],
      "exceptionDomain": null
    },
    "windows": {
      "wix": {
        "language": ["en-US"]
      },
      "nsis": {}
    }
  }
}
