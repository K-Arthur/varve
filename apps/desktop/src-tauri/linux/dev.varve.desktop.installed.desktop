[Desktop Entry]
Name=Varve
GenericName=Design Tool
Comment=Local-first design application for vector, raster, layout, typography, motion, and print
Exec=varve-desktop %F
Icon=dev.varve.desktop
Type=Application
Categories=Graphics;2DGraphics;VectorGraphics;
