<!--
  AppStream metainfo for Varve.

  Installed to /usr/share/metainfo/ by the deb, rpm and AppImage bundles so
  GNOME Software, KDE Discover, AppImageHub and similar consumers can render
  a proper application page. Requires at least one <release> entry; the
  version here must match the committed release version (enforced by
  scripts/release/linux-package-metadata.test.mjs).

  License note: Varve is source-available under FSL-1.1-MIT, which is not a
  standard SPDX identifier. It is expressed as a custom SPDX reference
  (LicenseRef-) rather than being mislabelled as an OSI-approved license —
  the SPDX identifier used by the AUR package and the distro candidates must
  stay consistent with this declaration.
-->
<component type="desktop-application">
  <id>dev.varve.desktop</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-FSL-1.1-MIT</project_license>
  <name>Varve</name>
  <summary>Local-first design suite for vector, layout, typography, motion, and print</summary>
  <description>
    <p>
      Varve is a local-first design suite for vector illustration, page
      layout, typography, motion, prototyping, and print production. It runs
      natively on Linux, macOS, and Windows, and keeps your designs on your
      machine.
    </p>
    <p>
      Source-available under FSL-1.1-MIT. Optional AI assist features
      (background removal, image upscaling, raster-to-vector tracing) run
      on-device; a small set of optional models downloads on demand.
    </p>
  </description>
  <launchable type="desktop-id">dev.varve.desktop.desktop</launchable>
  <url type="homepage">https://varve.studio</url>
  <url type="bugtracker">https://github.com/K-Arthur/varve/issues</url>
  <url type="faq">https://varve.studio/support/faq</url>
  <developer id="dev.varve.desktop">
