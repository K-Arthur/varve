{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel-windows",
  "description": "Restricted capability for auxiliary panel windows (ADR-0040): window lifecycle, placement, monitor enumeration, and native window events only. No filesystem, dialog, opener, path, webview, menu, tray, or app access.",
  "windows": ["varve-w-*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-is-visible",
    "core:window:allow-is-focused",
    "core:window:allow-is-minimized",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-available-monitors",
    "core:window:allow-primary-monitor",
    "core:window:allow-current-monitor",
    "core:window:allow-get-all-windows"
  ]
}
